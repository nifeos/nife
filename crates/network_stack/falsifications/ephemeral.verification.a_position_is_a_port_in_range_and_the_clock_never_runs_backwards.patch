--- a/crates/network_stack/src/ephemeral.rs
+++ b/crates/network_stack/src/ephemeral.rs
@@ -79,7 +79,7 @@ fn clock(milliseconds: u64) -> u64 {
 }
 
 fn port_at(position: u64) -> u16 {
-    LO + (position % SPAN) as u16
+    LO + (position % (SPAN + 1)) as u16
 }
 
