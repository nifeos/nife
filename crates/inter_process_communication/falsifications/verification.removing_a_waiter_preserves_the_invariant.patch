+++ b/crates/inter_process_communication/src/rendezvous.rs
@@ -296,6 +296,10 @@ impl<T: Node> Rendezvous<T> {
             return None;
         };
         let found = senders.remove(victim);
+        if let Some(node) = &found {
+            // SAFETY: none. This is the defect: the victim goes back on the queue it was taken off.
+            senders.push_back(unsafe { Unqueued::new(node.as_non_null()) });
+        }
         if senders.is_empty() {
             self.waiting = Waiting::Nobody;
         }
