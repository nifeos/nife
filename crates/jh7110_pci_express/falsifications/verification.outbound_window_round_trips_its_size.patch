     }
     // At most 62, since `size_bytes` is a power of two of at least 4 KiB in a u64: always inside
     // the 6-bit field.
-    let size_field = size_bytes.trailing_zeros() - 1;
+    let size_field = size_bytes.trailing_zeros();
