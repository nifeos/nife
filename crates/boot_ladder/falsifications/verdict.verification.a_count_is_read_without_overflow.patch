Falsifies `boot_ladder::verdict::verification::a_count_is_read_without_overflow`.

The defect: a count is accumulated with plain arithmetic instead of checked arithmetic. A line whose
count has more digits than a `usize` holds, which a corrupted link can produce, then overflows.

Expected to fail: an arithmetic overflow in `leading_number`.

diff --git a/crates/boot_ladder/src/verdict.rs b/crates/boot_ladder/src/verdict.rs
--- a/crates/boot_ladder/src/verdict.rs
+++ b/crates/boot_ladder/src/verdict.rs
@@ -429,9 +429,7 @@ fn leading_number(bytes: &[u8]) -> Option<(usize, usize)> {
     let mut value = 0usize;
     let mut end = 0;
     while end < bytes.len() && bytes[end].is_ascii_digit() {
-        value = value
-            .checked_mul(10)?
-            .checked_add(usize::from(bytes[end] - b'0'))?;
+        value = value * 10 + usize::from(bytes[end] - b'0');
         end += 1;
     }
     (end > 0).then_some((value, end))
