From 047a1b6aeff539f66fb2bc9274e748d11c18c7d2 Mon Sep 17 00:00:00 2001
From: Chris Alef <chris@crickertech.com>
Date: Sun, 22 Nov 2026 19:11:14 +0000
Subject: [PATCH] docs(rsext4): state the safety argument at each CRC32C unsafe
 use

Each call into a hardware CRC32C helper now names the CPU feature it
needs and the register it was detected from. The aarch64 feature read
says why `mrs` of an EL1 ID register is valid at EL0, and the aarch64
loop has one unsafe block per pointer operation, each with its
alignment and bounds argument, instead of one block over the whole
body. The instructions executed are unchanged.
---
 fs/rsext4/src/crc32c/arm64.rs  | 88 +++++++++++++++++++++-------------
 fs/rsext4/src/crc32c/crc32c.rs |  9 ++++
 2 files changed, 64 insertions(+), 33 deletions(-)

diff --git a/fs/rsext4/src/crc32c/arm64.rs b/fs/rsext4/src/crc32c/arm64.rs
index 7f2c87826..22c56daef 100644
--- a/fs/rsext4/src/crc32c/arm64.rs
+++ b/fs/rsext4/src/crc32c/arm64.rs
@@ -48,6 +48,12 @@ pub fn has_hardware_crc32() -> bool {
     #[cfg(not(target_os = "macos"))]
     {
         let mut reg_val: u64;
+        // SAFETY: `mrs` only copies the read-only ID register into a
+        // general-purpose register and touches no memory. At EL1 the read is
+        // architectural. At EL0 it traps, and the instruction is only valid
+        // there because the kernel emulates the ID registers for user space
+        // (Linux does so when it sets `HWCAP_CPUID`); a host that does not
+        // emulate them delivers the trap as an illegal instruction.
         unsafe {
             // mrs: Move from System Register to general purpose register
             asm!("mrs {}, ID_AA64ISAR0_EL1", out(reg) reg_val);
@@ -76,44 +82,60 @@ pub fn has_hardware_crc32() -> bool {
 pub unsafe fn crc32c_hardware(mut crc: u32, data: &[u8]) -> u32 {
     // This helper only performs the raw CRC update step. Callers remain
     // responsible for any ext4-specific init/finalize inversion.
-    unsafe {
-        let mut p = data.as_ptr();
-        let mut len = data.len();
+    let mut p = data.as_ptr();
+    let mut len = data.len();
 
-        // 1. Consume the unaligned prefix so the hot loop can use 64-bit loads.
-        while len > 0 && !(p as usize).is_multiple_of(8) {
-            crc = __crc32cb(crc, *p);
-            p = p.add(1);
-            len -= 1;
-        }
+    // Every read below is in bounds because `len` counts the bytes left
+    // between `p` and the end of `data`, and each step reads at most `len`
+    // bytes before advancing `p` and lowering `len` by the same amount.
 
-        // 2. Main loop: process aligned 64-bit chunks.
-        while len >= 8 {
-            let val = *(p as *const u64);
-            crc = __crc32cd(crc, val);
-            p = p.add(8);
-            len -= 8;
-        }
+    // 1. Consume the unaligned prefix so the hot loop can use 64-bit loads.
+    while len > 0 && !(p as usize).is_multiple_of(8) {
+        // SAFETY: `len > 0`, so `p` points at a byte of `data`.
+        let byte = unsafe { *p };
+        crc = __crc32cb(crc, byte);
+        // SAFETY: `p` stays within `data` or one past its end.
+        p = unsafe { p.add(1) };
+        len -= 1;
+    }
 
-        // 3. Finish the tail with progressively smaller chunk sizes.
-        if len >= 4 {
-            let val = *(p as *const u32);
-            crc = __crc32cw(crc, val);
-            p = p.add(4);
-            len -= 4;
-        }
+    // 2. Main loop: process aligned 64-bit chunks.
+    while len >= 8 {
+        // SAFETY: the prefix loop left `p` 8-byte aligned, the loop advances
+        // it in steps of 8, and `len >= 8` keeps all eight bytes in `data`.
+        let val = unsafe { *(p as *const u64) };
+        crc = __crc32cd(crc, val);
+        // SAFETY: `p` stays within `data` or one past its end.
+        p = unsafe { p.add(8) };
+        len -= 8;
+    }
 
-        if len >= 2 {
-            let val = *(p as *const u16);
-            crc = __crc32ch(crc, val);
-            p = p.add(2);
-            len -= 2;
-        }
+    // 3. Finish the tail with progressively smaller chunk sizes.
+    if len >= 4 {
+        // SAFETY: `p` is 8-byte aligned here, so also 4-byte aligned, and
+        // `len >= 4` keeps the four bytes in `data`.
+        let val = unsafe { *(p as *const u32) };
+        crc = __crc32cw(crc, val);
+        // SAFETY: `p` stays within `data` or one past its end.
+        p = unsafe { p.add(4) };
+        len -= 4;
+    }
 
-        if len > 0 {
-            crc = __crc32cb(crc, *p);
-        }
+    if len >= 2 {
+        // SAFETY: `p` advanced by 0 or 4 from an 8-byte boundary, so it is
+        // 2-byte aligned, and `len >= 2` keeps the two bytes in `data`.
+        let val = unsafe { *(p as *const u16) };
+        crc = __crc32ch(crc, val);
+        // SAFETY: `p` stays within `data` or one past its end.
+        p = unsafe { p.add(2) };
+        len -= 2;
+    }
 
-        crc
+    if len > 0 {
+        // SAFETY: `len > 0`, so `p` points at the last byte of `data`.
+        let byte = unsafe { *p };
+        crc = __crc32cb(crc, byte);
     }
+
+    crc
 }
diff --git a/fs/rsext4/src/crc32c/crc32c.rs b/fs/rsext4/src/crc32c/crc32c.rs
index c7e9419c5..4ac78e957 100644
--- a/fs/rsext4/src/crc32c/crc32c.rs
+++ b/fs/rsext4/src/crc32c/crc32c.rs
@@ -94,6 +94,9 @@ pub fn crc32c_append(crc: u32, data: &[u8]) -> u32 {
     #[cfg(target_arch = "aarch64")]
     {
         if is_hardware_crc32_supported() {
+            // SAFETY: `crc32c_hardware` needs the ARMv8 CRC32 extension, and
+            // `is_hardware_crc32_supported` has just read it as present from
+            // `ID_AA64ISAR0_EL1[19:16]` (see `crc32c::arm64`).
             return unsafe { crc32c_hardware(crc, data) };
         }
     }
@@ -104,6 +107,9 @@ pub fn crc32c_append(crc: u32, data: &[u8]) -> u32 {
     #[cfg(target_arch = "x86_64")]
     {
         if is_hardware_crc32_supported() {
+            // SAFETY: `crc32c_hardware` needs SSE4.2, and
+            // `is_hardware_crc32_supported` has just read it as present from
+            // CPUID leaf 1 ECX bit 20 (see `crc32c::x86_64`).
             return unsafe { crc32c_hardware(crc, data) };
         }
     }
@@ -219,6 +225,9 @@ mod tests {
                 for len in 0..=257 {
                     let data = &storage[offset..offset + len];
                     assert_eq!(
+                        // SAFETY: the test returned early above unless
+                        // `is_hardware_crc32_supported` read SSE4.2 as present
+                        // from CPUID leaf 1 ECX bit 20.
                         unsafe { crate::crc32c::x86_64::crc32c_hardware(seed, data) },
                         crc32c_update(seed, data),
                         "offset={offset} length={len} seed={seed:#x}"
-- 
2.53.0

