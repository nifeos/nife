+++ b/crates/capability/src/lib.rs
@@ -171,13 +171,7 @@ pub const fn reap_decision(
     dead: bool,
 ) -> Reap {
     match supervising_rendezvous {
-        Some(rendezvous) if rendezvous == invoked_rendezvous => {
-            if dead {
-                Reap::Permitted
-            } else {
-                Reap::StillAlive
-            }
-        }
+        Some(rendezvous) if rendezvous == invoked_rendezvous && dead => Reap::Permitted,
         _ => Reap::NotSupervised,
     }
