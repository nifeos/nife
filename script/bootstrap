#!/bin/sh
# script/bootstrap: resolve every dependency the project needs to build and test.
#
# Part of the "Scripts to Rule Them All" set (see notes/scripts.md). Idempotent: it checks
# for what is already present and installs only what is missing, so it is cheap to re-run and
# safe to call from script/setup, script/update, and script/ci-build.
#
# **QEMU is not this script's.** `script/ci-qemu` is the one place that checks for the pinned
# emulator and builds it when the one on PATH is not exactly `.qemu-version` (§322 (the QEMU
# bootstrap is the one QEMU check)). `script/setup`, `script/update` and `script/ci-build` run it
# after this script; anyone running this one alone runs `script/ci-qemu` next.
#
# Name: ratified 2026-07-22 by adopting Scripts to Rule Them All. The canonical set keeps its
# standard names even where a more descriptive word exists, because the entire value is that the
# command is the same in every repository that follows the pattern (design/naming.md).

set -e

# `sudo` only when not already root: a container often runs as root with no `sudo` binary at all,
# which is the cloud-session case (notes/working-from-a-cloud-session.md).
if [ "$(id -u)" -eq 0 ]; then SUDO=; else SUDO=sudo; fi
cd "$(dirname "$0")/.."

os="$(uname -s)"

# --- Rust toolchain -----------------------------------------------------------------------
# rust-toolchain.toml pins the channel, its components, and the bare-metal target. We install
# that exact toolchain rather than trusting first-cargo-use to pull the components in.
if ! command -v rustup >/dev/null 2>&1; then
    echo "==> Installing rustup"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
    export PATH="$HOME/.cargo/bin:$PATH"
fi

channel="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
[ -n "$channel" ] || channel="nightly"

echo "==> Ensuring Rust toolchain '$channel' (components + bare-metal targets)"
# Through helpers/rustup-retry.sh because every CI job runs this against static.rust-lang.org with
# nothing cached, and one dropped connection there should cost a retry, not a red check.
helpers/rustup-retry.sh toolchain install "$channel" --profile minimal
helpers/rustup-retry.sh component add --toolchain "$channel" rust-src llvm-tools rustfmt clippy miri
# **Every target the pin declares**, read from `rust-toolchain.toml` rather than spelled here, the
# way `channel` above already is and the way `script/drift` does it: a fourth architecture is
# installed here the day it is added to the pin, and there is no second list to forget. See
# notes/architecture-list-sweep.md, option A.
all_targets="$(awk -F'"' '/^targets *=/ {for (i = 2; i < NF; i += 2) printf "%s ", $i}' rust-toolchain.toml)"
# shellcheck disable=SC2086  # word splitting is the point: one flag per target
helpers/rustup-retry.sh target add --toolchain "$channel" $all_targets

# Python 3 and the GitHub CLI. Neither was checked here until 2026-09-24, when calef asked whether
# this script installs everything and the answer was no. `script/lint` runs six embedded Python
# programs and about thirty files in script/ and helpers/ call python3, as does the Claude Code Stop
# hook in .claude/settings.json; a machine without it fails the first gate with a bare "not found".
# `gh` is how a lane claims work (script/claim opens the draft pull request that IS the claim, per
# §90 (the claim is a draft pull request)) and how the watchers read the queue. macOS ships a
# python3 stub that prompts for the Command Line Tools, which works but is not a check, so
# Homebrew's is installed when none answers.
# The pinned cargo subcommands (cargo-mutants, cargo-fuzz, cargo-deny, cargo-llvm-cov, Kani) are
# deliberately not here: each script that needs one installs its own pinned version on first use.
for tool in python3 gh; do
    if command -v "$tool" >/dev/null 2>&1 && "$tool" --version >/dev/null 2>&1; then
        echo "==> $tool present: $("$tool" --version 2>&1 | head -1)"
        continue
    fi
    echo "==> Installing $tool"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        if [ "$tool" = python3 ]; then brew install python; else brew install gh; fi
        ;;
    Linux)
        $SUDO apt-get update
        # shellcheck disable=SC2046
        $SUDO apt-get install -y $(helpers/apt-packages.sh "bootstrap-$tool")
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install $tool by hand." >&2
        exit 1
        ;;
    esac
done
if ! gh auth status >/dev/null 2>&1; then
    echo "==> gh is not signed in. Claiming work needs it: run 'gh auth login'."
fi

# ShellCheck, for the 23 `#!/bin/sh` scripts in script/ and helpers/. Worth a dependency because of
# where this project runs: macOS `/bin/sh` is bash in POSIX mode and Ubuntu CI's is dash, so a
# bashism works on a dev machine and fails on a runner. ShellCheck knows the difference and says so.
# The scripts are the gates; a gate that fails silently is worse than no gate. See notes/scripts.md.
if command -v shellcheck >/dev/null 2>&1; then
    echo "==> ShellCheck present: $(shellcheck --version | sed -n 's/^version: //p')"
else
    echo "==> Installing ShellCheck"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        brew install shellcheck
        ;;
    Linux)
        $SUDO apt-get update
        # shellcheck disable=SC2046
        $SUDO apt-get install -y $(helpers/apt-packages.sh bootstrap-shellcheck)
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install shellcheck by hand." >&2
        exit 1
        ;;
    esac
fi

# Ruby, for the YAML parser of two `script/lint` checks: every workflow file parses
# (helpers/workflow_parses.py) and every issue form renders (helpers/issue_forms.py). Both run
# `ruby -ryaml`, so the check is that command rather than `command -v`, and both fail rather than
# skip without it, which on Linux also blocks every push through the pre-push hook. It sits beside
# ShellCheck and outside NIFE_SKIP_LINT_TOOLS for the same reason: one apt package, seconds to
# install. On Debian and Ubuntu the `ruby` package brings Psych (psych.so, in libruby, linked to
# libyaml). The ubuntu-26.04 runner images ship Ruby, so in CI this branch prints "present".
#
# macOS has shipped /usr/bin/ruby (2.6, with Psych) on every release so far, which is what a Mac
# normally finds here. Apple has called it deprecated since 10.15, so it is not guaranteed. When it
# is gone, Homebrew's ruby is installed, but that formula is keg-only (it would shadow the system
# one), so nothing puts it on PATH and bootstrap says which directory to add.
if ruby -ryaml -e '' >/dev/null 2>&1; then
    echo "==> Ruby present: $(ruby --version)"
else
    echo "==> Installing Ruby"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        brew install ruby
        if ! ruby -ryaml -e '' >/dev/null 2>&1; then
            echo "==> Homebrew's ruby is keg-only. Put $(brew --prefix ruby)/bin on PATH for script/lint."
        fi
        ;;
    Linux)
        $SUDO apt-get update
        # shellcheck disable=SC2046
        $SUDO apt-get install -y $(helpers/apt-packages.sh bootstrap-ruby)
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install a ruby that can run \`ruby -ryaml\` by hand." >&2
        exit 1
        ;;
    esac
fi

# **NIFE_SKIP_LINT_TOOLS=1 skips cargo-machete and typos**, the two tools only `script/lint` runs. On
# Linux both are source builds, about 85 s per job on the arm64 runners (measured on #1778), and six
# CI jobs (test, cpu-matrix, bench, boot-check, swish-check, swish-check-x86_64) never lint. Unset,
# the default, installs everything, so a developer and `script/ci-build` with no arguments are
# unchanged; a job that lints must not set it. See notes/scripts/helpers-and-bootstrap.md.
if [ -n "$NIFE_SKIP_LINT_TOOLS" ]; then
    echo "==> Skipping cargo-machete and typos (NIFE_SKIP_LINT_TOOLS is set)"
else
    # cargo-machete, for script/lint's unused-dependency gate (§46: a dependency is a decision). Comes
    # from cargo rather than a package manager because it is a cargo subcommand and there is no OS
    # packaging worth the branch; `--locked` so a fresh install cannot pick up a dependency resolution
    # nobody tested.
    if command -v cargo-machete >/dev/null 2>&1; then
        echo "==> cargo-machete present"
    else
        echo "==> Installing cargo-machete"
        cargo install cargo-machete --locked
    fi

    # typos, for script/lint's spelling gate over the prose (the documentation is a deliverable here).
    # Homebrew calls it `typos-cli` and the binary `typos`, which is the sort of mismatch that wastes an
    # afternoon, so both names appear here on purpose.
    if command -v typos >/dev/null 2>&1; then
        echo "==> typos present: $(typos --version)"
    else
        echo "==> Installing typos"
        case "$os" in
        Darwin)
            brew install typos-cli
            ;;
        Linux)
            # Not in Ubuntu's archive; cargo is the portable route and CI takes it too.
            cargo install typos-cli --locked
            ;;
        *)
            echo "bootstrap: unknown OS '$os'; install typos by hand." >&2
            exit 1
            ;;
        esac
    fi
fi

# --- A bare-metal C compiler ----------------------------------------------------------------
# Milestone 36 links a C component into the `c_shim` userspace program (fixtures/c/c_seam.c,
# DECISIONS §30), so building `fixtures` now needs a clang with BOTH the AArch64 and RISC-V
# backends. One
# compiler for both ISAs, not two, because architectural parity is a gate (DECISIONS §19) and two
# clangs would mean "works on aarch64" stopped predicting anything about riscv64.
#
# The check is a capability check, not a `command -v`, because the clang most likely already
# present on a macOS dev machine is Apple's, and Apple's has no RISC-V backend at all. The same
# resolution order lives in fixtures/build.rs, which is what actually runs the compiler; this only
# installs one so that build succeeds. Set CRICKER_CC to point either at something else.
have_cross_clang() {
    for cc in "$CRICKER_CC" /opt/homebrew/opt/llvm/bin/clang /usr/local/opt/llvm/bin/clang clang; do
        [ -n "$cc" ] || continue
        targets="$("$cc" -print-targets 2>/dev/null || true)"
        if echo "$targets" | grep -qE '^ *aarch64 ' && echo "$targets" | grep -qE '^ *riscv64 '; then
            echo "==> Cross clang present: $cc"
            return 0
        fi
    done
    return 1
}

if have_cross_clang; then
    :
else
    echo "==> Installing a clang with the AArch64 and RISC-V backends"
    case "$os" in
    Darwin)
        if ! command -v brew >/dev/null 2>&1; then
            echo "bootstrap: Homebrew not found; install it from https://brew.sh, then re-run." >&2
            exit 1
        fi
        # Homebrew's llvm keg ships every LLVM backend. It is deliberately not linked onto PATH
        # (that would shadow Apple's clang), so fixtures/build.rs names the keg path directly.
        brew install llvm
        ;;
    Linux)
        # Debian/Ubuntu build every LLVM backend into their clang packages.
        $SUDO apt-get update
        # shellcheck disable=SC2046
        $SUDO apt-get install -y $(helpers/apt-packages.sh bootstrap-clang)
        ;;
    *)
        echo "bootstrap: unknown OS '$os'; install a clang whose \`clang -print-targets\` lists" >&2
        echo "           both aarch64 and riscv64, then re-run." >&2
        exit 1
        ;;
    esac
    have_cross_clang || {
        echo "bootstrap: still no clang that can target both aarch64 and riscv64." >&2
        echo "           Set CRICKER_CC=/path/to/clang and re-run." >&2
        exit 1
    }
fi

echo "==> Bootstrap complete. QEMU is not provisioned here: run script/ci-qemu, which checks for"
echo "    the pinned version and builds it when the one on PATH is not exactly that."
