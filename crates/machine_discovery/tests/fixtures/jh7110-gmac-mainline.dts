/dts-v1/;

/*
 * radon's ports as MAINLINE Linux describes a VisionFive 2 v1.3B. MODELED from source, not
 * captured: torvalds/linux master, `arch/riscv/boot/dts/starfive/jh7110.dtsi` (gmac0, gmac1,
 * aoncrg, aon_syscon), `jh7110-common.dtsi` (gmac0's phy-mode and mdio/phy0) and
 * `jh7110-starfive-visionfive-2-v1.3b.dts` (phy0's delays, drive strengths and clock inversion),
 * read 2026-10-06 (UTC). radon's EEPROM says PCB revision 0xb2, a v1.3B.
 *
 * The tree radon serves is the vendor's (jh7110-gmac-vendor.dts); this one exists so the
 * discovery reads the standard binding too, and so a test can show the two land on the same
 * register values.
 */

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "starfive,visionfive-2-v1.3b", "starfive,jh7110";

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gmac0: ethernet@16030000 {
			compatible = "starfive,jh7110-dwmac", "snps,dwmac-5.20";
			reg = <0x0 0x16030000 0x0 0x10000>;
			interrupts = <7>, <6>, <5>;
			interrupt-names = "macirq", "eth_wake_irq", "eth_lpi";
			rx-fifo-depth = <2048>;
			tx-fifo-depth = <2048>;
			snps,fixed-burst;
			snps,no-pbl-x8;
			snps,force_thresh_dma_mode;
			snps,txpbl = <16>;
			snps,rxpbl = <16>;
			starfive,syscon = <&aon_syscon 0xc 0x12>;
			starfive,tx-use-rgmii-clk;
			phy-handle = <&phy0>;
			phy-mode = "rgmii-id";
			status = "okay";

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				compatible = "snps,dwmac-mdio";

				phy0: ethernet-phy@0 {
					reg = <0>;
					motorcomm,tx-clk-adj-enabled;
					motorcomm,tx-clk-100-inverted;
					motorcomm,tx-clk-1000-inverted;
					motorcomm,rx-clk-drv-microamp = <3970>;
					motorcomm,rx-data-drv-microamp = <2910>;
					rx-internal-delay-ps = <1500>;
					tx-internal-delay-ps = <1500>;
				};
			};
		};

		gmac1: ethernet@16040000 {
			compatible = "starfive,jh7110-dwmac", "snps,dwmac-5.20";
			reg = <0x0 0x16040000 0x0 0x10000>;
			interrupts = <78>, <77>, <76>;
			phy-handle = <&phy1>;
			phy-mode = "rgmii-id";
			status = "okay";

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				compatible = "snps,dwmac-mdio";

				phy1: ethernet-phy@1 {
					reg = <0>;
					motorcomm,tx-clk-adj-enabled;
					motorcomm,tx-clk-100-inverted;
					motorcomm,rx-clk-drv-microamp = <3970>;
					motorcomm,rx-data-drv-microamp = <2910>;
					rx-internal-delay-ps = <300>;
					tx-internal-delay-ps = <0>;
				};
			};
		};

		aoncrg: clock-controller@17000000 {
			compatible = "starfive,jh7110-aoncrg";
			reg = <0x0 0x17000000 0x0 0x10000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		aon_syscon: syscon@17010000 {
			compatible = "starfive,jh7110-aon-syscon", "syscon";
			reg = <0x0 0x17010000 0x0 0x1000>;
		};
	};
};
