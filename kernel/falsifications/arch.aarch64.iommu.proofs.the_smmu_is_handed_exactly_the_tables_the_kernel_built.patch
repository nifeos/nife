         ttb as u32 & 0xffff_fff0, //  TTB0[31:4]; the low flag bits stay zero
-        (ttb >> 32) as u32 & 0xf_ffff, // TTB0[51:32]
+        (ttb >> 31) as u32 & 0xf_ffff, // TTB0[51:32]
         0,                        // TTB1 does not exist
