#!/bin/sh
# script/qemu-check: is the QEMU on PATH exactly the one this project pins, with every device the
# suite needs? Exits 0 when it is, and 1 with one line per problem when it is not. It never installs.
#
# This is the verdict `script/ci-qemu` renders before and after it builds, §322 (the QEMU bootstrap
# is the one QEMU check): ci-qemu is the one place that acts on it, and `script/bootstrap` neither
# runs this nor provisions QEMU. Run it directly to ask the question without building anything.
#
# What it accepts, and nothing less:
#
#   1. All three emulators the suite boots are on PATH: qemu-system-aarch64, qemu-system-riscv64 and
#      qemu-system-x86_64.
#   2. **Each of them is exactly `.qemu-version`.** An emulator version is part of what "the tests
#      passed" means, and the benchmarks are icount instruction counts that a different QEMU can
#      move; each baseline's `# qemu:` line records the emulator that produced it. Each binary is
#      checked, because a PATH can mix two installations.
#   3. The devices whose absence would gut a test rather than fail it: `riscv-iommu-pci` on riscv64
#      (milestone 16b, the RISC-V IOMMU, §20) and the `virt` machine on aarch64. Dropping the IOMMU
#      device when QEMU lacks it is refused on purpose: the confinement tests would pass while
#      testing nothing, and a test that quietly stops testing is worse than a red build.
#
# **"The QEMU on PATH" means the project's when it has one.** This sources `helpers/qemu-path.sh`,
# which puts `script/ci-qemu`'s build first on PATH when that build is the pinned version, so the
# verdict is about the emulator every `script/` entry point will run, never about a `/usr/bin` QEMU
# that the build shadows.
#
# `.qemu-version` is the single source of truth, read by this check, `script/ci-qemu`,
# `helpers/qemu-path.sh` and the CI cache key. Change the file and all of them move together.
#
# Name: recorded (script/undefined-behavior-check, ratified 2026-08-03 by calef). Introduced
# 2026-07-30. The `-check` suffix is not this script's coinage to defend: calef signed it while
# replacing `miri`, and the ratification cites this script by name as one of the two that had
# already established the suffix, concluding that "the long form costs nothing the directory was
# not already paying" because eight of twenty-six scripts were hyphenated already. The stem is the
# tool it checks the version of. no architect has ratified this instance.

set -e
cd "$(dirname "$0")/.."

# This project's own QEMU, when `script/ci-qemu` has built the pinned version (helpers/qemu-path.sh
# says why PATH is the mechanism).
. helpers/qemu-path.sh

want="$(tr -d ' \n' < .qemu-version)"

# The version a QEMU binary reports: the word after `version`, not a field position, so a vendor's
# first line ("qemu-system-aarch64 version 8.2.2 (Debian 1:8.2.2+ds-0ubuntu1)") cannot shift it
# (xtask/src/host.rs parses it the same way). An exact string comparison then keeps 11.0.2 from
# satisfying a pin of 11.0.20.
qemu_version() {
    "$1" --version 2>/dev/null | head -1 | sed -n 's/.*version \([0-9][0-9.]*\).*/\1/p'
}

problems=""
for arch in aarch64 riscv64 x86_64; do
    bin="$(command -v "qemu-system-$arch" 2>/dev/null || true)"
    if [ -z "$bin" ]; then
        problems="$problems
qemu-system-$arch is not on PATH"
        continue
    fi
    have="$(qemu_version "$bin")"
    if [ "$have" != "$want" ]; then
        problems="$problems
$bin is ${have:-a QEMU whose version cannot be read}, and .qemu-version pins $want"
    fi
done
if command -v qemu-system-riscv64 >/dev/null 2>&1 \
    && ! qemu-system-riscv64 -device help 2>&1 | grep -q "riscv-iommu-pci"; then
    problems="$problems
qemu-system-riscv64 has no riscv-iommu-pci device (milestone 16b, §20)"
fi
if command -v qemu-system-aarch64 >/dev/null 2>&1 \
    && ! qemu-system-aarch64 -machine help 2>&1 | grep -q "^virt"; then
    problems="$problems
qemu-system-aarch64 has no virt machine"
fi

if [ -n "$problems" ]; then
    echo "$problems" | sed '/^$/d; s/^/qemu-check: /' >&2
    exit 1
fi

echo "qemu-check: QEMU $want on PATH ($(command -v qemu-system-aarch64)), with every required device."
