+//! The slice of std rufs uses: `io`, `ffi` and `time`. With the `std` feature they are std's own.
+//! Without it they are the small stand-ins below, built on core and alloc, so the filesystem logic
+//! compiles unchanged for a target with no std at all.
+
+#[cfg(feature = "std")]
+pub use std::{ffi, io, time};
+
+/// The alloc names std's prelude supplies and a `no_std` crate must import.
+pub mod prelude {
+	pub use alloc::{borrow::ToOwned, format, vec, vec::Vec};
+}
+
+#[cfg(not(feature = "std"))]
+pub mod io {
+	use alloc::{string::String, vec::Vec};
+	use core::fmt;
+
+	#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+	pub enum ErrorKind {
+		NotFound,
+		AlreadyExists,
+		InvalidInput,
+		UnexpectedEof,
+		Other,
+	}
+
+	/// An errno, or a kind with a message, as std's `io::Error` carries either.
+	#[derive(Debug)]
+	pub struct Error {
+		kind:  ErrorKind,
+		errno: Option<i32>,
+		msg:   String,
+	}
+
+	impl Error {
+		pub fn new(kind: ErrorKind, msg: impl Into<String>) -> Self {
+			Self { kind, errno: None, msg: msg.into() }
+		}
+
+		pub fn from_raw_os_error(errno: i32) -> Self {
+			let kind = match errno {
+				crate::errno::ENOENT => ErrorKind::NotFound,
+				crate::errno::EEXIST => ErrorKind::AlreadyExists,
+				crate::errno::EINVAL => ErrorKind::InvalidInput,
+				_ => ErrorKind::Other,
+			};
+			Self { kind, errno: Some(errno), msg: String::new() }
+		}
+
+		pub fn raw_os_error(&self) -> Option<i32> {
+			self.errno
+		}
+
+		pub fn kind(&self) -> ErrorKind {
+			self.kind
+		}
+	}
+
+	impl fmt::Display for Error {
+		fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+			match self.errno {
+				Some(e) => write!(f, "errno {e}"),
+				None => write!(f, "{:?}: {}", self.kind, self.msg),
+			}
+		}
+	}
+
+	pub type Result<T> = core::result::Result<T, Error>;
+
+	#[derive(Clone, Copy, Debug)]
+	pub enum SeekFrom {
+		Start(u64),
+		End(i64),
+		Current(i64),
+	}
+
+	pub trait Read {
+		fn read(&mut self, buf: &mut [u8]) -> Result<usize>;
+
+		fn read_exact(&mut self, mut buf: &mut [u8]) -> Result<()> {
+			while !buf.is_empty() {
+				match self.read(buf)? {
+					0 => return Err(Error::new(ErrorKind::UnexpectedEof, "short read")),
+					n => buf = &mut buf[n..],
+				}
+			}
+			Ok(())
+		}
+	}
+
+	pub trait Write {
+		fn write(&mut self, buf: &[u8]) -> Result<usize>;
+
+		fn flush(&mut self) -> Result<()>;
+
+		fn write_all(&mut self, mut buf: &[u8]) -> Result<()> {
+			while !buf.is_empty() {
+				match self.write(buf)? {
+					0 => return Err(Error::new(ErrorKind::Other, "short write")),
+					n => buf = &buf[n..],
+				}
+			}
+			Ok(())
+		}
+	}
+
+	pub trait Seek {
+		fn seek(&mut self, pos: SeekFrom) -> Result<u64>;
+
+		fn stream_position(&mut self) -> Result<u64> {
+			self.seek(SeekFrom::Current(0))
+		}
+	}
+
+	pub trait BufRead: Read {
+		fn fill_buf(&mut self) -> Result<&[u8]>;
+
+		fn consume(&mut self, amt: usize);
+	}
+
+	/// An in-memory buffer with a position, as std's.
+	pub struct Cursor<T> {
+		inner: T,
+		pos:   u64,
+	}
+
+	impl<T> Cursor<T> {
+		pub fn new(inner: T) -> Self {
+			Self { inner, pos: 0 }
+		}
+
+		pub fn into_inner(self) -> T {
+			self.inner
+		}
+	}
+
+	impl<T: AsRef<[u8]>> Cursor<T> {
+		fn rest(&self) -> &[u8] {
+			let b = self.inner.as_ref();
+			&b[(self.pos as usize).min(b.len())..]
+		}
+	}
+
+	impl<T: AsRef<[u8]>> Read for Cursor<T> {
+		fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
+			let rest = self.rest();
+			let n = rest.len().min(buf.len());
+			buf[..n].copy_from_slice(&rest[..n]);
+			self.pos += n as u64;
+			Ok(n)
+		}
+	}
+
+	impl<T: AsRef<[u8]>> BufRead for Cursor<T> {
+		fn fill_buf(&mut self) -> Result<&[u8]> {
+			Ok(self.rest())
+		}
+
+		fn consume(&mut self, amt: usize) {
+			self.pos += amt as u64;
+		}
+	}
+
+	impl<T: AsRef<[u8]>> Seek for Cursor<T> {
+		fn seek(&mut self, pos: SeekFrom) -> Result<u64> {
+			let (base, off) = match pos {
+				SeekFrom::Start(n) => {
+					self.pos = n;
+					return Ok(n);
+				}
+				SeekFrom::End(n) => (self.inner.as_ref().len() as u64, n),
+				SeekFrom::Current(n) => (self.pos, n),
+			};
+			match base.checked_add_signed(off) {
+				Some(n) => {
+					self.pos = n;
+					Ok(n)
+				}
+				None => Err(Error::new(ErrorKind::InvalidInput, "seek before start")),
+			}
+		}
+	}
+
+	impl Write for Cursor<&mut [u8]> {
+		fn write(&mut self, buf: &[u8]) -> Result<usize> {
+			let pos = (self.pos as usize).min(self.inner.len());
+			let n = (self.inner.len() - pos).min(buf.len());
+			self.inner[pos..pos + n].copy_from_slice(&buf[..n]);
+			self.pos += n as u64;
+			Ok(n)
+		}
+
+		fn flush(&mut self) -> Result<()> {
+			Ok(())
+		}
+	}
+
+	impl Write for Cursor<Vec<u8>> {
+		fn write(&mut self, buf: &[u8]) -> Result<usize> {
+			let pos = self.pos as usize;
+			if self.inner.len() < pos + buf.len() {
+				self.inner.resize(pos + buf.len(), 0);
+			}
+			self.inner[pos..pos + buf.len()].copy_from_slice(buf);
+			self.pos += buf.len() as u64;
+			Ok(buf.len())
+		}
+
+		fn flush(&mut self) -> Result<()> {
+			Ok(())
+		}
+	}
+}
+
+#[cfg(not(feature = "std"))]
+pub mod ffi {
+	use alloc::vec::Vec;
+	use core::{fmt, ops::Deref};
+
+	/// A name as UFS stores it: bytes, with no encoding promised.
+	#[repr(transparent)]
+	#[derive(PartialEq, Eq)]
+	pub struct OsStr([u8]);
+
+	impl OsStr {
+		pub fn new<S: AsRef<OsStr> + ?Sized>(s: &S) -> &OsStr {
+			s.as_ref()
+		}
+
+		/// # Safety
+		/// Always sound here, since this `OsStr` accepts any bytes; `unsafe` matches std's.
+		pub unsafe fn from_encoded_bytes_unchecked(b: &[u8]) -> &OsStr {
+			Self::from_bytes(b)
+		}
+
+		pub fn from_bytes(b: &[u8]) -> &OsStr {
+			// SAFETY: OsStr is a repr(transparent) wrapper around [u8].
+			unsafe { &*(b as *const [u8] as *const OsStr) }
+		}
+
+		pub fn to_os_string(&self) -> OsString {
+			OsString(self.0.into())
+		}
+
+		pub fn as_encoded_bytes(&self) -> &[u8] {
+			&self.0
+		}
+
+		pub fn len(&self) -> usize {
+			self.0.len()
+		}
+
+		pub fn is_empty(&self) -> bool {
+			self.0.is_empty()
+		}
+	}
+
+	impl fmt::Debug for OsStr {
+		fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+			write!(f, "\"{}\"", self.0.escape_ascii())
+		}
+	}
+
+	impl AsRef<OsStr> for OsStr {
+		fn as_ref(&self) -> &OsStr {
+			self
+		}
+	}
+
+	impl AsRef<OsStr> for str {
+		fn as_ref(&self) -> &OsStr {
+			OsStr::from_bytes(self.as_bytes())
+		}
+	}
+
+	impl PartialEq<str> for OsStr {
+		fn eq(&self, other: &str) -> bool {
+			&self.0 == other.as_bytes()
+		}
+	}
+
+	impl PartialEq<OsString> for &OsStr {
+		fn eq(&self, other: &OsString) -> bool {
+			self.0 == other.0[..]
+		}
+	}
+
+	#[derive(Default, PartialEq, Eq)]
+	pub struct OsString(Vec<u8>);
+
+	impl OsString {
+		pub fn new() -> Self {
+			Self(Vec::new())
+		}
+
+		pub fn push<S: AsRef<OsStr>>(&mut self, s: S) {
+			self.0.extend_from_slice(&s.as_ref().0);
+		}
+
+		pub fn into_encoded_bytes(self) -> Vec<u8> {
+			self.0
+		}
+	}
+
+	impl From<&str> for OsString {
+		fn from(s: &str) -> Self {
+			Self(s.as_bytes().into())
+		}
+	}
+
+	impl Deref for OsString {
+		type Target = OsStr;
+
+		fn deref(&self) -> &OsStr {
+			OsStr::from_bytes(&self.0)
+		}
+	}
+
+	impl AsRef<OsStr> for OsString {
+		fn as_ref(&self) -> &OsStr {
+			self
+		}
+	}
+
+	impl fmt::Debug for OsString {
+		fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+			fmt::Debug::fmt(&**self, f)
+		}
+	}
+}
+
+#[cfg(not(feature = "std"))]
+pub mod time {
+	use core::{
+		ops::{AddAssign, SubAssign},
+		sync::atomic::{AtomicPtr, Ordering},
+	};
+
+	pub use core::time::Duration;
+
+	/// A point in time as UFS stores it: seconds and nanoseconds either side of the epoch.
+	#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+	pub struct SystemTime(i128);
+
+	static CLOCK: AtomicPtr<()> = AtomicPtr::new(core::ptr::null_mut());
+
+	/// Installs the wall clock `SystemTime::now` reads, as nanoseconds since the epoch. Without
+	/// one, `now` is the epoch, and every new inode carries 1970-01-01 as its times.
+	pub fn set_clock(f: fn() -> i128) {
+		CLOCK.store(f as *mut (), Ordering::Release);
+	}
+
+	impl SystemTime {
+		pub const UNIX_EPOCH: Self = Self(0);
+
+		pub fn now() -> Self {
+			let p = CLOCK.load(Ordering::Acquire);
+			if p.is_null() {
+				return Self::UNIX_EPOCH;
+			}
+			// SAFETY: only set_clock stores here, and it stores a `fn() -> i128`.
+			let f: fn() -> i128 = unsafe { core::mem::transmute(p) };
+			Self(f())
+		}
+
+		pub fn duration_since(&self, earlier: Self) -> Result<Duration, ()> {
+			let d = self.0 - earlier.0;
+			if d < 0 {
+				return Err(());
+			}
+			Ok(Duration::new((d / 1_000_000_000) as u64, (d % 1_000_000_000) as u32))
+		}
+	}
+
+	impl AddAssign<Duration> for SystemTime {
+		fn add_assign(&mut self, d: Duration) {
+			self.0 += d.as_nanos() as i128;
+		}
+	}
+
+	impl SubAssign<Duration> for SystemTime {
+		fn sub_assign(&mut self, d: Duration) {
+			self.0 -= d.as_nanos() as i128;
+		}
+	}
+}
