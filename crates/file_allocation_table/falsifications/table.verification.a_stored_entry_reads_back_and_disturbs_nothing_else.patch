Falsifies `file_allocation_table::table::verification::a_stored_entry_reads_back_and_disturbs_nothing_else`.

The defect: a FAT12 store into an odd cluster drops the low bit of the neighbor's nibble that shares its first byte, so storing one entry corrupts the entry before it.

Expected to fail: the harness's `assert_eq!(after[0] & 0x0F, before[0] & 0x0F)`.

diff --git a/crates/file_allocation_table/src/table.rs b/crates/file_allocation_table/src/table.rs
--- a/crates/file_allocation_table/src/table.rs
+++ b/crates/file_allocation_table/src/table.rs
@@ -167,7 +167,7 @@ pub(crate) fn store(
             let value = (value & 0xFFF) as u16;
             let old = u16::from_le_bytes([bytes[0], bytes[1]]);
             let new = if cluster & 1 == 1 {
-                (old & 0x000F) + (value << 4)
+                (old & 0x000E) + (value << 4)
             } else {
                 (old & 0xF000) + value
             };
