<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SYNTHESIZED, not captured: no USB flash stick was attached when these fixtures were taken. It is the disk-image document with a USB bus, a generic name and a round size written in, on the documented behaviour that a flash stick sets the SCSI removable-media bit. Replace it with a real capture (diskutil info -plist diskN), neutralized the same way, the first time one is at hand. -->
<plist version="1.0">
<dict>
	<key>BusProtocol</key>
	<string>USB</string>
	<key>DeviceIdentifier</key>
	<string>disk6</string>
	<key>Ejectable</key>
	<true/>
	<key>IORegistryEntryName</key>
	<string>Generic USB Flash Media</string>
	<key>Internal</key>
	<false/>
	<key>MediaName</key>
	<string>USB Flash</string>
	<key>OSInternalMedia</key>
	<false/>
	<key>Removable</key>
	<true/>
	<key>RemovableMedia</key>
	<true/>
	<key>RemovableMediaOrExternalDevice</key>
	<true/>
	<key>Size</key>
	<integer>32000000000</integer>
	<key>TotalSize</key>
	<integer>32000000000</integer>
	<key>VirtualOrPhysical</key>
	<string>Physical</string>
	<key>WholeDisk</key>
	<true/>
</dict>
</plist>
