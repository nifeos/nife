+        links.set_table_entry(cluster, TableEntry::Free)?;
         let next = match entry {
             TableEntry::EndOfChain => None,
             TableEntry::Next(next) if is_data(clusters, next) => Some(next),
             entry => return Err(ChainError::Broken { cluster, entry }),
         };
