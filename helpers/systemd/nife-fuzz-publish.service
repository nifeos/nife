# The daily publish: counter totals and clean seed ranges, from the state the fuzz run keeps.
# Triggered by nife-fuzz-publish.timer. It runs as the same user and never touches the held findings'
# contents (notes/fuzzing/continuous-host.md). As shipped it writes the report to its output
# directory and publishes nothing; the drop-in that publishes the daily release is step P5 of
# notes/fuzzing/finishing-the-setup.md.
[Unit]
Description=nife continuous fuzzing, daily report

[Service]
Type=oneshot
User=lane
Group=lane
Environment=NIFE_FUZZ_HOME=/home/lane/fuzz
ExecStart=/home/lane/nife/helpers/fuzz-daily-publish.sh
