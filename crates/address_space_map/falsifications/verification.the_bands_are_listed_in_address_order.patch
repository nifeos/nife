 pub const BANDS: [(&str, Band); 8] = [
     ("NULL_GUARD", NULL_GUARD),
     ("PAIR_PAGES", PAIR_PAGES),
-    ("RUNTIME_WINDOWS", RUNTIME_WINDOWS),
     ("HEAP", HEAP),
+    ("RUNTIME_WINDOWS", RUNTIME_WINDOWS),
     ("SERVICE_WINDOWS", SERVICE_WINDOWS),
     ("IMAGE", IMAGE),
     ("STACK", STACK),
@@ -282,10 +282,6 @@ const _: () = {
     let mut i = 0;
     while i < BANDS.len() {
         let band = BANDS[i].1;
