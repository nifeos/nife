# Milestone 724 (the merge queue reports its ejection share and its time to merge): the daily record
# `helpers/merge_queue_share.py update` writes from GitHub's merge-queue events. Read from the working
# tree like `effort.csv`, and for its reason: a committed record of a fact git cannot reproduce.
QUEUE_PATH = DATA_DIR / 'merge-queue-daily.csv'
# The week notes (milestone 623, provisional): hand-appended rows, pruned by this script when a
# week ages out of the chart window, rendered as bullets under the chart a row names. Like the two
# above rather than like the measure files: it is a record of an explanation, not a series
# restated from git, so nothing here may rewrite a row that is already in it.
WEEK_NOTES_PATH = DATA_DIR / 'week-notes.csv'
# Which merged pull requests carry the `debt-paydown` label (notes/debt-paydown.md), one row per
