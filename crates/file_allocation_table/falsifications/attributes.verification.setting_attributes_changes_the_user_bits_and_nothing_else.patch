Falsifies `file_allocation_table::attributes::verification::setting_attributes_changes_the_user_bits_and_nothing_else`.

The defect: the user bits are added to the stored byte instead of replacing the old ones, so a read-only file made writable again keeps its read-only bit.

Expected to fail: the harness's `assert_eq!(result & USER_BITS, set.bits())`.

diff --git a/crates/file_allocation_table/src/attributes.rs b/crates/file_allocation_table/src/attributes.rs
--- a/crates/file_allocation_table/src/attributes.rs
+++ b/crates/file_allocation_table/src/attributes.rs
@@ -94,7 +94,7 @@ impl Attributes {
 /// **`DIR_Attr` after the user bits become `new`**: the directory and label bits and the two bits
 /// the specification reserves keep their value.
 pub(crate) const fn apply(stored: u8, new: Attributes) -> u8 {
-    (stored & !USER_BITS) + new.0
+    stored | new.0
 }
 
 impl NamedEntry {
