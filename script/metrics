# The flat row every metric function and `--table` still speaks in, derived from the split rather
# than maintained beside it, so the two cannot disagree about which columns exist.
FIELDS = [WEEK] + [column for _name, columns in MEASURES for column in columns]
if len(set(FIELDS)) != len(FIELDS):
    raise SystemExit('metrics: MEASURES names a column twice; a column belongs to one measure')


def measure_path(name):
    return DATA_DIR / (name + '.csv')

# Columns a rewrite must CARRY rather than recompute, because nothing in git can produce them and
# the only copy is the cell itself. `--backfill` drops every row and rebuilds it, so a column not
# named here is silently erased by one. That is not hypothetical: milestone 276 ran a backfill to
# add a column and watched 2026W36's measured 94.4 coverage disappear with it, which is why the
# mechanism is now a named set instead of one special case in `main`. It was found by
# milestone 276 (the dashboard counts milestones and decisions by status, and names not at all).
#
# `human_person_weeks` joins coverage here for a different reason than coverage's. It is DERIVED on
# a new row, at 1.0 per calendar week, from calef's standing datum that he works on this full time
# (milestone 519, which refuses time tracking and asks only for a correction when the datum stops
# being true). Carrying it is what makes that correction survive: a hand-edited 0.4 for a week he
# was away stays 0.4 through every later backfill, and nothing has to remember it was edited.
CARRIED_FIELDS = ('coverage_lines_pct', 'coverage_min_file_pct', 'human_person_weeks')

# Milestone 610's columns are carried for coverage's reason: they come from a build this script is
# not allowed to run, so the only copy is the cell `helpers/interface_stability.py` wrote. A
# `--backfill` here would otherwise erase the series it cannot restate.
INTERFACE_FIELDS = tuple(interface_stability.FIELDS)
CARRIED_FIELDS = CARRIED_FIELDS + INTERFACE_FIELDS

# calef's standing datum, applied to a week that has no cell yet. See CARRIED_FIELDS.
DEFAULT_PERSON_WEEKS = '1.0'


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, check=True).stdout


# ---------------------------------------------------------------------------------------------
# Reading a commit's tree without touching the working tree.
#
# `git show <rev>:<path>` per file would be several thousand processes over nine weeks. One
# `git ls-tree -r -z` names the blobs and one `git cat-file --batch` streams every one of them, so
# a whole week's tree costs two processes. Nothing is ever checked out: AGENTS.md's rule against
# `git checkout <path>` exists because it destroyed uncommitted work three times, and a backfill
# that walks history is exactly where that mistake would be made.

# What a week's tree has to carry. `.rs` and `.md` are the line, comment, `BUGS`, harness and
# `unsafe` counts. `Cargo.toml` and `script/` joined them for the naming columns (milestone 276):
# a package's provenance block lives in its manifest, because a package here may have a `lib.rs`, a
# `main.rs` or neither, and a `script/` entry point's lives in its shell comment header. Widening
# the filter costs about sixty more blobs in the same single `cat-file --batch`, and changes nothing
# else, because every other metric selects by suffix out of the same dictionary.
def _wanted(path):
    if path.startswith(('vendor/', 'target/')):
        return False
    return (path.endswith(('.rs', '.md', '/Cargo.toml'))
            or (path.startswith('script/') and path.count('/') == 1)
            or path.startswith('packages/')
            # The released crates' measures: a lock entry says a crate has left, the allowlist
            # says it may, and a falsification patch is shipped text the citation scan reads.
            or path in ('Cargo.lock', crate_release.ALLOWLIST)
            or (path.startswith('crates/') and path.endswith('.patch')))


def _cat(oids):
    """Each blob's text, in order, from one `git cat-file --batch`."""
    if not oids:
        return []
    blob = subprocess.run(['git', 'cat-file', '--batch'],
                          input=('\n'.join(oids) + '\n').encode(),
                          capture_output=True, check=True).stdout
    out, pos = [], 0
    for _oid in oids:
        end = blob.index(b'\n', pos)
        size = int(blob[pos:end].split()[2])
        out.append(blob[end + 1:end + 1 + size].decode('utf-8', 'replace'))
        pos = end + 1 + size + 1
    return out


class Tree:
    """Every blob a metric reads in one commit: Rust, markdown, manifests and `script/` entries."""

    def __init__(self, rev):
        self.rev = rev
        paths, oids = [], []
        # Every tracked path, wanted or not, for the homes measure: it asks whether each one has a
        # home, and the blob filter below is about which texts to read, not which paths exist.
        self.paths, self.oid, self.links = [], {}, set()
        for entry in git('ls-tree', '-r', '-z', rev).decode('utf-8', 'replace').split('\0'):
            if not entry:
                continue
            meta, path = entry.split('\t', 1)
            mode, kind, oid = meta.split()
            if kind != 'blob':
                continue
            self.paths.append(path)
            self.oid[path] = oid
            if mode == '120000':
                self.links.add(path)
            if not _wanted(path):
                continue
            paths.append(path)
            oids.append(oid)
        self.text = dict(zip(paths, _cat(oids)))

    def read(self, paths):
        """{path: text} for any of this commit's blobs, `_wanted` or not, in one more batch."""
        missing = [p for p in paths if p not in self.text and p in self.oid]
        return {**{p: self.text[p] for p in paths if p in self.text},
                **dict(zip(missing, _cat([self.oid[p] for p in missing])))}

    def rust(self):
        return [(p, t) for p, t in self.text.items() if p.endswith('.rs')]

    def markdown(self):
        return [(p, t) for p, t in self.text.items() if p.endswith('.md')]


# ---------------------------------------------------------------------------------------------
# The metrics. Each one takes a Tree and returns numbers; none of them builds anything.

# The roadmap index row: `| 231 | NOT-STARTED | [title](file) | note | date |`, read ONLY from the
# single `design/roadmap.md` that trees before milestone 76 (split the roadmap: one file per
# milestone) carried. The status vocabulary is checked rather than assumed, because that file also
# held a vocabulary table whose rows start with a pipe. Every tree with blocks is counted from the
# blocks; see `_blocks` below.
# The statuses whose index row carries a date, which is `script/roadmap`'s own `DATED`. Both mean
# the milestone turned BUILT on that day; REMOVED keeps the date because removal does not unbuild
# it.
DATED_STATUSES = ('BUILT', 'REMOVED')

# A bare `YYYY-MM-DD` anywhere in the Built cell, which is more forgiving than anchoring the cell:
# a handful of early rows carry a parenthetical beside the date.
_DATE = re.compile(r'\d{4}-\d{2}-\d{2}')

_INDEX_ROW = re.compile(r'^\|\s*(\d+)\s*\|\s*([A-Z][A-Z0-9 _-]*?)\s*\|')

# The blocks, for every revision since milestone 76 split the roadmap. Each block states its own
# number (the filename), its own status (the `**Status:` line) and, since milestone 294, its own
# Built date (the `**Built:**` line under `## Index row`), so the fields these two metrics want are
# in the tree one file per milestone.
#
# **`design/roadmap/README.md` is never read** (calef, 2026-09-24: *"There need not be a check the
# file for milestone status at all because it cannot be found there any longer."*). Until that day
# this preferred the README's index table wherever one existed, on the argument that a past week
# should be counted the way its reader counted it. Measured when the preference was removed, it
# bought nothing: a backfill from the blocks alone reproduced every `milestones.csv` and
# `velocity.csv` row from 2026W29 to 2026W37 exactly. The one historical difference is 2026W38,
# where milestone 518 (a census that cannot be attributed is a number nobody can act on) says
# `BUILT 2026-09-20` in its block and had no index row at the week's end, so the index was stale
# and the block was right. And the preference had a live cost: when #1247 brought the README back
# as a pointer, both readers took it for an empty index and zeroed the series.
_BLOCK = re.compile(r'^design/roadmap/(\d+)-[a-z0-9][a-z0-9-]*\.md$')


def _blocks(tree):
    """(number, status, built) per milestone block in one tree."""
    out = []
    for path, text in tree.text.items():
        m = _BLOCK.match(path)
        if not m:
            continue
        # Either form: this walks revisions on both sides of the switch in milestone 596 (the roadmap blocks
        # get frontmatter too).
        status, built = roadmap_block.status_and_built(text)
        if not status:
            continue
        out.append((m.group(1), status, built))
    return out


def _pre_split_roadmap(tree):
    """The single `design/roadmap.md` of a tree from before milestone 76, or None for any tree
    that has per-milestone blocks, which is then counted from them."""
    if any(_BLOCK.match(path) for path in tree.text):
        return None
    return tree.text.get('design/roadmap.md')


def milestones(tree):
    counts = dict.fromkeys(MILESTONE_STATUSES, 0)
    text = _pre_split_roadmap(tree)
    if not text:
        for _number, status, _built in _blocks(tree):
            if status in counts:
                counts[status] += 1
        return counts
    seen = set()
    for line in text.split('\n'):
        match = _INDEX_ROW.match(line)
        if not match:
            continue
        number, status = match.group(1), match.group(2)
        if status in counts and number not in seen:
            seen.add(number)
            counts[status] += 1
    return counts


def built_by_week(tree):
    """How many milestones turned BUILT in each ISO week, from one tree, keyed by week.

    **A flow, where every other milestone column here is a stock**, and the only one that answers
    "how fast". That difference is why it is derived differently, and the reason is measured rather
    than assumed.

    **It is read from the CURRENT tree for every week, not from each week's own revision**, which
    breaks this file's usual rule on purpose. Computing it per revision was tried first and is
    wrong: the index milestone 294 (`design/roadmap/README.md`'s index is generated) generated
    was regenerated at an integrator's convenience while it existed, so a week whose revision predates its own
    regeneration reports zero and the next week reports both. Backfilled that way on 2026-09-20 it
    gave 0 for 2026W29 through 2026W31 and 0 for 2026W33, against 10, 8, 20 and 9 actually built in
    those weeks. A stock read late is merely stale; a flow read late lands in the wrong bucket,
    which is worse than stale because it looks like history.

    A BUILT date is a stable fact (`script/roadmap`: a milestone built on a date turned BUILT on
    that date, and nothing later makes that untrue), so reading them all from today's tree is not a
    revision of history, it is the only way to get it right. The cost is that this column, alone
    among these, changes for a past week if somebody corrects that week's date, and correcting it
    is what we would want.

    REMOVED rows keep their date and are counted here: a week in which something was built and then
    removed still had the building in it.
    """
    text = _pre_split_roadmap(tree)
    counts = {}
    if not text:
        for _number, status, built in _blocks(tree):
            if status in DATED_STATUSES and built:
                key = week_of_date(built)
                counts[key] = counts.get(key, 0) + 1
        return counts
    seen = set()
    for line in text.split('\n'):
        match = _INDEX_ROW.match(line)
        if not match:
            continue
        cells = [c.strip() for c in line.split('|')]
        if len(cells) < 6:
            continue
        number, status = match.group(1), match.group(2)
        if number in seen or status not in DATED_STATUSES:
            continue
        seen.add(number)
        stamp = _DATE.search(cells[5])
        if stamp:
            key = week_of_date(stamp.group(0))
            counts[key] = counts.get(key, 0) + 1
    return counts


def merges_by_week(rev):
    """How many pull requests merged in each ISO week, from git alone, keyed by week.

    **A flow beside `built_by_week`, and the pairing is the point.** Milestones count DECLARED units
    of work, and a large share of what lands here is not one: a decision, a correction, a record
    fix, a capture. On 2026-09-21 the maintainer opened about fifteen pull requests of which three
    were milestones, and every column on this page was blind to the other twelve. That work is real
    and it costs real tokens, which is the reason calef asked for this column in milestone 519's
    lane rather than a later one.

    **It is derived from git and never from the GitHub API**, which is what makes it backfill to the
    first commit like everything else here. A merge commit carries its own committer date and
    `main` holds every one of them; Actions' run history is retained for ninety days and would have
    given a series that started in June and could never be extended backwards.

    Read from HEAD for every week rather than from each week's own revision, for the same reason
    `built_by_week` is: a merge's date is a fact that does not change, so one pass over one log
    answers every week at once, and a past week's answer is identical either way.

    The shape matched is GitHub's own default merge-commit subject, `Merge pull request #N from ...`,
    which is what the merge queue writes. A merge made any other way is not counted, and there is no
    way to tell one from an ordinary merge commit after the fact.
    """
    counts = {}
    log = git('log', '--first-parent', '--format=%cI%x09%s', rev).decode('utf-8', 'replace')
    for entry in log.split('\n'):
        if '\t' not in entry:
            continue
        when, subject = entry.split('\t', 1)
        if not subject.startswith('Merge pull request #'):
            continue
        key = week_of(when)
        counts[key] = counts.get(key, 0) + 1
    return counts


def models_by_week(rev):
    """Commits and lines by the model that signed them, per ISO week, from git alone.

    **The third flow on this page, and it answers a question the other two cannot**: the velocity
    and pull-request columns say how much landed, and this says who wrote it. The source is the
    `Co-Authored-By` trailer `AGENTS.md` has every agent commit carry; MODEL_TRAILERS above has the
    argument for why the harness's own token records were refused as the spine.

    Read from HEAD for every week rather than from each week's own revision, exactly like
    `merges_by_week`: a commit's trailer and its diff are facts that do not change, so one pass
    over one log answers every week at once.

    **Four buckets, mutually exclusive, and the sum is asserted.**

    - `merge`, first, because a merge commit is not authored work. On this repository
      `allow_squash_merge` is false and the merge queue creates them, so a merge commit IS a pull
      request landing, which makes this a throughput count worth having on its own terms rather
      than a residue. 95 merge commits do carry a trailer, from an agent resolving a conflict, and
      the bucket still wins: the commit records a landing, not a piece of writing.
    - `claim`, next, for a commit whose tree is its parent's tree: it changes nothing. That is what
      makes a commit a claim under §90 (the claim is a draft pull request): `script/claim` commits
      `--allow-empty` so the draft survives its base landing, and signs it with whatever
      `NIFE_CLAIM_MODEL` names, `Claude Code` by default. So neither the trailer nor the `claim:`
      subject is the test. Ten non-empty commits have a `claim:` subject and are real work on
      `script/claim`; the hand-made claims from before that script have subjects like `milestone
      208: claim the lane`. Measured on main 2026-10-18 UTC: 959 empty non-merge commits, 914 with
      the script's `claim:` subject and 36 of the other 45 hand-made claims. Six are CI re-triggers
      and three are stray empty commits, which carry no work either and are counted here too: an
      exception, on purpose, since telling them apart would need a subject pattern. A claim
      carries no line count.
    - `attributed`, per model, for a non-merge commit whose trailer this table knows.
    - `unattributed`, for a non-merge commit with no trailer, split into `pre_convention` (before
      the first trailer this repository ever carried) and `unattributed` proper (after it, which is
      the half that is actually a gap).

    **Merges carry a commit count and no line count**, and the reason is that a merge's diff
    against its first parent is the whole of what landed on the branch, every line of which is
    already counted on the branch's own commits. Adding it would double the tree.

    **Lines are `added + removed`, the churn, not the net.** Net is the wrong quantity twice over:
    a commit that only deletes reads negative, and a careful mechanical sweep across 246 files can
    net out near zero while being the largest diff of the week. The tree's net size already has a
    series of its own (`lines.svg`), which is a stock; this is a flow, and what flows is how much
    text was touched.

    A week entirely before the convention gets EMPTY cells for every model column and for
    `unattributed`, not zeroes, which is the same absent-is-not-zero rule milestone 519's cost
    columns follow. `pre_convention`, `merge` and `model_commits_total` are still filled for such a
    week, because those three are countable without any trailer existing.
    """
    slugs = MODEL_SLUGS + MODEL_EXTRA
    weeks = {}
    unknown = {}

    def bucket(week):
        return weeks.setdefault(week, {s: 0 for s in slugs})

    # One `git log --numstat` over the whole history: two numbers and a trailer per commit, in one
    # process, the same economy `Tree` buys with one `cat-file --batch`. RS separates the records
    # because a commit subject can hold anything, US separates trailers because a trailer value can
    # hold a comma.
    fmt = '%x1e%H%x09%T%x09%P%x09%cI%x09%(trailers:key=Co-Authored-By,valueonly,separator=%x1f)'
    log = git('log', '--numstat', '--format=' + fmt, rev).decode('utf-8', 'replace')
    merge_parents = set(git('log', '--min-parents=2', '--format=%H', rev).decode().split())
    first_trailer = None
    records = []
    trees = {}
    recorded = commit_models()
    for chunk in log.split('\x1e'):
        if not chunk.strip():
            continue
        head, _, rest = chunk.partition('\n')
        sha, tree, parents, when, trailers = head.split('\t')
        trees[sha] = tree
        names = [normalize_model(t) for t in trailers.split('\x1f') if t.strip()]
        names = signed_by(sha, names, recorded)
        churn = 0
        for line in rest.split('\n'):
            if not line.strip():
                continue
            added, removed, _ = line.split('\t', 2)
            churn += (int(added) if added != '-' else 0) + (int(removed) if removed != '-' else 0)
        records.append((sha, tree, parents, when, names, churn))
        if names and sha not in merge_parents and (first_trailer is None or when < first_trailer):
            first_trailer = when

    for sha, tree, parents, when, names, churn in records:
        week = week_of(when)
        row = bucket(week)
        row['_commits'] = row.get('_commits', 0) + 1
        if sha in merge_parents:
            row['merge'] += 1
            continue
        if parents and trees.get(parents) == tree:
            row['claim'] += 1
            continue
        if names:
            # **A commit with more than one trailer is counted once, under the first, and named on
            # stderr.** Counting it twice would break the invariant this function asserts, and
            # splitting a commit in half would put a fraction in a column of counts. Measured
            # 2026-09-24: no commit in this repository carries two, so the rule has never fired and
            # the warning is what would tell us it started to.
            if len(names) > 1:
                unknown.setdefault('(%d trailers on one commit) %s' % (len(names), sha), 0)
                unknown['(%d trailers on one commit) %s' % (len(names), sha)] += 1
            slug = MODEL_TRAILERS.get(names[0])
            if slug is None:
                unknown[names[0]] = unknown.get(names[0], 0) + 1
                slug = MODEL_UNKNOWN
            row[slug] += 1
            row[_model_col('lines', slug)] = row.get(_model_col('lines', slug), 0) + churn
        elif first_trailer is not None and when < first_trailer:
            row['pre_convention'] += 1
            row['model_lines_pre_convention'] = row.get('model_lines_pre_convention', 0) + churn
        else:
            row['unattributed'] += 1
            row['model_lines_unattributed'] = row.get('model_lines_unattributed', 0) + churn

    if unknown:
        # Named, never swallowed. See MODEL_TRAILERS.
        print('metrics: %d commit trailer value(s) this script has never seen, counted in '
              'other_models: %s' % (sum(unknown.values()),
                                    '; '.join('%s (%d)' % (k, v) for k, v in sorted(unknown.items()))),
              file=sys.stderr)

    out = {}
    for week, row in weeks.items():
        total = row.pop('_commits')
        counted = sum(row[s] for s in slugs)
        if counted != total:
            # Loud, because a denominator that leaks quietly is the failure this whole shape was
            # built to make impossible. There is no softer self-check in this script to follow.
            raise SystemExit('metrics: %s does not balance: %d commits, %d bucketed '
                             '(attributed + unattributed + merge + claim must be every commit)'
                             % (week, total, counted))
        cells = {_model_col('commits', s): row[s] for s in slugs}
        cells['model_commits_total'] = total
        for s in MODEL_SLUGS + ['unattributed', 'pre_convention']:
            cells[_model_col('lines', s)] = row.get(_model_col('lines', s), 0)
        # A week wholly before the first trailer could not have carried one. Absent, not zero.
        if first_trailer is not None and week < week_of(first_trailer):
            for s in MODEL_SLUGS + ['unattributed']:
                cells[_model_col('commits', s)] = ''
                cells[_model_col('lines', s)] = ''
        out[week] = cells
    return out


# ---------------------------------------------------------------------------------------------
# Milestone 519's cost inputs, which are the two things on this page that no revision can produce.
#
# `notes/project-metrics/effort.csv` is written by `script/effort` from the agent harness's session
# records, which live on one laptop outside this repository and are discarded. `ledger.md` is typed
# by a person. Both are committed, so the weekly workflow on a GitHub runner reads exactly what a
# run on the dev Mac reads, and produces the same bytes.
#
# **An absent week is absent, never zero.** The first five weeks of this project have no session
# records left anywhere, and a zero in a cost column would be averaged into a published figure by
# somebody who never read this comment. Every function below returns nothing for a week it cannot
# answer for, and every cell it does not fill stays empty.

# `| 2026-08-15 | argon, ... | 89.99 | source |` and the two other table shapes in the
# ledger. Parsed by the heading they sit under, because three tables in one file cannot be told
# apart by their columns alone and guessing from column count is how a ledger silently loses a row.
_LEDGER_DATE = re.compile(r'^\d{4}-\d{2}-\d{2}$')


def _money(cell):
    """A price cell, or None. Commas and a leading currency symbol are tolerated, prose is not."""
    text = cell.replace(',', '').replace('$', '').strip()
    text = re.sub(r'\*+', '', text)
    try:
        return float(text)
    except ValueError:
        return None


def ledger():
    """What was paid and what a token lists for, out of `notes/project-metrics/ledger.md`.

    Returns (purchases, subscriptions, rates):
      purchases     [(YYYY-MM-DD, usd)]
      subscriptions [(YYYY-MM-DD start, usd per month)]
      rates         {model: {'input': usd, 'cache_write_5m': ..., ...}} per million tokens

    A missing file is not an error: it means the cost columns stay empty, which is the correct
    reading of a tree that has not recorded a cost yet.
    """
    purchases, subscriptions, rates = [], [], {}
    if not LEDGER_PATH.exists():
        return purchases, subscriptions, rates
    section = ''
    for line in LEDGER_PATH.read_text().split('\n'):
        if line.startswith('#'):
            section = line.lstrip('#').strip().lower()
            continue
        if not line.startswith('|'):
            continue
        cells = [c.strip() for c in line.strip().strip('|').split('|')]
        # `rented capacity` is hardware's shape one level over (§203 (capacity is rented rather
        # than bought)): a dated one-time purchase, so it feeds `purchases` beside the boards
        # rather than living in a section nothing reads.
        if (section in ('hardware', 'rented capacity')
                and len(cells) >= 3 and _LEDGER_DATE.match(cells[0])):
            price = _money(cells[2])
            if price is not None:
                purchases.append((cells[0], price))
        elif section == 'subscriptions' and len(cells) >= 4 and _LEDGER_DATE.match(cells[0]):
            # `200.00 / month`, which is the only cadence this tree has ever had. A rate written in
            # any other unit is skipped rather than guessed at, and the ledger's own BUGS says so.
            rate = _money(cells[3].split('/')[0]) if '/ month' in cells[3] else None
            if rate is not None:
                subscriptions.append((cells[0], rate))
        elif (section.startswith('retail rates') and len(cells) >= 7
              and _LEDGER_DATE.match(cells[0])):
            model = cells[1].strip('`')
            values = [_money(c) for c in cells[2:7]]
            if model and all(v is not None for v in values):
                # A later row for the same model replaces an earlier one: the ledger is appended to,
                # so the last row wins, and the file's own BUGS records that this restates old weeks
                # at the newest rate.
                rates[model] = dict(zip(('input', 'cache_write_5m', 'cache_write_1h',
                                         'cache_read', 'output'), values))
    return purchases, subscriptions, rates


def _subscription_charges(subscriptions, through):
    """[(YYYY-MM-DD, usd)] for every monthly charge from each start date up to `through`.

    The billing day is the monthly anniversary of the start date, which is an assumption the ledger
    states out loud because no invoice is recorded anywhere. A month with no such day (a start on
    the 31st) bills on its last day.
    """
    out = []
    for start, rate in subscriptions:
        first = date.fromisoformat(start)
        year, month = first.year, first.month
        while True:
            if month == 12:
                last = 31
            else:
                last = (date(year + (month == 12), month % 12 + 1, 1)
                        - timedelta(days=1)).day
            when = date(year, month, min(first.day, last))
            if when > through:
                break
            if when >= first:
                out.append((when.isoformat(), rate))
            month += 1
            if month > 12:
                year, month = year + 1, 1
    return out


def cash_by_week(through):
    """{ISO week: dollars actually paid that week}, from the ledger.

    **Paid, not accrued**, which is milestone 519's own definition of the column and is why it is
    lumpy: three weeks carry a subscription charge and seven carry nothing. An accrual is derivable
    from the ledger by anyone who wants one; a payment is not derivable from an accrual, so the
    file keeps the one that cannot be reconstructed.
    """
    purchases, subscriptions, _rates = ledger()
    out = {}
    for when, amount in purchases + _subscription_charges(subscriptions, through):
        key = week_of_date(when)
        out[key] = out.get(key, 0.0) + amount
    return out


def queue_by_week():
    """{ISO week: {entries, ejected}} summed from `merge-queue-daily.csv`, or {} without the file.

    Summed rather than averaged, so the weekly share is ejections over entries across the week and
    not a mean of daily percentages, which would weight a quiet Sunday like a busy Tuesday. The
    median hours to merge stays in the daily file: a median of daily medians is not a median."""
    if not QUEUE_PATH.exists():
        return {}
    weeks = {}
    for row in csv.DictReader(QUEUE_PATH.read_text().splitlines()):
        held = weeks.setdefault(week_of_date(row['day']), {'entries': 0, 'ejected': 0})
        held['entries'] += int(row['entries'] or 0)
        held['ejected'] += int(row['ejected'] or 0)
    return weeks


def debt_paydown_by_week(path=DEBT_PAYDOWN_PATH):
    """{ISO week: {merged, labeled}} counted from `merged-pull-requests.csv`, or {} without it.

    Both counts come from the one file, so the share's numerator and denominator agree about which
    pull requests exist. The total is close to `merged_pull_requests` and not equal to it: that
    column counts first-parent merge commits on `main` by committer date, this one counts GitHub's
    pull requests merged into `main` by `mergedAt`. A merge landing seconds either side of Monday
    00:00 UTC can fall in different weeks on the two, and a merge commit whose subject is not
    GitHub's default is in this count and not that one."""
    if not path.exists():
        return {}
    weeks = {}
    for row in csv.DictReader(path.read_text().splitlines()):
        held = weeks.setdefault(week_of_date(row['merged_day']), {'merged': 0, 'labeled': 0})
        held['merged'] += 1
        held['labeled'] += int(row['debt_paydown'])
    return weeks


def debt_paydown_cells(held):
    """The three columns for one week's `debt_paydown_by_week` entry, or None for a week the file
    does not cover: every cell empty then, never zero, for the queue's reason."""
    if held is None:
        return {'debt_paydown_merged_total': '', 'debt_paydown_merged': '', 'debt_paydown_pct': ''}
    return {'debt_paydown_merged_total': held['merged'],
            'debt_paydown_merged': held['labeled'],
            'debt_paydown_pct': '%.1f' % (100.0 * held['labeled'] / held['merged'])}


def _builds(path=None):
    """[(date, {(workflow, job): (start, end, seconds)}, wall seconds)] from `ci-builds.csv`, one
    entry per green build, or [] without the file."""
    path = path or CI_BUILDS_PATH
    if not path.exists():
        return []
    held = {}
    for row in csv.DictReader(path.read_text().splitlines()):
        build = held.setdefault((row['date'], row['build']), [None, {}])
        if row['kind'] == 'build':
            build[0] = float(row['seconds'])
        else:
            build[1][(row['workflow'], row['job'])] = (float(row['start_seconds']),
                                                      float(row['end_seconds']), float(row['seconds']))
    return [(d, jobs, wall) for (d, _b), (wall, jobs) in sorted(held.items()) if wall is not None]


def p90(values):
    """The 90th percentile by linear interpolation between closest ranks (`inclusive`), so one
    build is its own p90 and the figure never leaves the range measured."""
    if len(values) < 2:
        return values[0]
    return statistics.quantiles(values, n=10, method='inclusive')[8]


def builds_by_week(path=None):
    """{ISO week: {column: value}}: the week's green builds, and the median and p90 of their wall
    time, first job start to last job end across `ci.yml` and `verify.yml` (helpers/ci_job_times.py's
    `build_wall`). Every build counts once, so a busy day weighs what it merged."""
    weeks = {}
    for d, _jobs, wall in _builds(path):
        weeks.setdefault(week_of_date(d), []).append(wall / 60.0)
    return {w: {'ci_builds': len(v), 'ci_build_median_minutes': '%.1f' % statistics.median(v),
                'ci_build_p90_minutes': '%.1f' % p90(v)} for w, v in weeks.items()}


def job_label(workflow, job):
    """A bar's name: the job key, with verify's marked, since both workflows have a `gate`."""
    return job if workflow == 'ci.yml' else '%s (verify)' % job


def bar_key(key):
    """The bar a job counts toward. `x-shard` folds into `x` when a suite is split into shards and a
    job that waits for them (cpu-matrix on 2026-10-06, falsify on 2026-10-05): the build waits for
    the slower of the two, and one bar keeps the job's history across the split."""
    workflow, job = key
    return (workflow, job[:-len('-shard')]) if job.endswith('-shard') else key


def build_job_weeks(path=None):
    """{ISO week: {(workflow, job): median minutes}} over the week's green builds that ran the job.
    A build that skipped it (verify's path filter skips most) is not a zero: the bar is how long the
    job takes when it runs, and the p90 line is what its runs do to the build."""
    held = {}
    for d, jobs, _wall in _builds(path):
        week = held.setdefault(week_of_date(d), {})
        per_build = {}
        for key, (_s, _e, t) in jobs.items():
            per_build[bar_key(key)] = max(per_build.get(bar_key(key), 0.0), t / 60.0)
        for key, minutes in per_build.items():
            week.setdefault(key, []).append(minutes)
    return {w: {k: statistics.median(v) for k, v in jobs.items()} for w, jobs in held.items()}


def build_job_series(weeks, path=None):
    """(series, note) for ci-jobs.svg: one bar per job whose weekly median reaches JOB_BAR_MINUTES in
    any charted week, slowest first, at most one per palette slot; and the line under the chart
    naming how many jobs fell short and the longest of them. A job past the eighth slot joins the
    note rather than taking a ninth hue (PALETTE_LIGHT's rule)."""
    by_week = build_job_weeks(path)
    peak = {}
    for w in weeks:
        for key, m in by_week.get(w, {}).items():
            peak[key] = max(peak.get(key, 0.0), m)
    drawn = sorted((k for k, m in peak.items() if m >= JOB_BAR_MINUTES), key=lambda k: -peak[k])
    drawn = drawn[:len(PALETTE_LIGHT)]
    rest = sorted((k for k in peak if k not in drawn), key=lambda k: -peak[k])
    series = [(job_label(*k), [by_week.get(w, {}).get(k, 0.0) for w in weeks], None) for k in drawn]
    note = ''
    if rest:
        note = ('%d other job%s, each under %.1f minutes in every week shown (the longest, %s, '
                'peaked at %.1f)' % (len(rest), '' if len(rest) == 1 else 's', JOB_BAR_MINUTES,
                                     job_label(*rest[0]), peak[rest[0]]))
        if any(peak[k] >= JOB_BAR_MINUTES for k in rest):
            note = '%d other jobs, past the palette\u2019s eight bars or under %.1f minutes' % (
                len(rest), JOB_BAR_MINUTES)
    return series, note


def critical_path(week, path=None):
    """([(label, (workflow, job), median start, median minutes, median end, builds that ran it)],
    median wall, builds) for the week's green builds, latest median end first, so the job that
    sets the build time heads the list. Each figure is the median over the builds that ran the job,
    so a bar is a typical run of it and not any one build."""
    starts, secs, ends, walls = {}, {}, {}, []
    for d, jobs, wall in _builds(path):
        if week_of_date(d) != week:
            continue
        walls.append(wall / 60.0)
        for key, (s, e, t) in jobs.items():
            starts.setdefault(key, []).append(s / 60.0)
            secs.setdefault(key, []).append(t / 60.0)
            ends.setdefault(key, []).append(e / 60.0)
    rows = [(job_label(*k), k, statistics.median(starts[k]), statistics.median(secs[k]),
             statistics.median(ends[k]), len(secs[k])) for k in starts]
    rows.sort(key=lambda r: (-r[4], r[0]))
    return rows, (statistics.median(walls) if walls else None), len(walls)


def effort_by_week():
    """{ISO week: dict of the cost and context figures} from `effort.csv`.

    `tokens` is every token class added together, which is the physical quantity and is the only
    thing on this page a reader can compare against another project's. The price is kept separate
    rather than folded in, because the four classes are billed between 0.1x and 2x of each other and
    one number would hide which.

    **The blended rate is left blank for a week whose mix this tree cannot price**, rather than
    priced over the part it can. A rate derived from three quarters of a week's tokens is not that
    week's rate, and a number that looks like a measurement is the one thing this page cannot
    afford to be casual with.

    **The context figures ride along because they come out of the same rows**, and they answer the
    other half of the cost question. `turns` is the request count. `read_share` is the cache-read
    share of every token spent, which is the number that reframes the question: it is near 98% and
    that is not waste, it is what carrying a long session's context costs. `context_mean` is the
    whole prompt (input plus cache write plus cache read) over the turns that carried it, and
    `context_peak` is the largest single request, which is a MAXIMUM over models rather than a sum
    for the reason `script/effort`'s `MAXED` gives: adding two peaks invents a request nobody made.
    """
    if not EFFORT_PATH.exists():
        return {}
    _p, _s, rates = ledger()
    text = EFFORT_PATH.read_text().strip().split('\n')
    header = text[0].split(',')
    weeks = {}
    for line in text[1:]:
        if not line.strip():
            continue
        row = dict(zip(header, line.split(',')))
        week = row['week']
        held = weeks.setdefault(week, {'tokens': 0, 'hours': 0.0, 'usd': 0.0, 'priced': True,
                                       'turns': 0, 'context': 0, 'read': 0, 'peak': 0})
        counts = {
            'input': int(row.get('input_tokens') or 0),
            'cache_write_5m': int(row.get('cache_write_5m_tokens') or 0),
            'cache_write_1h': int(row.get('cache_write_1h_tokens') or 0),
            'cache_read': int(row.get('cache_read_tokens') or 0),
            'output': int(row.get('output_tokens') or 0),
        }
        total = sum(counts.values())
        held['tokens'] += total
        held['hours'] += float(row.get('machine_hours') or 0.0)
        held['turns'] += int(row.get('requests') or 0)
        held['read'] += counts['cache_read']
        # The prompt, however it was billed. Output is what the model wrote and is not context.
        held['context'] += total - counts['output']
        held['peak'] = max(held['peak'], int(row.get('peak_context_tokens') or 0))
        rate = rates.get(row['model'])
        if rate is None:
            # A model with no rate and no tokens is the harness's `<synthetic>` label, which nobody
            # billed for and which cannot make a week unpriceable. A model with tokens and no rate
            # can, and does.
            if total:
                held['priced'] = False
            continue
        for kind, count in counts.items():
            held['usd'] += count * rate[kind] / 1_000_000.0
    out = {}
    for week, held in weeks.items():
        blended = ''
        if held['priced'] and held['tokens']:
            blended = '%.3f' % (held['usd'] * 1_000_000.0 / held['tokens'])
        out[week] = {
            'tokens': held['tokens'],
            'hours': held['hours'],
            'blended': blended,
            'turns': held['turns'],
            # Per cent to one place, not a fraction, because that is how the page quotes it and a
            # column a reader has to multiply by a hundred is a column they will misread once.
            'read_share': (100.0 * held['read'] / held['tokens']) if held['tokens'] else None,
            'context_mean': (held['context'] / held['turns']) if held['turns'] else None,
            'peak': held['peak'] or None,
        }
    return out


# A decision file, and the frontmatter status milestone 582 (a decision's status becomes a field,
# and the index becomes generated) gave it on 2026-09-23. A tree from before that carries
# `**Status: X.**` prose instead and is counted from the index table it also carried, because that
# table was the reader's record then and the prose form is the one that once printed a word nobody
# wrote (§211 (what a fatal-risk verdict says, and what the chart can plot as a result)).
_DECISION_FILE = re.compile(r'^design/decisions/(\d+)-[a-z0-9][a-z0-9-]*\.md$')
_DECISION_STATUS = re.compile(r'\A---\n(?:[a-z_]+: .*\n)*?status: *([A-Z]+)\s*\n')


def decisions(tree):
    """Decision counts by status, and the honest bucket for the years before there was one.

    Three records, newest first, and a tree is counted from the newest it has. Since milestone 582
    each file's frontmatter holds its status, and that is the only record from 2026-10-12 (UTC),
    when calef retired the README's index table. Between milestone 114 (split `DECISIONS.md`, and give
    a decision a status) and 582 the table in
    `design/decisions/README.md` was the record. Before 114 a decision was a `## N.` heading in one
    5,320-line file and nothing said whether it still held. Those weeks are counted as UNRECORDED
    rather than as DECIDED, because reading them as decided would invent a status the record never
    carried, which is the failure `script/names` refuses one directory over.
    """
    counts = dict.fromkeys(DECISION_STATUSES, 0)
    for path, text in tree.text.items():
        if _DECISION_FILE.match(path):
            match = _DECISION_STATUS.match(text)
            if match and match.group(1) in counts:
                counts[match.group(1)] += 1
    if sum(counts.values()):
        return counts
    text = tree.text.get('design/decisions/README.md')
    if text:
        seen = set()
        for line in text.split('\n'):
            match = _INDEX_ROW.match(line)
            if not match:
                continue
            number, status = match.group(1), match.group(2)
            key = 'SUPERSEDED' if status.startswith('SUPERSEDED') else status
            if key in counts and number not in seen:
                seen.add(number)
                counts[key] += 1
        if sum(counts.values()):
            return counts
    legacy = tree.text.get('DECISIONS.md')
    if legacy:
        counts['UNRECORDED'] = len(set(re.findall(r'^## (\d+)\.', legacy, re.M)))
    return counts


def names(tree):
    """Naming provenance by status, the ruled-and-owed subset, and the count of named things.

    **The names are `script/names`' own**: `helpers/name_census.py` enumerates them for both
    scripts, out of this week's `git ls-tree` here and out of the working tree there, so the
    current week's `names_total` is `script/names`' total and `check_names_total` fails when it is
    not. Every kind it tracks is counted (crates, programs, packages, scripts, marked items and
    modules, documentation directories and documents), and a name a rule on
    design/naming/convention-rulings.md covers counts as ratified.

    **`names_total` is every named thing, not the sum of the four columns**, which is the one place
    this series deviates from `milestones()` and `decisions()` above, and the deviation is the
    honest part. A surface with no block has said nothing, and counting that silence as
    `unrecorded` would put a claim in the record that nobody made, which is the failure
    `script/names` refuses one directory over. So before milestone 115 (the names that were
    ratified, and the ones that were refused) invented the convention on
    2026-08-04 the four columns are zero and `names_total` is the whole vocabulary of the tree. A
    block that fails `script/names`' form checks counts toward the total and toward no status.
    `script/lint` runs `script/names --check`, so on `main` the gap is zero.

    **A name is found in the tree, so the total does not move when a block is written.** Every
    `.rs` file under a `src/` directory, every top-level document and every `pub` item counts, and
    one with no block is in no status (the "No provenance block" band). An old week is counted
    with TODAY's enumeration, like every row here, and because the names are found in the code the
    enumeration reaches every week the same way: a week before blocks existed shows its names in
    that band, not missing from the total.
    """
    records, _problems, missing, unblocked = name_census.census(tree.paths, tree.text.get)
    counts = dict.fromkeys(NAME_STATUSES, 0)
    for record in records:
        counts[record['status']] += 1
    return counts, len(name_ruled.owed(records)), len(records) + missing + len(unblocked)


# The line `script/names` prints its total on, which `check_names_total` reads.
_NAMES_TOTAL = re.compile(r'^total: (\d+) names,', re.M)


def check_names_total(rows, week, rev, head):
    """Fail when `week`'s `names_total` is not `script/names`' total for the same tree.

    The two share `helpers/name_census.py`, so what this catches is a difference in sourcing (a
    file `Tree` does not read, a path the working tree holds and the commit does not). Compared
    only when the row stands for HEAD and the working tree is HEAD's: `script/names` reads the
    disk, and a lane's uncommitted edit is a different tree, so that case prints why it skipped.
    """
    if rev != head:
        return
    if git('status', '--porcelain', '--untracked-files=normal').strip():
        print('metrics: names_total not compared with script/names: the working tree differs '
              'from HEAD', file=sys.stderr)
        return
    out = subprocess.run(['script/names'], capture_output=True, text=True).stdout
    hit = _NAMES_TOTAL.search(out)
    if not hit:
        raise SystemExit('metrics: script/names printed no `total: N names` line; '
                         'check_names_total reads it')
    ours = int(rows[week]['names_total'])
    if ours != int(hit.group(1)):
        raise SystemExit('metrics: %s names_total is %d and script/names counts %s names in the '
                         'same tree; helpers/name_census.py is shared, so the two scripts are '
                         'reading different files' % (week, ours, hit.group(1)))


def proposals(tree):
    """Unnumbered roadmap proposals: identified work filed where a script can see it, awaiting a number.

    **Nothing else on this dashboard can count these**, which is why the column exists.
    `milestones()` above reads milestone blocks and keys on a milestone NUMBER, and a proposal is defined by not having one, so it is invisible to that count by
    construction rather than by oversight.

    Counted the way `script/roadmap` counts them, out of the shared parse, so the two cannot
    disagree about what is in the pile. A file that does not parse as a proposal is not counted;
    `script/lint` runs `script/roadmap --check`, so in any tree since milestone 247 there are none.

    A promoted proposal is deleted rather than marked (calef, 2026-09-18), so it leaves this count
    by leaving the directory and no exclusion is needed here.

    The weeks before 2026-09-04 are zero because the directory did not exist, which is the same
    restatement artifact as the naming columns above and is rendered rather than backfilled.
    """
    count = 0
    for path, text in tree.markdown():
        directory, _slash, filename = path.rpartition('/')
        if directory != roadmap_proposals.DIRECTORY:
            continue
        if roadmap_proposals.filename_problem(filename):
            continue
        _when, _title, problem = roadmap_proposals.classify(text)
        if problem is None:
            count += 1
    return {'proposals_unnumbered': count}


def coe_action_counts(tree):
    """Open and closed action items across every correction of error in one tree.

    The parse and the open-or-closed rule are `helpers/coe_actions.py`'s, the same function
    `script/roadmap --check` gates with, so the chart and the gate cannot disagree about what an
    item is. A STOCK, read from each week's own tree: an item closes in the week its milestone turns
    BUILT or its decision is decided, which is the week a reader should see the bar shrink.

    A week with no correction under `notes/coes/` has no row rather than a zero, because the
    directory did not exist (2026-09-30). An item that does not resolve counts as neither, since the
    gate refuses it and it cannot have reached `main`.
    """
    texts = {p: t for p, t in tree.markdown()
             if coe_actions.is_record(p) or p.startswith(('design/roadmap/', 'design/decisions/'))}
    if not any(coe_actions.is_record(p) for p in texts):
        return {}
    paths = set(tree.paths)
    counts, _problems = coe_actions.evaluate(texts, paths.__contains__)
    return {'coe_actions_open': sum(o for o, _c in counts.values()),
            'coe_actions_closed': sum(c for _o, c in counts.values())}


def lines(tree):
    """Code and comment lines, `kernel/src` split from everything else.

    The split is the point rather than a convenience. AGENTS.md's second principle records that
    `kernel/src` measures about 40% comments deliberately, and a single tree-wide ratio hides
    exactly the thing that makes the number interesting.
    """
    out = {'kernel_code_lines': 0, 'kernel_comment_lines': 0,
           'other_code_lines': 0, 'other_comment_lines': 0}
    for path, text in tree.rust():
        total = non_blank(text)
        code = non_blank(strip_non_code(text))
        where = 'kernel' if path.startswith('kernel/src/') else 'other'
        out[where + '_code_lines'] += code
        out[where + '_comment_lines'] += total - code
    return out


# A `BUGS` section is a markdown heading in a note, a decision or a milestone block, or the same
# heading inside a Rust doc comment beside the feature it limits. Rising is GOOD: AGENTS.md calls
# these "not modesty, they are the mechanism", and a tree that grows features without growing
# honest limitations beside them is hiding them, not avoiding them.
_MD_BUGS = re.compile(r'^#{1,6} BUGS\b', re.M)
_RS_BUGS = re.compile(r'^[ \t]*(?:///|//!)[ \t]*#{1,6} BUGS\b', re.M)


# Milestone 611 (every program and crate belongs to a package, and every package has a home).
# calef's end state is everything leaving this repository, with no default of staying, so the
# numbers to watch are homes still undecided and packages still here. Counted by
# helpers/packages.py, the same code `script/lint` gates with; blank before the first package file.
# The manifests `_wanted` skips (vendor/) are read here, a handful of blobs per week.


def homes(tree):
    if not any(p.startswith('packages/') and p.endswith(package_boundaries.PACKAGE_SUFFIX) for p in tree.paths):
        return {}
    texts = dict(tree.text)
    for path in tree.paths:
        if path not in texts and package_boundaries.wanted(path) and not path.endswith('.rs'):
            texts[path] = git('cat-file', '-p', tree.oid[path]).decode('utf-8', 'replace')
    cells = package_boundaries.counts(package_boundaries.evaluate(tree.paths, texts))
    return {k: cells[k] for k in HOMES_COLUMNS}


def crate_release_cells(tree):
    """Both crate measures from one tree: each crate at the furthest stage it has reached, and its
    proof coverage against its block's `## What is proven` table.

    The stages are a pipeline, so a crate counts at a stage only when it passes every one before:
    in tree, standalone (static), proven, allowlisted, published. "Standalone (static)" is the half
    of `script/crate-standalone` git can answer, from `helpers/crate_release.py`, which the script
    shares: no build, no `script/names` read and no Kani, so it can say clean where the script says
    no, never the other way. A crate that has left has no harnesses here to count; its proof cells
    are empty rather than zero, and its stage comes from `Cargo.lock`.
    """
    blocks = {int(m.group(1)): t for p, t in tree.text.items()
              for m in [_BLOCK.match(p)] if m and int(m.group(1)) in crate_release.MILESTONES}
    if not blocks:
        # Before 2026-10-07 no per-crate milestone existed, so there was nothing to measure: empty,
        # never zero, by the page's own rule.
        return {c: '' for name, columns in MEASURES if name in ('crate-release', 'crate-proofs')
                for c in columns}
    lock = tree.text.get('Cargo.lock', '')
    allow = tree.text.get(crate_release.ALLOWLIST, '')
    stages = dict.fromkeys(crate_release.STAGES, 0)
    cells = {}
    totals = {'proven': 0, 'required': 0}
    for number in crate_release.MILESTONES:
        block = blocks.get(number, '')
        crate = crate_release.crate_of(block)
        prefix = 'crates/%s/' % crate
        files = {p[len(prefix):]: t for p, t in tree.text.items() if crate and p.startswith(prefix)}
        paths = {p[len(prefix):] for p in tree.paths if crate and p.startswith(prefix)}
        rows = crate_release.required_properties(block)
        here = 'Cargo.toml' in files
        proven = sum(1 for _prop, h in rows if h and here and crate_release.is_proven(h, files, paths))
        cells['crate_%d_required' % number] = len(rows)
        cells['crate_%d_harnesses' % number] = crate_release.harness_count(files) if here else ''
        cells['crate_%d_patches' % number] = (sum(1 for p in paths if p.startswith('falsifications/')
                                                  and p.endswith('.patch')) if here else '')
        cells['crate_%d_proven' % number] = proven if here else ''
        totals['proven'] += proven
        totals['required'] += len(rows)
        if not crate or not block:
            continue
        if not here:
            if crate_release.published(crate, lock):
                stages['published'] += 1
            continue
        stage = 'in_tree'
        if not crate_release.static_findings(files, {p for p in paths if '/' not in p}):
            stage = 'standalone_static'
            if rows and proven == len(rows):
                stage = 'proven'
                if crate_release.allowlisted(crate, allow):
                    stage = 'allowlisted'
        stages[stage] += 1
    cells.update({'crates_' + k: v for k, v in stages.items()})
    cells['crate_properties_proven'] = totals['proven']
    cells['crate_properties_required'] = totals['required']
    cells['crate_properties_owed'] = totals['required'] - totals['proven']
    return cells


def bugs(tree):
    return {'bugs_markdown': sum(len(_MD_BUGS.findall(t)) for _p, t in tree.markdown()),
            'bugs_rust': sum(len(_RS_BUGS.findall(t)) for _p, t in tree.rust())}


# The unsafe census (milestone 134 (the register of measures)) and the harness count, both from `helpers/rust_source.py`.
# The columns keep their `unsafe_` prefix here because a CSV header has no other namespace; the
# shared function's keys are the unprefixed ones a caller in `script/lint` reads.


def unsafe_census(tree):
    """The census, and the ceiling `script/lint` held its density to that week: read through
    the gate's own marker reader, blank before the marker existed."""
    counts = rust_source.unsafe_census(tree.rust())
    ceiling = counted_claims.ceiling(rust_source.UNSAFE_DENSITY_MARKER, tree.markdown())
    return {**{'unsafe_' + key: value for key, value in counts.items()},
            'unsafe_density_ceiling': '' if ceiling is None else ceiling}


def unsafe_trust_census(tree):
    """The same census, split by trust boundary rather than by kernel/src/arch/.

    See `helpers/rust_source.py`'s own comment on `trust_boundary_census` for the classification
    and its caveats (`shared`, `boot_chain` and `unclassified` are populations this number cannot
    collapse into either side without guessing). Only the columns this page and a future ceiling
    could plausibly want are kept; `trust_boundary_census` also computes `*_code_lines` for
    `shared`/`boot_chain`/`unclassified`, dropped here because nothing charts them.
    """
    counts = rust_source.trust_boundary_census(tree.rust())
    return {
        'unsafe_trust_kernel': counts['kernel'],
        'unsafe_trust_kernel_code_lines': counts['kernel_code_lines'],
        'unsafe_trust_kernel_density': counts['kernel_density'],
        'unsafe_trust_userspace': counts['userspace'],
        'unsafe_trust_userspace_code_lines': counts['userspace_code_lines'],
        'unsafe_trust_userspace_density': counts['userspace_density'],
        'unsafe_trust_shared': counts['shared'],
        'unsafe_trust_boot_chain': counts['boot_chain'],
        'unsafe_trust_unclassified': counts['unclassified'],
    }


def harnesses(tree):
    counts = rust_source.harness_count(tree.rust())
    return {'harnesses_' + key: value for key, value in counts.items()}


# The three ratchets below (calef, 2026-10-13 UTC) are charted from the week's tree, never from a
# baseline's rows, through the gate's own functions and scope, so the chart and the gate cannot
# disagree about a file. Every item counts, an exempted one included: the graph measures the debt
# and the gate decides what passes. Each helper is today's, applied to the week's text, so a week
# from before a gate existed reads as the debt that gate would have found. The document scope is
# `helpers/prose_ratchet.py`'s, the one §212 (a prose budget) and §213 (writing standards) share.
def _prose_documents(tree):
    wanted = set(prose_ratchet.documents(set(tree.text)))
    for path, text in tree.markdown():
        if path in wanted:
            yield path, text


def writing_standards(tree):
    """Documents over each of the three limits of §213 (writing standards), as
    `prose_ratchet.over` judges them: median sentence over 20 words, longest over 40, bold over 4
    per 1,000 words. The 200-word floor is the gate's. A document over two limits counts in both columns. A `writing-standards` exception
    marker excuses a document at the gate and not here."""
    counts = {'writing_over_median': 0, 'writing_over_longest': 0, 'writing_over_bold': 0}
    for path, text in _prose_documents(tree):
        over = prose_ratchet.over(prose_ratchet.measured(path, text))
        counts['writing_over_median'] += 'median' in over
        counts['writing_over_longest'] += 'longest' in over
        counts['writing_over_bold'] += 'bold_lead' in over
    return counts


def comment_block_debt(tree):
    """Comment blocks over the 40-line cap of §267 (a comment states the constraint as it is now),
    by `comment_block_ratchet.blocks_over` over its `in_scope` files: files holding one, the
    blocks, and the lines past the cap summed."""
    cap = comment_block_ratchet.CEILING
    files = blocks = excess = 0
    for path, text in tree.text.items():
        if not comment_block_ratchet.in_scope(path):
            continue
        over = comment_block_ratchet.blocks_over(text)
        if over:
            files += 1
            blocks += len(over)
            excess += sum(size - cap for _first, size in over)
    return {'comment_block_files_over_cap': files, 'comment_blocks_over_cap': blocks,
            'comment_block_excess_lines': excess}


_CODE_CEILING = re.compile(r'(?m)^CODE_CEILING = ([\d_]+)$')


def line_citation_debt(tree):
    """Line-number citations under §277 (cite a heading or a symbol, never a line number), by
    `line_citations.file_hits` over its `in_scope` files, split into code and Markdown targets. A
    marked citation counts. The ceiling is the week's own `CODE_CEILING`, blank before the gate.

    The gate's scope is every text file, wider than `_wanted`, so this reads the rest of the week's
    blobs itself; a binary blob holds a NUL and is skipped, as the gate skips it."""
    paths = [p for p in tree.paths if line_citations.in_scope(p) and p not in tree.links]
    counts = {'code': 0, 'doc': 0}
    for path, text in tree.read(paths).items():
        if '\0' in text:
            continue
        for _line, _target, kind in line_citations.file_hits(text, path, honor_marks=False):
            counts[kind] += 1
    ceiling = _CODE_CEILING.search(tree.read([line_citations.SELF]).get(line_citations.SELF, ''))
    return {'line_citations_code': counts['code'], 'line_citations_doc': counts['doc'],
            'line_citations_ceiling': int(ceiling.group(1)) if ceiling else ''}


# Cumulative icount drift since a fixed anchor: milestone 415 item 3, which calef ruled on
# 2026-09-26 (UTC) is a report and not a gate (§190). The arithmetic and its selftest are
# helpers/baseline_drift.py. Three outputs: two cells per architecture in
# `baseline-drift.csv` (the largest upward drift, and rows past half the tripwire), one generated
# line on the page between DRIFT_BEGIN and DRIFT_END, and the whole report, every row and every
# save's `# why:` lines, regenerated as the appendix DRIFT_REPORT. The line and the appendix read
# HEAD, like the table of contents; the CSV restates each week from its own revision.
DRIFT_BEGIN = '<!-- baseline-drift: script/metrics writes this -->'
DRIFT_END = '<!-- /baseline-drift -->'
DRIFT_REPORT = DATA_DIR / 'baseline-drift.md'


# Milestone 610's generated line, the headline calef asked for, between these two markers. Four
# weeks because one week is noise at this rate (2026W37 read 6 and 2026W38 read 47) and a month is
# what a consumer of the interface would plan around.
INTERFACE_BEGIN = '<!-- interface-stability: script/metrics writes this -->'
INTERFACE_END = '<!-- /interface-stability -->'

def interface_line(rows):
    measured = [w for w in sorted(rows) if rows[w].get('interface_breaking', '') not in ('', None)]
    if not measured:
        return None
    recent = measured[-4:]

    def total(field):
        return sum(int(rows[w].get(field) or 0) for w in recent)

    commits = total('interface_contract_commits')
    crossing = total('interface_contract_commits_crossing')
    share = '; %d%% co-change' % round(100.0 * crossing / commits) if commits else ''
    unmeasured = max(int(rows[w].get('interface_crates_unmeasured') or 0) for w in recent)
    gap = '; %d crates unread' % unmeasured if unmeasured else ''
    # Short on purpose: the page is a deck with a 3,000-word budget and 7 words of headroom when
    # this panel arrived. Every column is in the CSV and the appendix.
    return ('interface, %s to %s: %d breaking changes (%d additions); %d syscall numbers changed, '
            '%d format bumps%s%s.'
            % (recent[0], recent[-1], total('interface_breaking'), total('interface_additions'),
               total('interface_syscall_changed'), total('interface_format_bumps'), share, gap))


def write_interface_line(rows):
    path = pathlib.Path(PAGE)
    text = path.read_text()
    if text.count(INTERFACE_BEGIN) != 1 or text.count(INTERFACE_END) != 1:
        raise SystemExit('metrics: %s must carry exactly one %r and one %r'
                         % (PAGE, INTERFACE_BEGIN, INTERFACE_END))
    line = interface_line(rows)
    if line is None:
        return
    before, rest = text.split(INTERFACE_BEGIN)
    _old, after = rest.split(INTERFACE_END)
    new = before + INTERFACE_BEGIN + '\n' + line + '\n' + INTERFACE_END + after
    if new != text:
        path.write_text(new)


def write_drift_report():
    """The page's generated drift line and the appendix beside it, both from HEAD."""
    reports, stamp = baseline_drift.report('HEAD')
    head = git('rev-parse', 'HEAD').decode().strip()
    week = week_of(git('show', '-s', '--format=%cI', head).decode().strip())
    path = pathlib.Path(PAGE)
    text = path.read_text()
    if text.count(DRIFT_BEGIN) != 1 or text.count(DRIFT_END) != 1:
        raise SystemExit('metrics: %s must carry exactly one %r and one %r'
                         % (PAGE, DRIFT_BEGIN, DRIFT_END))
    before, rest = text.split(DRIFT_BEGIN)
    _old, after = rest.split(DRIFT_END)
    new = (before + DRIFT_BEGIN + '\n' + baseline_drift.status(reports, week) + '\n'
           + DRIFT_END + after)
    if new != text:
        path.write_text(new)
    body = baseline_drift.render(reports, stamp)
    if not DRIFT_REPORT.exists() or DRIFT_REPORT.read_text() != body:
        DRIFT_REPORT.write_text(body)


# The ratified field and its three values, as `script/fatal-risks` gates them. calef ruled on
# 2026-09-23 and the vocabulary section of the fatal-risks summary (since 2026-09-29,
# `design/fatal-risks/README.md`) carries the argument; the enumeration
# is duplicated here rather than imported because `script/fatal-risks` is a shell wrapper around a
# heredoc with nothing importable in it, and because this reader is asked about HISTORY, where the
# words were different. A word that leaves the ratified set breaks the gate before it reaches here.
#
# **Two spellings, because the weekly row is read over history.** Until 2026-10-05 (UTC) the field was
# a bold line in the entry; calef moved it into each risk file's frontmatter that day (`experiment_status:
# RUN`, names provisional). `script/fatal-risks` refuses the bold form in the current tree, so the bold
# pattern survives here only to read old weeks, and the frontmatter pattern reads new ones. Both are
# anchors for the colour search below, not a value anyone charts: the status word is not a column.
FATAL_RISK_STATUS_BOLD = re.compile(r'^\*\*Experiment status: ([A-Z][A-Z-]*)\b', re.M)
FATAL_RISK_STATUS = re.compile(r'^experiment_status: ([A-Z][A-Z-]*)\b', re.M)

# Where a week's tree keeps the nine-entry summary, oldest spelling first. The old path is tried
# FIRST on purpose, because a tree can hold both: from the directory's mint (2026-09-23) to the move
# of the summary into it (2026-09-29, `45dfa3d77`, PR #1452), the `.md` was the nine-entry summary
# and the README a nine-line index, so reading the README first would count zero risks.
FATAL_RISKS_SUMMARY = ('design/fatal-risks.md', 'design/fatal-risks/README.md')

# The five retired status words (`Status: RUN`, and so on) head a line in weeks before the ruling;
# `_summary_colours` anchors its colour search on them. Nothing may be written in them today.
RETIRED_FATAL_RISK_STATUS = re.compile(r'^\*\*Status: ([A-Z]+)', re.M)


# The verdict colours, counted by week (the fatal-risk-colors-by-week proposal, 2026-09-29; file and
# column names provisional, that lane's). The proposal's commission said the colour reaches the
# machine through the appendices' frontmatter, one `color:` per risk beside the `risk:` number and
# an `updated:` date, and calef ruled the frontmatter holds the WORD rather than a hex: the word is
# the verdict, which is already the architect's, and the hue is a rendering choice that belongs in
# one mapping here rather than nine times in `design/`.
#
# The vocabulary is four values, not the proposal's three, because five of nine risks carry no
# verdict at all ("No verdict yet", risk 8's "no verdict"): `none` says that state outright rather
# than leaving the field absent, and it counts in none of the three columns. `MEASURED` and `AUDITED`
# stay prose qualifiers and never values here, per the proposal's own rule.
FATAL_RISK_COLOURS = ('green', 'amber', 'red')
_COLOUR_WORD = re.compile(r'\b(GREEN|AMBER|RED)\b')
# An appendix is a lowercase page that is NOT a numbered risk file. The old pattern matched both, so
# a `risk:` or `color:` key on a risk file (the nine now carry frontmatter of their own) would have
# overwritten the appendix's colour for that risk, silently, whichever file was read last.
_APPENDIX = re.compile(r'^design/fatal-risks/(?!\d+-)[a-z0-9-]+\.md$')
_FRONTMATTER = re.compile(r'\A---\n(.*?)\n---\n', re.S)
_RISK_FILE = re.compile(r'^design/fatal-risks/(\d+)-[a-z0-9-]+\.md$')


def _summary_colours(text):
    """{risk number: colour word or None} read out of a summary's status-line prose.

    The parse the proposal specified: the FIRST capitalized colour word after each entry's status
    marker. Capitalization is the discriminator, because risk 2's line says "AMBER. The red half is
    that..." and the lowercase `red` names half a finding rather than the verdict. Prose is not
    data, which is the whole argument for moving the present tense into frontmatter; this reader
    exists for the weeks before that happened, and for checking the weeks after.
    """
    out = {}
    parts = re.split(r'^## (\d+)\.', text, flags=re.M)
    for i in range(1, len(parts), 2):
        risk = int(parts[i])
        body = parts[i + 1]
        m = (FATAL_RISK_STATUS.search(body) or FATAL_RISK_STATUS_BOLD.search(body)
             or RETIRED_FATAL_RISK_STATUS.search(body))
        word = _COLOUR_WORD.search(body, m.end()) if m else None
        out[risk] = word.group(1).lower() if word else None
    return out


def _risk_as_section(text):
    """A risk file as a `## N.` section, its frontmatter moved from above the heading to just below
    it. Left where it is, one risk's `experiment_status:` line would land at the tail of the risk
    before it and anchor the wrong colour search."""
    block = _FRONTMATTER.match(text)
    head, rest = ('', text) if not block else (block.group(0), text[block.end():])
    return re.sub(r'(?m)^# (\d+)\. (.*)\n', lambda m: '## %s. %s\n%s' % (m.group(1), m.group(2), head),
                  rest, count=1)


def fatal_risks_colors(tree):
    """The same nine risks, by verdict colour: green, amber or red per week.

    **Two sources, one vocabulary.** A tree from this milestone on carries the colour in each
    appendix's frontmatter, and the weekly row counts those words. An older tree is read through
    `_summary_colours`, the status-line walk, so the backfill reads one parse
    rather than deriving a second one.

    **Where both sources exist they must agree, and a disagreement fails the run** naming the risk.
    The frontmatter exists to be the machine-read surface of a verdict the README states in prose;
    if the two drifted, the chart would be counting an edit nobody made to the record of record.
    `script/fatal-risks` gates the README and the nine risk files, never an appendix (its own BUGS), so this
    cross-check is the only thing that holds the new field to the old one, and it runs wherever the
    row is computed rather than only in a gate nobody has to run.

    `none` (no verdict rendered) and a risk missing from the file both count in no colour column;
    the chart's grey band is `fatal_risks_total` minus the three. **`fatal_risks_total` is every
    risk in that week's summary, not the sum of the three.** It is stored beside them so the chart
    reads one file; it was kept in `fatal-risks.csv` until 2026-10-03 UTC.
    """
    from_frontmatter = {}
    for path, text in tree.text.items():
        if not _APPENDIX.match(path):
            continue
        block = _FRONTMATTER.match(text)
        if not block:
            continue
        fields = dict(line.split(':', 1) for line in block.group(1).split('\n') if ':' in line)
        if 'risk' in fields and 'color' in fields:
            colour = fields['color'].strip()
            if colour not in FATAL_RISK_COLOURS + ('none',):
                raise SystemExit('metrics: %s says color: %s, which is not one of %s (plus none)'
                                 % (path, colour, ', '.join(FATAL_RISK_COLOURS)))
            from_frontmatter[int(fields['risk'])] = colour

    summary = next((tree.text.get(p) for p in FATAL_RISKS_SUMMARY if tree.text.get(p)), None)
    # From 2026-10-05 UTC each risk is its own file (`N-slug.md`, provisional names) and the README
    # holds no `## N.` entry. Join them, in numeric order, under the heading the walks below expect,
    # so a week before the split and a week after it read through one parse.
    split = sorted((p for p in tree.text if _RISK_FILE.match(p)),
                   key=lambda p: int(_RISK_FILE.match(p).group(1)))
    if split:
        summary = (summary or '') + '\n'.join(_risk_as_section(tree.text[p]) for p in split)
    prose = _summary_colours(summary) if summary else {}
    if from_frontmatter:
        for risk in sorted(from_frontmatter):
            # A status line with no colour word reads as None, and `none` is the frontmatter's
            # spelling of that same state, so the two compare equal rather than failing every risk
            # without a verdict.
            if risk in prose and from_frontmatter[risk] != (prose[risk] or 'none'):
                raise SystemExit('metrics: risk %d\'s appendix frontmatter says %s and the '
                                 'summary\'s status line says %s; the frontmatter is the '
                                 'machine-read surface of that line, so one of them is wrong'
                                 % (risk, from_frontmatter[risk], prose[risk] or 'no colour'))
        colours = from_frontmatter
    else:
        colours = prose
    counts = dict.fromkeys(('fatal_risks_' + c for c in FATAL_RISK_COLOURS), 0)
    counts['fatal_risks_total'] = len(re.findall(r'^## \d+\.', summary or '', flags=re.M))
    for colour in colours.values():
        if colour in FATAL_RISK_COLOURS:
            counts['fatal_risks_' + colour] += 1
    return counts


def coverage_from_lcov(path):
    """Aggregate line coverage from an lcov file, as a percentage to one decimal.

    LF and LH are lines-found and lines-hit per file, which is the same pair `script/coverage`'s
    per-file floor reads. This is the aggregate rather than the floor: the floor's job is to make
    one bad file loud, and a trend wants the whole.

    **The minimum is deliberately not computed here**, though the numbers to do it are in this same
    file. It would be a different minimum: `script/coverage` exempts files that cannot execute a
    line on the host, and the lowest file in an unfiltered lcov is one of those, so the answer would
    be a number no build can ever fail on. `coverage_min_from_summary` below reads the gate's own.
    """
    found = hit = 0
    for line in pathlib.Path(path).read_text(errors='replace').split('\n'):
        if line.startswith('LF:'):
            found += int(line[3:])
        elif line.startswith('LH:'):
            hit += int(line[3:])
    if not found:
        raise SystemExit('metrics: %s records no lines; is it an lcov file?' % path)
    return '%.1f' % (100.0 * hit / found)


def coverage_min_from_summary(path):
    """The minimum per-file line coverage, read from what `script/coverage` wrote.

    Plain `key value` lines. Only `min_file_pct` is plotted; the rest of the file (which file, how
    many were gated, how many a floor of 85 or 90 would newly fail) is there for a person deciding
    whether to raise the floor, and is not a series.
    """
    for line in pathlib.Path(path).read_text(errors='replace').split('\n'):
        if line.startswith('min_file_pct '):
            return '%.1f' % float(line.split()[1])
    raise SystemExit('metrics: %s records no min_file_pct; is it script/coverage floor summary?'
                     % path)


def row_for(rev, week, coverage='', person_weeks='', coverage_min=''):
    tree = Tree(rev)
    when = git('show', '-s', '--format=%cI', rev).decode().strip()
    row = {'week': week, 'commit': rev[:12], 'date': when[:10],
           'coverage_lines_pct': coverage,
           'coverage_min_file_pct': coverage_min,
           'human_person_weeks': person_weeks or DEFAULT_PERSON_WEEKS}
    ms = milestones(tree)
    for status in MILESTONE_STATUSES:
        row[_col('milestones', status)] = ms[status]
    row['milestones_total'] = sum(ms.values())
    dec = decisions(tree)
    for status in DECISION_STATUSES:
        row[_col('decisions', status)] = dec[status]
    row['decisions_total'] = sum(dec.values())
    nm, owed, named = names(tree)
    for status in NAME_STATUSES:
        row[_col('names', status)] = nm[status]
    row['names_ruled_owed'] = owed
    row['names_total'] = named
    for part in (proposals(tree), lines(tree), bugs(tree),
                 harnesses(tree),
                 unsafe_census(tree), unsafe_trust_census(tree),
                 fatal_risks_colors(tree), coe_action_counts(tree),
                 writing_standards(tree), comment_block_debt(tree), line_citation_debt(tree),
                 homes(tree), crate_release_cells(tree)):
        row.update(part)
    row.update(baseline_drift.series_cells(rev))
    return row


# ---------------------------------------------------------------------------------------------
# Weeks, and which commit stands for one.

def week_of(iso_datetime):
    when = datetime.fromisoformat(iso_datetime).astimezone(timezone.utc)
    year, week, _day = when.isocalendar()
    return '%04dW%02d' % (year, week)


def week_of_date(stamp):
    """The ISO week of a bare `YYYY-MM-DD`, with no timezone arithmetic.

    `week_of` above takes a git timestamp and converts it to UTC, which is right for a commit. A
    date written into the roadmap is already UTC (`AGENTS.md`, every date in this tree is UTC), and
    running it through a local-time conversion would move a Monday's milestone into the previous
    week on this machine and not on CI.
    """
    year, week, _day = date.fromisoformat(stamp).isocalendar()
    return '%04dW%02d' % (year, week)


def week_commits():
    """{ISO week: the first-parent commit that stands for it}, oldest first.

    The greatest committer date inside the week, on the first-parent trunk. First-parent because
    that is the tree a reader means by "on that date"; committer date because a merge's author date
    can be days old, which would file a merge under the week its branch was cut.
    """
    out = {}
    log = git('log', '--first-parent', '--format=%H %cI', 'HEAD').decode().split('\n')
    for entry in log:
        if not entry.strip():
            continue
        sha, when = entry.split()
        out.setdefault(week_of(when), sha)   # log is newest-first, so the first seen is the latest
    return dict(sorted(out.items()))


def update_targets(weeks, rows, current, head):
    """`[(week, rev)]` that `--update` recomputes: the current week at HEAD, and every other week
    whose row is not already at the commit `week_commits` names for it.

    A closed week's row is written while that week is the current one, so it records the commit
    the last run before the week ended saw. The daily workflow runs at 06:00 UTC and lanes merge
    until midnight, so that commit is hours short of the week's last one, and whatever merged after
    it would otherwise draw as a change in the following week. Keying on the recorded commit closes
    the week on the first run after it ends, whatever hour that run fires. A week with no row has
    no commit, so it lands here too: a missed or raced run heals on the next one, and `--check`
    fails on either state rather than passing it.
    """
    stale = [w for w in weeks
             if w != current and rows.get(w, {}).get('commit', '') != weeks[w][:12]]
    return [(w, weeks[w]) for w in stale] + [(current, weeks.get(current, head))]


def read_csv():
    """Every measure file merged into one row per week: `{week: {column: cell}}`.

    The join is on `WEEK` alone, which is why every file spells and formats it identically. A week
    a measure has no row for contributes no keys, so the cell comes back absent rather than empty,
    and `_cell` and `row.get` already treat those the same. That is what lets a series start at the
    week it was first measured instead of carrying blanks back to 2026W29.

    A column is read only from the file `MEASURES` assigns it to. A stray column left in another
    file by a hand edit or a half-finished rename is ignored rather than silently winning, and the
    next `--update` drops it.
    """
    rows = {}
    for name, columns in MEASURES:
        path = measure_path(name)
        if not path.exists():
            continue
        text = path.read_text().strip().split('\n')
        header = text[0].split(',')
        for line in text[1:]:
            if not line.strip():
                continue
            cells = dict(zip(header, line.split(',')))
            week = cells.get(WEEK)
            if not week:
                continue
            row = rows.setdefault(week, {WEEK: week})
            for column in columns:
                if column in cells:
                    row[column] = cells[column]
    return rows


def render_csvs(rows):
    """`{path: text}` for every measure, sorted, fixed columns, fixed formatting.

    Never appended to. This is the whole of the idempotence guarantee: the week being written
    replaces its own entry rather than adding one, so running twice in a week produces the same
    bytes, and so does running the backfill against a history that has not moved.

    A week with nothing to say is omitted rather than written blank, and that is the point of the
    split rather than a tidiness. A measure introduced in 2026W39 used to leave ten empty cells
    behind it in a wide file, and an empty cell is ambiguous between "measured zero" and "nobody
    looked"; the charts needed an `absent` flag per column to tell a reader which. An absent row
    says only the true thing. A week the measure answered for partially still gets its row, with
    the cell it could not fill left empty, because there the ambiguity is real and local.
    """
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    out = {}
    for name, columns in MEASURES:
        lines_out = [','.join([WEEK] + columns)]
        for week in sorted(rows):
            row = rows[week]
            cells = [str(row.get(column, '')) for column in columns]
            if not any(cells):
                continue
            lines_out.append(','.join([week] + cells))
        out[measure_path(name)] = '\n'.join(lines_out) + '\n'
    return out


def write_csvs(rendered):
    for path, text in rendered.items():
        path.write_text(text)


# ---------------------------------------------------------------------------------------------
# The charts.
#
# GitHub will not render an interactive chart, and it will not run a script in a markdown page, so
# a committed SVG is the only thing a reader actually sees. Written by hand rather than by a
# plotting crate: DECISIONS §46 (thin primitives or whole subsystems, and we write everything in
# between) makes taking one a decision, and a stacked bar is arithmetic and
# string formatting. The side benefit is that a diff can review one, which a binary PNG refuses.
#
# Colours are one categorical order with a LIGHT and a DARK step per hue, chosen for each surface
# rather than one set of hexes asked to serve both. Validated on 2026-09-19 with the dataviz
# skill's six-check validator against GitHub's own surfaces (#ffffff, #0d1117): every check passes
# in both modes, worst adjacent colour-blind separation 9.1 light and 8.4 dark (OKLab x100, target
# 8). This replaced Okabe-Ito, whose reputation is colour-blind separation and not contrast: its
# yellow read at 1.32:1 on white, which made the milestones chart's "Removed" band nearly
# invisible, and its gray failed the chroma floor. Three light steps still sit under 3:1 on white,
# which is legal only with relief, and each chart carries three kinds: the legend, a <title> on
# every segment, and the measure files as the table view. Slots are in this fixed order and never
# cycled. The eighth slot was added on 2026-09-19 for the milestones chart's proposals, appended
# rather than inserted so that no existing series changed colour, and all eight were validated
# again in both modes before it shipped. A ninth series is never a new hue; it folds into another.

PALETTE_LIGHT = ['#2a78d6', '#eb6834', '#1baf7a', '#eda100', '#e87ba4', '#008300', '#4a3aa7',
                 '#5a6b7d']
PALETTE_DARK = ['#3987e5', '#d95926', '#199e70', '#c98500', '#d55181', '#008300', '#9085e9',
                '#94a5b7']

# The one chart that takes no slot: the fatal-risks colours chart, whose series are colours and so
# name their own hues rather than cycling the categorical order. Green, amber and red reuse slots 3,
# 4 and 8 rather than minting hexes, so every hue on that chart has already passed the validation
# above on both surfaces; grey is GitHub's own neutral, for the band that is the absence of a
# verdict. One (light, dark) pair per series, in stack order, with the grey last. Provisional and
# calef's to change, which the frontmatter-holds-the-word ruling keeps to one edit here rather than
# nine edits under `design/fatal-risks/`.
RISK_COLOUR_HUES = [('#1baf7a', '#199e70'),   # green
                    ('#eda100', '#c98500'),   # amber
                    ('#e34948', '#e66767'),   # red
                    ('#6e7781', '#8c959f')]   # unclassified

CHART_W, CHART_H = 860, 380
# The charts show the most recent CHART_WEEKS weeks; the measure files keep every week, and a
# still restates all of them. calef, 2026-09-19: ten weeks, so W29 leaves the charts when W39
# arrives. Old weeks are not deleted, only no longer drawn, because the CSV is the table view
# the charts' relief rule leans on and a table that forgets is not one.
CHART_WEEKS = 10
PAD_L, PAD_R, PAD_T, PAD_B = 64, 210, 58, 56
LEGEND_WRAP = 22   # characters per legend line before a label wraps to a second


def esc(text):
    return (text.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;'))


def _wrap(text, width):
    """Split a legend label on word boundaries into lines of at most `width` characters.

    The legend column clipped six labels on 2026-09-19 because the width a label needs depends on
    whichever font the viewer's machine substitutes, and the arithmetic had assumed a narrow one.
    Wrapping is robust to that; a guess at glyph widths is not.
    """
    lines, line = [], ''
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            lines.append(line)
            line = word
        else:
            line = word if not line else line + ' ' + word
    return lines + ([line] if line else [])


def week_label(week):
    """The key is the label. `2026W36` on the axis, in the CSV, and in the prose.

    calef ratified one spelling on 2026-09-02, after the page carried three: `2026-W30` in the
    narrative, `202636` on an axis, `2026-W29` in the data. This function exists so that if a
    future spelling is wanted there is exactly one place to change it, and so the axis cannot
    drift from the key it is derived from.
    """
    return week


def svg_chart(title, subtitle, weeks, series, path, ceiling=None, absent=None, trend=None,
              grouped=False, lines=None, note=''):
    """One stacked bar per week, one colour per series, a legend on the right.

    `series` is [(label, [value per week], hue)]. `hue` is None for the charts that take a palette
    slot, or a (light, dark) pair for a chart whose series name their own hue, which is the
    fatal-risks colours chart alone: green must be green there, not slot 0. A single-element series
    is an ordinary bar chart, which is what the density and coverage panels are. `ceiling` is a
    number, labelled `ceiling`, or a (number, word) pair when the dashed line is something else:
    coverage's is `script/coverage`'s per-file floor, and labelling a floor a ceiling says the
    opposite. A list in place of the number is a ceiling per week (None where there was none),
    drawn as a step across each week's slot, for a ceiling that moves; the legend gives the newest.

    `absent` is a per-week flag for **a week that was not measured, as against a week that measured
    zero**. Both draw no bar, and a reader cannot tell them apart, which for milestone 519's cost
    columns is the difference between an honest gap and a lie that gets averaged into a published
    figure. A flagged week gets a muted marker in the plot and a `<title>` saying so. Coverage's
    2026W29 is the same shape and settled for a sentence in its subtitle; this makes it visible on
    the chart, where the reader is.

    `trend` is a line over the bars, (label, short label, [(value, full) per week]), from
    `trailing_mean`. It is drawn in the page's text colour rather than a palette slot, because the
    palette is for series and this is arithmetic over one of them; a full window is a solid line and
    a short one is dashed, each with its own legend entry, so the two are never read as the same.
    A point whose value is None is a week with nothing to draw, and the line breaks there.

    `grouped` draws each week's series side by side instead of stacked, for series that are
    alternatives rather than parts (the build chart's jobs). The axis is then scaled to the
    tallest bar, and each line point carries its value in place of a bar total.

    `lines` is [(label, [value or None per week])], stored columns drawn over the bars in the
    text color: the first solid with filled points, the second dotted with open ones, so neither
    reads as a trailing mean's solid or dashed line. Each point carries its value above it.
    `note` is one line of small text under the week labels.
    """
    line_word = 'ceiling'
    if isinstance(ceiling, tuple):
        ceiling, line_word = ceiling
    moving = isinstance(ceiling, list)
    steps = ceiling if moving else [ceiling]
    if moving:
        ceiling = next((v for v in reversed(steps) if v is not None), None)
    combine = max if grouped else sum
    totals = [combine(s[1][i] for s in series) for i in range(len(weeks))]
    top = max(totals + [v for v in steps if v] + [1]
              + ([v for v, _full in trend[2] if v is not None] if trend else [])
              + [v for _l, vals in (lines or []) for v in vals if v is not None])
    # An axis a person reads: gridlines at 1, 2, 2.5 or 5 times a power of ten, and whichever of
    # four, five or six intervals wastes the least height. Four alone rounds 231 up to 400.
    axis_top, ticks = None, 4
    for count in (4, 5, 6):
        raw = top / count
        magnitude = 10.0 ** math.floor(math.log10(raw)) if raw > 0 else 1.0
        for factor in (1, 2, 2.5, 5, 10):
            if magnitude * factor >= raw:
                candidate = magnitude * factor * count
                break
        if axis_top is None or candidate < axis_top:
            axis_top, ticks = candidate, count
    plot_w = CHART_W - PAD_L - PAD_R
    plot_h = CHART_H - PAD_T - PAD_B
    slot = plot_w / max(len(weeks), 1)
    bar_w = min(slot * 0.66, 54)

    def y_of(value):
        return PAD_T + plot_h - plot_h * value / axis_top

    out = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
           'viewBox="0 0 %d %d" role="img" aria-label="%s">'
           % (CHART_W, CHART_H, CHART_W, CHART_H, esc(title)),
           '<style>',
           '  .bg{fill:#ffffff} .fg{fill:#1f2328} .mut{fill:#59636e} .grid{stroke:#d1d9e0}',
           '  .seg{stroke:#ffffff;stroke-width:1}'
           + (' .tr{stroke:#1f2328;fill:none} .trd{fill:#1f2328}' if trend or lines else '')
           + (' .trh{fill:#ffffff;stroke:#1f2328}' if lines else ''),
           # A halo in the surface colour behind each value label, so a total that lands on the
           # dashed ceiling stays legible.
           '  .val{paint-order:stroke;stroke:#ffffff;stroke-width:3px;stroke-linejoin:round}',
           # A series with a hue of its own gets a .c class; the rest take palette slots by
           # position, as before. Both are emitted per final series, after series_of has dropped
           # the all-zero ones, so a hue can never slide onto another series by that drop.
           ''.join('  .c%d{fill:%s}' % (j, h[0]) if h else '  .s%d{fill:%s}' % (j, PALETTE_LIGHT[j])
                   for j, (_l, _v, h) in enumerate(series)),
           '  @media (prefers-color-scheme: dark){',
           '    .bg{fill:#0d1117} .fg{fill:#e6edf3} .mut{fill:#9198a1} .grid{stroke:#30363d}',
           '    .seg{stroke:#0d1117} .val{stroke:#0d1117}'
           + (' .tr{stroke:#e6edf3} .trd{fill:#e6edf3}' if trend or lines else '')
           + (' .trh{fill:#0d1117;stroke:#e6edf3}' if lines else '')
           + ''.join(' .c%d{fill:%s}' % (j, h[1]) if h else ' .s%d{fill:%s}' % (j, PALETTE_DARK[j])
                     for j, (_l, _v, h) in enumerate(series)) + '}',
           '  text{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,'
           'sans-serif}',
           '</style>',
           '<rect class="bg" width="%d" height="%d"/>' % (CHART_W, CHART_H),
           '<text class="fg" x="%d" y="26" font-size="16" font-weight="600">%s</text>'
           % (PAD_L - 44, esc(title)),
           '<text class="mut" x="%d" y="44" font-size="11">%s</text>'
           % (PAD_L - 44, esc(subtitle))]

    for tick in range(ticks + 1):
        value = axis_top * tick / ticks
        y = y_of(value)
        out.append('<line class="grid" x1="%d" y1="%.1f" x2="%.1f" y2="%.1f" '
                   'stroke-width="1"/>' % (PAD_L, y, PAD_L + plot_w, y))
        label = '%g' % value if value == int(value) else '%.1f' % value
        out.append('<text class="mut" x="%d" y="%.1f" font-size="10" text-anchor="end">%s</text>'
                   % (PAD_L - 8, y + 3, label))

    # The ceiling is drawn BEFORE the bars and their value labels, so a total landing on it
    # sits on top of the line rather than under it. It used to be drawn last and struck
    # through the unsafe chart's 77s, three of them, sitting just under its 88.
    # A ceiling per week is one path per run of weeks that had one.
    run = []
    for i, value in enumerate((steps if moving else []) + [None]):
        if value:
            y = y_of(value)
            run.append(('V%.1f' % y if run else 'M%.1f,%.1f' % (PAD_L + slot * i, y))
                       + ' H%.1f' % (PAD_L + slot * (i + 1)))
        elif run:
            out.append('<path d="%s" fill="none" stroke="#D55E00" stroke-width="1.5" '
                       'stroke-dasharray="5 4"/>' % ' '.join(run))
            run = []
    if ceiling and not moving:
        y = y_of(ceiling)
        out.append('<line x1="%d" y1="%.1f" x2="%.1f" y2="%.1f" stroke="#D55E00" '
                   'stroke-width="1.5" stroke-dasharray="5 4"/>'
                   % (PAD_L, y, PAD_L + plot_w, y))
        # Labeled in the legend, below the series. Until 2026-10-11 (UTC) the label sat at the
        # line's height in the legend's column, and struck through ci-jobs.svg's fourth entry once
        # backfilled weeks brought that axis to 30 and the 20 line level with it. Inside the plot
        # it collides with bars and value labels on four other charts.

    def _fill(j):
        return 'c%d' % j if series[j][2] else 's%d' % j

    for i, week in enumerate(weeks):
        x = PAD_L + slot * i + (slot - bar_w) / 2
        base = 0.0
        top_j = max((j for j, (_l, v, _h) in enumerate(series) if v[i]), default=None)
        for j, (label, values, _hue) in enumerate(series):
            value = values[i]
            if not value:
                continue
            height = plot_h * value / axis_top
            if grouped:
                # Side by side: each series its own narrower bar, each rounded, none stacked.
                sub = bar_w / len(series)
                gx = x + sub * j
                gy = y_of(value)
                tip = '<title>%s, %s: %s</title>' % (esc(week_label(week)), esc(label), _number(value))
                r = min(3.0, height / 2, (sub - 1) / 2)
                d = ('M%.1f,%.1f V%.1f Q%.1f,%.1f %.1f,%.1f H%.1f Q%.1f,%.1f %.1f,%.1f V%.1f Z'
                     % (gx, gy + height, gy + r, gx, gy, gx + r, gy, gx + sub - 1 - r,
                        gx + sub - 1, gy, gx + sub - 1, gy + r, gy + height))
                out.append('<path class="seg %s" d="%s">%s</path>' % (_fill(j), d, tip))
                continue
            y = y_of(base + value)
            # Every segment is stroked in the surface colour, which leaves a 2px gap between
            # neighbours so a stack reads as parts even where two fills are close in lightness.
            # Only the top of the whole bar is rounded: rounding every segment would make a
            # stack look like beads.
            tip = '<title>%s, %s: %s</title>' % (esc(week_label(week)), esc(label), _number(value))
            r = min(4.0, height / 2, bar_w / 2) if j == top_j else 0.0
            if r:
                d = ('M%.1f,%.1f V%.1f Q%.1f,%.1f %.1f,%.1f H%.1f Q%.1f,%.1f %.1f,%.1f V%.1f Z'
                     % (x, y + height, y + r, x, y, x + r, y, x + bar_w - r,
                        x + bar_w, y, x + bar_w, y + r, y + height))
                out.append('<path class="seg %s" d="%s">%s</path>' % (_fill(j), d, tip))
            else:
                out.append('<rect class="seg %s" x="%.1f" y="%.1f" width="%.1f" height="%.1f">'
                           '%s</rect>' % (_fill(j), x, y, bar_w, height, tip))
            base += value
        out.append('<text class="mut" x="%.1f" y="%d" font-size="10" text-anchor="middle">%s</text>'
                   % (x + bar_w / 2, PAD_T + plot_h + 18, esc(week_label(week))))
        if totals[i] and not grouped:
            out.append('<text class="fg val" x="%.1f" y="%.1f" font-size="10" '
                       'text-anchor="middle">%s</text>'
                       % (x + bar_w / 2, y_of(totals[i]) - 5, _number(totals[i])))
        elif absent and absent[i]:
            # Words rather than a dash at the foot of the empty slot. This is the one place on
            # this page where a reader is entitled to read "nothing here" as "nobody measured"
            # rather than "zero", so it says which, and it says it in the chart rather than only in
            # the tooltip, because a tooltip does not exist on a phone or in a screenshot.
            out.append('<text class="mut" x="%.1f" y="%.1f" font-size="9" '
                       'text-anchor="middle">not<tspan x="%.1f" dy="10">measured</tspan>'
                       '<title>%s: not measured</title></text>'
                       % (x + bar_w / 2, PAD_T + plot_h - 16, x + bar_w / 2,
                          esc(week_label(week))))

    if trend:
        label, short, points = trend
        center = [PAD_L + slot * i + slot / 2 for i in range(len(weeks))]
        for i in range(1, len(points)):
            if points[i - 1][0] is None or points[i][0] is None:
                continue
            dash = '' if points[i][1] else ' stroke-dasharray="4 3"'
            out.append('<line class="tr" x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" '
                       'stroke-width="2"%s/>' % (center[i - 1], y_of(points[i - 1][0]),
                                                 center[i], y_of(points[i][0]), dash))
        for i, (value, full) in enumerate(points):
            if value is None:
                continue
            out.append('<circle class="trd" cx="%.1f" cy="%.1f" r="3"><title>%s, %s: %.1f'
                       '</title></circle>' % (center[i], y_of(value), esc(week_label(weeks[i])),
                                             esc(label if full else short), value))
            if grouped:
                out.append('<text class="fg val" x="%.1f" y="%.1f" font-size="10" '
                           'text-anchor="middle">%s</text>' % (center[i], y_of(value) - 7,
                                                               _number(value)))

    dotted = ' stroke-dasharray="0.1 4" stroke-linecap="round"'
    for k, (label, values) in enumerate(lines or []):
        center = [PAD_L + slot * i + slot / 2 for i in range(len(weeks))]
        for i in range(1, len(values)):
            if values[i - 1] is None or values[i] is None:
                continue
            out.append('<line class="tr" x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" stroke-width="2"%s/>'
                       % (center[i - 1], y_of(values[i - 1]), center[i], y_of(values[i]),
                          dotted if k else ''))
        for i, value in enumerate(values):
            if value is None:
                continue
            out.append('<circle class="%s" cx="%.1f" cy="%.1f" r="3"%s><title>%s, %s: %s</title>'
                       '</circle>' % ('trh' if k else 'trd', center[i], y_of(value),
                                      ' stroke-width="1.5"' if k else '', esc(week_label(weeks[i])),
                                      esc(label), _number(value)))
            out.append('<text class="fg val" x="%.1f" y="%.1f" font-size="10" text-anchor="middle">'
                       '%s</text>' % (center[i], y_of(value) - 7, _number(value)))
    if note:
        out.append('<text class="mut" x="%d" y="%d" font-size="10">%s</text>'
                   % (PAD_L - 44, CHART_H - 12, esc(note)))

    legend_x = CHART_W - PAD_R + 22
    y = PAD_T + 6
    for k, (text, _values) in enumerate(lines or []):
        out.append('<line class="tr" x1="%d" y1="%d" x2="%d" y2="%d" stroke-width="2"%s/>'
                   % (legend_x, y + 5, legend_x + 11, y + 5, dotted if k else ''))
        out.append('<circle class="%s" cx="%.1f" cy="%d" r="3"%s/>'
                   % ('trh' if k else 'trd', legend_x + 5.5, y + 5, ' stroke-width="1.5"' if k else ''))
        wrapped = _wrap(text, LEGEND_WRAP)
        out.append('<text class="fg" y="%d" font-size="11">%s</text>'
                   % (y + 10, ''.join('<tspan x="%d" dy="%s">%s</tspan>'
                                      % (legend_x + 17, '0' if n == 0 else '13', esc(line))
                                      for n, line in enumerate(wrapped))))
        y += 19 + 13 * (len(wrapped) - 1)
    if trend:
        kinds = [(trend[0], True)] if any(f for _v, f in trend[2]) else []
        if not all(f for _v, f in trend[2]):
            kinds.append((trend[1], False))
        for text, full in kinds:
            out.append('<line class="tr" x1="%d" y1="%d" x2="%d" y2="%d" stroke-width="2"%s/>'
                       % (legend_x, y + 5, legend_x + 11, y + 5,
                          '' if full else ' stroke-dasharray="4 3"'))
            lines = _wrap(text, LEGEND_WRAP)
            spans = ''.join('<tspan x="%d" dy="%s">%s</tspan>'
                            % (legend_x + 17, '0' if k == 0 else '13', esc(line))
                            for k, line in enumerate(lines))
            out.append('<text class="fg" y="%d" font-size="11">%s</text>' % (y + 10, spans))
            y += 19 + 13 * (len(lines) - 1)
    for j, (label, _values, _hue) in enumerate(series):
        out.append('<rect class="%s" x="%d" y="%d" width="11" height="11" rx="2"/>'
                   % (_fill(j), legend_x, y))
        lines = _wrap(label, LEGEND_WRAP)
        spans = ''.join('<tspan x="%d" dy="%s">%s</tspan>'
                        % (legend_x + 17, '0' if k == 0 else '13', esc(line))
                        for k, line in enumerate(lines))
        out.append('<text class="fg" y="%d" font-size="11">%s</text>' % (y + 10, spans))
        y += 19 + 13 * (len(lines) - 1)
    if ceiling:
        out.append('<line x1="%d" y1="%d" x2="%d" y2="%d" stroke="#D55E00" stroke-width="1.5" '
                   'stroke-dasharray="5 4"/>' % (legend_x, y + 5, legend_x + 11, y + 5))
        out.append('<text class="fg" x="%d" y="%d" font-size="11">%s %s</text>'
                   % (legend_x + 17, y + 10, esc(line_word), _number(ceiling)))
    out.append('</svg>')
    path.write_text('\n'.join(out) + '\n')


def _number(value):
    value = float(value)
    return '%d' % value if value == int(value) else '%.1f' % value


def _cell(row, field):
    raw = row.get(field, '')
    return float(raw) if raw not in ('', None) else 0.0


# One band on this page is arithmetic over columns rather than a column of its own. The naming
# chart's "no provenance block" is `names_total` minus the four statuses, and it is deliberately not
# in the CSV: it is not a status a `Name:` block can carry, and a fifth column would put a fifth
# word in a four-word vocabulary that `script/names` gates on. Drawn rather than stored, because the
# three weeks before milestone 115 invented the convention would otherwise be three empty bars,
# which this page's own rule reads as "the record did not exist" and would leave the reader with no
# idea that the tree already had 119 named things in it.
def _tokens_per_milestone(row):
    """Millions of tokens per milestone built that week, or zero when either side is missing.

    **A ratio rather than a total, which is milestone 519's own requirement**: a total says the
    project was busy, and a ratio says whether the method is getting cheaper, which is the claim the
    project actually makes. Zero is returned for a week with no capture and for a week that built
    nothing, and the chart's `absent` flag is what tells those two apart for the reader.

    The denominator is the milestone count, with every caveat that series already carries: a
    milestone is not a fixed unit, and a week of bookkeeping moves the ratio without anything
    getting cheaper or dearer. Read the shape.
    """
    built = _cell(row, 'milestones_built_this_week')
    tokens = _cell(row, 'lane_tokens')
    if not built or not tokens:
        return 0.0
    return tokens / 1_000_000.0 / built


DERIVED = {
    # The colours chart's grey band, over the stored `fatal_risks_total` (in the same
    # file as the three colours): a risk with no verdict rendered, or a week whose colours the status-line backfill could not read, draws
    # rather than vanishes, so a bar of four reads as four of nine and not as nine.
    'fatal_risks_colors_unclassified': lambda row: max(
        0.0, _cell(row, 'fatal_risks_total') - sum(_cell(row, 'fatal_risks_' + c)
                                                   for c in ('green', 'amber', 'red'))),
    'names_no_block': lambda row: max(
        0.0, _cell(row, 'names_total') - sum(_cell(row, _col('names', s)) for s in NAME_STATUSES)),
    # The provisional band without the ruled-and-owed names, which the chart draws beside it.
    'names_provisional_unruled': lambda row: max(
        0.0, _cell(row, 'names_provisional') - _cell(row, 'names_ruled_owed')),
    'tokens_per_milestone': _tokens_per_milestone,
    # Three statuses in one band, because the milestones chart already fills the palette's eight
    # slots. Not "unbuilt": a REMOVED milestone was built first. The CSV keeps the three apart.
    'milestones_closed': lambda row: sum(_cell(row, _col('milestones', s))
                                         for s in ('REMOVED', 'SUPERSEDED', 'REFUSED')),
}


# The column, or columns summed, that each stacked chart's bands must add up to. A chart whose
# measure has a total and is not listed here can drop a band without anything noticing.
CHART_TOTALS = {
    'milestones.svg': ('milestones_total', 'proposals_unnumbered'),
    'decisions.svg': ('decisions_total',),
    'names.svg': ('names_total',),
    'harnesses.svg': ('harnesses_total',),
    'fatal-risks-colors.svg': ('fatal_risks_total',),
    'models-commits.svg': ('model_commits_total',),
    'homes-packages.svg': ('packages_total',),
    'crate-proofs.svg': ('crate_properties_required',),
}


def check_chart_totals(rows, week):
    """Fail when a chart in CHART_TOTALS draws `week` as anything but its total.

    A week whose total cell is blank was not measured and is skipped, not failed.
    """
    columns = {entry[0]: entry[3] for entry in CHARTS}
    wrong = []
    for name, totals in CHART_TOTALS.items():
        row = rows[week]
        if any(row.get(field, '') in ('', None) for field in totals):
            continue
        want = sum(_cell(row, field) for field in totals)
        drawn = sum((DERIVED[field](row) if field in DERIVED else _cell(row, field))
                    for _label, field in columns[name])
        if drawn != want:
            wrong.append('%s draws %s for %s and %s is %s'
                         % (name, _number(drawn), week, ' + '.join(totals), _number(want)))
    if wrong:
        raise SystemExit('metrics: a chart\'s bands do not add up to its total; add the missing '
                         'band or fold it into one:\n  ' + '\n  '.join(wrong))


def series_of(rows, weeks, columns, scale=1.0, hues=None):
    """[(label, values per week, hue or None)], dropping a series that is zero every week.

    `hues`, when given, is one entry per column and travels with its own series through that drop,
    which is why the hue is decided HERE rather than re-derived in `draw_charts`: red is zero on
    every week so far, so it is dropped today, and a hue re-indexed after the drop would put grey
    where red will be the week a risk first turns red.
    """
    out = []
    for j, (label, field) in enumerate(columns):
        values = []
        for week in weeks:
            derive = DERIVED.get(field)
            raw = derive(rows[week]) if derive else _cell(rows[week], field)
            values.append(raw / scale)
        if any(values):
            out.append((label, values, hues[j] if hues else None))
    return out


# The model charts draw one labelled series per model in MODEL_SLUGS, in family order, so that a
# model which starts signing commits is named on the chart the week it appears instead of being
# folded into a grey band (calef, 2026-10-03 UTC: "What are the other models in W40? Can we label
# them?"; 302 commits of 730 sat in `other models`). The label is derived from the slug
# (`sonnet_5_5` is `Sonnet 5.5`), so only the colour needs a row here, and a slug in MODEL_SLUGS
# with no row is a SystemExit at import rather than a hidden band: the same loud-not-quiet rule as
# MODEL_TRAILERS. `other_models` stays out of this table; it is the one bucket that means "a name
# this tree has not classified", and it keeps its own band and its own warning.
#
# One hue per family, a darker and a lighter step for the versions inside it, so 10 models read as
# 5 families. Stack order is this table's order. (light, dark) pairs, chosen for each surface like
# PALETTE_LIGHT. The blue, green, amber, pink and slate reuse validated palette hexes; the rest are
# new. Checked 2026-10-03 UTC with an OKLab script, NOT the dataviz skill's six-check validator:
# every stack-adjacent pair is 11.6 or more apart (x100; the palette's own target is 8) in both
# modes, and the worst non-adjacent pairs (Opus 4.8 and GLM 5.3 Flash, about 7) are told apart by
# the legend and each segment's <title>. Several light steps sit under 3:1 on white, the same relief
# the palette comment above already relies on. The claim tan, checked the same way 2026-10-18 UTC,
# sits on top of merge, 24.8 and 19.6 from it; in a week with no merge it would touch before the
# convention at 8.7 and 7.7, which is the palette's target and no better. The shared palette has
# eight slots and this chart needs up to fifteen series, so it carries its own hues the way the fatal-risks colours chart
# does, rather than cycling or widening the eight that nine other charts depend on.
MODEL_HUES = {
    'opus_4_8':      ('#8fb8ec', '#2c5ea8'),
    'opus_5':        ('#2a78d6', '#3987e5'),
    'opus_5_5':      ('#174a94', '#7db3f5'),
    'sonnet_5':      ('#1baf7a', '#199e70'),
    'sonnet_5_5':    ('#0b6b47', '#58d0a2'),
    'fable_5':       ('#eda100', '#c98500'),
    'fable_5_1':     ('#a85f00', '#f2c75c'),
    'haiku_4_5':     ('#0e9fb3', '#2bb5c9'),
    'glm_5_3':       ('#4a3aa7', '#9085e9'),
    'glm_5_3_flash': ('#a99fe6', '#5848b8'),
}
MODEL_BAND_HUES = {
    'other models':   ('#e87ba4', '#d55181'),
    'unattributed':   ('#eb6834', '#d95926'),
    'before the convention': ('#b1bac4', '#57606a'),
    'merge (a pull request landing)': ('#5a6b7d', '#94a5b7'),
    'claim (an empty commit)': ('#c4a982', '#7a6a52'),
}


def model_label(slug):
    """`sonnet_5_5` is `Sonnet 5.5`, `glm_5_3_flash` is `GLM 5.3 Flash`."""
    words = slug.split('_')
    name = words[0].upper() if words[0] == 'glm' else words[0].capitalize()
    digits = [w for w in words[1:] if w.isdigit()]
    rest = [w.capitalize() for w in words[1:] if not w.isdigit()]
    return ' '.join([name, '.'.join(digits)] + rest)


def model_chart(kind, with_merge):
    """(columns, hues) for a model chart: every model in MODEL_SLUGS, then the buckets no model owns."""
    models = [s for s in MODEL_SLUGS if s != 'other_models']
    missing = [s for s in models if s not in MODEL_HUES]
    if missing:
        raise SystemExit('metrics: MODEL_SLUGS has %s but MODEL_HUES has no colour for it; add one '
                         'row so the model is drawn rather than hidden' % ', '.join(missing))
    models.sort(key=list(MODEL_HUES).index)
    columns = [(model_label(s), _model_col(kind, s)) for s in models]
    buckets = [('other models', 'other_models'), ('unattributed', 'unattributed'),
               ('before the convention', 'pre_convention')]
    if with_merge:
        buckets.append(('merge (a pull request landing)', 'merge'))
        buckets.append(('claim (an empty commit)', 'claim'))
    columns += [(label, _model_col(kind, s)) for label, s in buckets]
    hues = [MODEL_HUES[s] for s in models] + [MODEL_BAND_HUES[label] for label, _s in buckets]
    return columns, hues


# Each entry is (file, title, subtitle, columns, scale, ceiling, absent_field, hues). `absent_field`
# names a CSV column whose empty cell means "not measured" rather than "zero"; the chart then marks
