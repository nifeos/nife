#!/bin/sh
#
# Validate and report the milestone roadmap in design/roadmap/, which is one file per milestone and
# no index: the directory listing is the index (calef, 2026-09-21).
#
# Why this exists: milestone status used to be prose in the detail blocks, phrased a dozen different
# ways, and a status sweep on 2026-07-30 mis-reported EIGHT milestones because no two blocks said
# "done" the same way. It also missed that milestone 34 was referenced by the display ladder while
# having no table row and no block at all. Both failures are cheap to catch mechanically and expensive
# to catch by reading, which is the definition of something that belongs in a script.
#
# Why a directory instead of the old single design/roadmap.md (milestone 76): four structural defects
# landed in one day, 2026-08-03, and the single-file gate reported clean through all four, because it
# verified that a block HAS a table row and never WHERE the block sits or whether the row and the
# block agree. Eight milestone blocks were filed under an essay about seL4; milestone 69's row said
# NOT-STARTED while its block said BUILT. The split makes the filing defects impossible (the filename
# is the identity, and `cat >>` into 0074-cycle-counters.md can only add text to milestone 74 (cycle counters: SBI PMU on RISC-V, `PMCCNTR_EL0` on aarch64)). The
# check the split alone could not prevent, that the status in the index and in the milestone's own
# file agree, is gone with the index: there is one record now, so there is nothing to disagree.
#
# **There is no index file any more** (calef, 2026-09-21: *"I don't think the milestone index table
# is worth building any more. It has too many rows to be digestible as a table"*, and, asked what
# should replace it, *"Nothing at all. You'll have to read the directory for now."*). The directory
# listing and the queries below are the index. Milestone 294 (`design/roadmap/README.md`'s index is
# generated, not hand-maintained) had already made the table derived, so retiring it cost no
# content: every column came from the block and still does. What survives is `--index`, which
# renders the same five columns to stdout for `script/audits` and `script/fatal-risks`, the two
# gates that need a status and a Built date per milestone. It is a data feed for scripts now, not a
# document, and nothing writes it to a file.
#
# What is checked, and which defect each check answers:
#   - **every block opens with frontmatter**, which is its only record of its status, its dates
#     and its dependencies (milestone 596 (the roadmap blocks get frontmatter too); calef ratified
#     the schema 2026-09-26 UTC). The keys, their vocabularies and what each status requires are in
#     helpers/roadmap_block.py and notes/roadmap.md. Before 596 each was a bold line in the prose,
#     read by regex; a block still in that form fails with the `--migrate` command that converts it,
#     and a field-shaped line in a block's opening prose fails as a second copy of its key;
#   - **every block carries one `## Index row` section** holding exactly one summary
#     paragraph, the one fact nothing else in the block states. The heading keeps the name
#     milestone 294 gave it although the index it was named for is retired: renaming it would touch
#     every block in this directory, and a name is an architect's;
#   - each file holds exactly one milestone: one H1, first after the frontmatter, whose number
#     matches the filename (the filed-under-an-essay class, and the appended-past-the-closer class);
#   - two files claiming one milestone number is fatal, for the reason script/decisions records: as
#     two files it would merge clean and silently where one file makes it a visible text conflict;
#   - **`IN-PROGRESS` carries a `branch`, and that branch has not already merged.** Added
#     2026-08-17, after a sweep found that ALL SIX `IN-PROGRESS` rows were false: four had MERGED
#     (one thirteen days earlier) and two named no branch at all. This is the only status whose
#     definition is mechanically checkable, "active work on a branch right now", and it was the only
#     one that rotted. The check is LOCAL, using merge-commit subjects rather than `git ls-remote`:
#     the remote needs network in a gate that otherwise only reads files, and a deleted branch
#     cannot tell a merged lane from a dead one where a merge commit is proof;
#   - **every REFUSED block carries one `## Revisit` section**, whose bullets open `**Condition.**`,
#     `**Nothing.**` or `**Unstated.**`; see milestone 448 (a refusal gets a number). REFUSED is "considered and deliberately not
#     taken", and the whole reason it is a status rather than a bullet in somebody's block is that a
#     status can be made to owe something. What it owes is the condition that would change it. The
#     check proves the condition is PRESENT and can prove nothing else about it: see BUGS;
#   - the **dependency fields** of §207 (the roadmap is a graph, and the block says so in fields a
#     script can walk), which answer "what stops a lane from starting this" and replaced the
#     `Gate:` line on 2026-09-26. Every reference must resolve, and **none is ever stale**: a
#     dependency stays true after its target lands, and whether it still blocks is computed from
#     the target's own status. The gate this replaced failed the build the day its target landed,
#     which obliged an edit in a block nobody in that lane was reading (§207's argument, and the
#     forced edit milestone 591 (a ruling should make the gate it answers fail until someone updates
#     it) added for decisions). `decision_dependencies: unwritten` is a fork nobody has written up;
#   - **a block or proposal raised on or after 2026-10-05 carries a `Reuse:` record** naming what it
#     considered taking, or `none exists` and what was searched (§46's 2026-10-04 amendment: taking
#     is the default outside the kernel and the crates Kani proves). Older blocks are exempt; the
#     comment at `reuse_problems` says why and what that misses;
#   - every `milestone N` citation TREE-WIDE resolves to a block (vendor/ and patches/ excluded:
#     other people's text). The old gate checked only the roadmap's own prose, so ~1,988 citations in
#     code comments were validated by nothing. A citation to a milestone that never existed is drift,
#     and failing the build on it is the point: the docs are versioned with the code so they cannot
#     describe a system that does not exist.
#
# `--migrate [FILE...]` rewrites a block from the old prose form (helpers/roadmap_migrate.py), which
# is what a lane runs on a block it wrote before the switch. `--unmodelled` lists the blocks with no
# dependency fields: a finished block from before the switch has none, because the gate it had was
# cleared when its dependencies landed and cannot be recovered from the block.
#
# Deliberately NOT checked: whether a
# citation that resolves points where its author meant (well-formed-but-wrong is invisible here, the
# same blind spot CLAUDE.md records for §N citations; check by content after any renumber).
#
# A lettered file (`0020b-x.md`) is refused (calef, 2026-10-18 UTC: "Yes, please"). A lettered
# addendum carried no frontmatter and no row, so every check below needed a second path for it; an
# addendum is an appendix in its block's directory instead, which `is_appendix_dir` already admits.
#
# With no arguments it prints the normalized status report, statuses first and gates after it.
# `--ready` prints only the milestones a lane could start today (nothing it depends on is open, no
# machine or person is needed, status `NOT-STARTED` or `PARTIAL`), which is the query the maintainer actually makes. `--unclaimed` prints the follow-on
# work a finished milestone named that nobody has taken, `--proposed` the unnumbered proposals oldest
# first, and `--outstanding` what a PARTIAL milestone still says is left (milestone 252, and the
# question calef had to ask by hand about milestone 16 (real hardware, IOMMU-backed driver
# isolation)). `--coe-actions` lists every open action item of a correction under notes/coes/,
# the list behind the count `script/metrics` charts (helpers/coe_actions.py). `--revisit` prints the REFUSED milestones
# whose stated condition names a milestone that has since turned BUILT, which is a refusal the tree
# has already walked past without noticing (milestone 448 (a refusal gets a number, a status, and a
# condition that would change it)). `--index` renders the five-column table to stdout for the two
# scripts that read it as data; nothing writes it to a file, and no file holds it.
# `--ready-branch BRANCH` fails when a block still reads IN-PROGRESS on BRANCH, which is what a
# ready pull request must never carry (milestone 630, the comment beside it says why), and
# `--selftest` proves that check against fixtures.
# See notes/roadmap.md for both vocabularies.
#
# (The sentence above replaced a dangling one that named a `--unswept` mode this script has never
# had: milestone 247's exemption list was removed an hour after it was written and took the mode
# with it, leaving half a sentence spliced onto the next. Corrected by milestone 252's lane, which
# was reading the header to add to it.)
#
# BUGS
#
# **`--index`'s escaping outlived the document it was written for.** A literal `|` or `]` in a
# title or a summary is still escaped for a markdown table nobody renders, because the two scripts
# that read `--index` split cells on `|`. If that feed is ever replaced by something that is not
# markdown-shaped, both escapes go with it. (The deadlock this section used to record, a `--write`
# that refused to overwrite the unparseable row it had itself produced, went with `--write`.)
#
# **The `## Revisit` check proves a condition is present and nothing else.** It cannot prove one is
# true, honest, current, or that the person writing it thought about it for longer than it took to
# type. `**Unstated.**` passes, and it is meant to: an author with no honest condition who cannot
# say so will invent one, and an invented condition is worse than a blank because it is a bell that
# fires for a reason nobody meant. So a green run here means every REFUSED block answered the
# question, never that the answers are good. This is the same posture `script/citations` takes about
# glosses ("what you write is checked, not that you must write it") and DECISIONS §71 (a limitation
# is promoted when it stops being a fact) takes about
# its own promotion triggers, and it is stated here because a green check gets read as an answer.
#
# **`--revisit` reads prose, so it sees one shape of condition and misses the rest.** It fires when a
# condition cites a milestone number that has since turned BUILT. It cannot fire on a condition
# phrased as a workload ("when an x86_64 workload touches the crypto path"), a measurement, a
# customer, a piece of hardware, or a decision, and most conditions in this tree are one of those:
# the run prints the two counts so the reach is visible rather than assumed. It also cannot tell a
# condition that CITES a milestone from one that merely MENTIONS one in passing, which is the
# well-formed-but-wrong blind spot this script already records for citations, one record over.
#
# **Nothing re-reads a condition that stays false.** A refusal whose condition never comes true sits
# here forever and this script will report it as healthy every time, because it is: a door with a
# bell on it is still a door. The count in `--check` is the only pressure, and it is the same
# pressure `--proposed` applies to the proposal pile, for the same reason a gate on age was refused
# there (a rule routed around by not writing the record is worse than the record).
#
# Name: recorded (DECISIONS §134, which lists this script by name in the `script/` family's noun
# half). Introduced 2026-07-30 with the status vocabulary and its gate. It reports rather than
# does, so §134's split gives it a noun, and the noun is the record it reads, which leaves nothing
# else to decide. no architect has ratified it.

set -e

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

# `--migrate [FILE...]` rewrites prose-form blocks into the frontmatter form, for milestone 596 (the roadmap blocks get frontmatter too). It is a
# separate program because it writes files and reads history, where everything below only reads.
if [ "${1:-}" = "--migrate" ]; then
    shift
    exec python3 "$ROOT/helpers/roadmap_migrate.py" "$ROOT" "$@"
fi

exec python3 - "$ROOT" "$@" <<'PY'
import os
import re
import subprocess
import sys

root = sys.argv[1]
mode = sys.argv[2] if len(sys.argv) > 2 else ""
args = sys.argv[3:]
d = os.path.join(root, "design", "roadmap")

# The proposal-file parse this script shares with `script/metrics`, which counts the pile per week
# (milestone 276). Milestone 236's rule: a derivation two scripts each copy will drift while both
# keep looking authoritative, and this pile's only defence against becoming a graveyard is that a
# script can see it. The directory LISTING stays here, because this reads the working tree and that
# reads blobs at revisions nobody has checked out. `dont_write_bytecode` because the import would
# otherwise leave a `helpers/__pycache__/` behind on every run, which is an untracked directory a
# gate has no business creating.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(root, "helpers"))
import roadmap_proposals                                                    # noqa: E402
import roadmap_block                                                        # noqa: E402


# ---- `--ready-branch BRANCH`: a ready pull request's block already says how it ended -------------
# Milestone 630 (a merge-queue ejection is caught before the queue, and recovered after it). The
# merged-branch check further down can only fail inside a merge group, because only there does the
# branch's merge commit exist. So a lane that marks its pull request ready while its own block still
# reads IN-PROGRESS learns it 20 to 38 minutes later, from an ejection, which also cancels auto-merge
# and tells nobody (#1473, 2026-10-03 01:45 UTC; notes/coes/2026-09-30-lane-follow-through.md).
#
# The fact is knowable the moment the pull request stops being a draft: a ready pull request is a
# merge request, and a block naming the branch being merged cannot honestly read "active work on a
# branch right now". So this asks the same question on `pull_request`, at ready time, in about a
# second, from `.github/workflows/ready-status.yml` and from the pre-push hook's fleet half
# (`helpers/pre-push-fleet.sh`, on a checkout with `nife.fleet` set).
#
# It runs BEFORE everything below on purpose. It reads frontmatter and nothing else: no history, no
# tree-wide grep, and no other block's problems, which are `--check`'s to report. A ready check that
# failed on somebody else's broken citation would teach a lane to ignore it.
#
# Only IN-PROGRESS is matched. A `branch:` on any other status is `--check`'s "belongs to another
# status" problem already, and reporting it twice under two names would be noise.
def ready_branch_problems(blocks, branch):
    """`blocks` is [(file name, text)]; the problems for each one still IN-PROGRESS on `branch`."""
    out = []
    for fname, text in blocks:
        fields, _, _ = roadmap_block.frontmatter(text.splitlines())
        if not fields or fields.get("branch") != branch or fields.get("status") != "IN-PROGRESS":
            continue
        out.append(
            f"design/roadmap/{fname} still reads IN-PROGRESS on {branch!r}, and its pull request "
            f"is ready for review. A ready pull request is a merge request, so the block must "
            f"already say how the work ended: the merge group's roadmap check fails on exactly "
            f"this, 20 to 38 minutes into the queue, and the ejection cancels auto-merge "
            f"(milestone 630).\n"
            f"  Fix: set 'status: BUILT' with 'built: YYYY-MM-DD' (UTC), or 'status: PARTIAL' "
            f"with what is left, and delete the 'branch:' line; commit and push.\n"
            f"  Or, if the work is not finished: gh pr ready --undo")
    return out


def unheld_promotions(added, held):
    """`added` is [(block file, promoted_from slug)] for the blocks THIS branch adds; `held` is the
    set of proposal slugs the branch held (present at its merge base, or added by its own commits).
    Returns one problem per block promoting a proposal the branch never held.

    **A branch commits no fact that only the merged tree can make true** (COE decision 4, calef,
    2026-10-03 UTC, on #1564). Promoting a proposal is a `git mv`, and a lane cannot move a file its
    branch has not got. A block that says `promoted_from: X` with no X in the branch's history was
    authored as a new file against a proposal still sitting in another open pull request, and the
    lint check above ("a promoted proposal leaves the pile") then passes on the branch and fails on
    the merged tree, 20 to 38 minutes into the queue, once per entry. On 2026-10-03 that was 33 of
    47 failed group builds."""
    return [
        f"design/roadmap/{fname}: promoted_from {slug!r}, and this branch never held "
        f"design/roadmap/proposals/{slug}.md (not at its merge base with origin/main, and not added "
        f"by its own commits). Only a proposal on main can be promoted, because promotion is a "
        f"`git mv`, and a proposal still in another open pull request makes the delete a fact about "
        f"the merged tree, which the queue then fails on.\n"
        f"  Fix: wait for the pull request holding the proposal to merge, then `git merge "
        f"origin/main`, `git rm design/roadmap/proposals/{slug}.md`, and remove 'promoted_from' "
        f"until then (set the block IN-PROGRESS with its 'branch:' line while you work)."
        for fname, slug in added if slug not in held]


# ---- `Reuse:`: a new milestone names what it considered taking (§46, 2026-10-04) ------------------
# calef ruled on 2026-10-04 (UTC) that outside the kernel and the crates Kani proves, the default is
# to take or adapt existing code, and that writing our own needs a recorded reason. The record is a
# `Reuse:` line in the block's prose, or a `## Reuse` section. It names at least one candidate
# considered, or says `none exists` and what was searched. The line is written plain, as §46 spells
# it. A bold `**Reuse:**` still reads, because blocks carried it until milestone 791 (bold that a
# script reads) dropped it, and a lane's open pull request may still add one; but the bold is not
# needed, so the prose ratchet counts it as emphasis (its NOT_MARKERS names this pattern).
#
# **Only blocks raised on or after REUSE_FROM owe one.** A check must not fail the tree it lands
# in, and every older block was written before the question was asked. That is an exception and a
# foot gun: an older block reopened by a new lane does not owe the line, and this check cannot tell
# it has been reopened. Milestones 242, 384 and 494 are exempt this way; their lanes are adding
# `## Reuse` sections voluntarily. REFUSED blocks are exempt too, because a refusal builds nothing.
# Proposals under design/roadmap/proposals/ owe it on the same date, since they become blocks.
#
# What it cannot check is the same blind spot as the `## Revisit` check: that a named candidate is
# real, or that it was weighed rather than typed. It proves the question was answered.
REUSE_FROM = "2026-10-05"
REUSE_LINE = re.compile(r"(?:\*\*Reuse:\*\*|Reuse:)\s*(.*)$")
REUSE_PLACEHOLDER = re.compile(r"(?:none|n/?a|tbd|todo|-+|\?+)\.?", re.I)


def reuse_problems(fname, status, raised, lines):
    """`lines` is the block's body after the frontmatter. Problems for a block that owes a `Reuse:`
    record and has none, or has one that names nothing."""
    if not raised or raised < REUSE_FROM or status == "REFUSED":
        return []
    texts, fence, section = [], False, None
    for l in lines:
        if l.lstrip().startswith("```"):
            fence = not fence
            continue
        if fence:
            continue
        if l.startswith("## "):
            section = [] if l.strip() == "## Reuse" else None
            if section is not None:
                texts.append(section)
            continue
        if section is not None:
            section.append(l.strip())
        m = REUSE_LINE.match(l)
        if m:
            texts.append([m.group(1).strip()])
    fix = (f"  Fix: add a line 'Reuse: <what was considered and why it was or was not taken>', "
           f"or 'Reuse: none exists; searched <where>' (§46's 2026-10-04 amendment; "
           f"notes/roadmap.md, step 3 of adding a milestone)")
    if not texts:
        return [f"{fname}: raised {raised}, on or after {REUSE_FROM}, and there is no 'Reuse:' line "
                f"or '## Reuse' section. Outside the kernel and the crates Kani proves, taking "
                f"existing code is the default, so a new milestone names what it considered.\n" + fix]
    out = []
    for t in texts:
        body = " ".join(x for x in t if x).strip()
        low = body.lower()
        if not body or REUSE_PLACEHOLDER.fullmatch(body):
            out.append(f"{fname}: its Reuse record is {body!r}, which names no candidate and no "
                       f"search.\n" + fix)
        elif low.startswith("none") and not (low.startswith("none exists")
                                             and len(body[len("none exists"):].split()) >= 3):
            out.append(f"{fname}: its Reuse record says none without saying what was searched "
                       f"({body[:60]!r}). 'none exists' is an answer only beside the search that "
                       f"found nothing.\n" + fix)
    return out


def ready_branch_selftest():
    """Fixtures, no files and no subprocesses, for the reason `script/fatal-risks --selftest` gives:
    a check whose green looks identical to a check that cannot fail must prove it can fail."""
    def block(status, branch=None):
        lines = ["---", f"status: {status}", "raised: 2026-10-03"]
        if branch:
            lines.append(f"branch: {branch}")
        return "\n".join(lines + ["---", "# 9. A fixture", ""])
    me, other = "milestone/9-fixture", "milestone/10-other"
    cases = [
        ("IN-PROGRESS on this branch", [("9-a.md", block("IN-PROGRESS", me))], 1),
        ("IN-PROGRESS on another branch", [("9-a.md", block("IN-PROGRESS", other))], 0),
        ("BUILT, branch line removed", [("9-a.md", block("BUILT"))], 0),
        # A `branch:` left on BUILT is --check's problem, not this one's.
        ("BUILT, branch line left behind", [("9-a.md", block("BUILT", me))], 0),
        ("a prose-form block", [("9-a.md", "# 9. Old\n\n**Status: IN-PROGRESS** on " + me)], 0),
        ("a branch whose name is a prefix of this one",
         [("9-a.md", block("IN-PROGRESS", me + "-two"))], 0),
        ("two blocks, one held", [("9-a.md", block("IN-PROGRESS", me)),
                                  ("10-b.md", block("PARTIAL"))], 1),
    ]
    promo = [
        ("promotes a proposal the branch held", [("9-a.md", "x")], {"x"}, 0),
        ("promotes a proposal the branch never held", [("9-a.md", "x")], set(), 1),
        ("holds a different proposal", [("9-a.md", "x")], {"y"}, 1),
        ("two blocks, one unheld", [("9-a.md", "x"), ("10-b.md", "y")], {"x"}, 1),
        ("adds no promoting block", [], set(), 0),
    ]
    new, old = "2026-10-05", "2026-10-04"
    reuse = [
        ("a new block with no Reuse record", "NOT-STARTED", new, ["# 9. A fixture", ""], 1),
        ("an old block with no Reuse record", "BUILT", old, ["# 9. A fixture", ""], 0),
        ("a REFUSED block with none", "REFUSED", new, ["# 9. A fixture"], 0),
        ("a bold line naming a candidate", "NOT-STARTED", new,
         ["# 9. A fixture", "", "**Reuse:** rust-osdev's `xhci`; taken for the register map."], 0),
        ("a bare line naming a candidate", "PARTIAL", new, ["Reuse: Redox's e1000d, adapted"], 0),
        ("a section naming a candidate", "NOT-STARTED", new,
         ["# 9. A fixture", "## Reuse", "", "`simple-dns`, refused: it is not no_std.", "## BUGS"], 0),
        ("an empty section", "NOT-STARTED", new, ["## Reuse", "", "## BUGS", "x"], 1),
        ("a bare 'none'", "NOT-STARTED", new, ["**Reuse:** none."], 1),
        ("'none exists' with no search", "NOT-STARTED", new, ["**Reuse:** none exists"], 1),
        ("'none' with a reason but no search", "NOT-STARTED", new,
         ["**Reuse:** none, we prefer ours"], 1),
        ("'none exists' with the search", "NOT-STARTED", new,
         ["**Reuse:** none exists; searched crates.io for no_std PL011 drivers"], 0),
        ("a Reuse line inside a code fence", "NOT-STARTED", new,
         ["```", "**Reuse:** xhci", "```"], 1),
    ]
    failed = 0
    for name, status, raised, lines, want in reuse:
        got = len(reuse_problems("9-a.md", status, raised, lines))
        if got != want:
            print(f"roadmap --selftest: reuse, {name}: {got} problems, expected {want}",
                  file=sys.stderr)
            failed += 1
    for name, added, held, want in promo:
        got = len(unheld_promotions(added, held))
        if got != want:
            print(f"roadmap --selftest: {name}: {got} problems, expected {want}", file=sys.stderr)
            failed += 1
    for name, blocks, want in cases:
        got = len(ready_branch_problems(blocks, me))
        if got != want:
            print(f"roadmap --selftest: {name}: {got} problems, expected {want}", file=sys.stderr)
            failed += 1
    if failed:
        sys.exit(1)
    print(f"roadmap --selftest: {len(cases)} ready-branch, {len(promo)} promotion and "
          f"{len(reuse)} reuse fixtures behave")
    sys.exit(0)


if mode == "--selftest":
    ready_branch_selftest()

if mode == "--ready-branch":
    if len(args) != 1 or not args[0]:
        print("roadmap: --ready-branch takes one branch name", file=sys.stderr)
        sys.exit(2)
    found = []
    for fname in sorted(os.listdir(d)):
        if fname.endswith(".md") and fname[:1].isdigit():
            with open(os.path.join(d, fname)) as fh:
                found.append((fname, fh.read()))
    problems = ready_branch_problems(found, args[0])
    for p in problems:
        print(f"roadmap: {p}", file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"roadmap: no block reads IN-PROGRESS on {args[0]!r}")
    sys.exit(0)

PROPOSED_DIR = "proposals"

VOCAB = ["BUILT", "REMOVED", "SUPERSEDED", "PARTIAL", "IN-PROGRESS", "NOT-STARTED", "OPTIONAL",
         "REFUSED"]

# REFUSED is "this was considered and deliberately not taken", and calef ratified the word on
# 2026-09-20. It is the status a refusal gets when the refusal names WORK: a route somebody could
# execute, as against a name (which `script/names` already homes at the thing it was refused for),
# a dependency, which §46 (thin primitives or whole subsystems) judges in design/decisions/, or a
# choice about how one lane shaped its own diff (which is a paragraph in the block that made it).
#
# **Why the word was needed, measured.** This tree carried 140 `- **Refused.**` bullets across 98
# milestone blocks and exactly two of them named a milestone. A bullet in a finished block is read
# once, on the day it is written, by one person, which is the same burial `## Follow-on` exists to
# stop one level up: that gate routes an INTENTION into a tracked form and has no word at all for a
# DECISION NOT TO. So a refusal that named real work had nowhere to live, and the cost arrived on
# 2026-09-20 as milestone 164 (x86_64 userspace can't build `aes`) and its Route 2, which refused
# an SSE-enabled x86 userspace target in
# September, correctly, because nothing needed FP state to compile `aes`. Milestone 442 (a crypto
# provider `rustls` can use on all three bare-metal targets) then needed
# five force-soft build flags, an AVX2-detecting crate died in ring 3 with `vector 6 (invalid
# opcode)`, and nothing compared any of it against the refusal, because a refusal had no home that
# anything reads. calef reopened it by hand, in conversation, which is the medium AGENTS.md exists
# to abolish.
#
# **The whole value of the word is the condition**, so a status that did not demand one would
# reproduce the bullet with a bigger font. OPTIONAL reads as available to pick up, which is the
# precise opposite. NOT-STARTED is a lie by omission: it says pending where this says declined.
#
# There is no status for "deliberately not taken" without a condition (calef, 2026-10-20 UTC). A
# block that was considered and declined is REFUSED and says what would reopen it; one waiting on a
# conversation is NOT-STARTED behind a decision dependency, which keeps it off `--ready`.
#
# **A REFUSED milestone is not outstanding work**, and every count in this script that reads as a
# backlog excludes it: it is not in STARTABLE, so `--ready` cannot offer it; it never reaches the
# gate parse, so it is not among "the milestones that are not built"; and it is not in ANSWERS,
# because a block nothing will build owes no '## Follow-on'. Adding several dozen of these moves
# every denominator a stranger quotes, which is why the exclusion is written here rather than
# happening incidentally: see notes/project-metrics.md for the before and after.

# REMOVED KEEPS its Built date where it had one, and that is half the reason it is a status rather
# than prose: a milestone built on a date turned BUILT on that date, nothing later makes that untrue,
# and what changed is the present tense. So the column answers "where do we stand" while the date says
# it once stood somewhere.
#
# **But the date is OPTIONAL for REMOVED, and that was a correction this gate made to its own
# minting.** The rule was first written as "every REMOVED row carries a date", and milestone 55
# failed it within the minute: 55 was PARTIAL and never turned BUILT, so it has no date to keep and
# inventing one would be a lie in the column whose entire job is not lying. A REMOVED milestone
# therefore carries the date it turned BUILT if it ever did, and none if it did not.
#
# Minted 2026-08-30 (calef) when milestone 54 lost its code: the existing words could only lie about
# it, since NOT-STARTED denies it was ever built, OPTIONAL reads as available to pick up, and leaving
# it BUILT makes the column claim a network file service that no longer exists.
# SUPERSEDED is "other work answered this, so it will never be built", and it is minted for the same
# reason REMOVED was: every existing word could only lie about it. REMOVED says it once existed and
# was taken out, when this was never built; NOT-STARTED is literally true and reads as still pending;
# OPTIONAL reads as available to pick up, when there is nothing left to pick up.
#
# **It is deliberately NOT in DATED.** A SUPERSEDED block never turned BUILT, so it has no date to
# keep, and inventing one is the lie milestone 55 caught this gate telling within a minute of minting
# the rule. The date that matters is in the status line's own prose, beside the milestone that
# settled it. It is not in ANSWERS either (a block nothing will build owes no '## Follow-on'), nor in
# STARTABLE (there is nothing to start).
#
# Minted 2026-09-15 (calef), promoting `one-grant-order-for-the-progenitor` to milestone 301 and
# disposing of it in the same act: milestone 166 split the 19d test roles out of the boot path and
# collapsed the two BootEndowment tables into one, which is precisely what that proposal asked for.
# A proposal cannot be retired in place, because `helpers/roadmap_proposals.py` matches PROPOSED and
# nothing else, so promotion is how a proposal reaches a disposition at all.
DATED = ("BUILT", "REMOVED")

# The statuses that need not carry dependency fields (they carried no `**Gate:**` line before
# milestone 596). The fields answer "what stops a lane from starting this", and on a REFUSED block
# the status word has already answered it: what stops a lane is the refusal. A dependency beside it
# would be a second answer to a settled question, and would say `--ready` should offer it the
# moment the dependency resolves, when what a changed mind produces is a new milestone rather than
# this one waking up.
#
# **A REFUSED block carries no `built` either**, and the date it WAS refused goes in its prose, the
# way a SUPERSEDED block writes "Superseded 2026-09-15, by milestone 166 (one boot loader)". The
# Built column means the date a milestone turned BUILT; a refusal date in it
# would be a lie in the field whose entire job is not lying, which is the correction this gate made
# to its own minting on 2026-08-30 when it tried to demand a date from milestone 55 (Time Machine:
# SMB3 with Apple's extensions, and mDNS).
NOGATE = DATED + ("REFUSED",)

# The statuses that must answer '## Follow-on'. BUILT and REMOVED were milestone 247's; PARTIAL is
# milestone 252's, and it is the harder half.
#
# A finished block is written once and closed, so its section is a record. **A PARTIAL block's is a
# standing claim about the future**, edited as pieces land, and nothing re-reads what it still
# asserts. Its prose is also what a lane reads when picking work up, so a stale one does not merely
# misinform: it offers work that does not exist. Milestone 16 listed three things as remaining and
# two of them were finished, one of them the UART marker every board run is judged by; the block
# said otherwise for weeks and calef asking what was left is what caught it.
ANSWERS = DATED + ("PARTIAL",)

# A milestone a lane may pick up: nothing gates it, and the status does not already say to leave it
# alone (BUILT is done, IN-PROGRESS has somebody on it, OPTIONAL is deliberately off the work list).
STARTABLE = ["NOT-STARTED", "PARTIAL"]

problems = []
# The `Built` column, by milestone, kept for the follow-on gate below: it is what closes the unswept
# list by date rather than by good intentions.
built_dates = {}
# (milestone, file, branch) for every IN-PROGRESS block, checked against merge history below.
in_progress_branches = []
# (milestone, file, line, disposition, prose) for every '## Revisit' bullet a REFUSED block carries.
# `--revisit` reads it, and so does the one thing this tree can check mechanically about a refusal:
# whether its condition names a milestone that has since turned BUILT.
revisits = []
# milestone -> the milestones its status paragraph names, which for a REFUSED block are the ones
# that refused it. `--revisit` excludes them: a condition quoting its own origin is context.
refused_by = {}

# ---- the files, which are the whole record ------------------------------------
# **There is no index to compare them against any more.** Milestone 294 (`design/roadmap/README.md`'s
# index is generated, not hand-maintained) had already made the table derived from these blocks,
# because it was the tree's worst merge hotspot: `script/lint-fleet` 4b makes every lane touch its own
# block, every milestone also needed a row in one sorted table, so every milestone in flight
# collided with every other one, always, in that one file. Eight conflicts in a single session on
# 2026-09-14 (pull requests #836, #843, #847, #849, #850, #851, #854 and #855), every resolution
# mechanical. Deriving it fixed the conflicts and left 540 rows nobody read, which is what calef
# retired on 2026-09-21. The five columns are still assembled, by `--index`, straight into the
# stdout of the two scripts that want them:
#
#   #        the filename's number
#   Status   the `**Status: <TOKEN>` line
#   Title    the H1
#   Why      the `## Index row` section's summary paragraph
#   Built    that section's `**Built:** <ISO date>` line
#
# **The summary and the date live in the block because milestone 294 moved them there**, and that
# move is why retiring the table cost nothing. Neither was derivable from what a block otherwise
# said: the summary is a hand-written precis whose median similarity to the block's opening
# paragraph was 0.07, and 129 of 288 blocks stated no Built date in any parseable position, in at
# least eight spellings. Both were moved verbatim, and the proof nothing was lost is the
# reconstruction: regenerating the table from the migrated blocks reproduced 271 of 288 rows byte
# for byte, and all 17 differences were pre-existing drift in the hand-maintained table.
generated = {}


# ---- the files ----------------------------------------------------------------

# ---- the files, which are now the SOURCE of the index -------------------------
FNAME = re.compile(r"(\d+)-[a-z0-9][a-z0-9-]*\.md")
LETTERED = re.compile(r"(\d+)[a-z]+-[a-z0-9][a-z0-9-]*\.md")
INDEX_HEADING = "## Index row"
# ---- the `## Revisit` section, which REFUSED owes (milestone 448) --------------
# **What would change this.** calef, 2026-09-20: "ensure we capture what would change for a
# milestone to no longer be refused." The word *ensure* is what puts this in the script instead of
# in a convention, because AGENTS.md's ladder prices the difference: a condition asked for in prose
# is rung four, and the tree's own evidence is that rung four does not hold. The refusal that
# prompted milestone 448 stated its condition perfectly (milestone 164: "The number is owed when an
# x86_64 workload touches the crypto path") and still went stale, because nothing re-read it.
#
# **The section is a fixed home, so the check tests structure and never vocabulary.** A sentence
# anywhere in the prose would mean grepping for intent, which is the 82% false-positive rate
# AGENTS.md prices for `git grep -w TODO` and the reason `## Follow-on` is a heading rather than a
# pattern. Each bullet opens with one of three words:
#
#   - **Condition.**   what would make this worth reopening. Not a promise to build: §71 refuses to
#                      let a `BUGS` entry become a plan and this refuses the same thing one record
#                      over. It is the difference between a dead end and a door with a bell on it.
#   - **Nothing.**     refused permanently, on a principle rather than on circumstance, and nothing
#                      would change it. Carries the reason, and stands alone.
#   - **Unstated.**    the original refusal names no condition and none can honestly be inferred.
#                      Stands alone, and is meant to READ as a gap somebody could close rather than
#                      as a settled matter.
#
# **`Unstated.` is the load-bearing one and it is deliberately cheap to write.** The failure this
# gate exists to stop is silence, and an author with no honest condition and no way to say so will
# invent one, which is worse than the blank: an invented condition is a false bell that fires for a
# reason nobody meant. Silence and "we thought about it and nothing would change our minds" look
# identical to the next reader and mean opposite things, so `Nothing.` and `Unstated.` must be
# different words and both must pass.
#
# **What this can and cannot prove, said here because a green check is read as an answer.** It
# proves a condition is PRESENT. It cannot prove one is true, honest, current, or that the person
# writing it thought for more than a second. The same limit `script/citations` records about
# glosses ("what you write is checked, not that you must write it") and §71 about its own promotion
# triggers. See BUGS in this script's header.
REVISIT_HEADING = "## Revisit"
# The pattern lives in helpers/roadmap_block.py, beside every other field token this script reads.
REVISIT = roadmap_block.REVISIT
ids = {}
milestones = {}
gates = {}
# slug -> the numbered file whose status paragraph says it was promoted from that proposal.
# Checked against the pile below, once both have been read.
promoted = {}
# numbered block file name -> the slug its `promoted_from` names, for the promotion-held check.
promoted_slug = {}


def section(lines, heading):
    """The lines under `heading`, up to the next heading of any level or the end of the file."""
    body, collecting = [], False
    for l in lines:
        if l.rstrip() == heading:
            collecting = True
            continue
        if collecting:
            if l.startswith("#"):
                break
            body.append(l)
    return body


def blocks_of(lines):
    """Non-blank runs, each joined into one line."""
    out, cur = [], []
    for l in lines:
        if l.strip():
            cur.append(l.strip())
        elif cur:
            out.append(" ".join(cur))
            cur = []
    if cur:
        out.append(" ".join(cur))
    return out


def is_appendix_dir(fname, is_dir, entries):
    """True for a §212 appendix directory: a directory named after a block file beside it.

    §212 (a prose budget) sites a long document's appendices in a sibling directory named after
    it, so `0047-navigation-and-naming/` sits beside `0047-navigation-and-naming.md`. Its files are
    appendices, not blocks, and are not scanned as blocks; the prose ratchet's orphan check is what
    watches them. A directory named after no block is still an error, since nothing else lives here.
    """
    return is_dir and FNAME.fullmatch(fname + ".md") is not None and fname + ".md" in entries


# The rule's selftest, run every time because it is four lines and a wrong answer either fails
# every split or lets any directory in.
assert is_appendix_dir("0047-navigation-and-naming", True, {"0047-navigation-and-naming.md"})
assert not is_appendix_dir("0047-navigation-and-naming", False, {"0047-navigation-and-naming.md"})
assert not is_appendix_dir("0048-no-such-block", True, {"0047-navigation-and-naming.md"})
assert not is_appendix_dir("notes", True, {"notes.md"})
# A lettered file must reach the refusal, never the generic "not a milestone file" or a block.
assert LETTERED.fullmatch("0020b-x.md") and not FNAME.fullmatch("0020b-x.md")

# ---- the frontmatter form (milestone 596) -------------------------------------
# calef, 2026-09-26 (UTC): the roadmap follows milestone 582 (a decision's status becomes a field,
# and the index becomes generated) onto frontmatter, and carries the five dependency fields of §207
# (the roadmap is a graph, and the block says so in fields a script can walk) as keys, retiring
# `**Gate:**`. The schema, its key names (ratified by calef the same day) and its value words live
# in `helpers/roadmap_block.py`, spelled once. What is checked here is what each key requires and
# forbids.
#
# **A dependency is never cleared** (§207). The `MILESTONE N` gate this replaced failed the day N
# turned BUILT, which obliged an edit in a block nobody in that lane was reading; a
# `milestone_dependencies` entry stays true forever, and whether it still blocks is computed below
# from N's own status. The same holds for a decision: a section that is ruled resolves the
# dependency, and nothing has to be edited for that to be so, which retires the forced edit of
# milestone 591 (a ruling should make the gate it answers fail until someone updates it).
BRANCH = re.compile(r"[a-z][a-z0-9]*(?:/[A-Za-z0-9._-]+)+")
SLUG = re.compile(r"[a-z][a-z0-9-]*")
HOST_AND_REASON = re.compile(r"[a-z][a-z0-9-]* \(.{8,}\)")
DATE_ONLY = re.compile(r"\d{4}-\d{2}-\d{2}")
NONE_WORD = roadmap_block.VALUE["none"]
# The three field-shaped lines the prose form used, anchored where a line begins. Exact shapes on
# purpose: `**Status: both halves built**` opening a phase's paragraph in milestone 56 (secrets,
# credentials, and the entropy to make them safe) and `**Built:** the per-crate cost measurement`
# in milestone 119 (the merge queue is the bottleneck) are prose about a part of the work, and
# refusing them would refuse a sentence to remove no ambiguity, the limit `script/decisions`
# records one directory over.
RESTATED = re.compile(r"\*\*Status: (?:" + "|".join(map(re.escape, VOCAB)) + r")\b"
                      r"|\*\*Built:\*\* \d{4}-\d{2}-\d{2}"
                      r"|\*\*Gate: [A-Z0-9§, ]+\.\*\*")
# milestone -> its five dependency fields, for the blocks that carry them (§207's "modelled").
modelled = {}
# (milestone, file, role, token) for every reference a field makes, resolved once all blocks are read.
field_refs = []


def check_fields(fname, num, status, f):
    """What each key requires and forbids, given the status. Problems only; nothing returned.

    `num` is None for a proposal, whose status is PROPOSED and which owes the dependency fields a
    numbered block owes, since a proposal a lane cannot start is worth as little as a milestone."""
    K = roadmap_block.KEY

    def owe(role, why):
        problems.append(f"{fname}: status is {status} and there is no '{K[role]}' key. {why}")

    def refuse(role):
        problems.append(f"{fname}: status is {status} and it carries '{K[role]}', which belongs "
                        f"to another status")

    if num is None:
        status = "NOT-STARTED"  # a proposal owes what an unbuilt block owes, and nothing else
    elif status not in VOCAB:
        problems.append(f"{fname}: status {status!r} is not in the vocabulary ({', '.join(VOCAB)})")
        return
    for role in ("raised", "built"):
        if f.get(role) and not DATE_ONLY.fullmatch(f[role]):
            problems.append(f"{fname}: {K[role]} is {f[role]!r}, not a YYYY-MM-DD date. Every date "
                            f"in this tree is UTC")
    if not f.get("raised"):
        owe("raised", "It is the date the milestone was first written down, and every block has one")
    elif f.get("built") and f["raised"] > f["built"]:
        problems.append(f"{fname}: raised {f['raised']} is after built {f['built']}")
    if f.get("built") and status not in DATED:
        refuse("built")
    if status == "IN-PROGRESS":
        if not f.get("branch"):
            owe("branch", "IN-PROGRESS means active work on a branch right now, and a claim with "
                          "nothing to look up was false all six times it was made")
        elif not BRANCH.fullmatch(f["branch"]):
            problems.append(f"{fname}: branch {f['branch']!r} is not a branch name")
    elif f.get("branch"):
        refuse("branch")
    if f.get("promoted_from") and not SLUG.fullmatch(f["promoted_from"]):
        problems.append(f"{fname}: promoted_from {f['promoted_from']!r} is not a proposal slug")
    for role, owner in (("superseded_by", "SUPERSEDED"), ("refused_by", "REFUSED")):
        if status == owner and not f.get(role):
            owe(role, "It names what settled this, so a reader can go and look")
        elif status != owner and f.get(role):
            refuse(role)
    for tok in roadmap_block.tokens(f.get("superseded_by")):
        if not re.fullmatch(r"§?\d+", tok):
            problems.append(f"{fname}: superseded_by names {tok!r}, which is neither a milestone "
                            f"number nor a section (§N)")
        else:
            field_refs.append((num, fname, "superseded_by", tok))
    for tok in roadmap_block.tokens(f.get("refused_by")):
        if not re.fullmatch(r"§?\d+", tok):
            problems.append(f"{fname}: refused_by names {tok!r}, which is neither a milestone "
                            f"number nor a section (§N)")
        else:
            field_refs.append((num, fname, "refused_by", tok))

    have = [r for r in roadmap_block.DEPENDENCIES if f.get(r) is not None]
    if have and len(have) < len(roadmap_block.DEPENDENCIES):
        missing = [K[r] for r in roadmap_block.DEPENDENCIES if r not in have]
        problems.append(f"{fname}: §207's dependency fields travel together, and this block lacks "
                        f"{', '.join(missing)}. A missing field is a defect rather than an "
                        f"assertion, so write 'none'")
        return
    if not have:
        if status not in NOGATE:
            problems.append(f"{fname}: a {status} milestone carries no dependency fields "
                            f"({', '.join(K[r] for r in roadmap_block.DEPENDENCIES)}). They say "
                            f"what stops a lane starting it, and 'none' is an answer")
        return
    for tok in roadmap_block.tokens(f["milestone_dependencies"]):
        if not tok.isdigit():
            problems.append(f"{fname}: milestone_dependencies names {tok!r}, not a milestone number")
        else:
            field_refs.append((num, fname, "milestone_dependencies", tok))
    unwritten = roadmap_block.VALUE["unwritten"]
    for tok in roadmap_block.tokens(f["decision_dependencies"]):
        if tok == unwritten:
            continue
        if not tok.isdigit():
            problems.append(f"{fname}: decision_dependencies names {tok!r}; a section is a bare "
                            f"number, and a fork nobody has written up is '{unwritten}'")
        else:
            field_refs.append((num, fname, "decision_dependencies", tok))
    if not f["machine_requirements"].strip():
        problems.append(f"{fname}: machine_requirements is empty; write 'none'")
    sm = f["specific_machine"]
    if sm != NONE_WORD and not HOST_AND_REASON.fullmatch(sm):
        problems.append(f"{fname}: specific_machine is {sm!r}. It is 'none' or a host and the "
                        f"reason that one machine is the point, '<host> (<reason>)': an "
                        f"unreasoned host forecloses a substitution nobody decided against (§207)")
    if f["needs_person"] not in (roadmap_block.VALUE["yes"], roadmap_block.VALUE["no"]):
        problems.append(f"{fname}: needs_person is {f['needs_person']!r}, not "
                        f"'{roadmap_block.VALUE['yes']}' or '{roadmap_block.VALUE['no']}'")
    if num is not None:
        modelled[num] = {r: f[r] for r in roadmap_block.DEPENDENCIES}


entries = set(os.listdir(d))
for fname in sorted(entries):
    if fname == "README.md" or fname == PROPOSED_DIR:
        continue
    if is_appendix_dir(fname, os.path.isdir(os.path.join(d, fname)), entries):
        continue
    m = FNAME.fullmatch(fname)
    lettered = LETTERED.fullmatch(fname)
    if lettered:
        n = int(lettered.group(1))
        base = next((e[:-3] for e in entries if FNAME.fullmatch(e) and int(e.split("-")[0]) == n),
                    f"<milestone {n}'s block>")
        problems.append(f"{fname}: a lettered block. Milestones carry no letters; an addendum to "
                        f"a milestone is an appendix in its block's directory, "
                        f"design/roadmap/{base}/<slug>.md (design/roadmap/README.md)")
        continue
    if not m:
        problems.append(f"{fname}: not the index and not a milestone file "
                        f"(expected <number>-<slug>.md); nothing else lives here")
        continue
    num = int(m.group(1))
    mid = str(num)
    if mid in ids:
        problems.append(f"milestone {mid} is claimed by two files: {ids[mid]} and {fname} "
                        f"(as one file this is a visible conflict; as two it merges silently)")
        continue
    ids[mid] = fname

    raw = open(os.path.join(d, fname)).read().split("\n")
    # ---- the frontmatter, which is the record (milestone 596) ---------------------------------
    # A block opens with `---`, its fields, `---`, then the H1. The prose form every block had
    # before 596 is refused, with the command that converts it: a lane that crossed the switch on
    # a branch takes its own side of the block and runs it (briefs/rebase-onto-main.md). `lines` is
    # the body, so everything below reads the H1 at lines[0], and `off` puts a reported line number
    # back where it is in the file.
    fields, off, fm_problems = roadmap_block.frontmatter(raw)
    for n, p in fm_problems:
        problems.append(f"{fname}:{n}: {p}")
    if fields is None:
        problems.append(f"{fname}: no frontmatter. A block opens with '---', its fields one per "
                        f"line, and '---' (helpers/roadmap_block.py has the schema). A block in "
                        f"the old prose form converts with `script/roadmap --migrate "
                        f"design/roadmap/{fname}`")
        continue
    lines = raw[off:]
    h = re.match(rf"# ({num})\. (\S.*)$", lines[0] if lines else "")
    if not h:
        problems.append(f"{fname}: the line after the frontmatter must be '# {mid}. <title>' "
                        f"(found {(lines[0] if lines else '')[:40]!r})")
    fence = False
    for n, l in enumerate(lines[1:], start=2 + off):
        if l.lstrip().startswith("```"):
            fence = not fence
        elif not fence and l.startswith("# "):
            problems.append(f"{fname}:{n}: a second H1: one file is one milestone, and appended "
                            f"text belongs under it, not beside it")
        elif not fence and re.match(r"#{2,6} \d+[a-z]?\. ", l):
            # The exact shape of the 2026-08-03 defect: a whole `### N.` block pasted into
            # something that already existed. No legitimate subheading is numbered like a milestone.
            problems.append(f"{fname}:{n}: a milestone-shaped heading ({l[:40]!r}) inside another "
                            f"milestone's file")

    # The frontmatter is the record, so a field-shaped line in the block's opening prose is a
    # second copy of it: the defect 582 removed from design/decisions/ (see `script/decisions`'
    # RESTATED). Only the opening, above the first `## ` section: a phase further down that opens
    # "**Status: BUILT.**" about itself is prose about part of the work, not a copy of the block's
    # status. Milestone 236 (three derivations are copied between scripts) has one.
    fence = False
    for n, l in enumerate(lines, start=1 + off):
        if l.startswith("## "):
            break
        if l.lstrip().startswith("```"):
            fence = not fence
        elif not fence and RESTATED.match(l):
            problems.append(f"{fname}:{n}: {l[:24]!r} restates a field this block's frontmatter "
                            f"holds, and a second copy is the one that stops being updated")
    status = fields.get("status")
    if not status:
        problems.append(f"{fname}: no 'status' key, which is the one field every block carries")
        continue
    if status not in VOCAB:
        problems.append(f"{fname}: status {status!r} is not in the vocabulary "
                        f"({', '.join(VOCAB)})")
        continue

    # A block that says it was promoted from a proposal owes that proposal its disposition; see
    # `helpers/roadmap_proposals.py` for why the citation is a slug and not a path. Collected here
    # and checked against the pile after it is read.
    check_fields(fname, num, status, fields)
    problems.extend(reuse_problems(fname, status, fields.get("raised"), lines))
    if status == "REFUSED":
        refused_by[num] = {int(x) for x in roadmap_block.tokens(fields.get("refused_by"))
                           if x.isdigit()}
    slug = fields.get("promoted_from")
    if slug:
        promoted[slug] = fname
        promoted_slug[fname] = slug

    # ---- the `## Index row` section, which IS the index row (milestone 294) --------
    # It carries the two fields nothing else in the block states: the Built date, and the
    # one-paragraph summary the table's "Why it matters" column shows. Both were moved here
    # verbatim from the table on 2026-09-14; see this script's header for the reconstruction that
    # proves nothing was lost.
    #
    # **One paragraph, on purpose.** A table cell is one paragraph, so the section is one, and a
    # section that could hold three would make the generator choose. The optional `**Built:**`
    # line comes first because a reader scanning for a date should not have to read a paragraph.
    built, summary = "", ""
    if lines.count(INDEX_HEADING) > 1:
        problems.append(f"{fname}: {lines.count(INDEX_HEADING)} '{INDEX_HEADING}' sections; one "
                        f"milestone is one row, and a second copy is the one that stops being "
                        f"updated")
    elif INDEX_HEADING not in lines:
        problems.append(
            f"{fname}: no '{INDEX_HEADING}' section. It carries the two facts nothing else in "
            f"the block states, the Built date and a one-paragraph precis, and `script/audits` "
            f"and `script/fatal-risks` read both through `script/roadmap --index`: give it "
            f"'{INDEX_HEADING}', a '**Built:** <YYYY-MM-DD>' line if the status is BUILT, and one "
            f"paragraph saying why this milestone matters")
    else:
        paras = blocks_of(section(lines, INDEX_HEADING))
        # The date is the frontmatter's. A `**Built:**` line here is a copy of it.
        built = fields.get("built", "")
        if paras and paras[0].startswith("**Built:"):
            problems.append(f"{fname}: '{INDEX_HEADING}' opens with a '**Built:**' line, a copy "
                            f"of the 'built' key; the section is the one-paragraph summary alone")
            paras = paras[1:]
        if not paras:
            problems.append(f"{fname}: '{INDEX_HEADING}' carries no summary. It is the table's "
                            f"'Why it matters' cell, and an empty one is a row that says nothing")
        elif len(paras) > 1:
            problems.append(f"{fname}: '{INDEX_HEADING}' has {len(paras)} paragraphs after the "
                            f"Built line. A table cell is one paragraph, so this section is one; "
                            f"the rest of the argument belongs in the block above it")
        else:
            summary = paras[0]
        # The Built column's own rule, moved here from the row it now generates. BUILT must carry
        # a date; REMOVED may (54 was BUILT on one, 55 never was, and inventing one would be a lie
        # in the field whose whole job is not lying); every other status must not.
        if status == "BUILT" and not built:
            problems.append(f"{fname}: BUILT with no 'built' key. It is the date the milestone "
                            f"turned BUILT, and the index's Built column is generated from it")
        elif status not in DATED and built:
            problems.append(f"{fname}: status is {status} and '{INDEX_HEADING}' carries "
                            f"'**Built:** {built}'. It is the date a milestone turned BUILT and "
                            f"belongs to BUILT and REMOVED alone; a first phase's date belongs in "
                            f"the block's prose")
    # ---- the `## Revisit` section, required by REFUSED and by nothing else --------
    # Required, so that a REFUSED milestone with no stated condition is unrepresentable in a
    # passing tree (rung one of AGENTS.md's ladder, where the bullet it replaces was rung four).
    # Forbidden elsewhere, for the reason the gate line is forbidden on a BUILT block: a section
    # answering "what would un-refuse this" on a milestone that was never refused can only be
    # stale, and a heading that means nothing in most files is a heading nobody maintains.
    if status == "REFUSED" and lines.count(REVISIT_HEADING) != 1:
        problems.append(
            f"{fname}: REFUSED with {lines.count(REVISIT_HEADING)} '{REVISIT_HEADING}' sections; "
            f"it owes exactly one. A refusal whose condition is unwritten is the bullet this "
            f"status replaced: bullets opening '**Condition.**' with what would make this worth "
            f"reopening, '**Nothing.**' with why it is permanent, or '**Unstated.**' if the "
            f"original names no condition and none can honestly be inferred. Silence is the one "
            f"answer that is not allowed, because it reads exactly like the second one and means "
            f"the opposite")
    elif status != "REFUSED" and REVISIT_HEADING in lines:
        problems.append(f"{fname}: status is {status} and it carries '{REVISIT_HEADING}', which "
                        f"asks what would un-refuse a milestone that was never refused")
    elif status == "REFUSED":
        rbody, collecting = [], False
        for n, l in enumerate(lines, start=1 + off):
            if l.rstrip() == REVISIT_HEADING:
                collecting = True
                continue
            if collecting:
                if l.startswith("#"):
                    break
                rbody.append((n, l))
        rbullets = []
        for n, l in rbody:
            if l.startswith("- "):
                rbullets.append([n, l])
            elif rbullets and l.startswith(("  ", "\t")) and l.strip():
                rbullets[-1][1] += " " + l.strip()
        if not rbullets:
            problems.append(f"{fname}: '{REVISIT_HEADING}' has no bullets. '- **Unstated.**' plus "
                            f"a sentence is the whole answer when the original refusal names no "
                            f"condition, and it is meant to be cheap to say")
        for n, l in rbullets:
            rm = REVISIT.match(l.rstrip())
            if not rm:
                problems.append(f"{fname}:{n}: {l[:60]!r} is not a revisit disposition. Every "
                                f"bullet under '{REVISIT_HEADING}' opens '**Condition.**', "
                                f"'**Nothing.**' or '**Unstated.**'")
                continue
            kind, rest = rm.group(1), rm.group(2).strip()
            if kind in ("Nothing", "Unstated") and len(rbullets) > 1:
                problems.append(f"{fname}:{n}: '**{kind}.**' is the whole answer, so it cannot sit "
                                f"beside {len(rbullets) - 1} other condition(s)")
            if len(rest) < 40:
                problems.append(f"{fname}:{n}: '**{kind}.**' carries its reasoning. A bare one is "
                                f"the silence this section exists to stop, with a heading over it "
                                f"(found {rest!r})")
            else:
                revisits.append((num, fname, n, kind, rest))

    title = h.group(2).strip() if h else ""
    milestones[num] = {"file": fname, "status": status, "title": title,
                       "built": built, "summary": summary}
    built_dates[num] = built

    # ---- IN-PROGRESS must name the branch it is held on ----------------------
    # Added 2026-08-17, after a sweep found that ALL SIX IN-PROGRESS rows were false and four
    # of them had MERGED, one of them thirteen days earlier. This is the token with a
    # mechanically checkable definition ("active work on a branch right now") and nothing was
    # checking it, so it was the only token in the vocabulary that rotted: nine NOT-STARTED
    # blocks audited in the same sweep were all honest.
    #
    # Naming the branch is what makes the claim falsifiable at all, which is why it is required
    # rather than encouraged. Two of the six named no branch, and that alone is the defect: a
    # status saying somebody is working on this, with nothing a reader can look up, is prose.
    if status == "IN-PROGRESS" and fields.get("branch"):
        in_progress_branches.append((num, fname, fields["branch"]))

def decision_statuses():
    """Section number -> the `status:` its frontmatter holds. script/decisions owns the schema and
    fails a file without one; this reads the one key and trusts that gate for the rest."""
    out = {}
    ddir = os.path.join(root, "design", "decisions")
    for fname in os.listdir(ddir):
        m = re.match(r"(\d+)-.*\.md$", fname)
        if not m:
            continue
        with open(os.path.join(ddir, fname), encoding="utf-8") as f:
            text = f.read()
        fm = re.match(r"---\n(.*?)\n---\n", text, re.S)
        sm = re.search(r"^status: *(\S+)", fm.group(1), re.M) if fm else None
        out[int(m.group(1))] = sm.group(1) if sm else None
    return out


section_status = decision_statuses()

# ---- what a frontmatter block's fields point at, and whether it is blocked -------------------
# Every reference must resolve; none is ever stale. Blocked-ness is computed here, from each
# target's own status, into the same `gates` shape the prose form fills, so every report below
# reads one structure. The tokens are the report's words, not the block's: `MILESTONE N` and
# `DECISION §N` for a dependency still open, `DECISION` for one nobody has written up, `MACHINE` for
# a machine requirement or a specific machine, and `PERSON` when somebody has to be there.
def resolve(refs):
    """Every reference a field makes names something that exists, and not the block itself."""
    for num, fname, role, tok in refs:
        resolve_one(num, fname, role, tok)


def resolve_one(num, fname, role, tok):
    if tok.startswith("§"):
        n = int(tok[1:])
        if n not in section_status:
            problems.append(f"{fname}: {role} names §{n}, which is not in design/decisions/")
    elif role == "decision_dependencies":
        if int(tok) not in section_status:
            problems.append(f"{fname}: {role} names §{tok}, which is not in design/decisions/")
    elif int(tok) not in milestones:
        problems.append(f"{fname}: {role} names milestone {tok}, which has no block")
    elif int(tok) == num:
        problems.append(f"{fname}: {role} names this milestone itself")


resolve(r for r in field_refs if r[0] is not None)
for num, dep in modelled.items():
    if milestones[num]["status"] in NOGATE:
        continue
    waiting = []
    for tok in roadmap_block.tokens(dep["milestone_dependencies"]):
        if tok.isdigit() and int(tok) in milestones and milestones[int(tok)]["status"] != "BUILT":
            waiting.append(f"MILESTONE {tok}")
    for tok in roadmap_block.tokens(dep["decision_dependencies"]):
        if tok == roadmap_block.VALUE["unwritten"]:
            waiting.append("DECISION")
        elif tok.isdigit() and section_status.get(int(tok)) == "PROPOSED":
            waiting.append(f"DECISION §{tok}")
    if dep["machine_requirements"] != NONE_WORD or dep["specific_machine"] != NONE_WORD:
        waiting.append("MACHINE")
    if dep["needs_person"] == roadmap_block.VALUE["yes"]:
        waiting.append("PERSON")
    gates[num] = waiting or ["NONE"]

# ---- a dependency graph has no cycles ----------------------------------------
# §207 calls the roadmap a graph that a script can walk, and a cycle makes every milestone on it
# wait forever while each block reads, alone, as a sensible thing to wait on. One stood unnoticed
# from 2026-10-06 to 2026-10-07 (UTC): 809 (the package client becomes a program) named 198 (a
# package manager), 198 the umbrella named 802 (the trivial install), and 802 named 809. Each edge
# was written by a different lane on a different day, so no reader of one block could see it; only
# a walk of the whole graph can. Every edge counts, BUILT or not, because a BUILT milestone on a
# cycle claims to have waited on something that waited on it, which is a record that is wrong.
def dependency_cycles(edges):
    """Each cycle once, as the list of milestones on it in edge order, from {n: [deps]}."""
    found, seen, state = [], set(), {}

    def walk(n, path):
        state[n] = "open"
        path.append(n)
        for m in edges.get(n, ()):
            if state.get(m) == "open":
                cyc = path[path.index(m):]
                key = frozenset(cyc)
                if key not in seen:
                    seen.add(key)
                    found.append(cyc[:])
            elif m not in state:
                walk(m, path)
        path.pop()
        state[n] = "done"

    for n in sorted(edges):
        if n not in state:
            walk(n, [])
    return found


assert dependency_cycles({809: [198, 205], 198: [801, 802], 802: [809]}) == [[198, 802, 809]]
assert dependency_cycles({1: [2], 2: [3], 3: []}) == []

dep_edges = {}
for num, _fname, role, tok in field_refs:
    if (role == "milestone_dependencies" and num is not None and tok.isdigit()
            and int(tok) in milestones and int(tok) != num):
        dep_edges.setdefault(num, []).append(int(tok))
for cyc in dependency_cycles(dep_edges):
    loop = " -> ".join(str(n) for n in cyc + cyc[:1])
    problems.append(f"design/roadmap: milestone_dependencies has a cycle, {loop}. Every milestone "
                    f"on it waits forever; find the edge that names more than it needs (usually "
                    f"an umbrella, where the part needed is its own milestone or already built)")

# ---- the five-column rendering, for `--index` --------------------------------
# Two escapes, and they are markdown's rather than this script's. A literal `|` inside a cell would
# end it, so it is written `\|` here and stored unescaped in the block, where it is ordinary prose.
# Two summaries and one title need it; one of them is milestone 67 (`swish` the language: quoting,
# sequencing, and exit status), which is ABOUT the `||` operator. A literal `]` inside a TITLE would end the link text, so
# it is written `\]`; found 2026-09-20 when milestone 448 (a refusal gets a number, a status, and a
# condition that would change it) minted the tree's first titles containing `#[path]` and the
# writer emitted a row the reader's own pattern rejected.
INDEX_HEADER = ["| #  | Status | Milestone | Why it matters (§14) | Built |",
                "|----|--------|-----------|----------------------|------------|"]


def cell(text, link_text=False):
    """Escape a cell's content. `link_text` also escapes `]`, which only a title needs."""
    out = text.replace("|", r"\|")
    return out.replace("]", r"\]") if link_text else out


for num in sorted(milestones):
    ms = milestones[num]
    tail = f" {ms['built']} |" if ms["built"] else " |"
    generated[num] = (f"| {num} | {ms['status']} | [{cell(ms['title'], link_text=True)}]({ms['file']}) "
                      f"| {cell(ms['summary'])} |" + tail)
# ---- unnumbered proposals (milestone 247, calef 2026-09-03) -------------------
# **Anybody may add to the roadmap; prioritising it is a different act.** That is an architect's
# distinction and it dissolves a rule this tree had been treating as one thing. Lanes could not
# mint milestone numbers because concurrent lanes cannot see each other and two reaching for the
# same number collide. The collision is in the NUMBER, not in the authority, and conflating them
# meant a lane that found work had to route it through a report, through the maintainer, into a
# decision that might be deferred. Every hop is a chance to lose it, and on the day this landed the
# maintainer had buried three items by deferring them into chat messages.
#
# So a proposal is a file with no number: `design/roadmap/proposals/<slug>.md`. The slug is the
# readable half of a numbered block's name, so nothing new has to be learned, and it collides only
# if two lanes pick the same words, which is visible rather than silent. **GUIDs were considered and
# rejected by calef**: milestones are cited in prose constantly and a GUID cannot be said out loud,
# where this tree already found bare numbers too opaque and cites by number AND name. Numbers also
# carry recency for free, which is why they stay for promoted blocks.
#
# **Promotion** is the integrator's, at merge, like every other global name: give the file its
# number and `git mv` it up a directory. Nothing else changes, because a proposal already carries
# the status and gate lines a numbered block carries.
#
# **The graveyard question, asked here rather than discovered later.** A proposal nobody promotes is
# the same burial in a new location. Nothing here can force a promotion, and a gate that tried
# ("no proposal older than N days") would be routed around by not writing proposals, which is worse.
# What this does instead is make the pile impossible to not see: the status line carries the date it
# was written, `--check` prints the count and the age of the oldest on every lint run, and
# `--proposed` lists them oldest first. An unread number is still rung two; a paragraph in a
# finished block was rung four.
proposals = []
pdir = os.path.join(d, PROPOSED_DIR)
for fname in sorted(os.listdir(pdir)) if os.path.isdir(pdir) else []:
    rel = f"{PROPOSED_DIR}/{fname}"
    named = roadmap_proposals.filename_problem(fname)
    if named == roadmap_proposals.EXEMPT_FILE:
        continue
    # A proposal over §212's budget takes an appendix like any block (proposals/README.md says so),
    # and §212's default siting is a parent-named directory: `<slug>/` beside `<slug>.md`. The
    # prose ratchet's orphan rule checks that every file in it is linked from the proposal. Before
    # 2026-10-06 (UTC) this check refused the directory the README told a lane to write (#1777).
    # Promotion must `git mv` the directory with the file.
    if (named == roadmap_proposals.NOT_MARKDOWN
            and os.path.isdir(os.path.join(pdir, fname))
            and os.path.isfile(os.path.join(pdir, fname + ".md"))):
        continue
    if named == roadmap_proposals.NOT_MARKDOWN:
        problems.append(f"{rel}: only proposal files live here (<slug>.md)")
        continue
    if named == roadmap_proposals.NOT_A_SLUG:
        problems.append(f"{rel}: a proposal filename is a lowercase hyphenated slug and carries "
                        f"NO number. The number is assigned at promotion, which is what lets a "
                        f"lane add to the roadmap without coordinating with any other lane")
        continue
    ptext = open(os.path.join(pdir, fname)).read()
    when, title, problem = roadmap_proposals.classify(ptext)
    plines = ptext.split("\n")
    if problem == roadmap_proposals.NO_TITLE:
        problems.append(f"{rel}: line 1 must be '# <title>', with no milestone number: an "
                        f"unpromoted proposal has none (found {plines[0][:40]!r})")
        continue
    pfields, _, _ = roadmap_block.frontmatter(plines)
    if pfields is None:
        problems.append(f"{rel}: no frontmatter. A proposal carries the numbered block's, with "
                        f"'status: PROPOSED', the date it was written as 'raised', and all five "
                        f"dependency fields; one in the old prose form converts with "
                        f"`script/roadmap --migrate design/roadmap/{rel}`")
        continue
    if problem in (roadmap_proposals.NO_STATUS, roadmap_proposals.NO_GATE):
        problems.append(f"{rel}: a proposal's frontmatter carries 'status: PROPOSED', the date it "
                        f"was written as 'raised', and all five of §207's dependency fields. The "
                        f"date is what makes the pile measurable, and a proposal a lane cannot "
                        f"start is worth as little as a milestone a lane cannot start")
        continue
    check_fields(rel, None, "PROPOSED", pfields)
    # A proposal owes the Reuse record too: promotion is a `git mv` at merge, and a proposal that
    # lacked it would fail the check only in the integrator's tree, after the lane is gone.
    problems.extend(reuse_problems(rel, "PROPOSED", pfields.get("raised"), plines))
    proposals.append((when, rel, title))
# A proposal's fields were checked as it was read, after the numbered blocks' references resolved,
# so its own references resolve here.
if any(r[0] is None for r in field_refs):
    resolve(r for r in field_refs if r[0] is None)

# **A promoted proposal leaves the pile, and that is the only disposition it has.** calef, 2026-09-15,
# promoting `one-grant-order-for-the-progenitor` to milestone 301 and disposing of it in the same
# act. `classify` above matches PROPOSED and nothing else, so there is no way to retire a proposal
# where it stands; the `git mv` IS the retirement. This fires when a numbered block says it was
# promoted from a proposal that is still sitting in the pile, which means the block was authored as
# a new file instead of moved, and both records now exist.
#
# **It forces no promotions, which is what makes it gateable at all.** design/roadmap/README.md
# refused a gate on a proposal's AGE, because "no proposal older than N days" is routed around by
# not writing proposals, and the pile is better than the silence. This asks nothing of anyone who
# has not already promoted something: it fires only on a motion somebody started and left half
# finished. Three on the record when it was written (milestones 304, 313, 315).
for slug, by in sorted(promoted.items()):
    if os.path.exists(os.path.join(pdir, f"{slug}.md")):
        problems.append(f"{PROPOSED_DIR}/{slug}.md: {by} says it was promoted from this proposal, "
                        f"and the proposal is still here. Promotion DELETES it: the milestone is "
                        f"where the work lives now, and a promoted file left behind is a second "
                        f"place work accumulates (calef, 2026-09-18, reversing his own ruling of "
                        f"that morning). Fold anything the proposal carries that the block does not "
                        f"into the block, then `git rm` it")

# ---- a branch promotes only a proposal it held (COE decision 4, calef, 2026-10-03 UTC) --------
# See `unheld_promotions`. Reads git, so it runs only where there is a main to compare against: on
# main itself the merge base is HEAD and nothing is added. Where git cannot answer (no
# `origin/main`, a shallow clone) it says so and does not fail, because a gate that breaks every
# checkout it cannot read is worse than the gap; CI checks out at `fetch-depth: 0`. About 0.08 s.
def _git(*a):
    r = subprocess.run(["git", "-C", root, *a], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


_base = _git("merge-base", "origin/main", "HEAD")
if _base is None:
    print("roadmap: no merge base with origin/main; skipping the promotion-held check",
          file=sys.stderr)
elif _base.strip() != (_git("rev-parse", "HEAD") or "").strip():
    _base = _base.strip()
    _added_files = (_git("diff", "--name-only", "--diff-filter=A", _base, "HEAD", "--",
                         "design/roadmap/") or "").split()
    # A block whose number was already on main was promoted there, so a new file under that number
    # is the old block renamed. git's rename detection misses it when the block was also rewritten
    # (830, renamed and rewritten 2026-10-12 UTC, read as an add and failed here).
    _base_numbers = {os.path.basename(f).split("-", 1)[0] for f in (_git(
        "ls-tree", "--name-only", _base, "design/roadmap/") or "").split()}
    _added = [(os.path.basename(f), promoted_slug[os.path.basename(f)])
              for f in _added_files if os.path.basename(f) in promoted_slug
              and os.path.basename(f).split("-", 1)[0] not in _base_numbers]
    if _added:
        _held = {os.path.basename(f)[:-3] for f in (_git(
            "ls-tree", "--name-only", _base, "design/roadmap/proposals/") or "").split()}
        # --full-history: in CI HEAD is a PR merge ref. If the branch added a proposal and then
        # promoted it away, the merge tree matches main's here, and default history simplification
        # follows only the main side and hides the branch-only add.
        _held |= {os.path.basename(f)[:-3] for f in (_git(
            "log", f"{_base}..HEAD", "--full-history", "--diff-filter=A", "--name-only", "--format=", "--",
            "design/roadmap/proposals/") or "").split()}
        problems.extend(unheld_promotions(_added, _held))

# ---- the Follow-on section (milestone 247) ------------------------------------
# A finished milestone is the last place anyone looks, and the work it named on the way out is what
# this project keeps losing. Three recorded times: milestone 90 exists only because calef happened
# to be at his desk the day a lane report named it; milestone 94 swept the tree for exactly this
# category and left its own inventory in a pull request body for twelve days; milestone 244 named an
# unvouched-binary hazard in a BUGS section and a design fork in a handoff paragraph, and both
# surfaced only because calef asked "any work to follow up on 244?" by hand. That question is the
# mechanism today and it is rung zero: somebody has to remember to notice.
#
# **What is checked is a section, not prose.** AGENTS.md already priced the greppable alternative:
# `git grep -w TODO` runs an 82% false-positive rate, and a check that cannot tell an observation
# from an intention gets disabled within a week. Nothing here reads a block's prose looking for
# intent. It checks that a block which has FINISHED carries a heading under which its author was
# asked the question, and that whatever answer they wrote resolves to something.
#
# **The moment it fires is the moment the work is buried**, which is why it hangs on the status
# rather than on a marker: a lane turning its block BUILT is the last time anybody will read that
# block on purpose. The same shape as the TODO gate one level up (a marker with a resolvable
# referent) and as the citations gate (a claim grounded in the document it names), which is the
# third instance of a pattern this tree already knows rather than a novel one.
#
# **Four dispositions, and three of them are one line.** The section is a bullet list, each bullet
# opening with one of:
#
#   - **None.**              nothing was identified. The whole answer, and it must stand alone.
#   - **Milestone N.**       it became milestone N; the block must exist and must not be this one.
#   - **Recorded.**          it is a limitation and it stays one; names the file it lives beside,
#                            in backticks, and that file must exist.
#   - **Refused.**           it was considered and deliberately not taken; carries the reason.
#   - **Decision.** it is an architect's call and is written up as one; names the file under
#                            design/decisions/ that holds it.
#   - **Proposed.**          the block named work nobody has taken, so it is now a proposal in
#                            design/roadmap/proposals/, named here.
#   - **Done.**              it was done, and not as a milestone. Says what carried it: a pull
#                            request, a branch, a commit, or the file it now lives in.
#
# **`Done.` came from the same sweep, reported by four lanes independently.** Work named by a block
# and then finished by two ordinary commits fits none of the other words: `Milestone N.` is a lie
# about what happened and `Recorded.` is a lie about it still being open. Every one of those lanes
# resolved it by leaving the item out, which is the silence this whole gate exists to stop, arriving
# through the gate itself.
#
# **`Proposed.` is this gate's whole subject and it went through two shapes in a day.** The other
# dispositions handle a limitation the block accepts and a successor the block got. Neither handles
# the case milestone 247 exists for: a block that wrote its follow-on work down honestly, in the
# place a reader meets it, and nobody picked it up. `Recorded.` lies about intent and `Refused.`
# lies about the decision, so a lane forced to choose writes the more comfortable one, and three
# lanes that would not lie **left the item out**, which is the burial arriving through the gate.
#
# It was first spelled `Unclaimed.` and took only prose, because a lane could not mint a milestone
# number and had nothing to point at. calef removed that constraint the same day
# (design/roadmap/proposals/, above): **the collision was in the number, never in the authority.**
# So the disposition now resolves to a file somebody wrote, which is strictly stronger than a
# sentence promising that work exists, and it costs the author one file and no coordination.
#
# **`Decision.` is not a fifth tracked form**, it is the tree's existing second one. AGENTS.md:
# "Open decisions live in a file, not in a conversation." Without this bullet a decision owed to
# calef would have to be spelled as a refusal, which would be a lie in the one place this gate
# exists to stop lying.
#
# **`None.` and `Recorded.` are deliberately the cheapest things to write here**, because the
# failure mode of an over-strict version is worse than the burial it prevents. If every observation
# had to resolve to a milestone, the honest thing to write becomes expensive and BUGS sections get
# thinner, which costs more than this gate buys. AGENTS.md's BUGS convention is upstream of this
# check and is not weakened by it: `Recorded.` points AT a BUGS entry rather than replacing it.
#
# **An explicit refusal is a success.** The defect this attacks is silence, not the absence of a
# milestone.
#
# **There is no exemption list, and there was one for about an hour.** The first draft let a block
# that finished before the sweep sit on a list in notes/follow-on-work.md instead of carrying a
# section, because 137 blocks is not something one lane can sweep honestly. The sweep then reached
# all of them, the list closed to zero, and an empty list that permits parking is exactly the
# hiding place its own BUGS section had called a foot gun. So it is gone rather than kept at zero.
# **What counts as a path claim, and this had to be tightened twice.** A backticked span in this
# tree is usually prose (`MAX_CPUS`, `scounteren.CY`), sometimes a command (`script/names
# --unratified`), sometimes a shell example (`rm a/b/c.txt`), and only sometimes a file. Checking
# every span that held a slash fired on all four. So a span is a path claim only when it has no
# whitespace and begins with a directory this repository actually has, which still catches the rot
# this check exists for: milestone 136's pin named `crates/regions` after §113 renamed it.
#
# **The list used to be typed out here, and it drifted** (milestone 311). It still named `user/`
# nineteen days after milestone 175 split that directory into `components/` and `fixtures/`, and it
# named neither of the two. Both halves of that are defects and only one is visible: a stale entry
# makes a dead path *look* checkable, and a missing entry means a `**Recorded.**` bullet citing
# `components/src/...` is not read as a path claim at all, so the broken footnote this check exists
# to catch passes it in silence. `.cargo/` and `.githooks/` had never been in the list either.
#
# So it is derived from the tree instead of copied from it, which is rung one of AGENTS.md's ladder:
# the wrong state is now unrepresentable rather than merely gated. `git ls-tree` rather than
# `os.listdir` because an untracked `target/` is not a directory a citation should resolve into,
# and git is already this script's neighbour two checks down.
_ROOT_DIRS = subprocess.run(["git", "-C", root, "ls-tree", "-d", "--name-only", "HEAD"],
                            capture_output=True, text=True).stdout.split()
PATHISH = re.compile(r"(?:" + "|".join(re.escape(d) for d in sorted(_ROOT_DIRS)) + r")/\S+")
# **`Outstanding.` is milestone 252's one addition, and it is the word a PARTIAL block needs that a
# finished one does not.** Seven of the eight say where work WENT. A PARTIAL block's commonest answer
# is that the work has not gone anywhere and is still its own scope, and none of the seven can say
# that without lying: `Recorded.` claims a limitation that stays, `Proposed.` claims nobody owns it
# when this block does, and `Milestone N.` cannot name the block it is written in. A lane forced to
# choose would write the comfortable word or leave the item out, which is the silence this gate
# exists to stop arriving through the gate, exactly as `Done.` and `Proposed.` did on 247's sweep.
#
# **What it buys is the date, not the word.** The gate cannot tell a stale claim from a live one, and
# this does not change that. What changes is that somebody wrote "still true, and here is what I
# checked" beside each item, which is the act that found milestone 16's two finished items. Name
# provisional (an architect names things); the vocabulary it joins is provisional in the same way.
DISPOSITION = roadmap_block.DISPOSITION  # spelled in helpers/roadmap_block.py

swept = 0
partial_swept = 0
unclaimed = []
outstanding = []
for mid, fname in sorted(ids.items()):
    num = int(mid)
    if num not in milestones:
        continue
    text = open(os.path.join(d, fname)).read()
    lines = text.split("\n")
    heads = [n for n, l in enumerate(lines, start=1) if l.rstrip() == "## Follow-on"]
    if len(heads) > 1:
        problems.append(f"{fname}: {len(heads)} '## Follow-on' sections; one milestone answers the "
                        f"question once, and a second copy is the one that stops being updated")
    if not heads:
        if milestones[num]["status"] in ANSWERS:
            why = ("A finished block is the last place anyone looks, so it says what happened to "
                   "the work it named"
                   if milestones[num]["status"] in DATED else
                   "A PARTIAL block claims work is remaining, and nothing re-reads the claim, so "
                   "it enumerates what is left and says of each that it is still true")
            problems.append(
                f"{fname}: milestone {num} is {milestones[num]['status']} and carries no '## Follow-on' "
                f"section. {why}: bullets opening '**None.**', "
                f"'**Milestone N.**', '**Recorded.**' (naming the file the limitation lives "
                f"beside, in backticks), '**Refused.**' with a reason, '**Done.**' with what "
                f"carried it, '**Decision.**' naming a file under design/decisions/, "
                f"'**Proposed.**' naming its file under design/roadmap/proposals/, or (PARTIAL "
                f"only) '**Outstanding.**' with what is left and how you checked. See "
                f"design/roadmap/README.md and "
                f"notes/follow-on-work.md")
        continue
    swept += 1
    if milestones[num]["status"] == "PARTIAL":
        partial_swept += 1
    body, collecting = [], False
    for n, l in enumerate(lines, start=1):
        if l.rstrip() == "## Follow-on":
            collecting = True
            continue
        if collecting:
            if l.startswith("#"):
                break
            body.append((n, l))
    # A bullet is its first line plus every continuation line under it, joined. Reading only the
    # first line was this check's own first defect, found within the hour by a lane whose path
    # wrapped onto line two: the bullet was correct and the gate called it pathless.
    bullets = []
    for n, l in body:
        if l.startswith("- "):
            bullets.append([n, l])
        elif bullets and (l.startswith("  ") or l.startswith("\t")) and l.strip():
            bullets[-1][1] += " " + l.strip()
    bullets = [(n, l) for n, l in bullets]
    if not bullets:
        problems.append(f"{fname}: '## Follow-on' has no bullets. '- **None.**' is the whole "
                        f"answer when nothing was identified, and it is meant to be cheap to say")
    for n, l in bullets:
        dm = DISPOSITION.match(l.rstrip())
        if not dm:
            problems.append(f"{fname}:{n}: {l[:60]!r} is not a disposition. Every bullet under "
                            f"'## Follow-on' opens '**None.**', '**Milestone N.**', "
                            f"'**Done.**', '**Recorded.**', '**Refused.**', '**Decision.**', "
                            f"'**Proposed.**' or '**Outstanding.**' "
                            f"(see design/roadmap/README.md)")
            continue
        kind, rest = dm.group(1).split(" ")[0], dm.group(3).strip()
        if kind == "None":
            if len(bullets) > 1:
                problems.append(f"{fname}:{n}: '**None.**' says nothing was identified, so it "
                                f"cannot sit beside {len(bullets) - 1} other disposition(s)")
            # **The one thing this gate can prove about a PARTIAL block**, and it is worth more
            # than the enumeration: PARTIAL means "built in part, work remains", so a block whose
            # whole answer is that nothing is outstanding has contradicted its own status word.
            # Either something is left, or the status is wrong and the row wants BUILT with a date.
            # This is the milestone-69 class of defect (the row and the block disagreeing) one
            # level in, where the block disagrees with itself.
            if milestones[num]["status"] == "PARTIAL":
                problems.append(f"{fname}:{n}: milestone {num} is PARTIAL and answers '**None.**', "
                                f"which is a contradiction: PARTIAL means work remains. Either "
                                f"name what is left, or the status is stale and the row wants "
                                f"BUILT with a date")
        elif kind == "Milestone":
            target = int(dm.group(2))
            if target not in milestones:
                problems.append(f"{fname}:{n}: names milestone {target}, which has no block "
                                f"under design/roadmap/")
            elif target == num:
                problems.append(f"{fname}:{n}: names itself as its own follow-on")
        elif kind == "Recorded":
            # **A path is checked when one is named, and never demanded.** The first draft of this
            # required every `Recorded.` bullet to name an existing file, and three lanes hit it
            # within the hour on bullets that were correct: a backticked identifier is ordinary
            # prose here (`MAX_CPUS`, `scounteren.CY`, `display_terminal`), and the common case is
            # a limitation recorded in the block the reader is already holding, where repeating
            # the block's own path in five consecutive bullets is noise.
            #
            # It is also the BUGS convention's own boundary, which this gate must not cross. "This
            # is a limitation and it stays one" has to stay the cheapest sentence in the roadmap,
            # or the honest thing becomes expensive to write and the BUGS sections thin out, which
            # costs more than the burial does. So the bullet owes prose, the same as a refusal,
            # and a citation is checked only for being true.
            named = [p for p in re.findall(r"`([^`]+)`", rest) if PATHISH.fullmatch(p)]
            dead = [p for p in named if not os.path.exists(os.path.join(root, p.split("#")[0]))]
            if dead:
                problems.append(
                    f"{fname}:{n}: '**Recorded.**' names {dead}, which does not exist. A citation "
                    f"that resolves to nothing is a broken footnote, and a rename is how it "
                    f"happens: milestone 136's pin still named crates/regions after §113 moved it")
            elif len(rest) < 40:
                problems.append(f"{fname}:{n}: '**Recorded.**' says what the limitation is and "
                                f"where a reader meets it. A bare one is silence with a heading "
                                f"over it (found {rest!r})")
        elif kind == "Decision":
            paths = re.findall(r"`([^`]+)`", rest)
            real = [p for p in paths
                    if p.startswith("design/decisions/")
                    and os.path.exists(os.path.join(root, p.split("#")[0]))]
            if not real:
                problems.append(
                    f"{fname}:{n}: '**Decision.**' means an architect's call is written up as "
                    f"one, so it names the file under design/decisions/ that holds it, in "
                    f"backticks, and that "
                    f"file has to exist (found {paths if paths else 'no path'}). A decision that "
                    f"lives only in a conversation is the medium AGENTS.md abolished")
        elif kind == "Outstanding":
            # Restricted to PARTIAL on purpose. On a finished block "still outstanding" is either a
            # limitation (`Recorded.`), work nobody took (`Proposed.`), or a successor
            # (`Milestone N.`), and letting the word through there would give all three a softer
            # synonym to hide in. On a PARTIAL block it is the honest answer and the other three
            # are the lies.
            if milestones[num]["status"] != "PARTIAL":
                problems.append(f"{fname}:{n}: '**Outstanding.**' is for a PARTIAL block, whose "
                                f"own scope is what is left. Milestone {num} is {milestones[num]['status']}: "
                                f"work still open there is '**Recorded.**', '**Proposed.**' or "
                                f"'**Milestone N.**'")
            elif len(rest) < 40:
                problems.append(f"{fname}:{n}: '**Outstanding.**' says what is left AND how you "
                                f"checked it is still left, because the checking is the only part "
                                f"of this a gate cannot do. Milestone 16 carried two items that "
                                f"were finished, and reading the tree is what found them "
                                f"(found {rest!r})")
            else:
                outstanding.append((num, fname, n, rest))
        elif kind == "Done" and len(rest) < 40:
            problems.append(f"{fname}:{n}: '**Done.**' says what carried the work, because a claim "
                            f"that something happened is only useful if a reader can go and look: "
                            f"a pull request, a branch, a commit, or the file it lives in now "
                            f"(found {rest!r})")
        elif kind == "Proposed":
            named = [p for p in re.findall(r"`([^`]+)`", rest)
                     if p.startswith(f"design/roadmap/{PROPOSED_DIR}/")]
            real = [p for p in named if os.path.exists(os.path.join(root, p))]
            if not real:
                problems.append(
                    f"{fname}:{n}: '**Proposed.**' names the proposal file that now holds this "
                    f"work, in backticks, under design/roadmap/{PROPOSED_DIR}/, and that file has "
                    f"to exist (found {named if named else 'no proposal'}). Writing one costs a "
                    f"file and no coordination, which is why a promise in prose is not enough")
            else:
                unclaimed.append((num, fname, n, rest))
        elif kind == "Refused" and len(rest) < 40:
            problems.append(f"{fname}:{n}: '**Refused.**' carries the reason it was refused. A "
                            f"refusal with a reason is a success here; a bare one is silence with "
                            f"a heading over it (found {rest!r})")


# ---- a correction's action items (§210, and calef's review of #1513) ----------
# The same disposition vocabulary as the Follow-on check above, read out of every
# `notes/coes/*.md` `## Action items` section and resolved to a file that says whether it is
# done. helpers/coe_actions.py holds the parse and the open-or-closed rule, because
# `script/metrics` counts the open ones each week and the two must not disagree about either. A
# correction whose action item resolves to nothing has produced nothing (§210 (a correction of
# error, and its action items are decisions, proposals or milestones)), so it fails here.
import coe_actions                                                          # noqa: E402

_coe_texts = {}
for _dir in ("design/roadmap", "design/decisions", coe_actions.DIRECTORY,
             *coe_actions.OLDER_DIRECTORIES, "notes"):
    _full = os.path.join(root, _dir)
    for _name in sorted(os.listdir(_full)) if os.path.isdir(_full) else []:
        if _name.endswith(".md") and (_dir != "notes" or coe_actions.is_record(f"notes/{_name}")):
            with open(os.path.join(_full, _name)) as _f:
                _coe_texts[f"{_dir}/{_name}"] = _f.read()
coe_counts, _coe_problems = coe_actions.evaluate(
    _coe_texts, lambda p: os.path.exists(os.path.join(root, p)))
for _path, _n, _problem in _coe_problems:
    problems.append(f"{_path}{':' + str(_n) if _n else ''}: {_problem}")


# ---- an IN-PROGRESS branch that already merged --------------------------------
# The other half of the check above, and the one that caught real defects: a branch named by an
# IN-PROGRESS status which this history has already MERGED is not active work, it is a milestone that
# shipped and never had its status moved. Four of the six found on 2026-08-17 were exactly this, and
# milestone 115 was being listed under IN-PROGRESS and under "ready to start" simultaneously, so the
# queue was offering a lane work that had landed thirteen days earlier.
#
# Deliberately LOCAL and deliberately not `git ls-remote`. Asking the remote whether a branch still
# exists is the more obvious check and it is worse on three counts: it needs network in a gate that
# otherwise only reads files, it cannot tell a merged lane from a lane that died, and a deleted
# branch is ambiguous where a merge commit is proof. Merge subjects are already in the history every
# checkout has.
#
# The cost is zero unless the token is in use: no IN-PROGRESS block means no subprocess at all.
#
# **And it must refuse a history it cannot see, which is how this check spent a day passing in CI
# while being unable to fail.** `actions/checkout` clones to depth 1 unless told otherwise, and the
# job that runs `script/lint` did not tell it otherwise, so `git log --merges` returned nothing, no
# branch matched, and the check reported success. On 2026-09-03 milestone 247 merged reading
# IN-PROGRESS on its own branch, every pull request's clippy went green, and `main` went red the
# moment somebody ran the same gate on a full clone. A check that cannot fail is worse than a check
# that is absent, because its green is read as an answer. The `fetch-depth: 0` in ci.yml fixes it for
# that job; this refusal is what stops a future job reintroducing it silently.
if in_progress_branches:
    log = subprocess.run(["git", "-C", root, "log", "--merges", "--format=%s"],
                         capture_output=True, text=True)
    subjects = log.stdout
    if not subjects.strip():
        problems.append(
            "the merged-branch check cannot see any merge commits, so it cannot answer whether an "
            "IN-PROGRESS branch has already landed. That is a shallow clone (actions/checkout "
            "defaults to depth 1) rather than a repository with no merges, and the check passes "
            "vacuously in it. Give the job `fetch-depth: 0`")
    for num, fname, branch in in_progress_branches:
        # `Merge pull request #124 from calef/milestone/58-riscv-tlb-shootdown`, and the plain
        # `Merge branch 'x'` form. Anchored at a word boundary so `milestone/58` does not match
        # `milestone/58-something-else`.
        if re.search(rf"(?:from [^ /]+/|branch '){re.escape(branch)}(?:'|$)", subjects, re.M):
            problems.append(f"milestone {num}: IN-PROGRESS on {branch!r}, which this history has "
                            f"already merged. That is a milestone that shipped and never had its "
                            f"status moved, four of which were found stale on 2026-08-17 (one for "
                            f"thirteen days). Set the status from the tree and give it a Built date")

# ---- citations, tree-wide ----------------------------------------------------
# `milestone 16a` resolves as 16, since prose names a block's phases with a letter. Case-insensitive on the M because
# prose starts sentences with it. vendor/ and patches/ are other people's text.
grep = subprocess.run(
    ["git", "-C", root, "grep", "-I", "-n", "-E", "[Mm]ilestone [0-9]+",
     "--", ":!vendor/", ":!patches/"],
    capture_output=True, text=True)
for line in grep.stdout.splitlines():
    loc = ":".join(line.split(":", 2)[:2])
    for m in re.finditer(r"[Mm]ilestone (\d+)", line.split(":", 2)[2]):
        n = int(m.group(1))
        # No floor: milestones 1 to 11 were backfilled from the first commits on 2026-08-03,
        # so every citation back to the first instruction resolves or fails the gate.
        if n not in milestones:
            problems.append(f"{loc}: cites milestone {n}, which has no block under "
                            f"design/roadmap/")

# ---- `--index`, which is a data feed and not a document ----------------------
# `script/audits` counts BUILT rows out of this for its cadence trigger, and `script/fatal-risks`
# takes the Built dates out of it for its "as of" check. Both used to open the committed table and
# read its lag as a fact, which jammed four pull requests on 2026-09-19 (milestone 443 (lanes wait
# on each other for three reasons, and none of them is the work)); they moved upstream to this, and
# when the table itself was retired on 2026-09-21 they needed no further change, which is the point
# of having moved them.


def rendered():
    return "\n".join(INDEX_HEADER + [generated[n] for n in sorted(generated)])


if mode == "--index":
    print(rendered())
    sys.exit(0)

# ---- report ------------------------------------------------------------------
ready = sorted(n for n, g in gates.items() if g == ["NONE"] and milestones[n]["status"] in STARTABLE)


if mode == "--check":
    for p in sorted(set(problems)):
        print(f"roadmap: {p}", file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"roadmap: {len(milestones)} milestones, {len(ids)} files, status vocabulary clean, "
          f"every '## Index row' parses, every tree-wide citation resolves")
    print(f"roadmap: {len(gates)} of them classified by gate, {len(ready)} ready to start "
          f"(script/roadmap --ready)")
    print(f"roadmap: {swept} blocks answer '## Follow-on', {partial_swept} of them PARTIAL")
    print(f"roadmap: {len(outstanding)} pieces of work are outstanding on a PARTIAL milestone "
          f"(script/roadmap --outstanding)")
    print(f"roadmap: {len(unclaimed)} pieces of follow-on work were named by a finished "
          f"milestone and became proposals (script/roadmap --unclaimed)")
    nrefused = sum(1 for ms in milestones.values() if ms["status"] == "REFUSED")
    if nrefused:
        print(f"roadmap: {nrefused} milestones are REFUSED and every one states what would change "
              f"it; they are excluded from the gate, ready and outstanding counts above "
              f"(script/roadmap --revisit)")
    if proposals:
        print(f"roadmap: {len(proposals)} unnumbered proposals awaiting a number, oldest "
              f"{min(p[0] for p in proposals)} (script/roadmap --proposed)")
    print(f"roadmap: {sum(o for o, _c in coe_counts.values())} correction action items open, "
          f"{sum(c for _o, c in coe_counts.values())} closed, across {len(coe_counts)} "
          f"corrections (script/roadmap --coe-actions)")
    sys.exit(0)

if mode == "--revisit":
    # ---- the bell (milestone 448) ------------------------------------------------
    # A REFUSED block states what would change it. This asks the one part of that a machine can
    # answer: does the condition name a milestone that has since turned BUILT? If it does, the
    # thing the refusal was waiting for has happened and nobody compared the two, which is exactly
    # how milestone 164's Route 2 went stale while stating its condition perfectly.
    #
    # **Its reach is small and stated rather than implied.** A condition is prose. This catches the
    # mechanical case, a citation of a milestone number, and misses every condition phrased as a
    # workload, a measurement, a customer or a piece of hardware, which is most of them. The
    # denominator is printed on every run for that reason: a reader should be able to see what
    # fraction of the conditions this check can see at all, rather than reading a clean run as
    # "nothing has gone stale". See BUGS in this script's header.
    # **A condition almost always names the block that refused it**, because the reasoning being
    # quoted is that block's. Those citations are context and never triggers, and left in they made
    # this check useless on its first run: both of its two findings were a block pointing at its own
    # origin. So the milestones named in a REFUSED block's status paragraph, which are by
    # construction the ones that refused it, are excluded here.
    rung = []
    for num, fname, n, kind, rest in sorted(revisits):
        for m in re.finditer(r"[Mm]ilestone (\d+)", rest):
            t = int(m.group(1))
            if t in refused_by.get(num, ()):
                continue
            if t in milestones and milestones[t]["status"] == "BUILT":
                rung.append((num, fname, n, t, rest))
                break
    for num, fname, n, t, rest in rung:
        print(f"  {num:>3}  {milestones[num]['title'][:66]}")
        print(f"       names milestone {t} ({milestones[t]['title'][:48]}), BUILT "
              f"{milestones[t]['built']}")
        print(f"       {fname}:{n}")
        print(f"       {rest[:150]}")
    refused = sorted(n for n, ms in milestones.items() if ms["status"] == "REFUSED")
    cited = {r[0] for r in revisits
             if any(int(m) not in refused_by.get(r[0], ())
                    for m in re.findall(r"[Mm]ilestone (\d+)", r[4]))}
    print(f"\n{len(rung)} of {len(refused)} REFUSED milestones name a condition this check can "
          f"see and that has come true. {len(cited)} state a condition naming a milestone at all; "
          f"the other {len(refused) - len(cited)} are phrased as a workload, a measurement, a "
          f"customer or a piece of hardware, and nothing here can read those")
    sys.exit(0)

if mode == "--coe-actions":
    # Every open action item, by correction, so the number script/metrics charts has a list behind
    # it. Closed ones are counted, not listed: a reader asking this wants what is left.
    _ctx = coe_actions.context(_coe_texts)
    for _path in sorted(coe_counts):
        _items, _ = coe_actions.bullets(_coe_texts[_path])
        for _n, _line in _items:
            _state, _ = coe_actions.resolve(_line, _ctx, lambda p: os.path.exists(os.path.join(root, p)))
            if _state == "open":
                print(f"  {_path}:{_n}  {_line[2:100]}")
    print(f"\n{sum(o for o, _c in coe_counts.values())} open, "
          f"{sum(c for _o, c in coe_counts.values())} closed")
    sys.exit(0)

if mode == "--proposed":
    # Oldest first, because age is the only thing that distinguishes a proposal from a graveyard.
    for when, rel, title in sorted(proposals):
        print(f"  {when}  {title[:72]}")
        print(f"              design/roadmap/{rel}")
    print(f"\n{len(proposals)} proposals with no number. Promoting one is the integrator's: give "
          f"it a number and git mv it up a directory")
    sys.exit(0)

if mode == "--outstanding":
    # What is actually left, per PARTIAL milestone, derived from the blocks rather than maintained
    # beside them. This is the question calef had to ask by hand about a PARTIAL block, which is the
    # whole reason milestone 252 exists, answered as a command instead.
    for num, fname, n, rest in sorted(outstanding):
        print(f"  {num:>3}  {rest[:96]}")
    print(f"\n{len(outstanding)} outstanding items across {partial_swept} PARTIAL milestones. "
          f"None of it is checked for still being true; a person wrote that down, once")
    sys.exit(0)

if mode == "--unclaimed":
    # Work a finished block named, nobody took, and that now has a proposal file. Derived from the
    # blocks, so it cannot go stale the way a separate list would.
    for num, fname, n, rest in sorted(unclaimed):
        print(f"  {num:>3}  {rest[:96]}")
        print(f"       {fname}:{n}")
    print(f"\n{len(unclaimed)} unclaimed, named by {len({u[0] for u in unclaimed})} milestones")
    sys.exit(0)

if mode == "--unmodelled":
    # §207: the dependency fields are backfilled lazily, so a block without them is legal and is
    # debt, and this is where the debt is visible rather than assumed away. An unbuilt block without
    # them fails --check; a finished one (BUILT, REMOVED, REFUSED) may go without, because what it
    # waited on was cleared by the gate it had before 596 and cannot be recovered from the block.
    by_status = {}
    for n, ms in milestones.items():
        if n not in modelled:
            by_status.setdefault(ms["status"], []).append(n)
    for s in sorted(by_status, key=lambda s: -len(by_status[s])):
        print(f"  {s:<12} {len(by_status[s]):>4}")
    print(f"\n{sum(map(len, by_status.values()))} of {len(milestones)} milestones carry no "
          f"dependency fields")
    sys.exit(0)

if mode == "--ready":
    # The maintainer's question, answered from the files rather than from a conversation: nothing
    # gates these and nobody is on them.
    for n in ready:
        print(f"  {n:>3}  {milestones[n]['status']:<11}  {milestones[n]['title'][:66]}")
    print(f"\n{len(ready)} ready of {len(gates)} not built")
    sys.exit(0)

if mode:
    print(f"roadmap: unknown argument {mode!r} (no argument, --ready, --unclaimed, "
          f"--outstanding, --proposed, --revisit, --unmodelled, --index, --check, "
          f"--ready-branch BRANCH, --selftest, or --migrate [FILE...])", file=sys.stderr)
    sys.exit(2)

by_status = {}
for n, ms in milestones.items():
    by_status.setdefault(ms["status"], []).append((n, ms["title"]))

for status in VOCAB:
    items = sorted(by_status.get(status, []))
    if not items:
        continue
    print(f"\n{status} ({len(items)})")
    for n, title in items:
        print(f"  {n:>3}  {title[:76]}")

by_gate = {}
for n, g in gates.items():
    for token in g:
        by_gate.setdefault(token, []).append(n)


def gate_order(token):
    # NONE first, then the two standing gates, then the milestone gates in numeric order, because
    # "MILESTONE 106" sorts before "MILESTONE 16" as text and that reads as a mistake.
    kind, _, n = token.partition(" ")
    n = n.lstrip("§")
    return (kind == "MILESTONE", 0 if kind == "NONE" else 1, kind, int(n) if n.isdigit() else 0)


print(f"\nGATES (what stops the {len(gates)} milestones that are not built)")
for token in sorted(by_gate, key=gate_order):
    label = "NONE (ready to start)" if token == "NONE" else token
    print(f"  {label:<22} {', '.join(str(n) for n in sorted(by_gate[token]))}")

print(f"\ntotal: {len(milestones)} milestones, {len(ready)} ready to start")
for p in sorted(set(problems)):
    print(f"PROBLEM: {p}")
PY
