#!/bin/sh
# script/lint: run clippy across the workspace with warnings denied (the CI `lint` job's gate).
#
# Two invocations, because the workspace has two worlds: the pure-logic host crates and xtask build
# for the host, while kernel and user are bare-metal no_std and only build for the aarch64 target.
# Both use --all-targets so test code is linted too; the kernel supplies its own test harness
# (custom_test_frameworks) and the user bin opts its libtest target out (user/Cargo.toml), which is
# what lets --all-targets work on the bare-metal target. Not one of the canonical scripts, but it
# keeps the CI job a one-liner. It also lints each kernel boot-mode feature (shell/bench/icount/...)
# separately, because each compiles different code and a warning can hide in a configuration the
# default build never compiles. See notes/scripts.md.
#
# Name: recorded (AGENTS.md's naming section, "standard terms a reader already knows from
# outside"; and DECISIONS §134 for the verb half). Introduced 2026-07-22 with the Scripts to Rule
# Them All adoption, though it is not one of that convention's canonical names. "Lint" is the
# field's own word for the thing, from the 1978 C checker onward, so the protected class keeps it
# and a rename would spend a newcomer's recognition to buy nothing. It does rather than reports,
# which puts it in §134's verb half where its form already sits. no architect has ratified it.

set -e
cd "$(dirname "$0")/.."

# This project's own QEMU, if `script/ci-qemu` has built one. This file matches its own
# "the project's QEMU is on PATH" rule below, because a checker's source necessarily
# carries every pattern it looks for; taking the line is cheaper than an exemption.
. helpers/qemu-path.sh

# The host pass excludes every crate that cannot compile for the host: `user_mode_runtime` (the EL0 syscall
# runtime, inline `asm!` naming architecture registers) and everything that depends on it.
#
# **The old comment here said "on CI's x86_64 host those registers are unknown register errors", and
# it was wrong in both directions by 2026-08-14.** CI runs on `ubuntu-24.04-arm`, where the asm
# compiles; and excluding `user_mode_runtime` alone never removed it from the dependency graph, so four crates
# that took unconditional `user_mode_runtime` dependencies dragged it into the host pass anyway. The result was
# a workspace that did not build on x86_64, invisible to the one gate that would have caught it
# because that gate runs on aarch64. Found by milestone 117's first stranger run.
#
# The "host pass excludes exactly the bare-metal crates" gate below derives this set rather than
# trusting this line.
# `--baselines`: only the icount-baseline-vs-pin check. `.githooks/pre-push` calls this beside
# `--clippy` because the two are the cheap gates a push can break: code shape, and pin state.
# Added 2026-09-30 after #1463's toolchain bump pushed past an unread lint with the floors
# unstamped: a failure no rust-level hook could ever see.
if [ "${1:-}" = "--baselines" ]; then
    echo "==> baselines-only mode (pre-push); the rest of lint still runs before any report or merge"
    python3 "$(dirname "$0")/../helpers/lint_icount_baselines.py" || exit 1
    exit 0
fi

# `--no-cargo`: every check that never runs cargo, which is what `.githooks/pre-push` runs (milestone
# 729 (the pre-push hook runs what fits in seconds), provisional, from COE decision 3, 2026-10-03). The hook had been all of lint, 70 to 202 s
# measured on a loaded machine, past an agent harness's two-minute limit when cold, so lanes took to
# `--no-verify` and the gate caught nothing. What a push can break and a person would otherwise learn
# from CI is mostly text (36 of 38 lint failures on pull requests, 09-19 to 10-03), and text checks
# are the seconds-long ones. Clippy stays in CI.
#
# **The partition is read from this file, not kept beside it.** `helpers/lint-no-cargo.awk` splits
# this script at each `echo "==> ` line and drops every section that invokes cargo; its header says
# how a section opts back in and what keeps the opt-in honest. So a new check is in exactly one
# bucket the moment it is written, and nothing here lists names that can lag. `--no-cargo --list`
# prints which sections run and which are skipped. The filtered text runs with $0 still naming this
# file, because many sections locate the tree from it.
if [ "${1:-}" = "--no-cargo" ]; then
    lint_self="$(pwd)/script/lint"
    if [ "${2:-}" = "--list" ]; then
        exec awk -v mode=list -f helpers/lint-no-cargo.awk "$lint_self"
    fi
    echo "==> no-cargo mode (pre-push): every check that does not run cargo; CI and script/lint run the rest"
    # The filtered text goes through a temp file, never argv: it is about 190 KB, and Linux caps one
    # argument at 128 KB (MAX_ARG_STRLEN), so `sh -c "$text"` failed there with "Argument list too
    # long". macOS has no per-argument cap, which is why it went unseen. Not stdin either, since a
    # section that reads stdin would eat the script. `.` keeps $0 naming this file.
    lint_tmp="$(mktemp "${TMPDIR:-/tmp}/lint-no-cargo.XXXXXX")" || exit 1
    trap 'rm -f "$lint_tmp"' EXIT HUP INT TERM
    awk -v mode=emit -f helpers/lint-no-cargo.awk "$lint_self" > "$lint_tmp" || exit 1
    LINT_NO_CARGO=1 sh -c 'lint_tmp=$1; shift; . "$lint_tmp"' "$lint_self" "$lint_tmp"
    exit $?
fi

echo "==> the pre-push hook's contract with this script"
# The pre-push hook's contract with this script, checked (2026-09-29). `.githooks/pre-push` runs
# `script/fmt --check` then `script/lint --no-cargo` before any push leaves a worktree, and every
# part of that line can rot silently: a script the hook names can be renamed, and the hook's own
# `[ -x ... ]` tolerance then exits 0 and the gate stops gating with no signal anywhere; or a flag
# can drift out of this parser, and the hook falls through to this full run, slower and unnoticed.
# This section sits before every cargo section on purpose, so the hook's own invocation (which
# drops those) proves the contract at every push. It may look like it breaks old branches, whose trees lack the hook, but
# a branch runs the lint it contains: only a tree with a current lint executes this, and a current
# lint implies the hook. Deleting the hook is therefore a deliberate act that fails here until
# this check goes with it, which is the sentence a pull request deleting a gate should have to
# write.
lint_root="$(git rev-parse --show-toplevel)"
[ -x "$lint_root/.githooks/pre-push" ] || {
    echo "lint: .githooks/pre-push is missing or not executable, so the pre-push gate is gone" >&2
    exit 1
}
for hook_script in $(grep -oE 'script/[a-z0-9_-]+' "$lint_root/.githooks/pre-push" | sort -u); do
    [ -x "$lint_root/$hook_script" ] || {
        echo "lint: the pre-push hook calls $hook_script, which does not exist here; pushes would skip it silently" >&2
        exit 1
    }
done
for hook_flag in $(grep -oE 'script/lint (-[a-z-]+ ?)+' "$lint_root/.githooks/pre-push" | grep -oE '\--[a-z-]+' | sort -u); do
    grep -q -- "\"$hook_flag\"" "$0" || {
        echo "lint: the pre-push hook passes $hook_flag to this script, which no longer knows it; the hook falls through to the full run unnoticed" >&2
        exit 1
    }
done

echo "==> the commit-msg hook (an agent's commit carries a Co-Authored-By trailer)"
# Milestone 725 (provisional): `.githooks/commit-msg` refuses a commit made under an agent harness
# (CLAUDECODE=1 or OPENCODE=1) with no trailer. Same reasoning as the pre-push contract above: a
# hook that is deleted or loses its executable bit stops gating with no signal, so its absence
# fails here, and its behaviour is proved against a scratch repository (no cargo, so it runs in
# the pre-push `--no-cargo` mode too).
[ -x "$lint_root/.githooks/commit-msg" ] || {
    echo "lint: .githooks/commit-msg is missing or not executable, so agent commits are no longer checked for a trailer" >&2
    exit 1
}
helpers/commit-msg-selftest.sh >/dev/null

# The partition `--no-cargo` relies on, proved against fixtures (no tree, no cargo).
helpers/lint-no-cargo-selftest.sh >/dev/null

echo "==> clippy: host crates + xtask"
cargo clippy --workspace --exclude kernel --exclude system_tests --exclude components --exclude fixtures --exclude user_mode_runtime \
    --exclude swap_protocol --exclude virtio --exclude supervision_protocol --exclude system_initializer \
    --all-targets -- -D warnings

# The RedoxFS host tool (tools/redoxfs_host) is its own workspace, outside ours on purpose (it wraps
# the vendored engine, which we do not want in our gates; see Cargo.toml). Lint it on its own so our
# code there is still held to -D warnings. The engine it depends on is external to its workspace too,
# so clippy does not lint upstream redoxfs, only our tool.
echo "==> clippy: redoxfs_host (its own workspace)"
cargo clippy --manifest-path tools/redoxfs_host/Cargo.toml --all-targets -- -D warnings

# redoxfs_server is its own workspace too (it wraps the vendored RedoxFS engine, which we keep out of our
# gates). Only the rustdoc pass reached it before milestone 41, so its own code was never clippy'd,
# and there was a real `deref_addrof` sitting in `second_mount` when this line was added. `-D warnings`
# applies to local crates only, so the vendored engine's own warnings do not fail the run.
echo "==> clippy: redoxfs_server (its own workspace)"
cargo clippy --manifest-path redoxfs_server/Cargo.toml --all-targets -- -D warnings

# The fuzz workspace (milestone 42), a fourth. `cargo clippy` is `cargo check` semantics, so this
# does NOT link libFuzzer or need a sanitizer; it type-checks four fuzz targets and the four crates
# under test, which are already built by the pass above. A fuzz target is ordinary Rust that nothing
# else compiles, which makes it exactly the kind of code that rots: it is the one place in the tree
# where a crate's API can change and nothing notices until somebody goes looking for a bug.
echo "==> clippy: fuzz targets (its own workspace)"
cargo clippy --manifest-path fuzz/Cargo.toml --all-targets -- -D warnings

# The proofs' own code, which nothing else in this file compiles (milestone 113).
#
# `cfg(kani)` is set by the model checker and by nothing else. So every `#[cfg(kani)] mod
# verification` in the tree was invisible to every pass above, and `undocumented_unsafe_blocks` and
# `unsafe_op_in_unsafe_fn` could not fire inside one. That is the wrong place in this tree to have a
# blind spot: the unsafe code that sets up a proof is the code deciding what the proof is *about*.
#
# **What it found, first run: 26 warnings in 9 crates**, of which 13 were undocumented `unsafe` (11
# blocks and 2 `unsafe impl`s, all in `ipc` and `intrusive`) and 13 were ordinary clippy hits nobody
# had ever seen (`doc_markdown`, `manual_range_contains`, `manual_let_else`, `len_zero`,
# `needless_range_loop`, `assertions_on_constants`).
#
# **The alternative was `-D warnings` on the `script/verify` build**, which is `cfg(kani)` by
# definition and needs no shim. It finds **none of the 26**, measured: `cargo kani` drives a rustc,
# not a clippy-driver, so no `clippy::` lint exists there to fire. (`RUSTFLAGS=-D warnings` does
# reach it and does gate *rustc* lints, which was checked with a deliberate unused variable.) It also
# runs only when someone runs the proofs, which is ~20 minutes and therefore rarely; this runs on
# every pull request for about a second.
#
# The price is the shim in helpers/kani-lint-shim/, because the harnesses are written against Kani's
# intrinsics and a plain `--cfg kani` cannot compile them. Two crates, since an attribute macro can
# only come from a proc-macro crate; read that directory for what the shim does and does not promise.
# A clean pass here is not a proof, and `script/verify` remains the thing that proves.
echo "==> clippy: the Kani proof harnesses (--cfg kani)"
shim=target/kani-lint-shim
mkdir -p "$shim"
attrs=$(rustc --print file-names --crate-type proc-macro --crate-name kani_attributes \
    helpers/kani-lint-shim/kani_attributes.rs)
rustc --edition 2024 --crate-type proc-macro --crate-name kani_attributes \
    helpers/kani-lint-shim/kani_attributes.rs --out-dir "$shim"
rustc --edition 2024 --crate-type lib --crate-name kani \
    helpers/kani-lint-shim/kani.rs --extern kani_attributes="$shim/$attrs" --out-dir "$shim"
# Same package selection as the host pass above. `--all-targets` because a harness crate's
# `cfg(test)` build compiles the harnesses too, and the two configurations are not the same
# compilation.
#
# **`kernel` is excluded and now holds a `#[cfg(kani)]` module anyway** (milestone 193's harnesses in
# `syscall.rs`), so this pass has a hole in it and this is where a reader meets it. Two things block
# closing it, and both are tooling rather than effort:
#
#  - `cargo clippy -- <args>` applies the trailing rustc arguments to **every workspace member in the
#    build graph**, not to the selected package, which is why the line below is `--workspace` with
#    excludes rather than `-p`. Adding `-p kernel --target aarch64-unknown-none-softfloat` therefore
#    hands `--cfg kani` to `glob`, `dtb` and the rest with a shim rlib built for the wrong triple,
#    and they fail to find the crate. Measured 2026-08-30, not assumed.
#  - The kernel's `#[panic_handler]` is `cfg(not(kani))` (panic.rs says why: real Kani links `std`,
#    which already defines the lang item). Under this shim there is no `std`, so a bare-metal
#    `--cfg kani` build of the kernel binary has no panic handler at all.
#
# What the hole costs: clippy lints, `undocumented_unsafe_blocks` included, do not fire inside the
# kernel's harnesses. What still covers them: `script/verify` builds them for real and gates rustc
# lints through `RUSTFLAGS`, and `script/lint`'s aarch64 pass below compiles the same file without
# the cfg. Keep kernel harnesses free of `unsafe` while this holds.
cargo clippy --workspace --exclude kernel --exclude system_tests --exclude components --exclude fixtures --exclude user_mode_runtime \
    --exclude swap_protocol --exclude virtio --exclude supervision_protocol --exclude system_initializer \
    --all-targets -- \
    --cfg kani --extern "kani=$shim/libkani.rlib" -L "$shim" -D warnings

echo "==> clippy: kernel + user + user_mode_runtime (aarch64)"
cargo clippy -p kernel -p components -p fixtures -p user_mode_runtime --target aarch64-unknown-none-softfloat --all-targets -- -D warnings

# The system-test image (milestone 609 (the system tests leave the kernel crate)), in its own
# invocation and never beside `-p kernel`: it turns on the kernel's `system_tests` feature, cargo
# unifies features across one invocation, and under that feature the kernel allows dead code, so a
# shared run would quietly lint the kernel with its dead-code check off. `--all-targets` is what
# reaches the suite, which is `cfg(test)`.
echo "==> clippy: system_tests (aarch64)"
cargo clippy -p system_tests --target aarch64-unknown-none-softfloat --all-targets -- -D warnings

# The confinement tests' attacker roles (milestone 261 (the NVMe driver leaves the kernel)'s
# DMA-escape test), compiled only under `components/confinement_attackers`. Nothing above reaches
# them: `components` is built by xtask, not depended on, so `system_tests` cannot turn the feature
# on, and the shipped lint above must not. One architecture, because the gated code is
# architecture-neutral; the shipped build is linted on x86_64 below as well.
echo "==> clippy: components --features confinement_attackers (aarch64)"
cargo clippy -p components --features confinement_attackers --target aarch64-unknown-none-softfloat --all-targets -- -D warnings

# The third architecture (milestone 161). **The kernel BINARY only, with dead code allowed**, and
# every one of those narrowings is a scope gap rather than an oversight, so they are named here,
# where a reader checking what is covered will look.
#
# - **No `--all-targets`** on the kernel. Its test suite DOES compile and run for x86_64 now
#   (170 pass, 67 skip), but `--all-targets` also builds the nine build-mode feature targets, which
#   is the next bullet's problem rather than this one's. `user` and `user_mode_runtime` below take
#   `--all-targets`.
# - **No feature loop for seven of the nine build-mode features.** They fail on x86_64, measured,
#   because each selects a boot path that needs an arch layer this port has not written. Adding
#   them to the loop below would fail the gate for a reason the gate cannot fix.
#   `bench` is one of the two exceptions (DECISIONS §121's amendment, the TSS I/O-bitmap switch
#   cost); `cycle_counter_grant` is the other, and its own line below says why it is a different
#   case rather than the same one. Of `bench`: milestone
#   161 item 4 brought the scheduler up on this ISA, `kernel_main`'s x86_64 arm now diverges into
#   `bench::run()` the same way the other two do, and it passes this same clippy line clean. Linted
#   on its own line below rather than folded into the two-ISA loop above, because that loop's
#   `--target` list is aarch64/riscv64 only and widening it would also run every OTHER feature in the
#   list against x86_64, which is exactly what this paragraph says still fails.
# - **`-A dead_code`, and this one deserves the argument rather than the note.** The x86 boot is a
#   self-contained tour that halts before the scheduler and userspace, so about 85 items that are
#   live on the other two ISAs are unreferenced here. The source-level way to say that is a
#   crate-level `allow`, which the ratchet below refuses, and it is right to: that is exactly the
#   blanket milestone 41 removed, and it blindfolded the whole kernel on riscv64 while `-D warnings`
#   reported success. The per-item way is ~85 `cfg_attr`s scattered through portable files that
#   every other lane also edits, describing a fact that stops being true as soon as the x86 boot
#   reaches the shared path.
#
#   So the suppression lives HERE instead, on one invocation, where it is visible next to what it
#   gives up. **What it gives up is small and worth stating exactly**: code that is dead on ALL
#   THREE architectures is still caught, by the aarch64 and riscv64 passes above, which keep full
#   dead-code checking. The only thing that can now hide is code dead on x86_64 alone, which today
#   is the expected state of a partial port and tomorrow is a real gap. **The trigger for removing
#   this flag is the x86 boot joining the shared path**; see design/roadmap/0161-x86-64-kernel-port.md.
#
# - **`-A clippy::reversed_empty_ranges`** is a smaller thing and is not a suppression of a real
#   finding: `arch::mmu::VIRTIO_SLOTS` is genuinely ZERO on q35 (a PC has no virtio-mmio bus; every
#   virtio device is a PCI function), so `virtio.rs`'s three scan loops correctly iterate over
#   nothing. The alternative, a non-zero slot count over a zero base, would make the kernel probe
#   address 0.
#
# What it does cover is every line of `arch/x86_64/` and every portable file compiled with
# `target_arch = "x86_64"`, held to the same `-D warnings` as the other two.
echo "==> clippy: kernel (x86_64, the binary only; see the note above)"
cargo clippy -p kernel --target x86_64-unknown-none -- \
    -D warnings -A dead_code -A clippy::reversed_empty_ranges

# `bench` on x86_64, same flags, same reasoning: see the note above this block.
#
# **Four more build-mode features are checked below, and two are still held out** (measured
# 2026-09-15, calef's call). `shell`, `soak_test`, `job_mix` and `board` compile clean on x86_64
# under these flags: what each gates is either arch-neutral or dead on this ISA, and the shared
# `-A dead_code` already covers the partial port. `icount` and `fastpath_pad` genuinely fail to
# COMPILE, not merely warn: `icount` calls `arch::timer::calibration_loop`, `missed_ticks` and
# `deadline`, and `fastpath_pad` calls `arch::fastpath_pad_body`, none of which exist on x86_64
# yet. Those two stay out until their arch functions exist; a loop over them would fail the gate
# for a reason the gate cannot fix. The earlier version of this comment said all five failed,
# which stopped being true once each of the four grew arch-neutral or dead-only code.
echo "==> clippy: kernel --features bench (x86_64, the binary only; see the note above)"
cargo clippy -p kernel --features bench --target x86_64-unknown-none -- \
    -D warnings -A dead_code -A clippy::reversed_empty_ranges

# `cycle_counter_grant` (milestone 237) on x86_64, and it is a second exception to the paragraph
# above for a different reason than `bench`: it selects no boot path at all. It compiles milestone
# 229's grant in and nothing else moves, so the port's own arm of it
# (`arch::x86_64::timer::set_cycle_counter_grant`, the empty one DECISIONS 139 part 3 decided on)
# is held to this ISA's bar rather than to nobody's. Same flags as the two lines above, and for the
# same reasons: the `-A dead_code` is the partial boot's, not this feature's.
echo "==> clippy: kernel --features cycle_counter_grant (x86_64, the binary only; see the note above)"
cargo clippy -p kernel --features cycle_counter_grant --target x86_64-unknown-none -- \
    -D warnings -A dead_code -A clippy::reversed_empty_ranges

# The five build-mode features that compile clean on x86_64 (see the note above the `bench` line).
# Each on its own line rather than in the two-ISA loop above, because that loop's `--target` list is
# aarch64/riscv64 and widening it would also drag `icount` and `fastpath_pad` in, which do not build.
for feat in shell soak_test job_mix lock_wait board; do
    echo "==> clippy: kernel --features $feat (x86_64, the binary only; see the note above)"
    cargo clippy -p kernel --features "$feat" --target x86_64-unknown-none -- \
        -D warnings -A dead_code -A clippy::reversed_empty_ranges
done

# `network_bench` (milestone 494 (a driver for the network card a PC actually has)'s bench boot),
# on x86_64 only because xenon is the machine it is for. Linted because nothing else compiles it:
# `cargo xtask network-bench` is in no gate, and a bench boot that has rotted is found on the
# evening rather than here. `disk_throughput` has the same exposure and is not in this file yet.
echo "==> clippy: kernel --features network_bench (x86_64, the binary only; see the note above)"
cargo clippy -p kernel --features network_bench --target x86_64-unknown-none -- \
    -D warnings -A dead_code -A clippy::reversed_empty_ranges

# And userspace on the third architecture (milestone 161, item 4's hand-off). Held to the SAME bar
# as the aarch64 pass above, with no `-A dead_code` and no narrowings, because there is nothing
# partial about it: every program in `user/` compiles for this target and `crates/user_mode_runtime` has arms
# for all three ISAs.
#
# This is the pass that keeps parity honest for the programs rather than for the kernel. Without
# it, a lane could add an aarch64/riscv64 pair to a user program and never learn that x86 fell
# through to nothing until `cargo xtask test --arch x86_64` failed to pack an archive.
echo "==> clippy: user + user_mode_runtime (x86_64)"
cargo clippy -p components -p fixtures -p user_mode_runtime --target x86_64-unknown-none --all-targets -- -D warnings

# The kernel's build-mode features (shell, bench, soak_test, cycle_counter_grant) each compile
# DIFFERENT code in and out:
# `shell` drops the milestone tour, `bench` diverges before the boot entirely, and
# `icount` (milestone 78) parks before `bench` does, which is the one configuration where
# `bench::run` and everything after it is unreachable, and `soak_test` (milestone 219) takes the place of
# the progenitor handoff and is the ONLY configuration in which the scheduler's event counters and
# `Thread::last_cpu` exist at all: those are `cfg`-gated rather than `allow(dead_code)` because
# their increments sit on the IPC fastpath and shipping them everywhere put `ipc_fastpath` 5.7% over
# milestone 132's bound, so this loop is the only thing that keeps them under clippy's eye. So a
# warning that only appears in one configuration -- e.g. dead code once the tour is compiled out --
# is invisible to the default run above. Lint each feature build on its own. (A missed dead-code
# warning under the boot-mode feature that was then called `initboot` is exactly why this loop
# exists.) Bin only: the boot code these features gate lives in the binary, not the test target
# (the boot block is `cfg(not(test))`).
#
# **The list below is written out, not globbed, and that is the property to keep** (milestone 296,
# which removed `initboot` from it). Milestone 401, `design/roadmap/0401-a-gate-that-selects-the-set-it-judges.md`,
# is the class: a gate that computes the set it judges goes BLIND rather than red when the set
# empties, which is how milestone 265's crate check passed by checking zero crates. This loop cannot
# do that -- an empty `for` list is visible in the diff and in the output, since every iteration
# echoes its own `==>` line -- so removing a feature here is a deletion a reader can see rather than
# a silence. Count: 8 features x 2 targets = 16 `==>` lines. `lock_wait` joined on 2026-10-04: it
# is a measurement build no gate otherwise compiles, and it is the only build that compiles the
# counting arm of `IrqSafeMutex::lock` and the reaper's timing (kernel/src/lock_wait.rs).
#
# On BOTH ISAs since milestone 41. riscv64 was linted only under `watchdog_probe` before, so the
# whole riscv `shell` boot path (`user::riscv_shell_boot` and the console it builds) was compiled
# by `cargo xtask` and checked by nobody. Parity is a gate, not an aspiration (DECISIONS §19), and
# that applies to the gate itself.
for tgt in aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf; do
    for feat in shell bench icount board fastpath_pad soak_test cycle_counter_grant lock_wait; do
        echo "==> clippy: kernel --features $feat ($tgt)"
        cargo clippy -p kernel --features "$feat" --target "$tgt" -- -D warnings
    done
done

# `cycle_counter_grant` (milestone 237) is in the loop above for the reason `soak_test` is: it compiles
# milestone 229's per-thread cycle-counter grant in, and a gated path rots unless something builds
# it. **Bin-only is the interesting half here**, because the gate on every piece is
# `any(test, feature = "cycle_counter_grant")`: the test target has `test` set, so `--all-targets`
# would lint the configuration `script/test` already compiles and RUNS on all three architectures
# every time anyone gates. The feature alone, with no `test`, is the configuration nothing else in
# the tree ever builds, and it is the one where `grant_cycle_counter` becomes dead code with no test
# caller. It is linted on the third architecture too, beside the `bench` line above.

# watchdog_probe is the exception to "bin only" above: it gates a TEST (the livelock probe in
# testing.rs), so it is invisible without --all-targets. Linted on all three ISAs (x86_64 below, with the same `-A dead_code` the other x86_64 lines
# carry and for the same reason; milestone 186 (derive the architecture list, and close what it does not reach) found it was the one skipped) because an unlinted
# feature rots, and this one is only ever compiled deliberately.
for tgt in aarch64-unknown-none-softfloat riscv64imac-unknown-none-elf; do
    echo "==> clippy: kernel --features watchdog_probe ($tgt)"
    cargo clippy -p kernel --features watchdog_probe --target "$tgt" --all-targets -- -D warnings
done
echo "==> clippy: kernel --features watchdog_probe (x86_64)"
cargo clippy -p kernel --features watchdog_probe --target x86_64-unknown-none --all-targets -- \
    -D warnings -A dead_code -A clippy::reversed_empty_ranges

# `--clippy`: stop after the last clippy pass. `.githooks/pre-push` called this so the clippy gate
# had exactly one copy, here, until milestone 630 measured the rest of lint at about 29 s more and
# made the hook run all of it; the flag stays for a person who wants the clippy half alone. Added 2026-09-29 after lane
# branches kept reaching CI with clippy failures a local gate would have caught (#1424's stale
# lints; #1442, where a push left before lint was read): the cheap half of this script belongs
# before the push, and everything after this point still runs in full here and in CI.
if [ "${1:-}" = "--clippy" ]; then
    echo "==> clippy-only mode (pre-push); the rest of lint still runs before any report or merge"
    exit 0
fi

# Every `unsafe fn` states its contract in a `# Safety` section (milestone 112).
#
# **Read what this does and does not claim, because the milestone it comes from is about exactly
# that distinction.** It checks that a contract is WRITTEN. It cannot check that the contract is
# true, that it is relevant, or that any caller met it. No gate here can: `undocumented_unsafe_blocks`
# has the same limit one level down, and DECISIONS §61 carries the BUGS note about a generated pass
# that produced a comment false at its first site. What this buys is that the reader of an
# `unsafe fn` always has a sentence to judge, which is a low bar and is the bar that was missing.
#
# It earns its place because of the shape of this tree's unsafe code, measured in milestone 82: of
# the tree's `unsafe fn`s, a third contain **no unsafe operation at all**. Their unsafety is a
# contract about meaning rather than a memory operation a compiler can point at (`set_ttbr0` is
# unsafe because `aarch64-cpu` hands `TTBR0_EL1.set` over as a safe call; `assume_no_stale_entry` is
# named for its contract). For those, both unsafe lints have nothing to fire on and **the rustdoc
# section is the only enforcement there is.** Nothing was checking that it existed.
#
# `clippy::missing_safety_doc` is already on via `-D warnings` and does NOT cover this: it only fires
# on an EXPORTED function, and the interesting ones here are private to their module (`set_ttbr0`,
# `write_satp`). This found one violation on its first run, `redoxfs_server`'s `file_page`, whose contract
# was written but spelled `SAFETY:` instead of `# Safety` and so rendered as ordinary prose.
#
# **Trait-impl methods are excluded, and that is correctness rather than convenience.** `GlobalAlloc`'s
# `alloc` and RedoxFS's `Disk::read_at` are `unsafe fn` because the TRAIT declares them so; the
# contract belongs to the trait's own documentation and an impl restating it would be a copy that can
# drift. Twelve of the tree's `unsafe fn`s are this case, and clippy's own lint skips them for the
# same reason. Without that exclusion this check is twelve false positives out of thirteen, which is
# a nag rather than a gate.
echo "==> unsafe fn contracts"
python3 - <<'PY'
import pathlib
import re
import sys

# `unsafe fn`, at any visibility, but not `unsafe trait`, not `unsafe impl`, and not a bare `fn`.
DECL = re.compile(
    r'^\s*(?:pub(?:\([^)]*\))?\s+)?(?:default\s+)?(?:const\s+)?'
    r'unsafe\s+(?:extern\s+"[^"]*"\s+)?fn\s+(\w+)')
# An `impl ... for ...` header. `impl<T> Node for N` counts; `impl Fifo<T>` (inherent) does not.
IMPL_FOR = re.compile(r'^\s*(?:unsafe\s+)?impl\b.*\bfor\b')

total = 0
in_trait_impl = 0
missing = []

for path in sorted(pathlib.Path('.').rglob('*.rs')):
    parts = path.parts
    if any(p in ('target', 'vendor', '.git', '.claude', 'patches') for p in parts):
        continue
    lines = path.read_text(errors='replace').split('\n')
    # Brace depth, so "am I inside a trait impl" is answered by nesting rather than by guessing.
    depth = 0
    trait_impl_at = None
    for i, line in enumerate(lines):
        if trait_impl_at is None and IMPL_FOR.match(line):
            trait_impl_at = depth
        m = DECL.match(line)
        if m:
            total += 1
            if trait_impl_at is not None:
                in_trait_impl += 1
            else:
                # Walk up over attributes and comments to the doc block that belongs to this item.
                j, doc = i - 1, []
                while j >= 0:
                    s = lines[j].strip()
                    if s.startswith('///') or s.startswith('//!'):
                        doc.append(s)
                        j -= 1
                    elif s.startswith(('#[', '#!', '//')):
                        j -= 1
                    else:
                        break
                if not any(re.search(r'#\s*Safety', d, re.I) for d in doc):
                    missing.append(f'{path}:{i + 1}  {m.group(1)}')
        depth += line.count('{') - line.count('}')
        if trait_impl_at is not None and depth <= trait_impl_at:
            trait_impl_at = None

if missing:
    print('lint: unsafe fn with no `# Safety` section in its rustdoc:', file=sys.stderr)
    for entry in missing:
        print(f'  {entry}', file=sys.stderr)
    print('', file=sys.stderr)
    print('For a third of this tree\'s unsafe fns the doc section is the ONLY enforcement there '
          'is: they contain no unsafe operation, so neither unsafe lint has anything to fire on. '
          'Spell it `# Safety` (a heading), not `SAFETY:` (a block comment): that is the form '
          'rustdoc renders as the contract. See notes/unsafe-obligations.md.', file=sys.stderr)
    sys.exit(1)

print(f'unsafe fn contracts: {total} declarations '
      f'({in_trait_impl} trait-impl methods, whose contract is the trait\'s), '
      f'every other one has a `# Safety` section')
PY

# Rule 1, made mechanical (milestone 83): all architecture-specific code in the kernel lives under
# kernel/src/arch/. This is the rule that makes the x86_64 port a new directory instead of a diff
# across every file, and until now it was enforced by discipline alone; the discipline slipped once
# (a raw SPSel read in user/tests.rs), which is exactly how the second slip arrives. The check is
# the three spellings arch code has in Rust: an `asm!(`/`global_asm!(` invocation (one pattern,
# since the second contains the first) and anything reached through `core::arch::`.
#
# No allowlist, deliberately. `current_sp` and `sync_icache` are the precedent: when portable code
# needs a register, the register read moves behind an `arch::` helper and the portable caller names
# what it wants rather than how to get it. Comments are scanned too, and that is the em-dash gate's
# self-consistency argument: prose may name the macro (`asm!`, no parenthesis, as user.rs already
# does), but a comment that spells the call form is one copy-paste from being code.
echo "==> rule 1 (arch code stays under kernel/src/arch/)"
# `system_tests/src` too: the system suite is kernel-side code that left the kernel crate
# (milestone 609 (the system tests leave the kernel crate)), and the rule did not move with it.
# $$ (this shell's own pid), not a fixed name: `/tmp` is shared by every worktree on the machine,
# and lanes gate concurrently (CLAUDE.md, "lane count"). A fixed path here raced two lint runs in
# different worktrees against the same file: one run's `git grep` would truncate-and-write it after
# another run's had already succeeded but before that run's own `cat` read it back, so a lane could
# report a check failure quoting a FILE THAT DOES NOT EXIST IN ITS OWN WORKTREE. Reproduced
# 2026-09-27 (Milestone lint-worktree-leak): two `script/lint`-shaped loops racing this same command
# in two worktrees, one with a matching file and one without, produced the matchless run's output
# containing the OTHER worktree's file in 69 of 100 iterations. `$$` is unique per running process,
# so two concurrent lint runs never share a path, which is what makes this the strongest fix rather
# than a narrower one: no lint run can observe another's temp file at all.
if git grep -nE 'asm!\(|core::arch::' -- \
    'kernel/src' ':!kernel/src/arch' 'system_tests/src' > "/tmp/nife-rule-1.$$" 2>/dev/null; then
    echo "lint: architecture-specific code outside kernel/src/arch/ (CLAUDE.md rule 1):" >&2
    cat "/tmp/nife-rule-1.$$" >&2
    echo "" >&2
    echo "Move the register touch behind a helper in kernel/src/arch/ and call that; see" >&2
    echo "arch::current_sp for the shape. A port should be a new directory, not a diff." >&2
    rm -f "/tmp/nife-rule-1.$$"
    exit 1
fi
rm -f "/tmp/nife-rule-1.$$"
echo "rule 1: no asm outside kernel/src/arch/"

# Rule 5's interface half (lane lint-arch-parity, 2026-10-08). arch/mod.rs re-exports one port
# flat, so the interface portable code calls is only the set of names it happens to use, and
# nothing held the three ports to that set. The clippy passes above catch a missing item only in a
# configuration they build, and they skip seven boot-mode features on x86_64. This reads every
# `arch::` path that kernel/src (outside arch/) and system_tests/src name, works out which ports
# can compile each use from its `target_arch` cfgs, and fails when one of those ports does not
# define the path. Arch-private extras (x86_64's `segments`, `port`, `rtc`) never trip it, since
# only a caller makes a name part of the interface.
#
# Intended gaps and known real ones are in ALLOWED in the helper, one reason each, and an entry
# that matches nothing fails, so the list cannot outlive its gap. A compile-time interface (a
# trait each port implements) would be a higher rung, but it means restructuring every port, which
# is a design fork and not this check's to make. What the text reading cannot see is the
# helper's BUGS paragraph.
echo "==> rule 5 (every arch:: path portable code names exists in every port)"
python3 helpers/lint_arch_parity.py

# Hand-written assembly carries call-frame information (milestone: CFI in hand-written asm).
#
# What this checks: that a `.s` file under kernel/src/arch/ which defines at least one exported
# (`.global`) symbol also contains at least one `.cfi_startproc`. **What it cannot check, and is
# honest about not checking**: that the CFI is CORRECT (a right-looking `.cfi_offset` with the
# wrong number passes this exactly as readily as a true one), that every individual function has
# its own directives rather than one somewhere in the file, or that a `.cfi_startproc` is matched
# by a `.cfi_endproc` in the right place (the assembler itself is the check for that: an unbalanced
# pair fails the build, not this gate). This is a presence check, at file granularity, the same
# reach `script/citations` and the roadmap's `## Revisit` check are honest about for their own
# claims. A file that is data rather than code (the boot header aarch64/image_header.s is the one
# example today) says so with a `CFI-EXEMPT:` comment instead of carrying directives that would
# describe a frame the file never builds; see notes/cfi-unwind.md for what that would cost.
echo "==> hand-written asm carries CFI"
cfi_bad=""
cfi_seen=0
# The hazard is the pattern, not the check: milestone 401 (a gate that selects the set it judges).
# `git ls-files` prints nothing for a pattern that matches nothing, so moving the `.s`
# files one directory deeper would leave this loop with zero iterations and the gate would
# announce that hand-written asm carries CFI having read no asm. The count below is what makes that a red rather than a green.
for f in $(git ls-files 'kernel/src/arch/*/*.s'); do
    cfi_seen=$((cfi_seen + 1))
    grep -q 'CFI-EXEMPT:' "$f" && continue
    grep -q '^\.global ' "$f" || continue
    grep -q '\.cfi_startproc' "$f" || cfi_bad="$cfi_bad $f"
done
if [ "$cfi_seen" -eq 0 ]; then
    echo "lint: no .s files matched kernel/src/arch/*/*.s, so the CFI check judged nothing." >&2
    echo "Hand-written assembly moved. Fix the pattern above; a selector that matches nothing" >&2
    echo "passes by checking nothing (design/roadmap/0401-a-gate-that-selects-the-set-it-judges.md)." >&2
    exit 1
fi
if [ -n "$cfi_bad" ]; then
    echo "lint: hand-written .s files with an exported symbol and no CFI directives:" >&2
    for f in $cfi_bad; do echo "  $f" >&2; done
    echo "" >&2
    echo "Add .cfi_startproc/.cfi_endproc around each function (and .type/.size), describing the" >&2
    echo "frame the function actually builds. Where a function genuinely has no caller (a boot" >&2
    echo "entry, a fake-return trampoline), say so with .cfi_undefined on the return-address" >&2
    echo "register rather than inventing a formula; see notes/cfi-unwind.md and the CFI comments" >&2
    echo "in kernel/src/arch/*/context.s for the shape. A file that is genuinely data, not code," >&2
    echo "gets a CFI-EXEMPT: comment instead (see kernel/src/arch/aarch64/image_header.s)." >&2
    exit 1
fi
echo "CFI: every hand-written .s file with an exported symbol carries call-frame information"

# The machine description prints on every boot (milestone 267).
#
# `kernel/src/lib.rs`'s `print_machine_description` is the bring-up transcript: paging, the ISA,
# firmware, the cores, the timer, the memory map. On xenon there was no serial console this project
# could read at first light, so those lines *were* the record, photographed off a monitor, and they
# are what diagnosed the local-APIC collision and the PCI BAR window landing in RAM.
#
# Before milestone 267 they shared one block with the milestone tour, under a single
# `#[cfg(not(any(feature = "shell", feature = "initboot")))]` sitting in the middle of it (quoted as
# it stood; milestone 296 deleted `initboot` and the live gate reads `not(feature = "shell")`), so the
# boundary between a diagnostic and a demonstration was a reader's inference. A line moved a few
# rows up or down changed which audience it served and nothing said so. This is the mechanism that
# replaces the inference: the split is a function name, and no boot-mode feature may appear inside
# it.
#
# It checks the body only. The signature carries `#[cfg(not(any(test, feature = "bench")))]` on
# purpose (a `bench` boot diverges before this point and a `test` boot exits through semihosting;
# neither is a boot anybody reads to bring up a board), which is why the scan starts after the
# opening brace rather than at the attribute.
echo "==> the machine description is not gated on a boot mode"
python3 - <<'M267EOF' || exit 1
import re, sys

src = open("kernel/src/lib.rs", encoding="utf8").read()
start = src.find("fn print_machine_description")
if start < 0:
    print("lint: kernel/src/lib.rs has no `print_machine_description`.", file=sys.stderr)
    print("      Milestone 267 (the milestone tour is three things wearing one name) made the",
          file=sys.stderr)
    print("      machine description a function so that nothing could gate half of it. If it was",
          file=sys.stderr)
    print("      renamed, rename it here too and say why in design/roadmap/0267-*.md.",
          file=sys.stderr)
    sys.exit(1)

# Brace-match from the opening brace of the body. The function contains no string or char literal
# with an unbalanced brace (every pair in its format strings is a placeholder and balanced), so
# counting is enough and a Rust parser is not.
open_at = src.index("{", start)
depth, end = 0, None
for i in range(open_at, len(src)):
    if src[i] == "{":
        depth += 1
    elif src[i] == "}":
        depth -= 1
        if depth == 0:
            end = i
            break
if end is None:
    print("lint: could not find the end of `print_machine_description`.", file=sys.stderr)
    sys.exit(1)

body = src[open_at:end]
bad = sorted(set(re.findall(r'feature\s*=\s*"[a-z_0-9]+"', body)))
if bad:
    print("lint: the machine description is gated on a boot-mode feature: " + ", ".join(bad),
          file=sys.stderr)
    print("", file=sys.stderr)
    print("These lines are how a port is verified on a machine with no serial console, so they",
          file=sys.stderr)
    print("print on every boot. A demonstration that should be compiled out belongs in the tour",
          file=sys.stderr)
    print("block in `kernel_main`, or in a userspace program. See design/roadmap/0267-*.md.",
          file=sys.stderr)
    sys.exit(1)

print("machine description: %d lines, no boot-mode feature inside it" % body.count("\n"))
M267EOF

# Every `fence` names where its other half is (milestone 116, CLAUDE.md rule 4).
#
# A release fence with no matching acquire orders nothing and reads as though it does, which is
# worse than an absent fence because the fence *is* the comment: a reader who sees
# `fence(Ordering::Release)` stops asking the question. That mistake was found twice on 2026-08-04
# by two methods that share nothing, milestone 80's loom harness on the clock seqlock and milestone
# 43's audit on the compositor, and no gate in the tree could see either one.
#
# **This checks the bookkeeping, not the ordering, and the difference is the whole design.** Pairing
# two fences is a dataflow problem across functions, across binaries and sometimes across address
# spaces; in this tree the other half is frequently not a fence at all but a blocking IPC rendezvous
# whose happens-before edge lives inside `spin::Mutex`, in a dependency. Nothing an AST can see. So
# this takes milestone 112's posture instead: a narrow check that is true beats a broad one that is
# aspirational. What it buys is the forcing function, because an author made to write down where the
# partner lives has to go and look for it, and that is exactly the step neither 43's nor 80's author
# took. See notes/memory-ordering.md, which measures the broad check and shows why it fails.
#
# Fences only, not every `Ordering::Release`. A `Release` store names its variable, so its partner
# is a grep away; `fence()` names nothing at all, which is what makes it the site where the partner
# has to be written down by hand.
echo "==> every fence names its counterpart"
python3 - <<'PYEOF' || exit 1
import re, subprocess, sys

MARKER = "PAIR:"
files = subprocess.run(["git", "ls-files", "*.rs"], capture_output=True, text=True,
                       check=True).stdout.split()
files = [f for f in files if not f.startswith("vendor/")]

def blank(src):
    """Comments and string literals blanked out, offsets and newlines preserved."""
    out, i, n = list(src), 0, len(src)
    while i < n:
        if src.startswith("//", i):
            j = src.find("\n", i)
            j = n if j < 0 else j
            for k in range(i, j):
                out[k] = " "
            i = j
        elif src.startswith("/*", i):
            j = src.find("*/", i + 2)
            j = n if j < 0 else j + 2
            for k in range(i, j):
                if src[k] != "\n":
                    out[k] = " "
            i = j
        elif src[i] == '"':
            j = i + 1
            while j < n and src[j] != '"':
                j += 2 if src[j] == "\\" else 1
            for k in range(i, min(j + 1, n)):
                if src[k] != "\n":
                    out[k] = " "
            i = j + 1
        else:
            i += 1
    return "".join(out)

# `#[cfg(test)] mod x;` makes the whole of x.rs test code. Chased down because the first version of
# this scan matched the next `{` after the attribute and swallowed 400 lines of live kernel, hiding
# a real fence in user.rs. The kernel's tests are `#[cfg(test)]` files, not inline modules.
CFG = re.compile(r"#\[cfg\((?:all\(|any\()?(?:test|kani|loom)\b")
test_files = set()
for f in files:
    code = blank(open(f, encoding="utf-8", errors="replace").read())
    for m in CFG.finditer(code):
        mm = re.match(r"[^;{]*?\bmod\s+([A-Za-z0-9_]+)\s*;", code[m.end():m.end() + 400], re.S)
        if mm:
            d, stem = f.rsplit("/", 1)[0], f.rsplit("/", 1)[1][:-3]
            for cand in (f"{d}/{mm.group(1)}.rs", f"{d}/{stem}/{mm.group(1)}.rs",
                         f"{d}/{mm.group(1)}/mod.rs"):
                if cand in files:
                    test_files.add(cand)

FENCE = re.compile(r"\b(compiler_fence|fence)\s*\(")
bad, seen = [], 0
for f in files:
    src = open(f, encoding="utf-8", errors="replace").read()
    lines = src.split("\n")
    code = blank(src)
    regions = []
    if f not in test_files and "/tests/" not in f and not f.startswith("fuzz/"):
        for m in CFG.finditer(code):
            tail = code[m.end():]
            semi, brace = tail.find(";"), tail.find("{")
            if brace < 0 or 0 <= semi < brace:
                continue  # `mod x;` or a `use`: no inline body to bound
            i, depth = m.end() + brace, 0
            while i < len(code):
                if code[i] == "{":
                    depth += 1
                elif code[i] == "}":
                    depth -= 1
                    if depth == 0:
                        break
                i += 1
            regions.append((m.start(), i))
    else:
        regions.append((0, len(code)))
    for m in FENCE.finditer(code):
        if any(a <= m.start() <= b for a, b in regions):
            continue
        seen += 1
        ln = code.count("\n", 0, m.start())  # 0-based index into `lines`
        # The contiguous comment block immediately above, which is where `SAFETY:` lives too.
        k, found = ln - 1, False
        while k >= 0 and lines[k].strip().startswith("//"):
            if MARKER in lines[k]:
                found = True
            k -= 1
        if not found:
            bad.append(f"{f}:{ln + 1}: {lines[ln].strip()}")

if bad:
    sys.stderr.write("lint: fences with no %s comment naming the other half:\n" % MARKER)
    for b in bad:
        sys.stderr.write("  " + b + "\n")
    sys.stderr.write("""
Put a comment directly above the fence saying where the matching acquire or release is, as
`// %s <file> <function>'s fence(Acquire)`. If there is no matching fence because the ordering
comes from somewhere else (a blocking IPC rendezvous, a lock, a spawn), say THAT and say which,
because a reader who cannot find the partner has no way to tell a sound fence from a one-sided
one. See notes/memory-ordering.md for the inventory and every site's adjudication.
""" % MARKER)
    sys.exit(1)
print(f"fences: {seen} outside test code, each naming its counterpart")
PYEOF

# No module-wide dead-code suppression, anywhere (milestone 41, DECISIONS §38).
#
# This is a ratchet, and it is the whole reason milestone 41 is not a one-off tidy. Six files used
# to carry `#![allow(dead_code)]` over 5,831 lines, including sched.rs (3,166) and the aarch64 MMU
# (1,275), and main.rs carried a crate-wide one for riscv64 that blindfolded the ENTIRE kernel on
# that ISA. So `-D warnings` reported success over a third of the kernel while nothing was looking,
# which is the same failure as the conflict markers that survived a full gate run below.
#
# An inner attribute (`#![...]`) applies to the whole enclosing module or crate, so one of these can
# never be a decision about a particular item: it is a blanket. A per-item `#[allow(dead_code)]` with
# a stated reason is fine and there are plenty; that is the distinction §38 draws. Bracket-matched
# rather than line-matched because `rustfmt` splits a long `cfg_attr` across lines, and the crate-wide
# riscv one would have been split the moment it grew a second condition.
echo "==> module-wide dead-code suppression"
found=""
rs_seen=0
for f in $(git ls-files '*.rs' | grep -v '^vendor/' | grep -v '^patches/'); do
    rs_seen=$((rs_seen + 1))
    hit=$(awk '
        /^[[:space:]]*#!\[/ { collecting = 1; buf = ""; ln = FNR; opens = 0; closes = 0 }
        collecting {
            buf = buf " " $0
            opens += gsub(/\(/, "(")
            closes += gsub(/\)/, ")")
            if (opens <= closes) {
                # One exemption, and it is not dead code: `unused_crate_dependencies` is about the
                # manifest, fires per target, and a bin target can only silence it crate-wide.
                # `kernel/src/main.rs` is a link line that names none of the package`s dependencies
                # (milestone 609 (the system tests leave the kernel crate)). Only an attribute whose
                # whole list is that one lint passes; anything more in it is still caught.
                if (buf ~ /dead_code|unused/ && buf !~ /^[[:space:]]*#!\[allow\(unused_crate_dependencies\)\][[:space:]]*$/) { gsub(/^[[:space:]]+/, "", buf); print ln ": " buf }
                collecting = 0
            }
        }
    ' "$f")
    [ -n "$hit" ] && found="$found
$f:$hit"
done
if [ "$rs_seen" -eq 0 ]; then
    echo "lint: the dead-code sweep read no .rs files at all, so it judged nothing" >&2
    echo "(milestone 401). Either the filters above are wrong or this is not the repository." >&2
    exit 1
fi
if [ -n "$found" ]; then
    echo "lint: module-wide dead-code suppression (an inner attribute blindfolds the whole module):" >&2
    echo "$found" >&2
    echo "" >&2
    echo "Put the allow on the ITEM, with a comment saying which configuration has no caller." >&2
    echo "See DECISIONS §38." >&2
    exit 1
fi
echo "module-wide suppression: none"

# The boot shell allocates only where every allocation can fail (milestone 47 (navigation and
# naming), calef's ruling of 2026-09-26: the boot shell is the owner's root console, so running out
# of heap is a refusal and never a panic). The compiler does most of it: `alloc` is nameable only
# where `extern crate alloc` is declared, and components/src/swish.rs declares it inside `mod heap`,
# whose one type exposes no allocating method. This holds the part the compiler cannot: that the
# declaration stays there. A second one, or one at the crate root, would let the whole shell name
# `Vec::push` again. crates/swish is the shell's host-tested half and declares none at all.
echo "==> the shell allocates only where it can fail"
shell_alloc=$(grep -n 'extern crate alloc' components/src/swish.rs || true)
if [ "$(printf '%s\n' "$shell_alloc" | grep -c 'extern crate alloc')" -ne 1 ] \
    || ! printf '%s\n' "$shell_alloc" | grep -q '^[0-9]*:    extern crate alloc;' \
    || ! awk '/^mod heap \{/ { inside = 1 } inside && /extern crate alloc/ { found = 1 } inside && /^}/ { inside = 0 } END { exit !found }' components/src/swish.rs \
    || grep -rn 'extern crate alloc' crates/swish/src >/dev/null; then
    echo "lint: components/src/swish.rs must declare \`extern crate alloc\` exactly once, inside" >&2
    echo "\`mod heap\`, and crates/swish must not declare it. Found:" >&2
    printf '%s\n' "$shell_alloc" >&2
    grep -rn 'extern crate alloc' crates/swish/src >&2 || true
    echo "Every allocation in the boot shell goes through \`mod heap\`, which cannot panic on" >&2
    echo "failure. See the comment above this check." >&2
    exit 1
fi
echo "shell allocation: one declaration, inside mod heap"

# No merge conflict markers, anywhere. This is not a style rule, it is a scar: a compositor merge
# resolved only the conflicts visible in a truncated `git merge` summary, and `git add -A` then
# committed DECISIONS.md with its markers intact and pushed them to main. Both sides' prose survived,
# so nothing failed and no test noticed, which is exactly why it needs a gate: broken markup in a
# documentation deliverable is invisible to every other check we run. Costs a grep.
echo "==> conflict markers"
# $$, not a fixed name: see the note on the rule-1 check above for why (a shared /tmp path races
# two worktrees' lint runs against each other).
if git grep -nE '^(<{7}|={7}|>{7})( |$)' -- \
    ':!vendor' ':!*.lock' > "/tmp/nife-conflict-markers.$$" 2>/dev/null; then
    echo "lint: merge conflict markers left in tracked files:" >&2
    cat "/tmp/nife-conflict-markers.$$" >&2
    rm -f "/tmp/nife-conflict-markers.$$"
    exit 1
fi
rm -f "/tmp/nife-conflict-markers.$$"

# Every `uses:` in .github/ is pinned to a full 40-hex commit SHA, with the tag in a trailing
# comment. A tag is a mutable pointer: whoever controls the action's repository can move `v2` to new
# code, and that code then runs in a job that holds a token. metrics.yml and toolchain-bump.yml mint
# the nife-smelter App token in the same job as `Swatinem/rust-cache` and `taiki-e/install-action`,
# so an unpinned third-party tag was a path from someone else's repository to a write-scoped App
# token (audit, 2026-10-07 UTC). A local `./` action is in this tree and is exempt. Dependabot's
# github-actions ecosystem (.github/dependabot.yml) bumps the SHA and the comment together.
# LINT_ACTIONS_REV, a test hook only, reads another revision (`origin/main`) to watch this fail.
echo "==> actions are pinned to a commit SHA"
unpinned="$(git grep -nE '^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]' ${LINT_ACTIONS_REV:-} -- .github \
    | grep -vE 'uses:[[:space:]]+\./' \
    | grep -vE 'uses:[[:space:]]+[^@[:space:]]+@[0-9a-f]{40}([[:space:]]|$)' || true)"
if [ -n "$unpinned" ]; then
    echo "lint: a workflow action is not pinned to a 40-hex commit SHA:" >&2
    echo "$unpinned" >&2
    echo "lint: resolve it with 'gh api repos/<owner>/<repo>/commits/<tag> --jq .sha' and write" >&2
    echo "lint: 'uses: <owner>/<repo>@<sha> # <tag>'." >&2
    exit 1
fi
echo "actions: every uses: line is pinned to a commit SHA"

# A TODO marker names the milestone that owns it, or it does not exist (milestone 94).
#
# The failure this drains is not untidiness. Work gets identified in media nobody rereads (a lane's
# report, a pull-request description, a commit message) and evaporates; milestone 90 exists only
# because calef happened to catch milestone 84's guard-page finding in a report on the day it was
# written. A bare `TODO:` in a source file is that same medium with a compiler in front of it: it
# looks like tracking and it is not, because nothing lists it, nothing reviews it, and nothing tells
# the reader whether anybody still intends it.
#
# A marker that cites a milestone is a different object. It is a cross-reference, the roadmap block
# is the record, and `script/roadmap` already gates the block. So the rule is not "no TODOs": it is
# that a marker names its home.
#
# **A marker is the word followed immediately by `(` or `:`; a mention is not.** That distinction is
# the whole check, and getting it wrong would make this unusable: this tree has nine comments that
# talk ABOUT a TODO ("see the TODO on `paging::unmap`", "Hardcoded on purpose, and it should stay
# that way. Not a TODO.") and a `git grep -w TODO` fires on every one of them. It also fires on
# `XXXXXXXX-XXXX-XXXX` in the GUID formatter and on `gl-one.txtXXX` in a glob test, which is why the
# marker words are matched with the punctuation attached rather than as bare words.
#
# **Markdown is out of scope, and that is a self-consistency exemption rather than a gap.** Prose
# that explains this convention has to spell the forbidden shape (design/roadmap/0094-untracked-work.md
# does); the em-dash gate below dodges the same problem by building
# its character out of UTF-8 bytes, and a TODO marker cannot be disguised that way without making
# the sentence unreadable. Prose is also where a *historical* marker legitimately lives: notes/uart.md
# quotes a milestone-5 TODO that was resolved five milestones ago, as history, not as intent. Code
# has no such category. This script excludes itself for the same reason.
#
# The cited milestone must exist, because `script/decisions --check` learned the other half of this
# lesson the hard way: a citation that resolves to nothing is a broken footnote, and one that is
# merely well-formed is worse.
echo "==> TODO markers cite a milestone"
todo_bad=$(git grep -nE '(TODO|FIXME|XXX|HACK)[[:blank:]]*[(:]' -- \
    ':!vendor' ':!patches' ':!*.md' ':!script/lint' 2>/dev/null |
    grep -vE '(TODO|FIXME|XXX|HACK)[[:blank:]]*\(milestone [0-9]+\)' || true)
if [ -n "$todo_bad" ]; then
    echo "lint: TODO/FIXME markers that do not name the milestone that owns them:" >&2
    echo "$todo_bad" | sed 's/^/  /' >&2
    echo "" >&2
    echo "Spell it TODO(milestone N): and add the block under design/roadmap/, or take the note out" >&2
    echo "of the marker form and record the limitation next to the feature (the BUGS convention)." >&2
    echo "A marker with no home is work nobody will find; see design/roadmap/0094-untracked-work.md." >&2
    exit 1
fi
# Every milestone a compliant marker cites has to have a block. Cheap, and it is the check that
# survives a renumber.
todo_dangling=""
for n in $(git grep -hoE '(TODO|FIXME|XXX|HACK)[[:blank:]]*\(milestone [0-9]+\)' -- \
           ':!vendor' ':!patches' ':!*.md' ':!script/lint' 2>/dev/null |
           grep -oE '[0-9]+' | sort -un); do
    # Block filenames carry the number zero-padded to four digits (calef, 2026-10-07 UTC).
    ls "$(dirname "$0")/../design/roadmap/$(printf '%04d' "$(expr "$n" + 0)")-"*.md >/dev/null 2>&1 ||
        todo_dangling="$todo_dangling $n"
done
if [ -n "$todo_dangling" ]; then
    echo "lint: TODO markers cite milestones with no block under design/roadmap/:$todo_dangling" >&2
    exit 1
fi
todo_count=$(git grep -hoE '(TODO|FIXME|XXX|HACK)[[:blank:]]*\(milestone [0-9]+\)' -- \
    ':!vendor' ':!patches' ':!*.md' ':!script/lint' 2>/dev/null | wc -l | tr -d ' ')
echo "TODO markers: $todo_count in code, each naming a milestone that has a block"

# The milestone blocks, validated (see notes/roadmap.md's status vocabulary and script/roadmap).
# Catches a status token nobody defined, a block missing the `## Index row` section that carries its
# Built date and its precis, and a milestone referenced in prose that has no block, which is exactly
# how milestone 34 (gPU acceleration via virtio-gpu 3D (the display ladder's rung four)) went missing. Documentation is part of this project's deliverable, so the record
# gets a gate.
#
# **The check that used to sit under this one went with the index it guarded.** Milestone 443 (lanes
# wait on each other for three reasons, and none of them is the work) added a grep forbidding any
# script but the generator and the two history readers from opening
# `design/roadmap/README.md`, because that file lagged its blocks and four pull requests jammed on
# scripts reading the lag as a fact. calef retired the file on 2026-09-21, so the failure it
# guarded cannot happen: a script that opens it now gets `FileNotFoundError`, which is louder than
# the grep was and needs nobody to maintain a list of exceptions. `script/metrics` and
# `script/catch-up` still read it at historical revisions, where it exists and is what that
# revision said.
echo "==> roadmap status"
"$(dirname "$0")/roadmap" --check
# The ready-time half (milestone 630): `--ready-branch` runs on `pull_request` from
# .github/workflows/ready-status.yml and from the pre-push hook, never from here, because lint
# cannot know whether the pull request is a draft. Its fixtures can still prove it fails.
"$(dirname "$0")/roadmap" --selftest >/dev/null


# Intra-doc links, denied when broken. This codebase leans unusually hard on `[`Item`]` links to
# stitch the code to itself and to the notes, which is deliberate (see CLAUDE.md on commenting) and
# makes a broken link a real loss rather than cosmetic. Nothing checked them until 2026-07-30, and
# there were TEN, including a whole crate's worth in `abi` where nested modules linked crate-root
# items without a path, plus `name[24]` in a comment that markdown read as a link.
#
# Split three ways because the workspace is not one target: the bare crates document for aarch64
# (riscv64 would refuse `xtask`, which needs std), `xtask` is a host tool, and redoxfs_server is its
# own workspace.
#
# `board_console` (milestone 216) is the second host-only member and joins `xtask` on the host
# line. It opens a serial port and spawns `stty`, so it is `std` by nature and cannot document for
# a bare-metal target any more than `xtask` can. Both are still documented, on the pass that suits
# them; the exclusion is about the target, not about skipping them.
#
# `stick_maker` (the stick program, 2026-09-19) is the third, and for the same reason: it is a
# host program that runs `diskutil` and reads sysfs. This list is typed out where `script/drift`
# derives the same set from each crate's `no_std` attribute; the next host-only crate will fail
# here exactly as this one did, and deriving it would make that unrepresentable.
#
# `sealed_pair` is the fourth, and it is the prediction above coming true: it was added on
# 2026-09-19 for milestone 223 (read a card and say whether its kernel and archive match), failed
# this pass on its first run with `Vec` not found, and the message said where to put it. It reads
# two files a host has and answers a question about them, so it is `std` by nature; the kernel side
# of the same question is `kernel::trust`, which is `no_std` and stays that way.
#
# `walk_pricing` (milestone 121 (`ripgrep` on nife: enumeration as a capability), 2026-09-26) is the fifth, and it is `std` for a different reason:
# it is plain `std::fs` code so that one walk runs on a host and on nife's `std` targets alike. It
# has no bare-metal build to document, and its nife build is `std_exerciser`'s.
#
# `c_library_errno` (milestone 835 (a C library, stage 1: files, clock and memory), 2026-10-10) is
# the sixth, for `walk_pricing`'s reason: it maps `std::io::ErrorKind` to `errno`, so it is `std` by
# nature, and its nife build is `c_library`'s.
echo "==> rustdoc (broken intra-doc links)"
DOCFLAGS="-D rustdoc::broken_intra_doc_links -D rustdoc::invalid_html_tags"
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --workspace --exclude xtask \
    --exclude board_console --exclude stick_maker --exclude sealed_pair --exclude walk_pricing \
    --exclude c_library_errno --exclude kernel --target aarch64-unknown-none-softfloat
# The kernel on its own, private items included (milestone 609 (the system tests leave the kernel
# crate)). It was a binary, and rustdoc documents a binary's private items by default; it is a
# library now, and a library's docs are its public surface, which for the kernel is nearly nothing.
# Its doc comments link private items throughout, so it is documented the way it always was. The
# library target only: the binary is a link line with the same name.
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet -p kernel --lib --document-private-items \
    --target aarch64-unknown-none-softfloat
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet -p xtask -p board_console -p stick_maker \
    -p sealed_pair -p walk_pricing -p c_library_errno
RUSTDOCFLAGS="$DOCFLAGS" cargo doc --no-deps --quiet --manifest-path redoxfs_server/Cargo.toml --lib

# The decision index (design/decisions/README.md and one file per decision, milestone 114): its
# numbering, its status vocabulary, that each decision's own Status line agrees with its index row,
# and that every §N cited in the tree resolves. Two concurrent milestones both claimed §30 on
# 2026-07-30 and it was caught only because an agent noticed; ~400 code comments cite a section by
# number, so a dangling citation is a broken footnote in the one place this project asks a reader to
# trust prose. See script/decisions, including what it still cannot check.
echo "==> decisions"
"$(dirname "$0")/decisions" --check

# A numbered record's file name carries exactly four digits (calef, 2026-10-07 UTC), so a directory
# listing sorts in numeric order: before it, `100-the-terminal-font.md` sat between `10-` and `11-`.
# Four rather than three so nothing is renamed again at 1000. Only the path is padded; a `§N` or
# `milestone N` citation stays as it is in prose, and so does each file's H1.
#
# This is rung two, and the case it exists for is a branch cut before the rename that adds
# `255-foo.md`: it merges clean, because no other file has that name, and the listing is unsorted
# again. script/decisions accepts either width on purpose, so the width is judged once, here.
# One check for every directory the ruling covers: design/roadmap/ joins the list rather than
# getting a near-copy of this block.
# design/roadmap/ joined on 2026-10-07 (UTC). Its letter addenda (`0020a-`) pass on the `[a-z]?`, and
# an appendix directory beside a block is judged like a file, since `listdir` returns both.
echo "==> numbered record files carry four digits"
python3 - <<'PY'
import os, re, sys

DIRS = ['design/decisions', 'design/roadmap']
NUMBERED = re.compile(r'(\d+)[a-z]?-')
bad = []
for d in DIRS:
    for name in sorted(os.listdir(d)):
        m = NUMBERED.match(name)
        if m and len(m.group(1)) != 4:
            bad.append(f'{d}/{name}')
if bad:
    print('lint: numbered record files whose number is not exactly four digits:', file=sys.stderr)
    for b in bad:
        n = NUMBERED.match(os.path.basename(b)).group(1)
        print(f'  {b} (rename it to {os.path.dirname(b)}/{int(n):04d}'
              f'{os.path.basename(b)[len(n):]}, and its links with it)', file=sys.stderr)
    print('calef ruled on 2026-10-07 (UTC) that these numbers are zero-padded to four digits so the',
          file=sys.stderr)
    print('directory sorts. See design/decisions/README.md and design/roadmap/README.md.',
          file=sys.stderr)
    sys.exit(1)
print(f'numbered records: every file in {", ".join(DIRS)} carries a four-digit number')
PY

# A dependency stays reachable by an upgrade (§81).
#
# Dependabot's `groups`, `schedule` and `open-pull-requests-limit` all reduce update noise and leave
# the upgrade reachable. `ignore` is the one that does not: it removes the pull requests by removing
# the upgrade, and the version stays out of reach until somebody edits this file again, which nothing
# prompts anyone to do. That is a standing decision about the dependency graph rather than about the
# queue, and §81 makes it calef's.
#
# The incident is §81's: four RustCrypto majors that could not build one at a time were silenced with
# an `ignore` block, on a pull request whose stated purpose was unblocking CI. Four lines of config is
# exactly the size at which a policy decision rides along unnoticed.
#
# So this refuses the SILENT foreclosure, not the deliberate one. An exception is allowed and has to
# say it is one, which is CLAUDE.md's rule for every rung of the ladder.
echo "==> dependency upgrades stay reachable"
dependabot="$(dirname "$0")/../.github/dependabot.yml"
if [ -f "$dependabot" ] && grep -qE '^[[:space:]]*ignore:' "$dependabot" &&
    ! grep -q 'EXCEPTION (§81)' "$dependabot"; then
    echo "lint: .github/dependabot.yml has an \`ignore:\` block with no recorded exception." >&2
    echo >&2
    echo "An \`ignore\` does not quiet an update, it forecloses the upgrade: the version stays" >&2
    echo "unreachable until somebody edits this file, and nothing will prompt them to. Prefer" >&2
    echo "\`groups\` (fold many pull requests into one), \`schedule\`, or" >&2
    echo "\`open-pull-requests-limit\`, all of which cut the noise and leave the upgrade reachable." >&2
    echo >&2
    echo "If a dependency genuinely must be held, say so where you hold it:" >&2
    echo "  # EXCEPTION (§81): <why this one cannot be upgraded, and what would change it>" >&2
    echo >&2
    echo "See design/decisions/0081-dependency-upgrades.md." >&2
    exit 1
fi

# The third citation gate, and the one that reads what a citation points AT (milestone 97). The two
# above prove a `§N` or a `milestone N` resolves to SOME entry; neither can prove it resolves to the
# RIGHT one, and both say so in their own headers. Twenty-eight comments credited the two-tier `^C`
# work to "milestone 24" (a second aarch64 board) rather than to §24, wrong from the day it was
# written, and both gates reported clean throughout because both numbers exist.
#
# This compares a citation's parenthetical gloss against the record's own title or body, and checks
# that an attributed block quote still exists in the file it names. See notes/citations.md for the
# tolerance rule and for the honest list of what it still cannot see.
#
# The selftest runs first and costs nothing (fixtures, no subprocesses, no tree), for the reason
# `script/fatal-risks --selftest` runs first a few checks above: a green `--check` looks identical
# whether the scanner works or has quietly stopped seeing a shape. It had stopped seeing two, a
# citation split by a line break and a lettered milestone, and neither failed anything until
# milestone 583 (a citation a line break split, or a lettered milestone).
# The metrics page's table of contents is generated (script/metrics --charts writes it between two
echo "==> citations"
"$(dirname "$0")/citations" --selftest >/dev/null
"$(dirname "$0")/citations" --check

# The ratchet on that gate, and the only check here that reads the DIFF rather than the tree
# (milestone 444 (a citation says what it cites, so a number stops being the identity)). calef ruled
# it on 2026-09-19: *"add the gloss ratchet."* A `milestone N` or `§N` on a line this branch ADDS has
# to say what it cites, once per number per file; nothing existing is touched, and nothing is swept.
#
# **Why a ratchet and not a sweep.** notes/citations.md priced the sweep and refused it: 2,911 sites,
# every one of which has to be READ to know what its author meant, because a pattern-applied gloss
# would make a wrong citation look verified. That argument is about a sweep and says nothing against
# a rule on new text, which is what this is. It moves the tree at the rate the tree changes.
#
# **Why it is worth a gate.** DECISIONS §151 (the goal of the repository split is independent
# release) rules that this repository becomes several. A number is one namespace over one tree; a
# gloss is a string a reader or a `grep` resolves wherever the block ends up. The tree is already
# 83% there by habit (465 of 560 glossed citations resolve against their target's own title) and
# nobody decided to make it so.
#
# **What it cannot catch, and the cost it is known to carry.** A citation arriving in a MERGE commit
# is invisible to it, by design, since the alternative fires on a lane for another lane's text. A
# gloss that is grounded and still cites the wrong record passes, which is `--check`'s own standing
# BUGS entry. And it bites the honest case: a lane adding one line to a dated account is asked for a
# gloss the surrounding passage already gives. Measured before it was turned on, over the 42 pull
# request merges from #953 to #1002: a median of 16 asks per pull request, each answered by one
# parenthetical, with one outlier of 893 (#970, which landed 24 proposal files at once).
echo "==> new citations say what they cite"
"$(dirname "$0")/citations" --ratchet

# Milestone 385 (when a milestone's status flips, tell the lane which notes cite it), and the only
# thing in this script that **cannot fail**. Every other check here says a build is wrong. This one
# says somebody's prose might be, and cannot tell which, so it prints and returns zero.
#
# It is here rather than beside the gates because of when it has to fire: the lane flipping a
# milestone to BUILT is the one person in the project who knows what that milestone now makes true,
# and it is holding that knowledge only while it is in the file. A sweep a week later is read by
# somebody who has to reconstruct it. That is the whole argument for the position, and it is why a
# report earns a line in a gate script.
#
# `|| true` because a report that can take the build down is a gate, whatever its output says, and a
# failure here would be a failure about prose nobody can prove wrong. This is the one place in
# script/lint where a non-zero exit is the bug rather than the finding.
echo "==> notes citing a milestone this branch moved"
"$(dirname "$0")/citations" --moved || true

# The fourth citation gate, and the only one that reads what a citation CLAIMS (milestone 275). The
# three above prove a `milestone N` or `§N` resolves, and that its gloss names the right record;
# none of them asks whether what `design/fatal-risks.md` SAYS about what it resolved to is still
# true. That file is the falsification list, nine claims that would stop the project, and its own
# BUGS section said from the day it was written that nothing gated it. On 2026-09-10 a maintainer
# reading it against the tree found that warning firing four ways at once, including risk 2 carrying
# `RUN, 2026-08-30. AMBER` for twelve days while milestone 191's own block read `NOT-STARTED`.
#
# It is here rather than on a cadence, which milestone 275's block left open, because drift in this
# file is always CAUSED by an in-tree edit: a milestone's status moved, or the file was written
# against a tree that has since changed. `script/cadence-check`'s header draws the line this sits on
# the far side of ("a dead cadence is not a defect in the commit that happens to trip it"); here the
# commit that trips it is the commit that caused it, and the lane holding it can fix it in the same
# breath. About a second, most of it the two report subprocesses it reuses rather than reimplements.
#
# The selftest runs first and costs nothing (fixtures, no subprocesses). It is here because a green
# `--check` on a clean tree looks identical whether the checks work or have quietly stopped firing,
# which is exactly how `script/roadmap`'s merged-branch check "spent a day passing in CI while being
# unable to fail". Eleven fixtures, eight that must come back red and three near-misses that must
# stay quiet.
echo "==> fatal risks"
"$(dirname "$0")/fatal-risks" --selftest >/dev/null
"$(dirname "$0")/fatal-risks" --check

# The script/ front door is documented in exactly one comprehensive place, and the README's list is a
# deliberate SUBSET of it. Two checks, because they fail in opposite directions: a script nobody
# documented is invisible, and a README naming a script that no longer exists sends a new reader into
# a wall. notes/scripts.md was missing five entries when this check was written, none of them noticed.
# The host pass must exclude EXACTLY the crates that cannot compile for the host, and this derives
# that set rather than trusting a list.
#
# The failure it prevents is the one that happened. `--exclude` removes a package from the test
# selection, not from the dependency graph, so excluding `user_mode_runtime` while four workspace crates
# depended on it unconditionally left it in the build. The host pass stopped compiling on x86_64 on
# 2026-08-03 and stayed broken until 2026-08-14, invisible throughout because CI moved to an aarch64
# runner the same day, where the EL0 assembly compiles by accident.
#
# So: ask cargo which workspace members reach `user_mode_runtime`, and check that every consumer of that
# knowledge excludes every one. A crate that takes a new `user_mode_runtime` dependency now fails here, naming
# itself, instead of breaking a stranger's first build.
#
# **Four consumers, not two** (milestone 244). It used to check this file's clippy lines and xtask's
# `test`, and the two it did not check are the two that report a NUMBER: `script/coverage`'s
# exclusions and `.cargo/mutants.toml`'s. `.cargo/mutants.toml` says in its own head comment that its
# list "deliberately mirrors script/coverage's exclusions" and asks the next person to "keep the two
# lists in step", which is rung four of the ladder and drifted exactly as rung four does. It was out
# of step by one crate, `system_initializer`, so the first published mutation report scored the
# largest crate in the tree at 191 mutants and 0 caught. Nobody was wrong; a number was, and it was
# the kind of number a stranger quotes.
#
# The check runs in one direction only. Every bare-metal crate must appear in all four places; a
# place may exclude MORE than that (xtask is host tooling, virtio is a live-device driver) because
# those exclusions carry their own recorded reasons and are judgement rather than physics.
echo "==> the host pass excludes exactly the bare-metal crates"
python3 - <<'PYEOF' || exit 1
import json, pathlib, subprocess, sys

meta = json.loads(subprocess.run(
    ["cargo", "metadata", "--format-version", "1", "--locked"],
    capture_output=True, text=True, check=True).stdout)

members = set(meta["workspace_members"])
name_of = {p["id"]: p["name"] for p in meta["packages"]}
edges = {n["id"]: [d["pkg"] for d in n.get("deps", [])] for n in meta["resolve"]["nodes"]}

def reaches_user_mode_runtime(pid, seen=None):
    if seen is None:
        seen = set()
    if pid in seen:
        return False
    seen.add(pid)
    for dep in edges.get(pid, []):
        if name_of.get(dep) == "user_mode_runtime" or reaches_user_mode_runtime(dep, seen):
            return True
    return False

bare = sorted(name_of[m] for m in members
              if name_of[m] == "user_mode_runtime" or reaches_user_mode_runtime(m))

lint = open("script/lint").read()
# Every xtask source, not `main.rs` alone: milestone 365 split that file into a module per
# command, and the exclusion list moved to the module that runs the host pass. What this check
# means is "the list exists somewhere in xtask", so read the directory rather than one file.
xtask_src = sorted(pathlib.Path("xtask/src").glob("*.rs"))
if not xtask_src:
    sys.exit("lint: xtask/src/*.rs matched no file, so the host-exclusion cross-check read an "
             "empty xtask and would have reported every crate missing (or none). See milestone 401.")
xtask = "".join(p.read_text() for p in xtask_src)
coverage = open("script/coverage").read()
mutants = open(".cargo/mutants.toml").read()
missing = []
for c in bare:
    if f"--exclude {c}" not in lint:
        missing.append((c, "script/lint"))
    if f'"{c}",' not in xtask:
        missing.append((c, "xtask/src/"))
    # script/coverage has two exclusion mechanisms and a crate needs only the one that fits it:
    # `--exclude` on the run (which `cargo llvm-cov report` has no equivalent of) or the awk filter
    # that drops the file from the report. `virtio` uses only the second and `kernel` only the
    # first, both correctly, so this asks for either rather than both.
    if f"--exclude {c}" not in coverage and f"/{c}/src/" not in coverage:
        missing.append((c, "script/coverage"))
    if f'"crates/{c}/**"' not in mutants and f'"{c}/**"' not in mutants:
        missing.append((c, ".cargo/mutants.toml"))

if missing:
    sys.stderr.write("lint: crates that cannot build for the host but are not excluded:\n")
    for c, where in missing:
        sys.stderr.write(f"  {c}  (missing from {where})\n")
    sys.stderr.write("""
These reach `user_mode_runtime`, which is EL0 syscall `asm!` and compiles only for aarch64 or riscv64. A
workspace member that reaches it cannot be built by a host `cargo test`, and `--exclude` on the
package alone does NOT help: it removes the package from the test selection, not from the dependency
graph, so cargo builds it anyway for whoever depends on it.

Either exclude it from the host pass in ALL FOUR places above, or do what redoxfs_server/Cargo.toml
does and put `user_mode_runtime` behind an optional `el0` feature, which is the better fix when the crate has
host logic worth testing. Milestone 244 measured that trade for the largest such crate
(`system_initializer`) and recommended the exclusion, with the numbers, in its own block: the pure
fraction there is about a fifth of the mutants and a fiftieth of the lines, and every pure function
is a leaf helper of the boot sequence beside it.

The last two matter for a reason the first two do not: they are what a published REPORT counts. A
bare-metal crate left in `.cargo/mutants.toml` is scored zero-caught against a suite that could never
have reached it, and a bare-metal crate left in `script/coverage` drags the coverage floor down by
lines nothing can execute.
""")
    sys.exit(1)

print(f"host pass: {len(bare)} bare-metal crates, every one excluded in all four places")
PYEOF

# The same failure one level down: a TARGET the host build never selects.
#
# The gate above derives what cannot compile for the host from the dependency graph, which is the
# right question for a crate and the wrong one for a `[[bin]]` with `required-features`. Such a
# target compiles perfectly well; `cargo build --workspace` and `cargo test` simply never put it in
# the build graph, because the feature is off. Nothing notices, which is the point of
# `required-features` and is also how it hides.
#
# It hides from the tool that publishes a NUMBER. cargo-mutants works from source files rather than
# from the build graph, so it happily mutates a file nothing compiles and scores every one of those
# mutants MISSED, in "0s build + 0s test". `uefi_loader/src/main.rs` is 154 of that crate's 189
# mutants, which is what scored the code that boots xenon at 15% and put it in
# notes/mutation-testing.md as one of two crates blamed for the tree's score falling seven points.
# The library half beside it, which is the half the design deliberately lifted out to BE
# host-testable, was at 91% the whole time.
#
# One target matches today, and it is five files, not one: 2026-09-24 found `main.rs`'s own modules
# (`src/arch/`, `src/chooser.rs`) scored MISSED because the gate checked only the root. The gate is
# worth its lines anyway, because it fires on the
# second one without anybody having read this paragraph, which is the difference between rung two
# and rung four. Coverage is not checked here: `script/coverage` reports on files the build
# produced, so a target it never built contributes no lines to drag the floor down.
echo "==> mutation excludes every target the host build never selects"
python3 - <<'MUTEOF' || exit 1
import json, subprocess, sys

meta = json.loads(subprocess.run(
    ["cargo", "metadata", "--format-version", "1", "--locked", "--no-deps"],
    capture_output=True, text=True, check=True).stdout)

root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      capture_output=True, text=True, check=True).stdout.strip()
mutants = open(".cargo/mutants.toml").read()

import os, re

# A target is not one file. `mod arch;` in `main.rs` puts `src/arch/mod.rs` and everything IT
# declares into the same unbuilt target, and cargo-mutants scores each of those files as MISSED
# exactly as it does the root. Checking only `src_path` let `uefi_loader/src/arch/` and
# `src/chooser.rs` through: 132 of the crate's 182 missed at the 2026-09-21 census. So walk the
# module tree from each root, the way rustc resolves a non-inline `mod name;`.
MOD = re.compile(r'(?:#\[path\s*=\s*"([^"]+)"\]\s*)?(?:pub(?:\([^)]*\))?\s+)?mod\s+(\w+)\s*;')

def module_tree(src):
    seen, todo = set(), [src]
    while todo:
        f = todo.pop()
        if f in seen or not os.path.isfile(f):
            continue
        seen.add(f)
        text = re.sub(r"//[^\n]*", "", open(f).read())
        here = os.path.dirname(f)
        owns_dir = os.path.basename(f) in ("main.rs", "lib.rs", "mod.rs")
        base = here if owns_dir else f[:-len(".rs")]
        for explicit, name in MOD.findall(text):
            if explicit:
                todo.append(os.path.normpath(os.path.join(here, explicit)))
            else:
                todo += [os.path.join(base, name + ".rs"), os.path.join(base, name, "mod.rs")]
    return seen

def glob_re(g):
    out, i = "", 0
    while i < len(g):
        if g.startswith("**", i):
            out, i = out + ".*", i + 2
        elif g[i] == "*":
            out, i = out + "[^/]*", i + 1
        else:
            out, i = out + re.escape(g[i]), i + 1
    return re.compile(out + "$")

block = re.search(r"exclude_globs\s*=\s*\[(.*?)\n\]", mutants, re.S).group(1)
excluded = [glob_re(g) for g in re.findall(r'^\s*"([^"]+)"', block, re.M)]

def rel(path):
    return path[len(root) + 1:] if path.startswith(root + "/") else path

missing = []
gated = []
for pkg in meta["packages"]:
    built = set()
    for target in pkg["targets"]:
        if not target.get("required-features"):
            built |= module_tree(target["src_path"])
    for target in pkg["targets"]:
        if not target.get("required-features"):
            continue
        # A file the host DOES build through another target (a module the library also declares)
        # is reachable by tests, so it stays mutated.
        for f in sorted(module_tree(target["src_path"]) - built):
            r = rel(f)
            gated.append(r)
            if not any(g.match(r) for g in excluded):
                missing.append((pkg["name"], target["name"], r,
                                target["required-features"]))

if missing:
    sys.stderr.write("lint: targets the host build never selects, but cargo-mutants still scores:\n")
    for name, tname, rel, feats in missing:
        sys.stderr.write(f"  {name}::{tname}  {rel}  (required-features = {feats})\n")
    sys.stderr.write("""
`required-features` keeps these out of `cargo build --workspace` and out of `cargo test`, so no host
test can reach a line of them. cargo-mutants does not read the build graph: it edits the source file
anyway, nothing rebuilds, the tests pass, and every mutant is recorded MISSED in "0s build + 0s
test". That is not a finding about the tests, it is arithmetic, and it lands in a published report.

Add the source path, or a glob over its module directory, to `exclude_globs` in `.cargo/mutants.toml`,
with the reason and with what DOES
prove the file (for `uefi_loader/src/main.rs` that is `cargo xtask uefi-boot` under OVMF). If the
target has logic worth mutating, the better fix is the one `uefi_loader` already made: lift the pure
half into a library the host compiles, and leave only the firmware calls behind the feature.
""")
    sys.exit(1)

print(f"mutation: {len(gated)} file(s) only feature-gated targets compile, every one excluded")
MUTEOF

# The same failure a THIRD time, and this one hides inside a package rather than beside it.
#
# The two gates above ask whether a crate or a target reaches the host build at all. This one asks a
# narrower question about a package that does: **when cargo-mutants runs this package's own tests,
# is every line it just mutated actually compiled?** cargo-mutants tests one package at a time
# (`--test-workspace` is off by default and turning it on would run the whole suite per mutant), so
# the command behind every number in the report is `cargo test -p <pkg>` with that package's DEFAULT
# features. Code behind a non-default feature is not in that build. The tool mutates it anyway,
# nothing it compiled changed, the tests pass, and the mutant is recorded MISSED.
#
# `documentation` is where it was found (milestone 280) and the cost was not the feature-gated code
# itself. `builder` gates the index WRITER, 92 mutants; it also gates six of the crate's twelve index
# tests, because a test that reads an index needs `build` to make one. So a single-crate run
# compiled away half the suite and then scored the READER against what was left. That is what put
# `documentation` at 52% in the first published mutation report, beside `uefi_loader`'s 15%, as one of
# two crates blamed for the tree's score falling from 92.4%.
#
# The fix a package makes is a dev-dependency on itself with the feature on: tests get it, consumers
# do not, and `cargo build -p <pkg>` is unchanged. That is what this checks for.
#
# **`script/coverage` hit the same failure on the same crate two weeks earlier and fixed only
# itself**, which is why this is a gate rather than another paragraph. On 2026-08-30 (PR #590,
# milestone 87) the coverage floor reported 33.3% on an index reader that is round-tripped against
# its own writer, because `builder` was off; it grew `--features documentation/builder` and a comment
# saying a feature gating something un-buildable "is a trap for every workspace-wide sweep, not just
# this one". The mutation config, whose own head comment asks the next person to keep the two lists
# in step, was not touched, and fourteen days later published 52% for the same crate for the same
# reason. The dev-dependency this gate requires fixes both tools at once, which is the other reason
# to prefer it: `script/coverage`'s per-feature line is now belt and braces rather than the mechanism.
#
# **Not the same question as the four-list problem beside it**, which is worth saying because the two
# read alike. Milestone 393, `design/roadmap/0393-the-host-excluded-crate-set-lives-in-four-places.md`, is about
# which CRATES cannot compile for the host, restated in four files where one derives it. This is
# about a crate that compiles perfectly well and a feature of it that a single-package test run does
# not turn on. Solving either leaves the other exactly where it was.
#
# **What it cannot see, said plainly rather than implied.** It checks that a feature is ON during the
# package's test build, not that anything tests the code behind it. And it reads `required-features`
# as the one honest exemption: a feature whose only job is to gate targets that are already excluded
# above (`uefi_loader`'s `uefi`) has no library code to compile. A feature that gated both a target
# and a `#[cfg]` block in the library would pass here and should not; nothing in the tree does that
# today.
echo "==> mutation compiles every feature of the crates it scores"
python3 - <<'FEATEOF' || exit 1
import json, subprocess, sys

meta = json.loads(subprocess.run(
    ["cargo", "metadata", "--format-version", "1", "--locked", "--no-deps"],
    capture_output=True, text=True, check=True).stdout)

root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      capture_output=True, text=True, check=True).stdout.strip()
mutants = open(".cargo/mutants.toml").read()


def excluded(pkg):
    """True if no line of this package is scored: its directory is in exclude_globs."""
    path = pkg["manifest_path"]
    if path.startswith(root + "/"):
        path = path[len(root) + 1:]
    return f'"{path[: -len("/Cargo.toml")]}/**"' in mutants


missing = []
checked = 0
for pkg in meta["packages"]:
    if excluded(pkg):
        continue
    # Which features this package turns on for its own test build, via a dev-dependency on itself.
    on_for_tests = set()
    for dep in pkg["dependencies"]:
        if dep["name"] == pkg["name"] and dep["kind"] == "dev":
            on_for_tests.update(dep["features"])
    # Which features exist only to gate targets the gate above already excluded.
    only_gates_excluded = set()
    for feat in pkg["features"]:
        users = [t for t in pkg["targets"] if feat in (t.get("required-features") or [])]
        if not users:
            continue
        rels = []
        for t in users:
            rel = t["src_path"]
            if rel.startswith(root + "/"):
                rel = rel[len(root) + 1:]
            rels.append(rel)
        if all(f'"{rel}"' in mutants for rel in rels):
            only_gates_excluded.add(feat)
    for feat in sorted(pkg["features"]):
        checked += 1
        if feat in on_for_tests or feat in only_gates_excluded:
            continue
        missing.append((pkg["name"], feat))

if missing:
    sys.stderr.write("lint: features cargo-mutants scores but the package's own tests never compile:\n")
    for name, feat in missing:
        sys.stderr.write(f"  {name}  feature \"{feat}\"\n")
    sys.stderr.write("""
cargo-mutants runs `cargo test -p <pkg>` with that package's DEFAULT features, so code behind a
non-default feature is mutated and never rebuilt: the tests pass, and every mutant there is recorded
MISSED. Worse, any TEST behind the same feature is compiled away too, so the surviving suite scores
the rest of the crate as well.

Give the package a dev-dependency on itself with the feature on, which is what `documentation` does:

    [dev-dependencies]
    <pkg> = { version = "0.1.0", path = ".", features = ["<feat>"] }

Tests get the feature, consumers do not, and `cargo build -p <pkg>` is unchanged. If instead the
feature only gates a `[[bin]]` nothing host-builds, exclude that target's source path in
.cargo/mutants.toml and this gate will read the exemption from `required-features`.
""")
    sys.exit(1)

print(f"mutation: {checked} feature(s) on mutated crates, every one compiled by its own tests")
FEATEOF

echo "==> script docs"
missing=""
for f in "$(dirname "$0")"/*; do
    name="$(basename "$f")"
    # Match the name followed by a non-name character, not a closing backtick: entries carry usage
    # (`script/toolchain-bump [YYYY-MM-DD]`), and requiring the backtick missed one on the first run.
    grep -qE "script/$name([^a-z-]|\$)" "$(dirname "$0")/../notes/scripts.md" || missing="$missing $name"
done
if [ -n "$missing" ]; then
    echo "lint: scripts with no entry in notes/scripts.md:$missing" >&2
    exit 1
fi
# The same hazard one line down (milestone 401): if README's phrasing stops spelling the scripts as
# `script/<name>`, this grep selects nothing and the resolve check judges nothing.
readme_refs=0
for name in $(grep -oE "script/[a-z-]+" "$(dirname "$0")/../README.md" | sort -u | cut -d/ -f2); do
    readme_refs=$((readme_refs + 1))
    [ -e "$(dirname "$0")/$name" ] || { echo "lint: README names script/$name, which does not exist" >&2; exit 1; }
done
if [ "$readme_refs" -eq 0 ]; then
    echo "lint: README.md names no script/<name>, so nothing was resolved. Either the README" >&2
    echo "stopped referencing scripts or its spelling moved; this check would otherwise pass" >&2
    echo "by checking nothing." >&2
    exit 1
fi
echo "script docs: every script documented, every README reference resolves"

# The project's QEMU is on PATH (milestone 287). On Linux `script/ci-qemu` builds the pinned
# emulator into `$HOME/.cache/nife-qemu` because no Ubuntu release ships one with
# `riscv-iommu-pci`, and until that milestone the ONLY thing in the tree that ever put that prefix
# on PATH was `.github/workflows/ci.yml`. So a Linux developer followed `script/bootstrap`'s own
# printed instructions, built the right QEMU, re-ran `script/setup` as told, and `qemu-check` found
# `/usr/bin`'s 8.2.2 again. Same failure, same message, same remedy, forever.
#
# `helpers/qemu-path.sh` is the fix and this is the rung-two half of it. The mechanism is PATH
# inherited by children, so it only works if the process at the TOP of the tree exported it, which
# means every entry point that can reach an emulator has to source the fragment. That is a thing to
# remember, and AGENTS.md is explicit that "somebody will notice" is rung zero.
#
# **The rule is mechanical on purpose, and it over-approximates.** A file under `script/` that runs
# `cargo xtask`, names a `qemu-system-*` binary, or calls a `helpers/qemu-*` helper must source the
# fragment. `script/apropos` and `script/crate-probes` are caught and boot nothing today; the line
# costs them nothing, and the alternative is a judgement call per file plus an allow-list, which is
# the shape `script/lint` check 5 and milestone 283 both refuse to grow.
#
# **A backticked mention is prose, not a call**, which is milestone 283's rule reused rather than
# reinvented: this directory's headers discuss `cargo xtask` constantly. Stripping backticked spans
# is what keeps `script/lint` (whose only hit is a sentence inside a Python heredoc) and
# `script/board-netboot` out, correctly, without either of them needing an exemption.
#
# BUGS: the token is textual, so an argv built indirectly still escapes it: `CARGO = "cargo"` then
# `[CARGO, "xtask"]`, or `"xtask"` appended to a list built elsewhere. No entry point does that
# today; the literal-list form is the one `script/falsifications` used, and it is caught.
echo "==> the project's QEMU is on PATH"
python3 - <<'QEMUEOF' || exit 1
import pathlib
import re
import sys

# The second alternative is the argv-list form, `["cargo", "xtask", ...]`, which a Python entry
# point builds for `subprocess`. It was missing until 2026-09-25, when `script/falsifications` ran
# `cargo xtask test` that way without the fragment and this check passed it (PR #1283).
TOKEN = re.compile(
    r"cargo\s+xtask\b"
    r"""|['"]cargo['"]\s*,\s*['"]xtask['"]"""
    r"|qemu-system-|helpers/qemu-"
)
FRAGMENT = "helpers/qemu-path.sh"

def callable_body(path):
    """The file with full-line comments and backticked prose removed."""
    text = path.read_text(errors="replace")
    lines = [ln for ln in text.splitlines() if not ln.lstrip().startswith("#")]
    # A span stops at a newline. Unbounded, one stray backtick paired with the next across dozens of
    # lines and erased real calls between them, which is the other half of why PR #1283 found
    # `script/falsifications` unchecked.
    return re.sub(r"`[^`\n]*`", "", "\n".join(lines))


def token_body(path):
    """callable_body, minus the fragment's own path, so sourcing it is not itself a trigger."""
    return callable_body(path).replace(FRAGMENT, "")

if not pathlib.Path(FRAGMENT).is_file():
    print(f"lint: {FRAGMENT} is missing; every script/ entry point sources it", file=sys.stderr)
    sys.exit(1)

missing = []
checked = 0
for path in sorted(pathlib.Path("script").iterdir()):
    if not path.is_file():
        continue
    body = callable_body(path)
    if not TOKEN.search(token_body(path)):
        continue
    checked += 1
    if FRAGMENT not in body:
        missing.append(path.as_posix())

if missing:
    print("lint: these script/ entry points can run an emulator and do not resolve the", file=sys.stderr)
    print("      project's QEMU, so on Linux they get apt's 8.2.2 instead of the pinned build:",
          file=sys.stderr)
    for name in missing:
        print(f"        {name}", file=sys.stderr)
    print(f"""
Add one line, immediately after the `cd` to the repository root:

    . {FRAGMENT}

It is sourced rather than executed because it edits the caller's PATH, which is
how all 38 bare-name `qemu-system-*` invocations in this tree get the right
emulator without any of them being patched. A no-op on macOS and wherever
`script/ci-qemu` has never run.

If this file genuinely cannot boot an emulator, the line still costs nothing and
is the cheaper answer than an exemption; see milestone 287.""", file=sys.stderr)
    sys.exit(1)

print(f"the project's QEMU is on PATH: {checked} entry point(s), each sourcing {FRAGMENT}")
QEMUEOF

# **The icount baselines name the nightly they were read against, and it has to be the pinned one.**
#
# `bench/baseline-{aarch64,riscv64,x86_64}.txt` are the tripwire's committed floors. icount counts
# guest instructions, so a new compiler revalues every number in them without anything in this
# repository changing: the floors move for a reason no commit is responsible for, and the tripwire's
# headroom erodes silently. That is not hypothetical. `nightly-2026-09-15` was pinned with the
# baselines left un-resaved, most of the headroom went with it, and the tree was bumped again to
# `nightly-2026-09-20` before anybody acted. It was luck that the drift evaporated: measured
# 2026-09-21 the worst margin was +2.27%.
#
# **This check can only ever fail on a pull request that raises the pin**, which is the whole design.
# Every other branch carries a baseline and a pin that already agree, and the merge queue rebases
# onto a `main` where they still do. So a bump pull request is where the delta is caused, where it is
# visible, and where a human is already deciding something; that is the shape calef chose on
# 2026-09-21 over a general staleness check, which would fail branches that caused nothing.
#
# **Auto-re-saving on a bump is refused; restamping a floor proven unmoved is not** (calef,
# 2026-09-26, overturning part of his 2026-09-21 refusal; milestone 598 (a nightly bump restamps the
# floors it proves it did not move)). A workflow that re-recorded the floors as part of raising the
# pin would make them track the compiler by construction, so a nightly that genuinely made this
# kernel slower would never be visible, and most of what the tripwire exists for is exactly that. So
# a floor NUMBER still moves only by a person's `--save --why`. What the bump workflow may do is
# `cargo xtask bench --restamp`: build the tree under the stamped nightly and the pin on one runner,
# and when every row moved under 0.5% and under 2% since the last save, rewrite this line and add a
# `# why:` line with the measurement. This check therefore reads `# toolchain:` as "the nightly these
# numbers were last proven valid for", which is weaker than "produced by" and is the ruling.
#
# **The one exemption, and it is a foot gun.** `script/toolchain-bump` sets
# `NIFE_BUMP_IN_PROGRESS=1` around its own gate run, because it has just raised the pin and has not
# re-recorded anything, so this check is guaranteed to fire and firing there would only un-bump a
# tree that is otherwise fine. Nothing in CI sets it and nothing else should: the enforcement is
# this check running unexempted on the bump's pull request. A green lint bought with this variable
# means nothing.
echo "==> the icount baselines name the pinned nightly"
python3 "$(dirname "$0")/../helpers/lint_icount_baselines.py" || exit 1

# Counted claims (milestone 125). DECISIONS §39 says a name is a claim; so is a number, and a number
# is the kind of claim a machine can check, which is what makes this a gate rather than an audit.
#
# The evidence it was needed: three claimed counts were tested against the tree on 2026-08-14 and
# **all three were wrong**, two of them disagreeing with each other as well as with the tree. Every
# one had been correct when it was written. Nobody re-derives a number, so every number in this tree
# is a snapshot of whenever somebody last counted.
#
# The convention is one HTML comment sitting after the number it vouches for:
#
#     **119 harnesses** <!--count:KANI-HARNESSES--> across 21 crates <!--count:HARNESS-CRATES-->
#
# (spelled in capitals here ONLY so this example is not itself a claim the gate then has to keep
# true; a real marker is lower case. The names below are the real ones.)
#
# and the registry below is the other half: one entry per name, each saying in the prose's own words
# WHICH QUESTION IT ANSWERS, and deriving the answer from the tree. See notes/counted-claims.md.
#
# **It is a ratchet, not a sweep.** An unmarked number stays unchecked and the gate says nothing
# about it; the population grows as people touch numbers. That is the honest boundary of what this
# buys, and it is the same restraint `script/names --check` keeps: insist a marked number be right,
# never that every number be marked.
echo "==> counted claims"
# The comment-and-literal stripper every count below is built on, against its fixtures first. It
# once backtracked exponentially on an unterminated raw string (CodeQL alert 26, see
# notes/code-scanning.md), which would hang this gate instead of failing it.
python3 helpers/rust_source.py --selftest >/dev/null
python3 - <<'PYEOF' || exit 1
import json
import os
import pathlib
import re
import subprocess
import sys

# The derivations this gate shares with `script/metrics`, in one place rather than copied into both
# (milestone 236: three derivations are copied between scripts, and nothing notices when they
# drift). This script `cd`s to the repository root on line 18, which is what lets a heredoc import
# at all; the block comment above `_unsafe_census` below says what stays here and why.
# `dont_write_bytecode` because the import would otherwise leave a `helpers/__pycache__/`
# behind on every run, which is an untracked directory a gate has no business creating.
sys.dont_write_bytecode = True
sys.path.insert(0, 'helpers')
import rust_source                                                          # noqa: E402

# --- the registry -------------------------------------------------------------------------------
#
# One entry per count name. `question` is the sentence the prose asks, in the prose's own words,
# because the failure this gate is most likely to have is answering a subtly different question than
# a human would and so failing a correct document. "How many `#!/bin/sh` scripts" has at least three
# defensible answers (`ls script/` gives 37; the shellcheck glob is wider), so the entry has to say
# which one it means and the prose has to mean the same one.
#
# `derive` returns an int and must be CHEAP and DETERMINISTIC: lint runs on every build, and a gate
# that is slow or flaky is a gate people route around. Anything needing a build (the frame numbers
# from script/stack-frame-check, say) does not belong here. Each derivation's comment states the
# SHAPE IT ASSUMES, because this tree already recorded a count that was wrong for exactly that
# reason: the grep behind it matched only single-line `#[path]` includes while several sites were
# two lines, and the resulting "three modules" went into AGENTS.md as fact.

# A proof harness: the attribute alone on its line, indented or not. Anchoring to the whole line is
# what keeps prose ABOUT the attribute out of the count -- helpers/kani-lint-shim/ spells
# `#[kani::proof]` twice inside doc comments, and neither is a harness. The `\b.*` tail admits
# `#[kani::proof_for_contract(...)]`, which the tree does not use today; matching only the bare form
# would give a count that is quietly low the day somebody does, and a low count is no better than a
# high one when the prose is copying it.
HARNESS = re.compile(r'^[ \t]*#\[kani::proof\b.*\][ \t]*$', re.M)

# Files holding `#[kani::proof]` that belong to no workspace package. Both are deliberate and
# neither is provable: the shim is source rustc compiles by hand for this file's harness-clippy
# pass, and `vendor/redoxfs` is upstream code kept out of the workspace on purpose (see the
# workspace Cargo.toml's own note). The verify-table check further down this file states the same
# two names in its own `EXEMPT`, and the duplication is deliberate rather than missed: the two checks
# are separate `python3` heredocs in a shell script, so there is no scope they could share. A new
# entry should be argued for rather than added, and it belongs in both.
_HARNESS_EXEMPT = {
    'helpers/kani-lint-shim/kani_attributes.rs',
    'vendor/redoxfs/src/node.rs',
}


def _harness_hits():
    """(workspace package, number of harnesses) for every package that has any.

    Scoped to the workspace because that is what `cargo kani` can reach, and **it was scoped to
    `crates/` until milestone 212**, with a docstring here that gave the reason as "the kernel, the
    user programs and xtask are not packages it compiles". That stopped being true a milestone
    later: 193 (put `kernel/src` within reach of the prover) and 197 (`user/` and `xtask` are out of
    reach of the prover) each added a row to `script/verify`'s crate table, and this count went on
    excluding both, so the tree carried two derived numbers for one question. That is precisely the
    failure `<!--count:-->` exists to prevent, one level up: the derivation was a snapshot of a
    scope somebody last checked.

    The package list comes from the same `cargo metadata` walk this file's verify-table check uses,
    with its EXEMPT set doing the work it already does: the `helpers/kani-lint-shim` source and
    `vendor/redoxfs` carry harnesses this suite has never run, and counting them would make the
    number describe a suite nobody executes.
    """
    meta = json.loads(subprocess.run(
        ['cargo', 'metadata', '--format-version', '1', '--locked', '--no-deps'],
        capture_output=True, text=True, check=True,
    ).stdout)
    ws = meta['workspace_root']
    prefixes = {}
    for pkg in meta['packages']:
        rel = os.path.relpath(os.path.dirname(pkg['manifest_path']), ws)
        if rel == '.' or rel.startswith('..'):
            continue
        prefixes[pkg['name']] = rel + '/'
    hits = {}
    for f in subprocess.run(['git', 'grep', '-lE', r'#\[kani::proof', '--', '*.rs'],
                            capture_output=True, text=True).stdout.split():
        if f in _HARNESS_EXEMPT:
            continue
        owner = None
        for name, prefix in prefixes.items():
            if f.startswith(prefix) and (owner is None or len(prefix) > len(prefixes[owner])):
                owner = name
        if owner is None:
            continue
        n = len(HARNESS.findall(pathlib.Path(f).read_text(errors='replace')))
        if n:
            hits[owner] = hits.get(owner, 0) + n
    return hits


def _sh_scripts():
    """Files under script/ and helpers/*.sh whose first line is exactly `#!/bin/sh`.

    Assumes script/ is flat (it is: every entry is an executable, no subdirectories) and that
    helpers/ mixes .sh files with directories, which is why only *.sh is globbed there. Deriving
    from the shebang rather than from the glob is what makes the NAME true: the prose says
    "`#!/bin/sh` scripts", so the gate counts files that start with `#!/bin/sh`.
    """
    files = [p for p in pathlib.Path('script').iterdir() if p.is_file()]
    files += [p for p in pathlib.Path('helpers').glob('*.sh') if p.is_file()]
    return sum(1 for p in files
               if p.read_text(errors='replace').split('\n', 1)[0].strip() == '#!/bin/sh')


def _abi_syscalls():
    """`SYS_*` u64 constants in crates/abi/src/lib.rs: the width of the syscall trap.

    Assumes the syscall numbers are the crate's only `SYS_`-prefixed u64 constants, which they are
    and which the naming makes self-enforcing: every other constant in the crate is a method, a
    right, an object type or a sentinel, and none of those is spelled `SYS_`. Optional leading
    whitespace so a future one nested in a module still counts; a nested one that was NOT counted
    would make this number quietly low, and a low count is no better than a high one when prose is
    copying it (the `_sh_scripts` entry records the same hazard).

    It is here because the 2026-08-17 documentation sweep found the ABI's own front page, the
    kernel's syscall module, an `Error` variant's description and two notes all saying the surface
    was **three** calls. `SYS_CAP_DELETE` landed 2026-07-24 and moved none of them.
    """
    text = pathlib.Path('crates/abi/src/lib.rs').read_text(errors='replace')
    return len(re.findall(r'^[ \t]*pub const SYS_[A-Z_0-9]+: u64\b', text, re.M))


def _rights_bits():
    """Named single-bit rights in crates/capability: how many rights a capability can carry.

    Counted from `capability::Rights` rather than from `abi::rights` because the prose that states
    this number is about `Rights`, and the abi module documents itself as *matching* it. Only the
    single-bit constants count: `NONE` is `Rights(0)` and `ALL` is a mask of the others, so the
    shape assumed is `pub const NAME: Rights = Rights(1 << N);` and neither aggregate matches it.

    That the two sides agree, and that `ALL` is exactly the union of these bits, is pinned by tests
    rather than here (`rights_are_distinct_single_bits`, `rights_bits_are_the_wire_format`). This
    counts; those compare.
    """
    text = pathlib.Path('crates/capability/src/lib.rs').read_text(errors='replace')
    return len(re.findall(r'^[ \t]*pub const [A-Z_0-9]+: Rights = Rights\(1 << \d', text, re.M))


def _loom_hits():
    """(crate directory name, loom harnesses) for every crate under crates/ that runs a loom model.

    A loom harness is a test that calls `loom::model`, which is the shape every one of them has and
    the thing that makes it a harness rather than an ordinary test: the model is the search. Counted
    that way rather than by `#[test]` inside a `#[cfg(all(test, loom))]` module, because the cfg
    spelling is incidental and the call is the definition. The two agreed at 19 when this was
    written, which is how the shape was checked.

    Distinct from `kani-harnesses`, and the distinction is the point of having both: Kani proves
    properties of pure logic, loom searches interleavings of hand-rolled atomics, and
    `script/interleaving-check` runs only the second. A note that conflated them would be counting a
    suite nobody executes.
    """
    hits = {}
    for path in pathlib.Path('crates').rglob('*.rs'):
        n = len(re.findall(r'\bloom::model\(', path.read_text(errors='replace')))
        if n:
            hits[path.parts[1]] = hits.get(path.parts[1], 0) + n
    return hits


def _longest_markdown_line():
    """The longest line, in bytes, in this repository's own markdown.

    Tracked .md files, vendor excluded, because that is the corpus `documentation`'s renderer is sized
    against. **This one has a consumer rather than only a reader**: `documentation::render::LINE_MAX` is
    2048, chosen as the next power of two above this measurement, and a document that exceeds
    LINE_MAX is truncated. So the number is a safety margin, and letting it drift silently spends
    the margin.

    It is here because this gate's own author spent it. Documenting the counted-claims check in
    notes/scripts.md's `script/lint` row (in notes/scripts/build-test-and-gate.md since 2026-09-25),
    which IS the longest line, took it to 2108 and broke a
    `documentation` render test whose message pointed three hundred lines away at unrelated text. Bytes
    rather than characters, matching what LINE_MAX bounds.
    """
    files = subprocess.run(['git', 'ls-files', '*.md', ':!vendor'],
                           capture_output=True, text=True, check=True).stdout.split()
    return max(len(line.encode())
               for f in files
               for line in pathlib.Path(f).read_text(errors='replace').split('\n'))


def _security_audits():
    """Security audits on the record, counted from the index every one of them is filed in.

    A row in design/audit-reports/README.md's findings table that carries a **link to a report**,
    which is one per audit and is what distinguishes that table from the scale table below it: the
    two carry the same (date, kind) pairs, so counting those would double, and deduplicating them
    would silently merge two audits of one kind on one day. 2026-08-17 has two audits already.

    It is here because SECURITY.md told a reporter "four adversarial reviews are on the record" and
    pointed at four of them by name, while the index held five. That page is read by exactly the
    person we most want to have read the fifth one first, and the stale number sent them to look
    for a lens that had already been taken.
    """
    text = pathlib.Path('design/audit-reports/README.md').read_text(errors='replace')
    return len(re.findall(r'^\| \d{4}-\d\d-\d\d \| security \|.*\]\(', text, re.M))


# The unsafe census (milestone 134), raised by calef on 2026-08-18 as one question: "how much
# unsafe code is there in a code base, and is that something we should be monitoring and driving in
# a particular direction over time?" A standalone census would have answered it with another
# one-time number nobody re-takes, which is the failure this milestone exists to fix, so it is a
# derivation here instead. See notes/register-of-measures.md and notes/unsafe-obligations.md.
#
# **The counting lives in `helpers/rust_source.py` and the file WALK lives here**, which is
# milestone 236's line and worth reading before moving either. `script/metrics` derives the same
# census over blobs it streams out of git at eight historical revisions, with nothing checked out,
# because AGENTS.md forbids the checkout that would be needed; this gate is asked about the tree in
# front of it and reads the working copy. Sharing the count removes the drift; sharing the walk
# would force one of those two to lie about which tree it is describing.
#
# Every regex, every exclusion and the reason for each is in that module, beside the code they
# govern rather than here.
_census = {}


def _unsafe_census():
    """Every unsafe number this tree tracks, in one pass over the source that runs on nife.

    Cached, because several numbers come out of one walk and `script/lint` runs on every build.
    The walk is about half a second over ~300 files, which is why it is one pass and not three.
    """
    if not _census:
        _census.update(rust_source.unsafe_census(_tracked_rust()))
    return _census


def _tracked_rust():
    """(path, text) for every tracked `.rs` file outside `vendor/`, read from the working tree.

    Cached for the same reason the census is: two derivations here walk it. `git ls-files` rather
    than a directory walk so an untracked scratch file cannot move a gate, and the same file set
    `script/metrics` gets from `git ls-tree` at a revision, which is what makes the two comparable
    at all.
    """
    if not _rust_files:
        names = subprocess.run(['git', 'ls-files', '*.rs', ':!vendor'],
                               capture_output=True, text=True, check=True).stdout.split()
        _rust_files.extend((name, pathlib.Path(name).read_text(errors='replace'))
                           for name in names)
    return _rust_files


_rust_files = []




def _markdown_files():
    """Markdown files the tree owns: everything but `target/` and `vendor/`.

    README.md tells a newcomer how large the corpus is, and that number rotted from 427 to 542
    without anybody noticing, because a count in prose is a claim nobody re-derives. Same argument
    counted-claims already makes everywhere else, applied to the one file a stranger reads first.

    `vendor/` is excluded for the reason it is excluded from every other sweep here: it is upstream's
    documentation, not ours, and a newcomer sent to read the corpus is not being sent there.
    """
    return sum(1 for p in pathlib.Path('.').rglob('*.md')
               if not str(p).startswith(('target/', 'vendor/')))


def _notes_files():
    """Files under `notes/`, which is what README.md calls the glossary."""
    return sum(1 for p in pathlib.Path('notes').glob('*.md'))


REGISTRY = {
    'longest-markdown-line': (
        "how long the repository's longest markdown line is, in bytes, which is what "
        'documentation::render::LINE_MAX is sized against',
        _longest_markdown_line,
    ),
    'kani-harnesses': (
        'how many Kani proof harnesses the tree carries, which is what script/verify proves',
        lambda: sum(_harness_hits().values()),
    ),
    'harness-crates': (
        'how many workspace packages carry at least one Kani proof harness',
        lambda: len(_harness_hits()),
    ),
    'markdown-files': (
        'how many markdown files the tree carries outside target/ and vendor/, which is the corpus '
        "README.md's reading order sends a newcomer into",
        _markdown_files,
    ),
    'notes-files': (
        'how many notes there are, which is the glossary a newcomer is told the size of',
        _notes_files,
    ),
    'sh-scripts': (
        'how many `#!/bin/sh` scripts there are under script/ and helpers/, which is the set '
        'shellcheck gates',
        _sh_scripts,
    ),
    'syscalls': (
        'how many syscall numbers the ABI defines, which is the whole width of the trap',
        _abi_syscalls,
    ),
    'rights-bits': (
        'how many named single-bit rights a capability can carry (capability::Rights)',
        _rights_bits,
    ),
    'loom-harnesses': (
        'how many loom harnesses the tree carries, which is what script/interleaving-check runs',
        lambda: sum(_loom_hits().values()),
    ),
    'loom-crates': (
        'how many crates carry at least one loom harness',
        lambda: len(_loom_hits()),
    ),
    'security-audits': (
        'how many security audits are on the record in design/audit-reports/README.md',
        _security_audits,
    ),
    'unsafe-density-outside-arch': (
        'how many `unsafe {}` blocks there are per 10,000 lines of code outside '
        'kernel/src/arch/, which is the unsafe that is not paying for hardware access',
        lambda: _unsafe_census()['density'],
    ),
    'unsafe-thread-safety-claims': (
        'how many `unsafe impl Send`/`Sync` claims the tree makes, each one a hand-written '
        'assertion that the compiler is wrong about a type',
        lambda: _unsafe_census()['thread_safety'],
    ),
    # The census's third population (milestone 139 (drive the unsafe count down), 2026-10-07 UTC;
    # name provisional). Its opening measurement counted `unsafe impl` as one number and the gate
    # above watched only its Send/Sync half; this is the other half, held the same way, at the
    # tree's exact value. `unsafe fn` is deliberately still not here: notes/unsafe-obligations.md
    # says why, beside this marker.
    'unsafe-trait-claims': (
        'how many `unsafe impl` of an unsafe trait other than Send/Sync the tree makes, each one a '
        "hand-written assertion that a trait's contract holds for a type",
        lambda: _unsafe_census()['trait_claims'],
    ),
}

# --- finding the markers ------------------------------------------------------------------------
#
# `git grep` rather than a walk: it is one process, it reads only tracked files, and it skips
# binaries and anything ignored, so target/ and a stray build directory cannot slow it down or
# confuse it. vendor/ is excluded for the reason the rest of this script excludes it -- it is not
# our prose.
# THREE relations, and neither of the other two is equality, because equality is the wrong one for
# any quantity that moves on its own.
#
#   <!--count:NAME-->           the number must EQUAL the tree. A census.
#   <!--count-at-least:NAME-->  the number must be a FLOOR. Fires only when the count goes DOWN.
#   <!--count-at-most:NAME-->   the number must be a CEILING. Fires only when the count goes UP.
#
# Why the floor (2026-08-17): `kani-harnesses` was marked in four claim sites and the count moved
# three times in one day, so every lane that added a harness had to edit four files, one of them
# README.md, which nearly every other lane touches too. That is a merge hotspot manufactured by the
# convention rather than by the tree. Reading what each site actually claimed split them cleanly:
# two are a census and want equality; two were conveying **scale** ("121 Kani harnesses across 21
# crates: the capability model, IPC, MMU isolation, ..."), and for a monotonically growing quantity
# a floor is the *true* claim while an exact equality is a maintenance tax that buys nothing.
#
# The ratchet is intact, which is the only test that matters here: a floor that goes false still
# fails the build. Deleting harnesses below a stated floor is exactly the event worth catching, and
# it is the one an equality check would have drowned in noise.
#
# **Why the ceiling (milestone 134, 2026-08-18), and it is the floor's mirror rather than a third
# idea.** A floor suits a quantity where MORE IS BETTER and the bad event is a deletion. Some
# quantities are the other way up, and unsafe is the tree's clearest one: nobody wants more of it,
# every addition should be a deliberate act with a written reason, and the bad event is a drift
# upward that no single commit looks responsible for. calef raised it as one question -- "is that
# something we should be monitoring and driving in a particular direction over time?" -- and a
# direction is exactly what the other two relations cannot express. Equality says "this is the
# number"; a floor says "at least"; only a ceiling says "and it should not grow".
#
# **What a ceiling is NOT.** It is not zero-slack, and this was measured before it was chosen. Over
# the 14 days to 2026-08-18, 38 non-merge commits changed the number of `unsafe {` outside
# kernel/src/arch/. A ceiling written at exactly the tree's value would have fired on all 38 and
# sent every one of them to edit the same line of the same note, which is precisely the merge
# hotspot the paragraph above records the convention manufacturing once already. A ceiling is
# written ABOVE the tree, with the headroom stated, so it fires on drift rather than on a lane.
#
# The exception is a population small and consequential enough that every addition deserves the
# stop: `unsafe-thread-safety-claims` is written at the tree's exact value for that reason, and it
# moved twice in three weeks rather than 38 times in two.
MARKER = re.compile(r'<!--count(-at-least|-at-most)?:([a-z0-9-]+)-->')

# **A ratchet ceiling (2026-09-24): a ceiling that must also follow the tree DOWN.** An ordinary
# ceiling is silent when the tree falls below it, which is right for a quantity with headroom and
# wrong for one whose ceiling is meant to sit at the tree's exact value. `agents-md-lines` is the
# case. Its ceiling was 935 when #1189 split AGENTS.md into imperatives plus `design/tenets/`
# appendices and took the file to 584 lines, and from then on the gate would have let the file
# regrow by 351 lines without a word: a fixed ceiling far above the file stops nothing. So a name in
# this set fails in BOTH directions. Above the ceiling is the old failure (take the addition out, or
# raise the ceiling with the reason beside it). Below it is new, and its only fix is to lower the
# number, so every shrink is banked and the ceiling can only move down without a written raise.
#
# The shape is `unsafe-thread-safety-claims`' (a ceiling written at the tree's exact value) with the
# slack direction closed, and the baseline stays where every counted claim's does: in the marker,
# here in design/roadmap/0118-constitution-budget.md. Not a separate baseline file, because the
# marker already is one, and two places holding one number is the drift this convention exists to
# end. BUGS: a raise is still an ordinary edit to that marker. Nothing here compares the number
# against origin/main, because every raise on record (925 to 929, and before) was a considered act
# with its reason written beside it, and a gate that forbade them would be deleted the first time
# one was right. The raise shows in the diff; the reader of that diff is the check.
#
# Empty since 2026-10-06 (UTC): calef dropped the line limit of milestone 118 (CLAUDE.md has a
# budget), "drop 118's limit and rely on §212's cap", so AGENTS.md is budgeted in words by the prose
# ratchet and `agents-md-lines` is gone. The mechanism stays for the next ceiling that must sit at the tree's exact value.
RATCHET_CEILINGS = set()

# Prose explaining this convention has to be able to spell it, which is the same exemption the
# "daemon" check below carries for the documents that argue about the word. A marker inside a
# backtick span is being QUOTED, not asserted, so blank the spans before looking. Blanked rather
# than deleted so that column positions still line up with the number-before-marker search.
CODE_SPAN = re.compile(r'`[^`]*`')

# The number a marker vouches for is the LAST number on the line before the marker, commas allowed
# so that `1,303 commits` works. Last rather than first, because a sentence usually reaches its
# number at the end ("across 21 crates") and because a line with two counts wants each marker to
# bind to the number just before it -- notes/unsafe-obligations.md is the live case, and it says
# crates before harnesses, the opposite order to everywhere else.
#
# **A count spelled in words counts too**, added by the 2026-08-17 documentation sweep, which
# needed it: the claim it went to gate was "the surface is three calls", and small counts in prose
# about a design are written as words far more often than as digits. notes/counted-claims.md
# recorded "digits or nothing" as a limitation, and this is that limitation closed rather than a
# second mechanism -- one regex and the same opt-in marker.
#
# Only small cardinals, and deliberately no composition ("twenty-one" is not read). A count large
# enough to want composing is one a person writes in digits anyway, and a parser that accepts
# "one hundred and twenty" would be guessing at prose. If a marked word is not in this table the
# gate says so rather than skipping the claim, which is the loud direction.
#
# This changes nothing about the ratchet: only a MARKED number is ever read, so admitting words
# cannot produce a false positive on the ordinary prose that says "the three of them".
WORD_VALUES = {
    'one': 1, 'two': 2, 'three': 3, 'four': 4, 'five': 5, 'six': 6, 'seven': 7, 'eight': 8,
    'nine': 9, 'ten': 10, 'eleven': 11, 'twelve': 12, 'thirteen': 13, 'fourteen': 14,
    'fifteen': 15, 'sixteen': 16, 'seventeen': 17, 'eighteen': 18, 'nineteen': 19, 'twenty': 20,
    'thirty': 30, 'forty': 40, 'fifty': 50, 'sixty': 60, 'seventy': 70, 'eighty': 80,
    'ninety': 90, 'hundred': 100,
}
# Longest first, so `fourteen` is never read as `four`. The word boundaries make that safe already;
# the ordering means it stays safe if a boundary is ever relaxed.
NUMBER = re.compile(
    r'\d[\d,]*|\b(?:' + '|'.join(sorted(WORD_VALUES, key=len, reverse=True)) + r')\b',
    re.I,
)


def claimed_value(text):
    """The last number-like token in `text` as an int, or None if there is none.

    Returns None for a word this table does not carry as well as for no number at all; the caller
    reports both, because a marker whose number cannot be read is a claim nobody is checking and
    that is the thing this gate exists to refuse.
    """
    token = None
    for hit in NUMBER.finditer(text):
        token = hit.group(0)
    if token is None:
        return None
    if token[0].isdigit():
        return int(token.replace(',', ''))
    return WORD_VALUES.get(token.lower())

grep = subprocess.run(
    ['git', 'grep', '-n', '-e', '<!--count:', '-e', '<!--count-at-least:',
     '-e', '<!--count-at-most:', '--', ':!vendor'],
    capture_output=True, text=True,
)
# git grep exits 1 for "no matches", which is a legitimate state for a ratchet that starts empty.
if grep.returncode not in (0, 1):
    sys.stderr.write(grep.stderr)
    sys.exit(1)

bad, checked, seen = [], 0, set()
derived = {}
# Markdown fences: a marker inside ``` is an EXAMPLE of the convention, not a claim about the tree.
# The roadmap block and notes/counted-claims.md both show one, and both would otherwise be checked
# against numbers they were never asserting. Fenced blocks only; an indented code block is not
# recognised, which is a limitation notes/counted-claims.md records rather than hides.
fenced = set()
for path in {line.split(':', 1)[0] for line in grep.stdout.splitlines() if line}:
    if not path.endswith('.md'):
        continue
    inside = False
    for n, text in enumerate(pathlib.Path(path).read_text(errors='replace').split('\n'), 1):
        if text.lstrip().startswith('```'):
            inside = not inside
        elif inside:
            fenced.add((path, n))

for line in grep.stdout.splitlines():
    if not line:
        continue
    path, lineno, text = line.split(':', 2)
    if (path, int(lineno)) in fenced:
        continue
    text = CODE_SPAN.sub(lambda m: ' ' * len(m.group(0)), text)
    # A marker's own name must not donate a numeral to the marker after it: `count:one-shot-reply`
    # would read as the number 1 for the next claim on the line. Blanked rather than deleted, so
    # column positions still line up with the number-before-marker search, the same trick CODE_SPAN
    # uses. Searched from `text`, and blanked into a parallel string, so the markers are still found.
    numbers_only = MARKER.sub(lambda m: ' ' * len(m.group(0)), text)
    for match in MARKER.finditer(text):
        relation, name = match.group(1), match.group(2)
        seen.add(name)
        if name not in REGISTRY:
            bad.append(f'{path}:{lineno}: {match.group(0)} names no entry in the registry')
            continue
        claimed = claimed_value(numbers_only[:match.start()])
        if claimed is None:
            bad.append(f'{path}:{lineno}: {match.group(0)} has no number before it on this line '
                       f'(digits, or a cardinal up to twenty)')
            continue
        if name not in derived:
            derived[name] = REGISTRY[name][1]()
        actual = derived[name]
        checked += 1
        if relation == '-at-least':
            # A floor. Only a claim that has gone FALSE is a problem; the tree growing past it is
            # the expected case and must stay silent, which is the whole point of the relation.
            if claimed > actual:
                bad.append(f'{path}:{lineno}: claims at least {claimed}, the tree has {actual} '
                           f'({name}: {REGISTRY[name][0]}). A floor is only wrong when it stops '
                           f'being true, so this means the count went DOWN')
        elif relation == '-at-most':
            # A ceiling, the floor read upside down: the tree falling below it is the wanted
            # direction and must stay silent. The message says what the two honest responses are,
            # because a ceiling that only says "no" teaches a lane to delete the marker. Raising it
            # is a legitimate answer AS LONG AS the reason is written where the number lives, which
            # is the whole mechanism: the edit is cheap and the sentence beside it is the point.
            if claimed < actual:
                bad.append(f'{path}:{lineno}: claims at most {claimed}, the tree has {actual} '
                           f'({name}: {REGISTRY[name][0]}). A ceiling is only wrong when it stops '
                           f'being true, so this means the count went UP by {actual - claimed} '
                           f'past the headroom. Take the addition back out, or raise the ceiling '
                           f'in this commit and say beside it why the addition was worth it')
            elif claimed > actual and name in RATCHET_CEILINGS:
                bad.append(f'{path}:{lineno}: claims at most {claimed}, the tree has {actual} '
                           f'({name}: {REGISTRY[name][0]}). This ceiling is a ratchet (see '
                           f'RATCHET_CEILINGS in script/lint): the count went DOWN, so bank it by '
                           f'lowering the ceiling to {actual} in this commit')
        elif claimed != actual:
            bad.append(f'{path}:{lineno}: says {claimed}, the tree says {actual} '
                       f'({name}: {REGISTRY[name][0]})')

if bad:
    print('lint: a counted claim disagrees with the tree:', file=sys.stderr)
    for entry in bad:
        print(f'  {entry}', file=sys.stderr)
    print('', file=sys.stderr)
    print('Fix the number, or fix the derivation in script/lint if the tree is right and the gate '
          'is asking the wrong question. See notes/counted-claims.md.', file=sys.stderr)
    sys.exit(1)

unused = sorted(set(REGISTRY) - seen)
extra = f'; {len(unused)} registered and unmarked ({", ".join(unused)})' if unused else ''
print(f'counted claims: {checked} markers over {len(derived)} counts, all agreeing with the tree'
      f'{extra}')

# The two unsafe numbers that are REPORTED rather than asserted, and the distinction is milestone
# 134's rule: a number with a consumer gets a relation, a number with only a reader gets printed.
#
# `kernel/src/arch/` deliberately has no ceiling. Driving that number down means either writing
# assembly wrong or moving it out of arch/, and DECISIONS rule 1 says arch code belongs there, so a
# target would be a gate pushing against the architecture. But an unmarked number in a note is a
# snapshot of whenever somebody last counted, which is this whole convention's founding complaint,
# so it is printed on every build instead: on screen every time, asserted never.
if _census:
    print(f'unsafe census: {_census["outside_arch"]} blocks in {_census["code_lines"]} lines '
          f'outside kernel/src/arch/, {_census["density"]} per 10,000 (ceiling); '
          f'{_census["inside_arch"]} blocks inside arch/ (no target: rule 1 puts assembly there); '
          f'{_census["thread_safety"]} Send/Sync claims (ceiling); '
          f'{_census["trait_claims"]} other unsafe trait impls (ceiling). '
          f'See notes/register-of-measures.md')

# --- the three derivations that could not be made one (milestone 236) ----------------------------
#
# The `unsafe` census and the code-line count above no longer need a check: they are the same
# function `script/metrics` calls, in `helpers/rust_source.py`, so there is nothing left to drift.
# The harness count could not be collapsed that way, and the reason is a real difference in what
# each caller is allowed to do rather than a preference:
#
#   - this script and `script/falsifications` attribute every harness to a workspace package out of
#     `cargo metadata`, which is the better derivation and needs a checked-out workspace;
#   - `script/metrics` reads blobs at eight historical revisions with nothing on disk, and its own
#     header records that nothing there is allowed to build, so it counts from source text alone.
#
# So the honest answer is the weaker one, here: run all three and fail on a disagreement. **It
# compares the real implementations and never restates one**, which is the trap this shape has.
# `_harness_hits()` is this script's own, `--count` is `script/falsifications`' own, and
# `rust_source.harness_count` is the function `script/metrics` itself calls. Nothing below knows
# what a harness looks like.
#
# One number rather than a table: the count is what reaches a reader, on notes/project-metrics.md
# and in the prose this file's counted claims gate, and a per-package breakdown would fail on a
# scope difference the three deliberately have.
# no-cargo-ok: everything above runs without cargo; only this cross-check needs `cargo metadata`.
if os.environ.get('LINT_NO_CARGO'):
    print('harness count: three-derivation cross-check skipped in --no-cargo mode (needs cargo metadata)')
    sys.exit(0)
_text_count = rust_source.harness_count(_tracked_rust())
_pkg_count = sum(_harness_hits().values())
_falsifications = subprocess.run(['script/falsifications', '--count'],
                                 capture_output=True, text=True, check=True).stdout.split()
_ways = {
    'script/lint, from cargo metadata': _pkg_count,
    'script/falsifications --count': int(_falsifications[0]),
    'helpers/rust_source.py, which script/metrics calls': _text_count['total'],
}
if len(set(_ways.values())) != 1:
    print('lint: the tree carries three derivations of the harness count and they disagree:',
          file=sys.stderr)
    for _where, _value in _ways.items():
        print(f'  {_value}  {_where}', file=sys.stderr)
    print('', file=sys.stderr)
    print('One of them changed its definition and the others kept the old one, which is what this '
          'check exists to make loud. Decide which question is the right one, change all three, '
          'and say why in the module that now holds the odd one out. See milestone 236.',
          file=sys.stderr)
    sys.exit(1)
if _text_count['falsified'] != int(_falsifications[1]):
    print(f'lint: script/falsifications counts {_falsifications[1]} harnesses with evidence and '
          f'helpers/rust_source.py counts {_text_count["falsified"]}, so the falsification ratio on '
          f'notes/project-metrics.md is not the one script/falsifications reports. See milestone 236.',
          file=sys.stderr)
    sys.exit(1)
# The fourth state (§134, amended 2026-10-06) is held to the same agreement, because it is a series
# on the same chart: a disagreement here would draw `unfalsifiable` from one definition and the
# ratio `script/falsifications` prints from another.
if _text_count['unfalsifiable'] != int(_falsifications[2]):
    print(f'lint: script/falsifications counts {_falsifications[2]} unfalsifiable harnesses and '
          f'helpers/rust_source.py counts {_text_count["unfalsifiable"]}, so the harnesses chart on '
          f'notes/project-metrics.md is not the one script/falsifications reports. See milestone '
          f'236 (three derivations are copied between scripts, and nothing notices when they drift).',
          file=sys.stderr)
    sys.exit(1)
print(f'harness count: {_pkg_count} by three derivations that agree, '
      f'{_text_count["falsified"]} of them falsified, {_text_count["unfalsifiable"]} unfalsifiable')
PYEOF

# The naming conventions, for the ones a machine can check (milestone 46, DECISIONS §39). The rest of
# them -- "name a component for what it is", "prefer a word a reader can parse without prior Unix
# exposure" -- need judgement and stay prose, in design/naming.md. These four do not.
#
# Every check below is a ratchet, and the argument is §39's: a name is a claim, made before a reader
# sees a line of code. `netd`, `compd`, `gpud` and `termd` each claimed a Unix daemon model this OS
# does not have, and the claim survived four milestones because nothing was looking. Cheap greps,
# because lint runs constantly.
echo "==> naming conventions"

# 1. No `-d` suffix on a component or a crate. §39 made this a rule; without a check it lasts until
#    the first inconvenient moment. Three characters or fewer is not enough room to claim a Unix
#    daemon model (`kbd`, before its 2026-08-27 rename to `keyboard_driver`, was the worked
#    example: an ordinary abbreviation that happened to end in `d`, not a `-d` claim), so the rule
#    starts at four. Names that genuinely end in `d` go in the allow-list WITH a reason, the same
#    shape as a per-item `#[allow]`.
#
#    Allowed: `uuid` is RFC 9562's own term for the object (milestone 111); the trailing d is the
# last letter of "identifier", not a daemon suffix, and there is no long-running process here at all:
# the program draws sixteen bytes, prints one line and exits.
#
#    `asid` was the other entry until 2026-09-18, and it left by being renamed rather than by being
# re-argued: DECISIONS §154 made it `address_space_identifier`, which ends in `r`. An entry that
# exists only because a name is an acronym the rule cannot read is one the expansion deletes.
naming_allow=" uuid "
named_for_a_daemon=""
for name in \
    $(ls "$(dirname "$0")/../components/src" | sed 's/\.rs$//') \
    $(ls "$(dirname "$0")/../fixtures/src" | sed 's/\.rs$//') \
    $(grep -A1 '^\[\[bin\]\]' "$(dirname "$0")/../components/Cargo.toml" | sed -n 's/^name = "\(.*\)"$/\1/p') \
    $(grep -A1 '^\[\[bin\]\]' "$(dirname "$0")/../fixtures/Cargo.toml" | sed -n 's/^name = "\(.*\)"$/\1/p') \
    $(ls "$(dirname "$0")/../crates")
do
    case "$name" in
        ???*d)
            case "$naming_allow" in
                *" $name "*) ;;
                *) named_for_a_daemon="$named_for_a_daemon $name" ;;
            esac
            ;;
    esac
done
if [ -n "$named_for_a_daemon" ]; then
    echo "lint: names ending in -d, which claims a daemon this OS does not have:$named_for_a_daemon" >&2
    echo "Name it for what it is (DECISIONS §39, design/naming.md). If the word simply ends in d," >&2
    echo "add it to naming_allow in this script with the reason." >&2
    exit 1
fi

# 2. "Daemon" appears nowhere. §39's vocabulary is component / service / contract, and the word is
#    excluded from code, comments and notes. Two places are exempt because they are where the
#    ARGUMENT about the word lives: design/, which holds the decisions and (since §155) the naming
#    conventions, and this script. A rule's rationale has to be able to name the thing it rejects.
# $$, not a fixed name: see the note on the rule-1 check above (a shared /tmp path races two
# worktrees' lint runs against each other).
if git -C "$(dirname "$0")/.." grep -Iilnw daemon -- \
    ':!vendor' ':!design' ':!script/lint' \
    > "/tmp/nife-daemon.$$" 2>/dev/null; then
    echo "lint: \"daemon\" outside the two places the argument about the word lives:" >&2
    cat "/tmp/nife-daemon.$$" >&2
    echo "The vocabulary is component / service / contract (DECISIONS §39)." >&2
    rm -f "/tmp/nife-daemon.$$"
    exit 1
fi
rm -f "/tmp/nife-daemon.$$"

# A fixed /tmp path in a script this tree ships, made mechanical (milestone lint-worktree-leak,
# 2026-09-27, closing the gap the three checks above just fixed). `/tmp` is one filesystem shared by
# every worktree on the machine, and lanes gate concurrently (CLAUDE.md, "lane count"), so a script
# that redirects into `/tmp/some-fixed-name` races every other worktree doing the same: whichever
# process's write lands last between another process's write and its own read wins, and the loser
# reports a finding that names a file from a WORKTREE IT NEVER READ. Reproduced for exactly this
# script: two lint-shaped loops racing the (now-fixed) `/tmp/nife-daemon.txt` path in two worktrees
# put the matchless worktree's own file report at 69 of 100 iterations.
#
# The check is a name test, not a behavior test, because a behavior test would mean racing every
# script on every run. A path is exempt when it contains a `$`: `$$` (this shell's pid, what the
# three checks above now use), `$(mktemp ...)`, or `$RANDOM` all make the path unique to the running
# process, which is what makes the race impossible rather than merely unlikely. A fixed literal has
# none, so `grep -v '\$'` is the whole test once comments are stripped. Comments are excluded because
# this paragraph and the three above it correctly say `/tmp/nife-daemon.txt` in prose, and
# `script/stranger-test`'s own usage note names literal example paths for a human to paste.
echo "==> fixed /tmp paths in scripts (they race across worktrees; see the note above)"
if git grep -nE '[<>]>?[[:space:]]*"?/tmp/[A-Za-z0-9_.-]+"?' -- 'script/*' 'helpers/*.sh' \
    | grep -vE ':[[:space:]]*#' \
    | grep -v '\$' > "/tmp/nife-fixed-tmp-paths.$$" 2>/dev/null; then
    echo "lint: a script redirects into a fixed /tmp path, which races every other worktree on" >&2
    echo "the machine doing the same (see the comment above this check):" >&2
    cat "/tmp/nife-fixed-tmp-paths.$$" >&2
    echo "" >&2
    echo "Make the path unique to this process: append \".\$\$\" (see the rule-1 check above for" >&2
    echo "the pattern) or use \$(mktemp)." >&2
    rm -f "/tmp/nife-fixed-tmp-paths.$$"
    exit 1
fi
rm -f "/tmp/nife-fixed-tmp-paths.$$"

# 3. One spelling for contract crates. The tree had four spellings of "the wire contract" when this
#    was written (`fs_proto`, `gfx_proto`, `netproto`, `line_editor::proto`); `*_proto` won for CRATES
#    because it is what both of them already were, and a second habit is how the first one rots.
#
#    **The suffix became `_protocol` at milestone 265** (`_proto` is a truncation, and it collides
#    with the other word it could be short for). calef ruled that on 2026-09-05. The check is
#    the same check; only the string moved.
#
#    **The glob is the whole hazard here and is why it is `*protocol` and not `*proto*`.** This loop
#    selects the crates it then judges, so a glob that matches nothing passes by checking nothing,
#    which is the `--exclude`-goes-stale failure design/naming.md lists. `crates/*proto` stopped
#    matching any directory the moment 265 landed and would have reported clean forever.
#    **The counter is milestone 401's mechanism and it is belt over braces here.** Measured against
#    the tree at 51fee8248^, the commit before 265 landed, this loop shape does NOT go quiet on an
#    empty glob: `sh` leaves the unexpanded word in place, `basename` yields the literal `*proto`,
#    and that falls through the `case` to the failure branch. The historical claim that it "passed
#    by checking nothing" is wrong; it would have failed loudly with a confusing message about a
#    crate named `*proto`. The counter is here anyway because the property should not depend on a
#    `case` arm somebody could reorder, and because the message it prints says what actually went
#    wrong instead of naming a crate that does not exist.
protocol_crates=0
for dir in "$(dirname "$0")"/../crates/*protocol; do
    [ -d "$dir" ] || continue
    protocol_crates=$((protocol_crates + 1))
    name="$(basename "$dir")"
    case "$name" in
        *_protocol) ;;
        *) echo "lint: contract crate $name should be spelled *_protocol (design/naming.md)" >&2; exit 1 ;;
    esac
done
if [ "$protocol_crates" -eq 0 ]; then
    echo "lint: crates/*protocol matched no directory, so the contract-crate spelling check" >&2
    echo "judged nothing. The suffix moved again; move the glob with it (design/naming.md)." >&2
    exit 1
fi

# 4. **The one branch prefix that carries a mechanism, guarded against near-misses.**
#
#    This was a fixed allowlist of eleven prefixes until 2026-08-17, and calef retired it after
#    asking what the taxonomy was for. The answer, checked rather than argued: **nothing consumes
#    it except this check.** A grep across `script/`, `helpers/`, `.github/workflows/` and `xtask/`
#    for any other reader of a branch prefix returns only false positives (`bench/baseline-*.txt`
#    is a directory, `$prefix/bin` is a shell variable). Only `milestone/N-` is read by anything,
#    and 4b below is what reads it.
#
#    **Every observed failure of the allowlist was a false rejection of legitimate work**, four
#    times: `roadmap/` (the repository's SECOND commonest prefix, refused while ~35 merges already
#    on main used it), `gh-readonly-queue/*` (failed every group build's clippy job, so the queue
#    evicted and rebuilt forever), `dependabot/*`, and `claude/*` (a harness names its own branches
#    and a lane cannot rename them from inside). Each was fixed by widening the list after
#    something broke. That is the signature §61 used to drop three lints and milestone 78 used on
#    three assertions: a check that only ever rejects valid work is measuring the wrong thing.
#
#    **What survives, and why it is the branch name rather than a label.** 4b needs to know which
#    milestone a lane claims, and it runs LOCALLY and OFFLINE: the branch comes from
#    `symbolic-ref`, with no network and no GitHub context. A label cannot carry this. It would
#    put a `gh` call and an authenticated network round trip inside a file-only gate, and it would
#    not exist yet, because a lane runs this before `gh pr create`. The status-accuracy sweep
#    decided the same question the same way on 2026-08-16, refusing `git ls-remote` for the
#    `IN-PROGRESS` check because "the remote needs network in a file-only gate". A branch name is
#    also **fixed when the lane is cut**, where a label is editable at any time; for a check whose
#    job is "you claimed 126, so move 126's block", the claim has to be the immutable half.
#
#    So the taxonomy moves to design/naming.md as a convention, and the only thing still refused is
#    a name that LOOKS like a milestone claim and would therefore skip 4b in silence. That is the
#    one real hole the allowlist was plugging: `milestone-126-pgrep`, with a hyphen, does not match
#    4b's `milestone/*` and would sail past the check that exists to catch a status that never
#    moved.
#
#    A detached HEAD (every CI pull_request run, since actions/checkout builds the merge commit)
#    has no branch to judge and is skipped rather than guessed at, as before.
#
#    **The shape rule itself lives in helpers/branch-name-check.sh** (2026-09-22), not here. This
#    check only ever sees a branch that already exists, which means it fires after the worktree is
#    made, after the work is written, sometimes after commits; script/claim runs the identical
#    refusal before any of that, and a shared case statement is what keeps the two answers from
#    drifting apart. See that file for the near-miss reasoning.
branch="$(git -C "$(dirname "$0")/.." symbolic-ref --quiet --short HEAD || true)"
. "$(dirname "$0")/../helpers/branch-name-check.sh"
nife_check_branch_name_shape "$branch" lint || exit 1

# 4b. **A `milestone/N-*` branch must touch that milestone's roadmap file** (§90, 2026-08-16).
#     The status field lagged the tree four times in one week: 43, 65 and 107 were BUILT for
#     eleven days while their rows said otherwise, and 54 sat hidden behind them. Merging is what
#     finishes a lane, so the status flip belongs in the merge rather than with whoever happens to
#     notice afterwards.
#
#     **The lane makes the edit, and this is the one exception to "a developer never edits
#     design/"** (calef, 2026-08-23; reaffirmed and narrowed 2026-09-01, and now stated in
#     AGENTS.md's developer role rather than only here). The original intent was the reverse: the
#     lane would report the status and the integrator would land the flip separately. That was
#     dropped because the check cannot tell who made an edit anyway, and because a status flip in
#     a different merge from the work is the drift this check exists to catch.
#
#     **Why it was reaffirmed.** On 2026-09-01 two lanes hit this check and both reported it as an
#     impossible instruction, because the failure message below still quoted the retired rule while
#     AGENTS.md's developer bullet forbade the fix. The exception had been real for eight days and
#     lived only in this comment, which no failing lane ever reads. It is narrow: a lane's own
#     milestone's roadmap block and nothing else under design/, not design/decisions/ and not
#     another milestone's block. The drift to watch for is between a lane's claim and the merged
#     tree, and review catches that rather than authorship.
#
#     A branch that leaves the status unmoved still touches the file, if only to say why. That
#     sentence was missing four times.
case "$branch" in
milestone/*)
    milestone_n="${branch#milestone/}"
    milestone_n="${milestone_n%%-*}"
    case "$milestone_n" in
    '' | *[!0-9]*) ;; # no leading number: the prefix check above owns that shape
    *)
        # The block's filename pads the number to four digits (calef, 2026-10-07 UTC); the
        # branch name does not, so `milestone/7-x` and `milestone/0007-x` both find 0007-*.md.
        milestone_file_n="$(printf '%04d' "$(expr "$milestone_n" + 0)")"
        roadmap_block="$(ls "$(dirname "$0")/../design/roadmap/$milestone_file_n-"*.md 2>/dev/null | head -1)"
        if [ -z "$roadmap_block" ]; then
            echo "lint: branch '$branch' names milestone $milestone_n, which has no roadmap block." >&2
            exit 1
        fi
        # Against the merge base, not the working tree: the question is what this branch changes,
        # and a branch that has merged main is not thereby excused.
        merge_base="$(git -C "$(dirname "$0")/.." merge-base HEAD origin/main 2>/dev/null || true)"
        if [ -n "$merge_base" ] && [ -n "$(git -C "$(dirname "$0")/.." rev-list -n1 "$merge_base"..HEAD 2>/dev/null)" ]; then
            if [ -z "$(git -C "$(dirname "$0")/.." diff --name-only "$merge_base"..HEAD -- "design/roadmap/$milestone_file_n-"*.md)" ]; then
                echo "lint: branch '$branch' changes nothing in ${roadmap_block#*design/}." >&2
                echo "  A milestone branch lands its status flip in the same merge as the work (§90)." >&2
                echo "  A lane edits its own milestone's roadmap block, and only that: this is the" >&2
                echo "  one exception to 'a developer never edits design/' (AGENTS.md, the developer" >&2
                echo "  role). If the status genuinely does not move, say so in the block: that" >&2
                echo "  sentence was missing four times in a week." >&2
            fi
        fi
        ;;
    esac
    ;;
esac

# 5. **No `#[path]` module shared by two or more binaries** (CLAUDE.md rule 7, 2026-08-01).
#    Anything two binaries must agree on is a crate; a `#[path]` module is not one, and the cost is
#    not tidiness. Such a module is unreachable by host tests AND by Kani, so the constants two
#    programs share are checked by nothing. `cseam` was the proof: it stated the shared-memory
#    layout twice, once in Rust and once in `fixtures/c/c_seam.c`, with no test that they agreed, and a
#    drift would have surfaced as a C component writing to the wrong offset.
#
#    A module with exactly ONE consumer is fine and stays fine: that is an ordinary submodule, and
#    the rule is about agreement between binaries, not about file layout. `virtio_net_transport` and
#    `socket_test_client` are that case today.
#
#    This check is the one that would have caught the whole class. It counts consumers per include
#    target, so it fails the moment a second binary reaches for the same file.
#    The allow-list is empty, and that is the intended steady state. `virtio` was the one
#    entry: it could not be a crate while it reached back into whichever binary included it
#    for `check`, and the fix was to delete `check` rather than to pass it in. Rust already
#    has the per-binary "how this program dies" hook, `#[panic_handler]`, and both binaries
#    already had one doing the same thing. An entry here needs that kind of reason.
path_module_allow=" "
shared_modules=""
program_src="$(dirname "$0")/../components/src $(dirname "$0")/../fixtures/src"
# **The directories have to exist** (milestone 401). Every grep below is `2>/dev/null`, so a renamed
# source tree makes this check silently find no `#[path]` targets and report rule 7 upheld over a
# tree it never read. milestone 175 (split `user/`) already moved `user/src` to `components/` and
# `fixtures/`, which is exactly the move this guard is for.
for d in $program_src; do
    [ -d "$d" ] || { echo "lint: $d does not exist, so the #[path] scan read nothing (rule 7)" >&2; exit 1; }
done
# shellcheck disable=SC2086
for target in $(grep -rhoE '#\[path = "[a-z_0-9]+\.rs"\]' $program_src 2>/dev/null |
                sed 's/.*"\(.*\)\.rs".*/\1/' | sort -u); do
    # shellcheck disable=SC2086
    consumers=$(grep -rlE "^mod $target;" $program_src 2>/dev/null | wc -l | tr -d ' ')
    if [ "$consumers" -gt 1 ]; then
        case "$path_module_allow" in
            *" $target "*) ;;
            *) shared_modules="$shared_modules $target($consumers)" ;;
        esac
    fi
done
if [ -n "$shared_modules" ]; then
    echo "lint: #[path] modules shared by more than one binary:$shared_modules" >&2
    echo "" >&2
    echo "CLAUDE.md rule 7: anything two binaries must agree on is a crate, never a #[path]" >&2
    echo "module. A shared module is invisible to host tests and to Kani, so what two programs" >&2
    echo "agree on ends up checked by nothing. Move it to crates/ and depend on it." >&2
    echo "A module with a single consumer is fine; this only fires at two or more." >&2
    exit 1
fi

# 5b. **A file compiled into a proof-only module for another architecture records every
#     `crate::arch` it names**, from milestone 432 (the RISC-V IOMMU driver has no counterpart to
#     the SMMU's proofs). `kernel/src/arch/mod.rs` compiles `arch/riscv64/iommu.rs` under
#     `cfg(all(kani, target_arch = "aarch64"))` so the prover can reach it from an aarch64 host. Inside that module `crate::arch` is aarch64's, not riscv64's, and
#     nothing says so at the call site: a harness that reaches a `crate::arch` call proves the
#     host's code while reading as riscv64's, which is the "stub that reads as coverage"
#     notes/kernel-proofs.md exists to prevent (its stub-list item 8).
#
#     The mechanism is a recorded set per file. The references a file has today are listed below
#     with the reason no harness reaches them; a new one fails here, and the author decides at that
#     moment whether a harness can reach it. It cannot prove reachability, which is a call graph
#     and not a grep: it is the tripwire that forces the question to be asked. The file list is
#     read from the `mod riscv64 { ... }` block itself, so a second file joining the module
#     without a recorded set fails too. Spellings it cannot see: `use crate::{arch, ...}` is caught
#     and refused outright, but `super::super::` climbing out of a nested module is caught only
#     as the literal `super::super`.
echo "==> proof-only modules: crate::arch is the host's"
python3 - <<'PY'
import re, sys

# file (relative to kernel/src/arch/riscv64/) -> the crate::arch paths it may name, and why no
# harness in it reaches them.
RECORDED = {
    "iommu.rs": {
        # MMIO and DMA-visible memory: `r32`/`w32`/`r64`/`w64`, `zeroed_page_frame`, `attach`,
        # `cmd_push`, `take_fault`. No harness calls any of them; the harnesses call only
        # `device_context`, `is_in_directory`, `context_offset` and `iodir_inval_ddt`.
        "crate::arch::mmu::phys_to_virt",
        # The write barrier in `attach` and `cmd_push`, neither of which a harness calls.
        "crate::arch::direct_memory_access_write_barrier",
    },
}

mod_rs = open("kernel/src/arch/mod.rs").read()
block = re.search(r'#\[cfg\(all\(kani, target_arch = "aarch64"\)\)\][^{]*?mod riscv64 \{(.*?)\n\}',
                  mod_rs, re.S)
if block is None:
    print("lint: kernel/src/arch/mod.rs has no proof-only `mod riscv64 { ... }` block, so this check "
          "read nothing. If the module moved or was removed, update or delete check 5b with it.",
          file=sys.stderr)
    sys.exit(1)
files = [m + ".rs" for m in re.findall(r'\bmod\s+(\w+)\s*;', block.group(1))]

bad = []
for f in files:
    src = open("kernel/src/arch/riscv64/" + f).read()
    found = set(re.findall(r'\bcrate::arch(?:::\w+)+', src))
    if re.search(r'\bcrate::\{[^}]*\barch\b', src) or "super::super" in src:
        bad.append(f"{f}: names crate::arch through a grouped `use` or `super::super`, which this "
                   "check cannot enumerate; spell it `crate::arch::...` so it can")
    extra = found - RECORDED.get(f, set())
    if f not in RECORDED:
        bad.append(f"{f}: compiled into the proof-only module with no recorded set here")
    for e in sorted(extra):
        bad.append(f"{f}: {e} is not recorded")

if bad:
    print("lint: a riscv64 file compiled for the prover on an aarch64 host names crate::arch "
          "paths nobody has accounted for:", file=sys.stderr)
    for b in bad:
        print("  " + b, file=sys.stderr)
    print("Inside that module crate::arch resolves to aarch64, so a harness reaching one of these "
          "proves aarch64's code under riscv64's name. If no harness reaches it, add it to "
          "RECORDED in script/lint check 5b with the reason. If one does, the harness is a fiction: "
          "restructure it. See notes/kernel-proofs.md, stub-list item 8.", file=sys.stderr)
    sys.exit(1)
print(f"proof-only modules: {len(files)} riscv64 file(s) on the aarch64 prover host, every "
      "crate::arch reference recorded")
PY

# 6. **`notes/` and `design/` markdown filenames are lowercase and hyphenated** (CLAUDE.md).
#    They are URL slugs the moment any of this is published, and a hyphen is a word separator in a
#    URL where an underscore is a joiner. It is also the convention every documentation tree uses
#    (the Rust Book, Linux Documentation/, the Kubernetes site), which is the whole argument: a
#    reader already knows the shape.
#
#    README.md is the exception and the only one: GitHub renders it as the directory index, which is
#    behaviour rather than style, and the same reason repo-root files are SCREAMING_SNAKE_CASE.
doc_name_bad=""
for f in "$(dirname "$0")"/../notes/*.md "$(dirname "$0")"/../design/*.md; do
    base="$(basename "$f")"
    [ "$base" = "README.md" ] && continue
    case "$base" in
        # `[[:upper:]]`, not `[A-Z]`: in most locales a glob range interleaves cases, so
        # `[A-Z]` matches lowercase too and this check flagged every file in the tree.
        *_*|*[[:upper:]]*) doc_name_bad="$doc_name_bad $base" ;;
    esac
done
if [ -n "$doc_name_bad" ]; then
    echo "lint: notes/ and design/ filenames must be lowercase and hyphenated:$doc_name_bad" >&2
    echo "" >&2
    echo "These become URL slugs. A hyphen separates words in a URL; an underscore joins them." >&2
    echo "README.md is the only exception, because GitHub renders it as the directory index." >&2
    exit 1
fi

# 7. **Every crate, program and script/ entry point carries a provenance block** (milestone 115).
#    A name in this tree is an architect's call, and until now nothing recorded that a call had been
#    made.
#    The failure was concrete: a lane proposed `system_builder`, the maintainer endorsed it, and
#    calef overruled it, and only afterwards did anyone find that milestone 63 had ALREADY refused
#    that exact name for a reason still true. The refusal sat in one table cell inside one milestone
#    block, and a blind rename later swept the old name out of that very row.
#
#    Presence, not content. This can check that a name carries a reason; it cannot check that the
#    reason is still true, that a date is right, that a `recorded` citation leads anywhere, or that
#    an `unrecorded` entry is honest rather than lazy. That is the same limit script/decisions
#    records for §N citations, and it is not closeable by a script, because a reason is prose and
#    prose is checked by reading.
#
#    **Presence of a STATE, never the state `ratified`**, and that is deliberate rather than a
#    weakness to tighten later. The three states are `ratified`, `recorded` (the tree argues the
#    name, calef never ruled) and `unrecorded`, and 54 of 126 names are not ratified today. A gate
#    keyed on ratification would hold every unrelated merge behind a review queue nobody can hurry,
#    which is a wall this milestone was written specifically not to build. `script/names
#    --unratified` is how the queue gets worked; the lint only insists a name say which it is.
#
#    **And exactly one block per file, in the spelling the parse reads** (milestone 283). The parse
#    stops at the first `Name:` line and matches `^<prefix> ?Name:`, so a stale proposal block above
#    a ratified one hides it AND a header wearing markdown is invisible on its own. Both at once is
#    how two of calef's ratifications sat on the worklist for a week with the gate reporting
#    `provisional`, which is a legitimate answer nothing disputes. The check asks the general
#    question underneath both: does anything in this file read as a provenance header without being
#    the one that was read. It names the line and which of four things is wrong with it.
"$(dirname "$0")/names" --check

echo "naming: no -d names, no daemons, contract crates spelled one way, branch prefix recognised,"
echo "        no #[path] module shared by two binaries, docs lowercase and hyphenated,"
echo "        every name carries its provenance, and exactly one block per file"

# 8. **The audit index holds together** (milestone 92). Structure only: the index's two tables
#    describe the same audits in the same order, every report link resolves, every kind has a
#    cadence row, and every finding carries one of the three dispositions.
#
#    **Deliberately not the overdue check.** `script/audits --due` is the tripwire and it lives in
#    its own scheduled workflow, because an audit coming due is information about the tree rather
#    than a defect in whichever commit tripped the count, and failing every pull request on it would
#    hold unrelated merges behind a review nobody can hurry. A malformed index is the opposite: it is
#    a defect in the commit that malformed it, and it silently breaks the tripwire, which reads the
#    newest row of both tables. Same split as the toolchain-drift workflow.
#    **And every Kani harness says what evidence it carries that it can fail** (milestone 194,
#    DECISIONS §134 (a harness carries a machine-replayable falsification record, or it is not
#    evidence)). Form only, and presence of a STATE rather than the state `replayable`, which is
#    the same line `script/names --check` draws two checks up and for the same reason: 135 of 141
#    harnesses have no falsification today, and a gate keyed on having one would hold every unrelated
#    merge behind proof work nobody can hurry. `script/falsifications --unfalsified` is how that queue
#    gets worked; the sweep that actually replays the patches is `script/falsifications --sweep` and
#    is scheduled, not gated, for `script/mutation`'s reason.
#
#    It checks both directions, which is the half a one-directional check would lose: a `replayable`
#    record names a patch that exists at the path §134 spells (as amended 2026-08-31,
#    `<module.path>.<harness_fn_name>.patch`, after this milestone's lane found the original spelling
#    could not name eighteen of `paging`'s harnesses), AND every patch under a crate's
#    `falsifications/` is claimed by a harness. Without the second, a patch rots into a file nothing
#    runs, which is the failure this whole record exists to end wearing different clothes.
echo "==> every Kani harness carries a falsification record"
# The new-confinement-test ratchet's fixtures first, for the reason `fatal-risks --selftest` runs
# first: a green `--check` looks the same whether the ratchet works or matches nothing.
"$(dirname "$0")/falsifications" --selftest
"$(dirname "$0")/falsifications" --check

echo "==> the audit index"
"$(dirname "$0")/audits" --check

#    **And the stranger test's run record, for the same reason and with the same split**
#    (milestone 117, 2026-08-18). `script/stranger-test --due` is the tripwire and lives in its own
#    weekly workflow; this is the structural half. The cadence sentence in notes/stranger-test.md
#    appears exactly once, the `### Run <n>, <date>:` headings are numbered from 1 without a gap,
#    and their dates are in order. Both numbers the tripwire needs come out of that note, so a
#    malformed heading does not fail loudly, it silently moves the date a run is measured from.
echo "==> the stranger test's run record"
"$(dirname "$0")/stranger-test" --check

# 9. **An environment variable named in prose has to exist** (milestone 93's first documentation
#    sweep, 2026-08-16). This is the compounding half of that mechanism rather than a check somebody
#    thought of: a sweep is supposed to convert checkable claims into checked ones, and this class
#    was the first one it found. Milestone 120 renamed the OS and swept `cricker` out of the
#    identifiers; it did not sweep the *environment* namespace, and eleven `CRICKER_*` names survived
#    in eight documents for a day, every one of them an instruction a reader would type and get
#    nothing from.
#
#    **It derives the answer rather than knowing it**, which is what keeps it honest through the next
#    rename: a name in prose is live if some non-markdown file reads or assigns it. That is why
#    `CRICKER_CC` passes today. `script/bootstrap` really does read `$CRICKER_CC`, so the note
#    naming it is *right* and the script is the stale one, and a gate spelling `NIFE_` into a rule
#    would have reported the correct document as the defect.
#
#    Prose only, and prose in the syntax `$NAME`/`${NAME}`/`NAME=`/`"NAME"` is what counts as a
#    definition, so a passing mention in a comment does not vouch for a name. `design/decisions/` is
#    out of scope, the same exclusion `script/audits --worklist` makes and for the same reason: a
#    decision is a dated record of an argument, and lanes do not edit them. Five stale names live
#    there and are milestone 93's handed-off finding, not this gate's business.
#
#    **Two more paths are exempt because they are where the argument about these names lives**, which
#    is the same exemption the "daemon" check makes for `design/` and `design/naming.md`: an audit
#    report has to be able to quote the stale name it found, and so does the procedure that explains
#    how it was found. Note what is deliberately NOT exempt: a fenced code block. The eleventh stale
#    name in the first sweep was inside one (`notes/cpu-models.md` opened with
#    `CRICKER_CPU=sifive-u54 cargo run ...`), and a fence is exactly where a reader copies from, so
#    exempting fences would exempt the sites that matter most.
#
#    It is deliberately narrow. It knows one namespace, `NIFE_`/`CRICKER_`, because those are the
#    names this project mints and therefore the ones only this project can check. See
#    notes/documentation-audit.md.
#
#    **A third case the two above do not cover: a name retired on purpose, quoted in an account**
#    (milestone 298, 2026-09-15). Retiring the multicast DNS responder removed the only reader of
#    `NIFE_MCAST_PORT`, and a BUILT block (222) quotes an error message naming it. A quotation never
#    moves, and a fake definition somewhere to satisfy this check would be worse than the failure. So
#    `RETIRED` names each such variable with the record that says it is gone; a reader who types one
#    and gets nothing finds that record by grepping the name. Add to it only when the code that read
#    the name was deleted deliberately, never to quiet a rename the prose did not follow.
echo "==> environment names in prose"
python3 - <<'PY'
import re, subprocess, sys

tracked = [f for f in subprocess.run(['git', 'ls-files'], capture_output=True, text=True)
           .stdout.split('\n') if f]

TOKEN = re.compile(r'\b((?:NIFE|CRICKER)_[A-Z0-9_]+)\b')

# Names whose reader was deleted on purpose, each with where its retirement is recorded. See the
# comment above the check: this is for a retirement, never for a rename.
RETIRED = {
    'NIFE_MCAST_PORT': 'milestone 298, 2026-09-15: the multicast prober and its runner hub (notes/mdns.md)',
}

live = set()
for f in tracked:
    if f.endswith('.md') or f.startswith(('vendor/', 'patches/')):
        continue
    try:
        text = open(f, errors='replace').read()
    except (IsADirectoryError, FileNotFoundError):
        continue
    # A definition or a read, never a mention. `$NAME` and `${NAME` are a shell read; `NAME =` and
    # `NAME:` cover a shell assignment, a Rust `pub const NAME: Guid`, and a YAML key; `"NAME"` is
    # how Rust asks for one (`env::var("NIFE_KBD")`). A name that only appears inside a sentence in
    # a comment is NOT live, which is the whole point: `script/qemu-check` mentions `CRICKER_DISK`
    # in a comment about a check, and that mention is itself stale rather than a definition.
    for m in re.finditer(r'\$\{?([A-Z0-9_]+)|\b([A-Z0-9_]+)\s*[:=]|"([A-Z0-9_]+)"', text):
        live.add(m.group(1) or m.group(2) or m.group(3))

bad = []
for f in tracked:
    if not f.endswith('.md') or f.startswith(('vendor/', 'patches/', 'design/decisions/',
                                              'design/audit-reports/')):
        continue
    if f == 'notes/documentation-audit.md':
        continue
    for i, line in enumerate(open(f, errors='replace'), 1):
        for name in TOKEN.findall(line):
            if name not in live and name not in RETIRED:
                bad.append((f, i, name))

if bad:
    print('lint: an environment variable named in prose does not exist in the tree:', file=sys.stderr)
    for f, i, name in bad:
        print(f'  {f}:{i}: {name}', file=sys.stderr)
    print('Nothing reads or assigns it, so a reader who types it gets nothing. Either the tree '
          'renamed it and the prose did not follow (milestone 120 left eleven of these), or the '
          'name is new and the code that reads it has not landed. See notes/documentation-audit.md.',
          file=sys.stderr)
    sys.exit(1)
ours = sorted(n for n in live if n.startswith(('NIFE_', 'CRICKER_')))
print(f'environment names: {len(ours)} live, and every one named in prose is read or assigned '
      f'({len(RETIRED)} retired on the record)')
PY

# 10. **No tracked file is one `.gitignore` says not to track** (2026-09-24 security audit). The
#     tree ignores `__pycache__/` and `*.pyc`, and on 2026-09-18 a lane committed
#     `scripts/__pycache__/name_provenance.cpython-314.pyc` anyway: `git add` refuses an ignored
#     path, but `git add -f`, a GUI, and `git add -A` after a stale index entry all get past it, and
#     nothing then notices. Compiled bytecode in a tree is a small supply-chain surface (Python
#     imports the `.pyc` when its mtime matches, and a reader diffs the `.py`) and a large hygiene
#     tell. `git ls-files -ci --exclude-standard` is the whole check, and it is empty today.
echo "==> tracked files the tree ignores"
ignored=$(git ls-files -ci --exclude-standard)
if [ -n "$ignored" ]; then
	echo "lint: these tracked files match .gitignore, and a tracked file the tree says to ignore is a mistake somebody forced past git:" >&2
	printf '  %s\n' $ignored >&2
	echo "  Remove it from the index (git rm --cached <path>) or, if it is meant to be tracked, un-ignore it." >&2
	exit 1
fi
echo "tracked-but-ignored files: none"

