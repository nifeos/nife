Falsifies `file_system_contract::proofs::the_directory_entry_walk_ends`.

The defect: `directory_entry::iter` advances by the name alone and skips the two-byte header, so an empty name never moves the walk.

Expected to fail: the unwinding assertion of the walk's loop, and `assert!(consumed <= length)`.

diff --git a/crates/file_system_contract/src/directory_entry.rs b/crates/file_system_contract/src/directory_entry.rs
--- a/crates/file_system_contract/src/directory_entry.rs
+++ b/crates/file_system_contract/src/directory_entry.rs
@@ -49,7 +49,7 @@ impl<'a> Iterator for Entries<'a> {
         let head = self.buf.get(self.at..self.at + 2)?;
         let (flags, len) = (head[0], head[1] as usize);
         let name = self.buf.get(self.at + 2..self.at + 2 + len)?;
-        self.at += record_len(len);
+        self.at += len;
         Some((name, flags & IS_DIRECTORY != 0))
     }
 }
