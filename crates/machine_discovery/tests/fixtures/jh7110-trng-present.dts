/dts-v1/;

/*
 * A hand-written device tree fragment, NOT a dump from any board, holding only the JH7110 TRNG
 * node from the Linux device-tree binding's own worked example
 * (Documentation/devicetree/bindings/rng/starfive,jh7110-trng.yaml, mainline as of 2026-08-24,
 * fetched via raw.githubusercontent.com):
 *
 *     rng: rng@1600C000 {
 *         compatible = "starfive,jh7110-trng";
 *         reg = <0x1600C000 0x4000>;
 *         clocks = <&clk 15>, <&clk 16>;
 *         clock-names = "hclk", "ahb";
 *         resets = <&reset 3>;
 *         interrupts = <30>;
 *     };
 *
 * One address cell and one size cell, matching the binding's own example literally (`reg` is two
 * raw numbers, not four): this is a peripheral-bus-scoped fragment, not a dump of the whole SoC
 * tree (compare crates/machine_discovery/tests/fixtures/jh7110.dts, which is two address cells at
 * the root for the full memory map). The clock and reset phandles are dropped: jh7110_entropy's
 * `discover` reads `reg` and `interrupts` only, and a phandle to a `clk`/`reset` node this fixture
 * does not define would not parse.
 *
 * Regenerate with:
 *
 *     dtc -I dts -O dtb -o crates/machine_discovery/tests/fixtures/jh7110-trng-present.dtb \
 *                          crates/machine_discovery/tests/fixtures/jh7110-trng-present.dts
 */

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "nife,jh7110-trng-discovery-test";

	rng@1600c000 {
		compatible = "starfive,jh7110-trng";
		reg = <0x1600c000 0x4000>;
		interrupts = <30>;
	};
};
