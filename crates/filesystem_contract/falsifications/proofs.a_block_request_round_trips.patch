 pub const fn request(operation: u64, blocks: usize) -> u64 {
     assert!(blocks >= 1 && blocks <= TRANSFER_BLOCKS);
-    (operation << super::OPERATION_SHIFT) | (blocks as u64 - 1)
+    (operation << super::OPERATION_SHIFT) | (blocks as u64)
 }
 
