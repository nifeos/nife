#!/bin/sh
# script/boot-file-size-check: the release BOOTX64.EFI must stay a small fraction of an install boot slot.
#
# **Why this exists.** An install puts one file, `\EFI\BOOT\BOOTX64.EFI`, into the EFI system
# partition and again into each of two boot slots, and a slot is a fixed 64 MiB
# (`BOOT_FILE_MAX` in uefi_loader/src/placement.rs; components/src/system_installer.rs has the layout). calef
# ruled on 2026-10-03 UTC to keep 64 MiB "with both fixes". This is the second fix. The first is
# that an installed image is always a release build with a kernel stripped of its DWARF
# (`cargo xtask stick` and `install-boot` build release, and the loader refuses to offer a debug
# image for install: `uefi_loader::image::carries_debug_info`). Without a budget the slot would be
# a limit that is only found by hitting it, on somebody's disk, after the first upgrade.
#
# **What it checks, in order.**
#   1. Builds the image with `cargo xtask uefi-image --release` (unless `--no-build`).
#   2. The embedded kernel has no `.debug_*` section. A debug kernel reaching an install image is
#      the failure the first fix exists to prevent, and this is the CI half of it.
#   3. The image is at most BUDGET bytes. WARN at 12 MiB, FAIL over 16 MiB.
#   4. The default budget is exactly a quarter of `BOOT_FILE_MAX`, read from the loader's source, so
#      the two cannot drift apart by one being edited.
#
# **The size breakdown is printed on every run** (loader, kernel, archive), so a failure or a
# creeping warning has a cause on record. The kernel and archive are embedded whole, so the loader
# is what remains.
#
# **The ratchet.** `bench/boot-file-size-x86_64.txt` may carry
#       budget_bytes: <N>
#       why: <the reason, one line>
# which replaces the 16 MiB default. A `budget_bytes` with no `why` is refused, and so is one above
# `BOOT_FILE_MAX`, because the loader would then refuse the file it was budgeted for. Raising the
# budget is therefore a committed change with a reason beside it, which is how
# `script/fastpath-footprint --save --why` works for the footprint floors. The file's
# `recorded_bytes` and `recorded_on` lines are the last measurement, for a reader; they gate
# nothing.
#
# **Parity (DECISIONS §19 (architectural parity is a tenet)), and why this is x86_64 only.** `BOOT_FILE_MAX` and the slots exist only
# on x86_64: the device-tree architectures have no installer and no slot (their boot file has
# nowhere to go; design/roadmap/0568-the-boot-file-has-nowhere-to-go-on-a-device-tree-machine.md).
# `cargo xtask stick` builds BOOTAA64.EFI and BOOTRISCV64.EFI as release too, but nothing bounds
# them, so there is nothing for a budget to protect. When milestone 568 (the boot file has nowhere to go on a device-tree machine) gives them a slot, the
# budget belongs beside it and this script grows an architecture argument.
# Measured 2026-10-03 UTC for the record: release BOOTAA64.EFI 10,469,376 bytes and BOOTRISCV64.EFI
# 7,896,064 bytes, against 4,640,256 for x86_64. Their kernels are not stripped (only the x86_64
# path is, because only it installs), which is most of the difference.
#
# Name: ratified 2026-10-03 UTC (calef, ruling on #1520's provisional name: "pairs nicely with
# swish-check"). The `-check` suffix is the majority pattern for a pass/fail gate (boot-check,
# cadence-check, stack-depth-check, swish-check, undefined-behavior-check). Replacing the
# provisional `boot-file-size`, which named the file it budgets in the family of
# `fastpath-footprint`. Two things kept the old spelling on purpose: the ratchet file
# `bench/boot-file-size-x86_64.txt` is named for the measure it records, not for the gate that
# reads it, and `design/decisions/244` is a closed decision, an account that keeps the name it
# used (it gains a pointer to this one). The CI job id and the `script/ci-build` row moved,
# because a job id is navigation and every sibling gate's id is its script's name. The job's
# display name (`boot file size (...)`), which is what a ruleset would match, did not change;
# it is not a required check.
#
# BUGS
#   **The budget is on the total, not on each part**, so a kernel that shrinks can hide an archive
#   that grew. The breakdown is printed for that reason; a per-part budget would be a second number
#   to keep true with nothing yet showing it is needed.
#   **It builds the image to measure it**, about as long as one release kernel plus one release
#   archive. It is a `ci` row for that reason, not `local`.

set -eu
cd "$(dirname "$0")/.."
. helpers/qemu-path.sh

build=1
for arg in "$@"; do
    case "$arg" in
        --no-build) build="" ;;
        *) echo "usage: script/boot-file-size-check [--no-build]" >&2; exit 2 ;;
    esac
done

MIB=1048576
WARN=$((12 * MIB))
DEFAULT_BUDGET=$((16 * MIB))
BASE=bench/boot-file-size-x86_64.txt
LOADER_SRC=uefi_loader/src/placement.rs

# BOOT_FILE_MAX, from the one place it is defined, written there as `64 * 1024 * 1024`.
slot_mib=$(sed -n 's/^\(pub([a-z]*) \)\{0,1\}const BOOT_FILE_MAX: u64 = \([0-9]*\) \* 1024 \* 1024;.*/\2/p' "$LOADER_SRC")
if [ -z "$slot_mib" ]; then
    echo "boot-file-size-check: cannot read BOOT_FILE_MAX from $LOADER_SRC; its spelling changed" >&2
    exit 1
fi
SLOT=$((slot_mib * MIB))
if [ $((DEFAULT_BUDGET * 4)) -ne "$SLOT" ]; then
    echo "boot-file-size-check: the default budget ($DEFAULT_BUDGET) is not a quarter of BOOT_FILE_MAX ($SLOT)." >&2
    echo "  Change this script's DEFAULT_BUDGET and WARN together with $LOADER_SRC." >&2
    exit 1
fi

budget=$DEFAULT_BUDGET
ratchet_why=""
if [ -f "$BASE" ]; then
    over=$(sed -n 's/^budget_bytes:[[:space:]]*\([0-9]*\)[[:space:]]*$/\1/p' "$BASE")
    ratchet_why=$(sed -n 's/^why:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' "$BASE" | head -n 1)
    if [ -n "$over" ]; then
        if [ -z "$ratchet_why" ]; then
            echo "boot-file-size-check: $BASE raises the budget to $over with no 'why:' line; a ratchet carries its reason." >&2
            exit 1
        fi
        if [ "$over" -gt "$SLOT" ]; then
            echo "boot-file-size-check: $BASE sets a budget of $over, above BOOT_FILE_MAX ($SLOT); the loader would refuse the file." >&2
            exit 1
        fi
        budget=$over
    fi
fi

if [ -n "$build" ]; then
    cargo xtask uefi-image --release
fi

efi=target/esp/EFI/BOOT/BOOTX64.EFI
kernel=target/x86_64-unknown-none/release/kernel.stripped
archive=target/initial-ramdisk-x86_64.img
for f in "$efi" "$kernel" "$archive"; do
    if [ ! -f "$f" ]; then
        echo "boot-file-size-check: $f is missing; run without --no-build" >&2
        exit 1
    fi
done

# The embedded kernel is the stripped copy; refuse the image if that copy still carries DWARF. The
# toolchain's own llvm-objdump, found the way script/stack-frame-check finds its tools.
sysroot=$(rustc --print sysroot)
host=$(rustc -vV | sed -n 's/^host: //p')
objdump="$sysroot/lib/rustlib/$host/bin/llvm-objdump"
if [ ! -x "$objdump" ]; then
    echo "boot-file-size-check: no llvm-objdump at $objdump; 'rustup component add llvm-tools'" >&2
    exit 1
fi
if "$objdump" -h "$kernel" | grep -q '[[:space:]]\.debug_'; then
    echo "boot-file-size-check: FAIL: the kernel in this image carries .debug_* sections." >&2
    echo "  An install image is a release build with a stripped kernel; see script header." >&2
    exit 1
fi

size_of() { wc -c < "$1" | tr -d '[:space:]'; }
total=$(size_of "$efi")
k=$(size_of "$kernel")
a=$(size_of "$archive")
l=$((total - k - a))

echo "boot-file-size-check: BOOTX64.EFI (release)"
printf '  %-8s %10d bytes  %5d.%02d MiB\n' loader "$l" $((l / MIB)) $((l % MIB * 100 / MIB))
printf '  %-8s %10d bytes  %5d.%02d MiB\n' kernel "$k" $((k / MIB)) $((k % MIB * 100 / MIB))
printf '  %-8s %10d bytes  %5d.%02d MiB\n' archive "$a" $((a / MIB)) $((a % MIB * 100 / MIB))
printf '  %-8s %10d bytes  %5d.%02d MiB\n' total "$total" $((total / MIB)) $((total % MIB * 100 / MIB))
echo "  budget $budget bytes ($((budget / MIB)) MiB, a quarter of the $slot_mib MiB slot unless ratcheted); warn at $((WARN / MIB)) MiB"

if [ "$total" -gt "$budget" ]; then
    echo "boot-file-size-check: FAIL: $total bytes is over the $budget byte budget." >&2
    echo "  The breakdown above says which part grew. If the growth is intended, raise it in" >&2
    echo "  $BASE with 'budget_bytes:' and a 'why:' line; it may not exceed BOOT_FILE_MAX." >&2
    exit 1
fi
if [ "$total" -gt "$WARN" ]; then
    msg="BOOTX64.EFI is $total bytes, over the $((WARN / MIB)) MiB warning line (budget $((budget / MIB)) MiB, slot $slot_mib MiB)"
    if [ -n "${GITHUB_ACTIONS:-}" ]; then
        echo "::warning title=boot file size::$msg"
    else
        echo "boot-file-size-check: WARN: $msg"
    fi
fi
echo "boot-file-size-check: PASS"
