# ---------------------------------------------------------------------------------------------
# Milestone 623 (provisional): the week note. A cliff in a chart reads as a defect in an
# instrument until somebody says otherwise, and calef's ask was a mechanism that says it under the
# chart, by week, and forgets it when the week leaves the window. Three moving parts live here:
# the flag, the prune and the render. The digest is NOT here, on purpose: it is `git log`
# archaeology between two snapshot refs, `helpers/week_digest.py`, a separate process, because
# this script is a reader of blobs and series and the digest is a walk over a diff.
#
# **The flag's threshold is a heuristic and it says so where it fires.** One tenth of the prior
# week's value, carried verbatim from the proposal; measured over the first ten charted weeks it
# flags every week on this tree's counts. The measurement and the options for the constant are in
# `design/roadmap/0698-the-week-flag-fires-every-week.md`, awaiting an architect. The flag
# never blocks and never edits, so the noise costs a line in a log and nothing else.
FLAG_ONE_OF = 10.0

def read_week_notes(path=WEEK_NOTES_PATH):
    """{week: [(chart svg name, note), ...]} from week-notes.csv, in file order.

    `#` lines and the `week,chart,note` header are not data. A note may hold commas and quotes,
    so each line goes through the csv reader rather than a split; the writer that prunes is
    line-wise, so what a hand wrote is what the file keeps.
    """
    notes = {}
    if not path.exists():
        return notes
    for line in path.read_text().split('\n'):
        if not line.strip() or line.startswith('#'):
            continue
        for week, chart, note in csv.reader([line]):
            if week in ('', WEEK) or not note.strip():
                continue
            notes.setdefault(week, []).append((chart, note.strip()))
    return notes


def charted_columns():
    """(label, field) for every series the charts draw, stored and derived alike.

    The flag must see what the reader sees, so this walks CHARTS rather than MEASURES: a derived
    band (`names_no_block`) is a cliff on the page exactly as a stored column is.
    """
    return [(label, field)
            for _name, _title, _sub, columns, _scale, _ceiling, _absent, *_hues in CHARTS
            for label, field in columns]


def flagged_weeks(rows):
    """{week: [(field, prior, now), ...]}, biggest absolute move first, charted weeks only.

    A week flags when its move in any charted series exceeds one tenth of the prior week's value
    (FLAG_ONE_OF); the prior week is the one before it in the series, which reaches back past the
    window's left edge exactly as `trailing_mean` does. A series born that week does not flag,
    because there is no prior value to move from; a measured zero that moves does, because zero
    was a reading. A week whose cell is absent was not measured, and does not flag either.

    The list is ordered by the size of the move, not its ratio, because the chart draws absolute
    values: a cliff the eye sees is a band that grew or shrank by a lot, and a ratio ordering
    would put every 0-to-3 debut above a 29% fall in a 46,000-line series.
    """
    every = sorted(rows)
    flags = {}
    for week in every[-CHART_WEEKS:]:
        i = every.index(week)
        if i == 0:
            continue
        before = every[i - 1]
        moved = []
        for label, field in charted_columns():
            derive = DERIVED.get(field)
            if derive is not None:
                prior, now = derive(rows[before]), derive(rows[week])
            else:
                a, b = rows[before].get(field, ''), rows[week].get(field, '')
                if a in ('', None) or b in ('', None):
                    continue
                prior, now = float(a), float(b)
            if abs(now - prior) > abs(prior) / FLAG_ONE_OF:
                moved.append((abs(now - prior), field, prior, now, label))
        if moved:
            moved.sort(key=lambda m: -m[0])
            flags[week] = [(field, prior, now) for _m, field, prior, now, _l in moved]
    return flags


def flag_lines(rows, notes=None):
    """One line per flagged week, `<week> <field> <prior>-><now> [+N more]; annotated|no week note`.

    Machine-facing: the weekly workflow reads this for its pull request body (field 1 the week,
    field 2 the series), and `--update` prints the unannotated ones as the weekly report.
    """
    if notes is None:
        notes = read_week_notes()
    out = []
    for week, moved in sorted(flagged_weeks(rows).items()):
        field, prior, now = moved[0]
        more = '' if len(moved) == 1 else ' (+%d more series)' % (len(moved) - 1)
        state = 'annotated' if week in notes else 'no week note'
        out.append('%s %s %g->%g%s; %s' % (week, field, prior, now, more, state))
    return out


def report_flags(rows):
    """The weekly report's one line per flagged week that carries no note (milestone 623).

    Printed by the modes that write the series, so the run that notices a cliff is the run that
    says so. It is a report and only a report: nothing downstream reads it, on purpose.
    """
    for line in flag_lines(rows):
        if line.endswith('no week note'):
            print('metrics: %s flagged and unannotated; explain it or age it out in '
                  'notes/project-metrics/week-notes.csv' % line.split(';')[0])


def prune_week_notes(keep_from, path=WEEK_NOTES_PATH):
    """Drop rows whose week falls before `keep_from`, keeping every other line's bytes.

    The aging-out rule: a bullet that outlives its graph explains nothing to anybody. Line-wise
    on purpose, so a rewrite that drops nothing writes nothing and a hand-formatted note is never
    requoted or rewrapped by the machinery that deletes its neighbours.
    """
    if not path.exists():
        return 0
    out, dropped = [], 0
    for line in path.read_text().split('\n'):
        if line.strip() and not line.startswith('#'):
            row = next(csv.reader([line]), [])
            if row and row[0] != WEEK and row[0] < keep_from:
                dropped += 1
                continue
        out.append(line)
    if dropped:
        path.write_text('\n'.join(out))
    return dropped


_CHART_IMAGE = re.compile(r'^!\[[^\]]*\]\(project-metrics/([a-z0-9-]+\.svg)\)$')
WEEK_NOTE_BEGIN = '<!-- week-notes: script/metrics writes this -->'
WEEK_NOTE_END = '<!-- /week-notes -->'


def write_week_notes_bullets(notes=None, page=PAGE):
    """One bullet per note, under the chart image the note names, in week order, between markers.

    The block sits directly after the image (calef ruled bullets under the graph, not markers in
    the SVG), so a reader meeting a cliff meets its explanation without scrolling. Rendering is
    idempotent and self-replacing: a chart whose notes have aged out loses its block, and a chart
    that never had one is untouched.
    """
    if notes is None:
        notes = read_week_notes()
    by_chart = {}
    for week in sorted(notes):
        for chart, note in notes[week]:
            by_chart.setdefault(chart, []).append('- %s: %s' % (week, note))
    path = pathlib.Path(page)
    text = path.read_text()
    lines = text.split('\n')
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        i += 1
        image = _CHART_IMAGE.match(line)
        if not image:
            continue
        if i < len(lines) and lines[i] == '':
            out.append('')
            i += 1
        if i < len(lines) and lines[i] == WEEK_NOTE_BEGIN and WEEK_NOTE_END in lines[i:]:
            i = lines.index(WEEK_NOTE_END, i) + 1
            if i < len(lines) and lines[i] == '':
                i += 1
        block = by_chart.get(image.group(1))
        if block:
            out.extend([WEEK_NOTE_BEGIN] + block + [WEEK_NOTE_END, ''])
    new = '\n'.join(out)
    if new != text:
        path.write_text(new)


def fill_derived(rows, rev):
    """Set every column that is read once for all weeks rather than per revision.

    Four kinds of thing land here and they are here for two different reasons.

    `milestones_built_this_week` and `merged_pull_requests` are FLOWS read from today's tree and
    today's log; `built_by_week` has the long argument for why a flow must not be read from each
    week's own revision. Both get a value for every week the CSV holds, a zero included, because a
    week in which nothing was built is a fact and an empty cell would read as "not measured".

    The cost columns are the opposite: they are read from committed records rather than from git,
    and **a week they cannot answer for is left EMPTY, never zeroed**. The first five weeks of this
    project have no session records left anywhere on earth. A zero there would be averaged into a
    published figure by a reader who never opened this file, which milestone 519 names as the one
    failure it exists to prevent.

    `human_person_weeks` is not touched here. It is carried on the row (CARRIED_FIELDS), because a
    hand correction to it has to survive every later rewrite.
    """
    built = built_by_week(Tree(rev))
    merged = merges_by_week(rev)
    models = models_by_week(rev)
    effort = effort_by_week()
    cash = cash_by_week(date.today())
    queue = queue_by_week()
    debt = debt_paydown_by_week()
    builds = builds_by_week()
    for week, row in rows.items():
        # Empty before the record starts, never zero, for the verify columns' reason.
        for column in ('ci_builds', 'ci_build_median_minutes', 'ci_build_p90_minutes'):
            row[column] = builds.get(week, {}).get(column, '')
        row['milestones_built_this_week'] = built.get(week, 0)
        row['merged_pull_requests'] = merged.get(week, 0)
        # Empty for a week the daily record does not cover, for the cost columns' reason: a zero
        # would read as a week the queue ejected nothing, which nobody measured.
        held_queue = queue.get(week)
        row['queue_entries'] = '' if held_queue is None else held_queue['entries']
        row['queue_ejected'] = '' if held_queue is None else held_queue['ejected']
        row['queue_ejection_pct'] = ('' if not held_queue or not held_queue['entries']
                                     else '%.1f' % (100.0 * held_queue['ejected'] / held_queue['entries']))
        row.update(debt_paydown_cells(debt.get(week)))
        row.update(models.get(week, {}))
        held = effort.get(week) or {}
        tokens, hours = held.get('tokens'), held.get('hours')
        row['lane_tokens'] = '' if tokens is None else tokens
        row['lane_wall_clock_hours'] = '' if hours is None else '%.1f' % hours
        row['price_per_mtok_at_date'] = held.get('blended', '')
        # Absent is absent here too, and for the same reason one line up: the first five weeks of
        # this project have no session records left anywhere, and a zero in a context column would
        # be read as a week of cheap turns rather than as a week nobody can see.
        row['lane_turns'] = held.get('turns') or ''
        share = held.get('read_share')
        row['lane_cache_read_share_pct'] = '' if share is None else '%.1f' % share
        mean = held.get('context_mean')
        row['lane_context_per_turn_mean'] = '' if mean is None else '%d' % mean
        row['lane_context_per_turn_peak'] = held.get('peak') or ''
        # Cash is the one cost column a missing week CAN be zero in, and the difference is that the
        # evidence exists. The ledger is complete by construction: it records every payment, so a
        # week with no row in it is a week nothing was paid, not a week nobody looked.
        row['cash_spend'] = '%.2f' % cash.get(week, 0.0)
    # Money paid in a week the series has no row for is money this column silently drops, and the
    # case is real rather than defensive: calef dates the subscription 2026-07-12, which is a Sunday
    # and therefore 2026W28, while the first commit is 2026-07-13 UTC and the series starts at
    # 2026W29. So $200 sits one week before the first row. A week has a row only if a commit fell in
    # it, and inventing a row with no commit would leave every other column in it empty or wrong,
    # so the amount is reported instead of absorbed into a neighbour. notes/project-metrics.md
    # carries the same arithmetic where a reader meets the number.
    orphaned = {week: amount for week, amount in cash.items() if week not in rows}
    if orphaned:
        print('metrics: $%.2f of ledger spend falls in %s, which the series has no row for; '
              'cash_spend does not include it'
              % (sum(orphaned.values()), ', '.join(sorted(orphaned))), file=sys.stderr)
    # The same silent drop, one column over, and it is the reason the flow does not sum to the
    # stock. Milestone 1 (boot to Rust on QEMU `virt`, and print to the PL011 UART) carries a
    # `**Built:**` date of 2026-07-12, a Sunday, so it lands in 2026W28, and the series starts at
    # 2026W29 because that is where the first commit is. Without this line the series is one short
    # of the tree's own BUILT total and nothing says so. Reported rather than absorbed into 2026W29,
    # for the reason above: a week has a row only if a commit fell in it.
    unbucketed = {week: n for week, n in built.items() if week not in rows}
    if unbucketed:
        print('metrics: %d dated milestone(s) fall in %s, which the series has no row for; '
              'milestones_built_this_week does not include them'
              % (sum(unbucketed.values()), ', '.join(sorted(unbucketed))), file=sys.stderr)
    return rows


def github_anchor(heading):
    """The fragment GitHub gives a heading: lowercased, every character that is not a letter, digit,
    space, hyphen or underscore dropped, and each space turned into a hyphen. Checked on 2026-09-24
    against GitHub's own rendering (`gh api markdown`) of every chart heading on the page, including
    the ones carrying a backtick, a slash, a comma and an apostrophe."""
    kept = ''.join(c for c in heading.lower() if c.isalnum() or c in ' -_')
    return kept.replace(' ', '-')


# Trend lines, keyed by chart. calef asked on 2026-09-24 for a trailing ten-week mean on the
# velocity chart and then the pull-request chart, one helper for both, because a flow that swings
# from 8 to 49 to 13 in three weeks cannot be read for direction by eye. It is drawn and never stored, like the fatal-risks chart's unclassified band:
# it is arithmetic over a column already in the CSV, and a stored copy could disagree with it.
# Charts whose series stand side by side rather than stacked, and charts that carry stored columns
# as lines over the bars: [(legend label, column)]. The build chart's jobs run side by side, and
# §213's limits overlap (one document can be over two), so neither may be summed.
GROUPED = {'ci-jobs.svg', 'writing-standards.svg'}
# Two lines, so the second is dotted with open markers: solid and dashed already mean a trailing
# mean's full and short window on this page (TRENDS).
LINES = {'ci-jobs.svg': [('median build', 'ci_build_median_minutes'),
                         ('p90 build', 'ci_build_p90_minutes')],
         'line-citations.svg': [('code ceiling', 'line_citations_ceiling')]}
# Charts whose bars are read from a record when drawn rather than from stored columns:
# chart -> function(weeks) returning (series, note), the note printed under the plot.
SERIES_FROM = {'ci-jobs.svg': build_job_series}

TRENDS = {'velocity.svg': ('milestones_built_this_week', 10),
          'interface-stability.svg': ('interface_breaking', 4),
          'pull-requests.svg': ('merged_pull_requests', 10),
          'unsafe.svg': ('unsafe_density', 10),
          # A share's trend is pooled, not a mean of shares: the line is ten weeks' labeled pull
          # requests over ten weeks' merged ones, so a quiet week weighs what it merged, for
          # `queue_by_week`'s reason. A (numerator, denominator) pair asks `trailing_mean` for that.
          'debt-paydown.svg': (('debt_paydown_merged', 'debt_paydown_merged_total'), 10)}


def trailing_mean(rows, weeks, field, span):
    """(mean, full) per charted week, over the `span` weeks ending there, reaching back past the
    chart's left edge into the CSV. Where the series is younger than `span` the mean is over the
    weeks that exist and `full` is False, which the chart draws dashed rather than hiding: the line
    would otherwise start two bars from the right edge until 2026W47."""
    every = sorted(rows)
    out = []
    for week in weeks:
        k = every.index(week)
        window = every[max(0, k - span + 1):k + 1]
        if isinstance(field, tuple):
            # A pooled share in per cent, over the weeks in the window that have a denominator; a
            # week the record does not cover is skipped rather than read as zero, and the window
            # counts as short until `span` weeks have one.
            num, den = field
            held = [w for w in window if rows[w].get(den, '') not in ('', None)]
            total = sum(_cell(rows[w], den) for w in held)
            out.append((100.0 * sum(_cell(rows[w], num) for w in held) / total if total else None,
                        len(held) == span))
            continue
        out.append((sum(_cell(rows[w], field) for w in window) / len(window),
                    len(window) == span))
    return out


def last_full_week(today=None):
    """The ISO week before the one `today` (UTC) falls in: the newest week with all seven days."""
    today = today or datetime.now(timezone.utc).date()
    return week_of_date((today - timedelta(days=7)).isoformat())


def svg_timeline(title, subtitle, items, wall, path, lid=None):
    """A horizontal bar per item, (label, start, length, slot, tail), on a minutes axis: where each
    job sits in a typical build. `tail` follows the length printed after the bar. `wall` is a solid marker for the median build's end and `lid` a
    dashed one. `slot` is the job's palette slot on ci-jobs.svg, so a job is one hue on both
    charts; None draws it in the muted neutral."""
    row_h, pad_l, pad_r, pad_t, pad_b = 20, 230, 130, 84, 44
    height = pad_t + row_h * len(items) + pad_b
    top = max([i[1] + i[2] for i in items] + [wall or 0, lid or 0, 1])
    step = 5 if top <= 40 else 10
    axis_top = step * math.ceil(top / step)
    plot_w = CHART_W - pad_l - pad_r

    def x_of(minutes):
        return pad_l + plot_w * minutes / axis_top

    out = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d" '
           'role="img" aria-label="%s">' % (CHART_W, height, CHART_W, height, esc(title)),
           '<style>',
           '  .bg{fill:#ffffff} .fg{fill:#1f2328} .mut{fill:#59636e} .grid{stroke:#d1d9e0}'
           ' .wall{stroke:#1f2328} .other{fill:#b1bac4}',
           '  .val{paint-order:stroke;stroke:#ffffff;stroke-width:3px;stroke-linejoin:round}',
           ''.join('  .s%d{fill:%s}' % (j, PALETTE_LIGHT[j]) for j in range(len(PALETTE_LIGHT))),
           '  @media (prefers-color-scheme: dark){',
           '    .bg{fill:#0d1117} .fg{fill:#e6edf3} .mut{fill:#9198a1} .grid{stroke:#30363d}'
           ' .wall{stroke:#e6edf3} .other{fill:#57606a} .val{stroke:#0d1117}'
           + ''.join(' .s%d{fill:%s}' % (j, PALETTE_DARK[j]) for j in range(len(PALETTE_DARK))) + '}',
           '  text{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,'
           'sans-serif}',
           '</style>',
           '<rect class="bg" width="%d" height="%d"/>' % (CHART_W, height),
           '<text class="fg" x="20" y="26" font-size="16" font-weight="600">%s</text>' % esc(title),
           '<text class="mut" x="20" y="44" font-size="11">%s</text>' % esc(subtitle)]
    bottom = pad_t + row_h * len(items)
    for tick in range(0, int(axis_top) + 1, step):
        x = x_of(tick)
        out.append('<line class="grid" x1="%.1f" y1="%d" x2="%.1f" y2="%d" stroke-width="1"/>'
                   % (x, pad_t - 4, x, bottom))
        out.append('<text class="mut" x="%.1f" y="%d" font-size="10" text-anchor="middle">%d</text>'
                   % (x, bottom + 14, tick))
    out.append('<text class="mut" x="%.1f" y="%d" font-size="10" text-anchor="middle">minutes '
               'after the build\u2019s first job starts</text>' % (pad_l + plot_w / 2, bottom + 30))
    for n, (label, start, length, slot, tail) in enumerate(items):
        y = pad_t + row_h * n
        out.append('<text class="fg" x="%d" y="%d" font-size="11" text-anchor="end">%s</text>'
                   % (pad_l - 8, y + 14, esc(label)))
        fill = 'other' if slot is None else 's%d' % slot
        w = max(plot_w * length / axis_top, 1.5)
        out.append('<rect class="%s" x="%.1f" y="%d" width="%.1f" height="%d" rx="2"><title>%s: starts '
                   'at %.1f, takes %.1f</title></rect>' % (fill, x_of(start), y + 4, w, row_h - 8,
                                                         esc(label), start, length))
        out.append('<text class="mut val" x="%.1f" y="%d" font-size="10">%s%s</text>'
                   % (x_of(start) + w + 4, y + 14, _number(round(length, 1)), esc(tail)))
    if lid:
        out.append('<line x1="%.1f" y1="%d" x2="%.1f" y2="%d" stroke="#D55E00" stroke-width="1.5" '
                   'stroke-dasharray="5 4"/>' % (x_of(lid), pad_t - 4, x_of(lid), bottom))
        out.append('<text class="fg val" x="%.1f" y="%d" font-size="10" text-anchor="middle">build lid '
                   '%s</text>' % (x_of(lid), pad_t - 22, _number(lid)))
    if wall:
        out.append('<line class="wall" x1="%.1f" y1="%d" x2="%.1f" y2="%d" stroke-width="1.5"/>'
                   % (x_of(wall), pad_t - 4, x_of(wall), bottom))
        out.append('<text class="fg val" x="%.1f" y="%d" font-size="10" text-anchor="middle">median '
                   'build %.1f</text>' % (x_of(wall), pad_t - 8, wall))
    out.append('</svg>')
    path.write_text('\n'.join(out) + '\n')


def draw_critical_path(weeks, today=None, path=None):
    """ci-critical-path.svg (name provisional, maintainer/build-time-chart, 2026-10-11 UTC): the
    newest full week's typical build as a timeline, every job that ran in it, so the chain that
    ends last is the one a reader sees setting the build time."""
    week = last_full_week(today)
    rows, wall, builds = critical_path(week, path)
    if not rows:
        return
    series, _note = build_job_series(weeks, path)
    slot = {label: j for j, (label, _v, _h) in enumerate(series)}
    # A job under half a minute is a gate or a scope check; a row each would push the chart past a
    # screen for jobs nobody waits on.
    shown = [(label, s, t, slot.get(job_label(*bar_key(key))),
              '' if n == builds else ' (%d of %d)' % (n, builds))
             for label, key, s, t, _e, n in rows if t >= 0.5]
    hidden = len(rows) - len(shown)
    svg_timeline('Where a merge-group build\u2019s time goes, %s' % week_label(week),
                 'median start and length of each job over the week\u2019s %d green builds, or '
                 'the (n of them) that ran it; the last to end on top%s'
                 % (builds, '; %d jobs under half a minute not drawn' % hidden if hidden else ''),
                 shown, wall, DATA_DIR / 'ci-critical-path.svg', BUILD_LID)


def draw_charts(rows, only=None):
    """Every chart and the generated lines on the page, or with `only` (a set of column names)
    just the charts that plot one of them and nothing on the page."""
    if only is None:
        write_drift_report()
        write_interface_line(rows)
        write_week_notes_bullets()
    weeks = sorted(rows)[-CHART_WEEKS:]
    check_chart_totals(rows, weeks[-1])
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    for name, title, subtitle, columns, scale, ceiling, absent_field, *rest in CHARTS:
        if only is not None and not only & {column for _label, column in columns}:
            continue
        hues = rest[0] if rest else None
        series = series_of(rows, weeks, columns, scale, hues)
        if not series:
            series = [(columns[0][0], [0.0] * len(weeks), None)]
        absent = None
        if absent_field:
            absent = [rows[week].get(absent_field, '') in ('', None) for week in weeks]
        trend = None
        if name in TRENDS:
            field, span = TRENDS[name]
            word = 'share' if isinstance(field, tuple) else 'mean'
            trend = ('trailing %d-week %s' % (span, word),
                     'trailing %s, fewer than %d weeks' % (word, span),
                     trailing_mean(rows, weeks, field, span))
        note = ''
        if name in SERIES_FROM:
            series, note = SERIES_FROM[name](weeks)
            if not series:
                series = [(columns[0][0], [0.0] * len(weeks), None)]
        lines = None
        if name in LINES:
            lines = [(label, [float(rows[w][field]) if rows[w].get(field) not in ('', None) else None
                              for w in weeks]) for label, field in LINES[name]]
        if isinstance(ceiling, str):
            ceiling = [float(rows[w][ceiling]) if rows[w].get(ceiling) not in ('', None) else None
                       for w in weeks]
        svg_chart(title, subtitle, weeks, series, DATA_DIR / name, ceiling, absent, trend,
                  grouped=name in GROUPED, lines=lines, note=note)
        if name == 'ci-jobs.svg':
            draw_critical_path(weeks)


# ---------------------------------------------------------------------------------------------

def print_table(row):
    width = max(len(f) for f in FIELDS)
    for field in FIELDS:
        print('%-*s  %s' % (width, field, row.get(field, '')))


# ---------------------------------------------------------------------------------------------
# The selftest (milestone 623). The flag, the prune and the render are three ways a wrong reader
# would mislead: a threshold off by an inequality, a prune that requotes what it kept, a render
# that loses the page around its own output. Each case below is one of those, fixture-built, no
# git and no real file written. Deliberately not in `script/lint`: run it when touching those.

def _decision_cases():
    """The three records a decision's status has lived in, newest first, driven with fixtures."""
    from types import SimpleNamespace

    def counted(text):
        return {k: v for k, v in decisions(SimpleNamespace(text=text)).items() if v}

    table = ('# Decisions\n\n| # | Status | Decision |\n|---|---|---|\n'
             '| 1 | DECIDED | [A](0001-a.md) |\n| 2 | SUPERSEDED BY 1 | [B](0002-b.md) |\n')
    files = {
        'design/decisions/0001-a.md': '---\nstatus: DECIDED\nraised: 2026-09-23\n---\n# 1. A\n',
        'design/decisions/0002-b.md': '---\nstatus: SUPERSEDED\nsuperseded_by: 1\n---\n# 2. B\n',
        'design/decisions/0003-c.md': '---\nraised: 2026-09-23\nstatus: PROPOSED\n---\n# 3. C\n',
    }
    return [
        ('decisions count from frontmatter, whatever key comes first, with no table at all',
         counted(files), {'DECIDED': 1, 'SUPERSEDED': 1, 'PROPOSED': 1}),
        ('frontmatter wins over a table that disagrees with it',
         counted(dict(files, **{'design/decisions/README.md': table.replace('| 2 |', '| 9 |')})),
         {'DECIDED': 1, 'SUPERSEDED': 1, 'PROPOSED': 1}),
        ('a tree from before frontmatter counts from its table',
         counted({'design/decisions/README.md': table,
                  'design/decisions/1-a.md': '# 1. A\n\n**Status: DECIDED.**\n'}),
         {'DECIDED': 1, 'SUPERSEDED': 1}),
        ('a tree from before the split is UNRECORDED, not DECIDED',
         counted({'DECISIONS.md': '## 1. A\n\n## 2. B\n'}), {'UNRECORDED': 2}),
    ]


def _update_target_cases():
    """A closed week whose row stopped before the week's last commit is restated by `--update`."""
    weeks = {'2026W41': 'a' * 40, '2026W42': 'b' * 40, '2026W43': 'c' * 40}
    rows = {'2026W41': {'commit': 'a' * 12},
            '2026W42': {'commit': 'e' * 12},   # written mid-week; 'b' merged after it
            '2026W43': {'commit': 'f' * 12}}
    return [
        ('a closed week written mid-week is restated at its last commit',
         update_targets(weeks, rows, '2026W43', 'c' * 40),
         [('2026W42', 'b' * 40), ('2026W43', 'c' * 40)]),
        ('a closed week with no row is written',
         update_targets(weeks, {'2026W43': {}}, '2026W43', 'c' * 40),
         [('2026W41', 'a' * 40), ('2026W42', 'b' * 40), ('2026W43', 'c' * 40)]),
    ]


def _chart_total_cases():
    """check_chart_totals passes a week whose bands add up and refuses one that drops a status."""
    def refused(row):
        try:
            check_chart_totals({'2026W01': row}, '2026W01')
        except SystemExit:
            return True
        return False

    whole = {'milestones_built': '2', 'milestones_refused': '1', 'milestones_total': '3',
             'proposals_unnumbered': '1'}
    # A status the chart has no band for: its count is in the total and in no column it draws.
    unseen = dict(whole, milestones_total='4')
    return [('a week whose bands add up to its total passes', refused(whole), False),
            ('a status counted in the total and drawn by no band is refused', refused(unseen), True)]


def _fatal_risk_cases():
    """The frontmatter reader and the appendix pattern, driven with fixture trees."""
    from types import SimpleNamespace

    def risk(n, status, verdict):
        return ('---\nexperiment_status: %s\nexperiment_run: 2026-10-04\n---\n# %d. A risk\n\n'
                'The red half is a claim. %s\n' % (status, n, verdict))

    def appendix(n, colour):
        return '---\nrisk: %d\ncolor: %s\nupdated: 2026-10-04\n---\n# Appendix\n' % (n, colour)

    def tree(**files):
        return SimpleNamespace(text={'design/fatal-risks/' + k.replace('_', '-') + '.md': v
                                     for k, v in files.items()})

    ok = fatal_risks_colors(tree(**{
        '1-first': risk(1, 'RUN', 'GREEN (calef).'), '2-second': risk(2, 'RUN', 'AMBER (calef).'),
        '3-third': risk(3, 'NOT-RUN', 'No verdict.'),
        'first-appendix': appendix(1, 'green'), 'second-appendix': appendix(2, 'amber')}))
    # A numbered risk file that carries `risk:` and `color:` must not be read as an appendix.
    shadowed = fatal_risks_colors(tree(**{
        '1-first': '---\nrisk: 1\ncolor: red\n' + risk(1, 'RUN', 'GREEN (calef).')[4:],
        'first-appendix': appendix(1, 'green')}))
    try:
        fatal_risks_colors(tree(**{'1-first': risk(1, 'RUN', 'AMBER (calef).'),
                                   'first-appendix': appendix(1, 'green')}))
        refused = False
    except SystemExit:
        refused = True
    return [
        ('frontmatter risk files count by the colour word in their verdict sentence',
         (ok['fatal_risks_green'], ok['fatal_risks_amber'], ok['fatal_risks_red'],
          ok['fatal_risks_total']), (1, 1, 0, 3)),
        ('a lowercase colour in the claim is not the verdict', ok['fatal_risks_red'], 0),
        ('a risk file with risk and color keys is not an appendix',
         (shadowed['fatal_risks_green'], shadowed['fatal_risks_red']), (1, 0)),
        ('an appendix colour that disagrees with the verdict sentence aborts', refused, True),
        ('the appendix pattern takes the lowercase page and refuses a numbered risk file',
         [bool(_APPENDIX.match('design/fatal-risks/' + n)) for n in
          ('multicore-reliability.md', '5-not-reliable-on-multicore.md', 'README.md')],
         [True, False, False]),
    ]


def _ratchet_debt_cases():
    """The ratchet-debt series, driven with fixture trees: each counts what its gate's function
    finds, an exempted item included, and nothing outside the gate's scope."""
    def tree(text, links=()):
        t = Tree.__new__(Tree)
        t.text, t.paths, t.oid, t.links = text, list(text), {}, set(links)
        return t

    long_sentence = ' '.join(['word'] * 45) + '.'
    over_bold = '**One** **two** **three**. ' + 'Words in a short sentence. ' * 60
    prose = tree({
        'notes/long.md': 'Short. ' + long_sentence + '\n',
        'notes/exempt.md': ('<!-- writing-standards: exception. 2026-10-13. Reason: a fixture. -->\n'
                            + long_sentence + '\n'),
        'notes/bold.md': over_bold + '\n',
        'kernel/README.md': long_sentence + '\n',
    })
    block = ''.join('// line %d\n' % k for k in range(45)) + 'fn f() {}\n'
    at_cap = ''.join('// line %d\n' % k for k in range(40)) + 'fn g() {}\n'
    rust = tree({'a.rs': block + block, 'b.rs': at_cap,
                 'vendor/x.rs': block, 'notes/a.md': block})
    # Each citation is built from its parts, or the gate would count this fixture as one.
    def at(path, line):
        return '%s:%d' % (path, line)
    cites = {'notes/a.md': ('See %s and %s.\n<!-- line-citation: exception. Reason: a fixture. -->'
                            '\n%s\n' % (at('notes/net.md', 63), at('x.rs', 12), at('notes/b.md', 3))),
             'kernel/a.rs': '// %s\n' % at('sched.rs', 40), 'vendor/v.rs': at('a.rs', 1),
             'bench/out.log': at('a.rs', 2), 'art/x.jpg': at('a.rs', 4) + '\0',
             'notes/link.md': at('x.rs', 9)}
    gated = dict(cites, **{line_citations.SELF: 'CODE_CEILING = 1_200\n'})
    # The trap the unsafe chart fell into: a fenced example and a quoted marker carry a number too.
    # Only the live marker is the gate's, and the chart's line must be that one.
    marker = '<!--count-at-most:%s-->' % rust_source.UNSAFE_DENSITY_MARKER
    held = tree({'notes/ceilings.md': 'At most 51 %s blocks.\nNot `at most 40 %s`.\n'
                 % (marker, marker),
                 'notes/example.md': '```markdown\n**at most 60** %s\n```\n' % marker,
                 'a.rs': 'fn f() { unsafe {} }\n'})
    return [
        ('unsafe ceiling: the live marker script/lint reads, not an example or a quoted one',
         unsafe_census(held)['unsafe_density_ceiling'], 51),
        ('unsafe ceiling: blank before the marker existed',
         unsafe_census(tree({'a.rs': 'fn f() {}\n'}))['unsafe_density_ceiling'], ''),
        ('line citations: marked ones counted; vendor, data, binary and symlink skipped; the '
         'week\'s own ceiling',
         line_citation_debt(tree(gated, links=['notes/link.md'])),
         {'line_citations_code': 2, 'line_citations_doc': 2, 'line_citations_ceiling': 1200}),
        ('line citations: no ceiling before the gate existed',
         line_citation_debt(tree(cites, links=['notes/link.md']))['line_citations_ceiling'], ''),
        ('writing standards: the gate\'s verdict, an exempted document counted, scope kept',
         writing_standards(prose),
         {'writing_over_median': 0, 'writing_over_longest': 2, 'writing_over_bold': 1}),
        ('comment blocks: files, blocks and lines past 40, outside vendor/ and .md alike',
         comment_block_debt(rust),
         {'comment_block_files_over_cap': 1, 'comment_blocks_over_cap': 2,
          'comment_block_excess_lines': 10}),
    ]


def selftest():
    rows = {}
    chain = [('2026W01', {'kernel_code_lines': '100'}),
             ('2026W02', {'kernel_code_lines': '90'}),
             ('2026W03', {'kernel_code_lines': '50'}),
             ('2026W04', {'kernel_code_lines': '0'}),
             ('2026W05', {'kernel_code_lines': '5'}),
             ('2026W06', {'kernel_code_lines': '5'}),
             ('2026W07', {'kernel_code_lines': '5', 'bugs_rust': '3'}),
             ('2026W08', {'kernel_code_lines': '5', 'bugs_rust': '3', 'names_total': '10'}),
             ('2026W09', {'kernel_code_lines': '5', 'bugs_rust': '3', 'names_total': '30',
                          'names_ratified': '10'}),
             ('2026W10', {'kernel_code_lines': '4', 'bugs_rust': '0', 'names_total': '30',
                          'names_ratified': '10'}),
             ('2026W11', {'kernel_code_lines': '4', 'bugs_rust': '', 'names_total': '36',
                          'names_ratified': '10'})]
    for week, cells in chain:
        rows[week] = dict({WEEK: week}, **cells)
    flags = flagged_weeks(rows)
    lines = flag_lines(rows, notes={})
    by_week = {line.split(' ', 1)[0]: line for line in lines}

    notes_file = None
    page_file = None
    original_page = None
    with tempfile.TemporaryDirectory() as tmp:
        notes_file = pathlib.Path(tmp) / 'week-notes.csv'
        notes_file.write_text(
            '# the append rule and the prune rule, in prose a reader meets first\n'
            '# a second comment line the prune must keep byte for byte\n'
            'week,chart,note\n'
            '2026W30,lines.svg,"aged out"\n'
            '2026W31,lines.svg,"stays, with its comma"\n'
            '2026W40,lines.svg,"the kernel cliff"\n')
        kept_before = notes_file.read_text().split('\n')
        dropped = prune_week_notes('2026W31', notes_file)
        kept_after = notes_file.read_text().split('\n')

        page_file = pathlib.Path(tmp) / 'page.md'
        original_page = (
            '# page\n'
            '\n'
            '![Rust](project-metrics/lines.svg)\n'
            '\n'
            'caption one\n'
            '\n'
            '![Bugs](project-metrics/bugs.svg)\n'
            '\n'
            'caption two\n')
        page_file.write_text(original_page)
        notes = {'2026W39': [('lines.svg', 'note a')],
                 '2026W40': [('lines.svg', 'note b')]}
        write_week_notes_bullets(notes, page_file)
        once = page_file.read_text()
        write_week_notes_bullets(notes, page_file)
        twice = page_file.read_text()
        write_week_notes_bullets({}, page_file)
        gone = page_file.read_text()

    with tempfile.TemporaryDirectory() as tmp:
        record = pathlib.Path(tmp) / 'commit-models.csv'
        record.write_text('sha,model,source\n' + 'a' * 40 + ',GLM 5.3,opencode-sha\n'
                          + 'b' * 40 + ',GLM 5.3 Flash,opencode-subject\n')
        recorded = commit_models(record)
        absent = commit_models(pathlib.Path(tmp) / 'no-such-file.csv')

    with tempfile.TemporaryDirectory() as tmp:
        # The build chart (maintainer/build-time-chart): two builds in W41, one of them with a
        # verify that ran, and a third in W42. Wall time is the build row's, set by the helper.
        builds_csv = pathlib.Path(tmp) / 'ci-builds.csv'
        builds_csv.write_text(
            'date,build,kind,workflow,job,start_seconds,end_seconds,seconds\n'
            '2026-10-06,aaa,build,,,0,1200,1200\n'
            '2026-10-06,aaa,job,ci.yml,test,30,900,870\n'
            '2026-10-06,aaa,job,ci.yml,gate,0,20,20\n'
            '2026-10-06,aaa,job,verify.yml,prove,60,1200,1080\n'
            '2026-10-06,aaa,job,ci.yml,cpu-matrix-shard,30,750,720\n'
            '2026-10-06,aaa,job,ci.yml,cpu-matrix,750,756,6\n'
            '2026-10-07,bbb,build,,,0,960,960\n'
            '2026-10-07,bbb,job,ci.yml,test,30,960,930\n'
            '2026-10-07,bbb,job,ci.yml,gate,0,10,10\n'
            '2026-10-12,ccc,build,,,0,600,600\n'
            '2026-10-12,ccc,job,ci.yml,test,30,600,570\n')
        build_weeks = builds_by_week(builds_csv)
        build_absent = builds_by_week(pathlib.Path(tmp) / 'absent.csv')
        build_series, build_note = build_job_series(['2026W41', '2026W42'], builds_csv)
        path_rows, path_wall, path_builds = critical_path('2026W41', builds_csv)
        grouped_svg = pathlib.Path(tmp) / 'grouped.svg'
        svg_chart('t', 's', ['2026W40', '2026W41'],
                  [('fast', [10.0, 12.0], None), ('slow', [20.0, 22.0], None)], grouped_svg,
                  (20, 'target'), None, ('slowest', 'slowest', [(None, True), (25.0, True)]),
                  grouped=True)
        grouped_text = grouped_svg.read_text()

        # The debt-paydown share (lane maintainer/debt-paydown-share-chart): one file gives both
        # counts, a Sunday and the Monday after it are two weeks, and no file is no weeks.
        debt_record = pathlib.Path(tmp) / 'merged-pull-requests.csv'
        debt_record.write_text('number,merged_day,debt_paydown\n'
                               '10,2026-10-05,1\n11,2026-10-11,0\n12,2026-10-11,1\n'
                               '13,2026-10-12,0\n')
        debt_weeks = debt_paydown_by_week(debt_record)
        debt_absent = debt_paydown_by_week(pathlib.Path(tmp) / 'absent.csv')
    debt_rows = {'2026W01': {'debt_paydown_merged_total': '', 'debt_paydown_merged': ''},
                 '2026W02': {'debt_paydown_merged_total': '10', 'debt_paydown_merged': '5'},
                 '2026W03': {'debt_paydown_merged_total': '30', 'debt_paydown_merged': '3'}}
    debt_pair = ('debt_paydown_merged', 'debt_paydown_merged_total')

    cases = [
        ('debt-paydown: both counts from one file, weeks split at Monday UTC', debt_weeks,
         {'2026W41': {'merged': 3, 'labeled': 2}, '2026W42': {'merged': 1, 'labeled': 0}}),
        ('debt-paydown: no record is no weeks, not zeros', debt_absent, {}),
        ('debt-paydown: the share to one place, the counts as counts',
         debt_paydown_cells({'merged': 3, 'labeled': 2}),
         {'debt_paydown_merged_total': 3, 'debt_paydown_merged': 2, 'debt_paydown_pct': '66.7'}),
        ('debt-paydown: a week the record does not cover is empty, never zero',
         debt_paydown_cells(None),
         {'debt_paydown_merged_total': '', 'debt_paydown_merged': '', 'debt_paydown_pct': ''}),
        ('debt-paydown: a week with none labeled is a measured zero',
         debt_paydown_cells({'merged': 4, 'labeled': 0})['debt_paydown_pct'], '0.0'),
        ('debt-paydown: the trend pools the window rather than averaging shares',
         trailing_mean(debt_rows, ['2026W03'], debt_pair, 3), [(20.0, False)]),
        ('debt-paydown: an uncovered week neither counts as zero nor fills the window',
         trailing_mean(debt_rows, ['2026W02', '2026W03'], debt_pair, 2),
         [(50.0, False), (20.0, True)]),
        ('debt-paydown: a window with no covered week draws no point',
         trailing_mean(debt_rows, ['2026W01'], debt_pair, 2), [(None, False)]),
        ('ci-jobs: a week is the median and p90 of its builds\u2019 wall time',
         build_weeks.get('2026W41'),
         {'ci_builds': 2, 'ci_build_median_minutes': '18.0', 'ci_build_p90_minutes': '19.6'}),
        ('ci-jobs: no record is no weeks, not zeros', build_absent, {}),
        ('ci-jobs: a skipped verify job is not a zero in its median, and a short job is a note',
         [(label, values) for label, values, _h in build_series],
         [('prove (verify)', [18.0, 0.0]), ('test', [15.0, 9.5]), ('cpu-matrix', [12.0, 0.0])]),
        ('ci-jobs: a shard folds into the job that waits for it, so one bar spans the split',
         [label for label, _v, _h in build_series].count('cpu-matrix-shard'), 0),
        ('ci-jobs: the note counts what was not drawn', build_note.startswith('1 other job,'), True),
        ('ci-jobs: the critical path ends latest first, with the week\u2019s median wall',
         ([r[0] for r in path_rows], path_wall, path_builds, path_rows[0][5]),
         (['prove (verify)', 'test', 'cpu-matrix', 'cpu-matrix-shard', 'gate'], 18.0, 2, 1)),
        ('ci-jobs: the last full week is the one before today\u2019s',
         (last_full_week(date(2026, 10, 11)), last_full_week(date(2026, 10, 12))),
         ('2026W40', '2026W41')),
        ('p90 of one build is that build', p90([7.0]), 7.0),
        ('grouped bars are never summed into a total',
         ('>30<' in grouped_text, '>34<' in grouped_text), (False, False)),
        ('a trend line over grouped bars carries its value and breaks at a missing week',
         (grouped_text.count('<circle'), '>25<' in grouped_text), (1, True)),
        ('a recorded sha with no trailer takes the recorded model',
         signed_by('a' * 40, [], recorded), ['GLM 5.3']),
        ('a trailer wins over the record', signed_by('a' * 40, ['Claude Opus 5'], recorded),
         ['Claude Opus 5']),
        ('a sha in neither stays unattributed', signed_by('c' * 40, [], recorded), []),
        ('Claude Sonnet 5.5 has its own column, as signed in git',
         MODEL_TRAILERS[normalize_model('Claude Sonnet 5.5 <noreply@anthropic.com>')], 'sonnet_5_5'),
        ('Claude Haiku 4.5 has its own column, as signed in git',
         MODEL_TRAILERS[normalize_model('Claude Haiku 4.5 <noreply@anthropic.com>')], 'haiku_4_5'),
        ('a missing record is empty, not an error', absent, {}),
        ('the record names map to columns',
         [MODEL_TRAILERS[recorded[s]] for s in ('a' * 40, 'b' * 40)], ['glm_5_3', 'glm_5_3_flash']),
        ('a move over a tenth flags, falling',
         [f for f, _p, _n in flags['2026W03']], ['kernel_code_lines']),
        ('a move of exactly one tenth does not flag', '2026W02' in flags, False),
        ('a fall to a measured zero flags', flags['2026W04'], [('kernel_code_lines', 50.0, 0.0)]),
        ('a rise from a measured zero flags', flags['2026W05'], [('kernel_code_lines', 0.0, 5.0)]),
        ('an unchanged week does not flag', '2026W06' in flags, False),
        ('a series born that week does not flag', '2026W07' in flags, False),
        ('a derived band flags through the same rule', flags['2026W08'],
         [('names_no_block', 0.0, 10.0)]),
        ('the biggest relative mover is named first',
         [f for f, _p, _n in flags['2026W10']], ['bugs_rust', 'kernel_code_lines']),
        ('an absent current cell does not flag that series',
         'bugs_rust' in [f for f, _p, _n in flags['2026W11']], False),
        ('the week before the window is a prior, never a flag', '2026W01' in flags, False),
        ('a flag line names week, series, move and state', by_week['2026W03'],
         '2026W03 kernel_code_lines 90->50; no week note'),
        ('an annotated week says so in the same line',
         flag_lines(rows, notes={'2026W03': [('lines.svg', 'n')]})[0],
         '2026W03 kernel_code_lines 90->50; annotated'),
        ('further movers are counted, not listed', by_week['2026W10'],
         '2026W10 bugs_rust 3->0 (+1 more series); no week note'),
        ('the prune drops only the aged row', dropped, 1),
        ('the prune keeps every other line byte for byte',
         kept_after, [l for l in kept_before if l != '2026W30,lines.svg,"aged out"']),
        ('a bullet renders under the chart it names, in week order',
         ('\n'.join(once.split('\n')[4:8])),
         '\n'.join([WEEK_NOTE_BEGIN, '- 2026W39: note a', '- 2026W40: note b',
                    WEEK_NOTE_END])),
        ('rendering twice writes the same bytes', twice, once),
        ('a chart with no notes left is back to its original bytes', gone, original_page),
    ]
    cases += _update_target_cases()
    cases += _chart_total_cases()
    cases += _fatal_risk_cases()
    cases += _decision_cases()
    cases += _ratchet_debt_cases()
    failed = [(name, got, want) for name, got, want in cases if got != want]
    for name, got, want in failed:
        print('metrics selftest: %s\n  got  %r\n  want %r' % (name, got, want), file=sys.stderr)
    if failed:
        return 1
    print('metrics selftest: %d cases pass' % len(cases))
    return 0


def main(argv):
    coverage = ''
    coverage_min = ''
    coverage_week = ''
    args = []
    i = 0
    while i < len(argv):
        if argv[i] in ('--coverage-from', '--coverage-min-from', '--coverage-for'):
            if i + 1 >= len(argv):
                raise SystemExit('metrics: %s needs an argument' % argv[i])
            if argv[i] == '--coverage-from':
                coverage = coverage_from_lcov(argv[i + 1])
            elif argv[i] == '--coverage-min-from':
                coverage_min = coverage_min_from_summary(argv[i + 1])
            else:
                coverage_week = argv[i + 1]
            i += 2
            continue
        args.append(argv[i])
        i += 1

    if coverage_week:
        # One cell, and only that cell. The row is deliberately NOT recomputed: that would repoint
        # its commit at whatever history says today and restate every count, which is --update's
        # job and is not what a caller measuring one historical week asked for.
        if args:
            raise SystemExit('metrics: --coverage-for takes no mode; it writes one cell and redraws')
        if not coverage and not coverage_min:
            raise SystemExit('metrics: --coverage-for needs --coverage-from <lcov.info> or '
                             '--coverage-min-from <floor.txt>')
        rows = read_csv()
        if coverage_week not in rows:
            raise SystemExit('metrics: %s is not a week in %s; --coverage-for only fills a row '
                             'that already exists' % (coverage_week, measure_path('weeks')))
        # Either cell alone, because they come from different files and a caller may hold only
        # one: a historical week has an lcov and no floor summary, and re-running the floor over an
        # old lcov would apply today's exemptions to it.
        if coverage:
            rows[coverage_week]['coverage_lines_pct'] = coverage
        if coverage_min:
            rows[coverage_week]['coverage_min_file_pct'] = coverage_min
        write_csvs(render_csvs(rows))
        draw_charts(rows)
        print('metrics: %s coverage_lines_pct = %s, coverage_min_file_pct = %s, charts in %s/'
              % (coverage_week, coverage or '(unchanged)', coverage_min or '(unchanged)',
                 DATA_DIR))
        return 0

    mode = args[0] if args else '--table'
    # `--selftest` and `--flags` were dropped by the merge of #1455 (2026-10-01), whose conflict
    # resolution cut the `--check-toc` branch beside them and took these two with it. The weekly
    # workflow calls `--flags` to write its pull request body, so every run from 2026-10-01 pushed
    # the week's branch and then failed (milestone 636 (the scheduled workflows are failing)).
    if mode == '--selftest':
        return selftest()
    if mode == '--flags':
        rows = fill_derived(read_csv(), git('rev-parse', 'HEAD').decode().strip())
        lines = flag_lines(rows)
        for line in lines:
            print(line)
        if not lines:
            print('no charted week moved more than a tenth')
        return 0
    if mode == '--backfill-measure':
        # One measure's columns, every week, from that week's commit; nothing else in any row
        # moves. row_for computes the whole row, which costs a backfill's time and keeps the
        # derivation the one --update uses, rather than a second path per measure that could drift.
        if len(args) != 2 or args[1] not in dict(MEASURES):
            raise SystemExit('metrics: --backfill-measure takes one measure name: %s'
                             % ', '.join(name for name, _columns in MEASURES))
        name, columns = args[1], dict(MEASURES)[args[1]]
        rows = read_csv()
        for week, rev in week_commits().items():
            if week not in rows:
                continue
            fresh = row_for(rev, week)
            for column in columns:
                rows[week][column] = fresh.get(column, '')
        head = git('rev-parse', 'HEAD').decode().strip()
        if 'names_total' in columns:
            check_names_total(rows, max(rows), week_commits().get(max(rows)), head)
        # A derived measure (`ci-jobs`, `debt-paydown`, the cost records) is not in row_for at all,
        # so the loop above blanks it; `fill_derived` is where `--update` computes it, and only this
        # measure's file is written. Before 2026-10-11 (UTC) `--backfill-measure ci-jobs` wrote a
        # header and nothing else.
        rows = fill_derived(rows, git('rev-parse', 'HEAD').decode().strip())
        path = measure_path(name)
        write_csvs({path: render_csvs(rows)[path]})
        draw_charts(rows, only=set(columns))
        print('metrics: %s rewritten for %d weeks, its charts redrawn' % (path, len(rows)))
        return 0

    if mode not in ('--table', '--csv', '--backfill', '--update', '--check', '--charts'):
        raise SystemExit('metrics: unknown argument %s; see the comment at the top of this script'
                         % mode)

    if mode == '--charts':
        draw_charts(fill_derived(read_csv(),
                                       git('rev-parse', 'HEAD').decode().strip()))
        print('metrics: charts written to %s/' % DATA_DIR)
        return 0

    head = git('rev-parse', 'HEAD').decode().strip()
    if mode in ('--table', '--csv'):
        row = row_for(head, week_of(git('show', '-s', '--format=%cI', head).decode().strip()),
                      coverage, coverage_min=coverage_min)
        if mode == '--csv':
            print(','.join(FIELDS))
            print(','.join(str(row.get(f, '')) for f in FIELDS))
        else:
            print_table(row)
        return 0

    weeks = week_commits()
    rows = read_csv()
    # CARRIED_FIELDS survive a rewrite, including a `--backfill` that drops every other cell,
    # because nothing in git can reproduce them. Coverage needs an instrumented build at each
    # checkout and nothing here is allowed to build; `human_person_weeks` is a person's statement.
    # Milestone 276 found this the way it is usually found: running `--backfill` to add a column,
    # and watching 2026W36's measured 94.4 disappear with it. It is a named set now rather than one
    # special case, so milestone 519's column inherited the protection instead of the bug.
    kept = {week: {field: row.get(field, '') for field in CARRIED_FIELDS}
            for week, row in rows.items()}
    current = week_of(git('show', '-s', '--format=%cI', head).decode().strip())
    if mode == '--backfill':
        rows = {}
        targets = weeks.items()
    else:
        targets = update_targets(weeks, rows, current, head)

    # A fresh lcov describes the tree HEAD is in and nothing else, so it lands on that week only.
    # It used to be `coverage or kept` for every target, which meant `--backfill --coverage-from`
    # stamped one measurement across every week in the series and erased the backfilled cells.
    for week, rev in targets:
        fresh = coverage if week == current else ''
        fresh_min = coverage_min if week == current else ''
        held = kept.get(week, {})
        rows[week] = row_for(rev, week,
                             fresh or held.get('coverage_lines_pct', ''),
                             held.get('human_person_weeks', ''),
                             fresh_min or held.get('coverage_min_file_pct', ''))
        rows[week].update({f: held[f] for f in INTERFACE_FIELDS if held.get(f, '') != ''})

    # Derived last, from HEAD and from the committed cost records, for every week at once: see
    # `fill_derived`. It runs before `--check` compares, so a stale cell is a failure there rather
    # than a surprise on the next write.
    rows = fill_derived(rows, head)
    check_names_total(rows, current, weeks.get(current, head), head)

    rendered = render_csvs(rows)
    if mode == '--check':
        # Every measure, and the message names all of the stale ones rather than the first. A
        # caller told one name at a time learns nothing, and `--update` rewrites them all anyway.
        stale = [path for path, text in rendered.items()
                 if (path.read_text() if path.exists() else '') != text]
        if stale:
            print('metrics: %s stale; run script/metrics --update'
                  % ', '.join(str(path) for path in sorted(stale)), file=sys.stderr)
            return 1
        print('metrics: %d measure files in %s/ are current' % (len(rendered), DATA_DIR))
        return 0

    write_csvs(rendered)
    # Milestone 623's aging-out rule runs here, before the charts are drawn, so the bullet a
    # pruned row was rendering disappears in the same run that dropped it. `--check` compares the
    # measure files only; the week notes are a hand record, and their prune is a side effect of
    # the run rather than something the staleness check can see.
    window = sorted(rows)[-CHART_WEEKS:]
    dropped = prune_week_notes(window[0])
    if dropped:
        print('metrics: pruned %d week-note row(s) whose week left the chart window' % dropped)
    draw_charts(rows)
    report_flags(rows)
    print('metrics: %d weeks across %d measure files in %s/, charts in the same directory'
          % (len(rows), len(rendered), DATA_DIR))
    return 0


sys.exit(main(sys.argv[1:]))
PYEOF
