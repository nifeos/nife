+++ b/crates/entropy_contract/src/lib.rs
@@ -206,7 +206,7 @@
         bring_up_failure(STEP_NO_FIRST_BYTES)
     } else if !any_nonzero {
         bring_up_failure(STEP_FIRST_ALL_ZERO)
-    } else if all_same && count >= MAXIMUM_BYTES as usize {
