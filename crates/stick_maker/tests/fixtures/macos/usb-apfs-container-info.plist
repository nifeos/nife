<plist version="1.0">
<dict>
	<key>BusProtocol</key>
	<string>USB</string>
	<key>DeviceIdentifier</key>
	<string>disk3</string>
	<key>Ejectable</key>
	<true/>
	<key>IORegistryEntryName</key>
	<string>AppleAPFSMedia</string>
	<key>Internal</key>
	<false/>
	<key>MediaName</key>
	<string>USB Disk</string>
	<key>OSInternalMedia</key>
	<false/>
	<key>Removable</key>
	<false/>
	<key>RemovableMedia</key>
	<false/>
	<key>RemovableMediaOrExternalDevice</key>
	<true/>
	<key>Size</key>
	<integer>999790284800</integer>
	<key>TotalSize</key>
	<integer>999790284800</integer>
	<key>VirtualOrPhysical</key>
	<string>Virtual</string>
	<key>WholeDisk</key>
	<true/>
</dict>
</plist>
