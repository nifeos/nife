/// The parser's state. Deliberately few: most of a full VT's dozen states disti[m nguish sequences[m
/// this engine swallows anyway. See notes/video-terminal.md, "Parsing".[m
#[derive(Debug, Clone, Copy, PartialEq, Eq)][m
enum State {[m
    /// Printing.[m
    Ground,[m
    /// `ESC` has been seen.[m
    Esc,[m
    /// Inside `ESC [`, accumulating parameters.[m
    Csi,[m
    /// Inside a **string** sequence (`ESC ]`, the operating-system command, and[m  its relatives),[m
    /// whose arbitrary text a parser without this state would print, a window t[m itle included.[m
    Str,[m
    /// Inside a string sequence, having just seen `ESC`: a `\` ends the string [m (ST), anything else[m
    /// is part of it.[m
    StrEsc,[m
}[m
:[K[K[m
/// How many numeric parameters a CSI sequence may carry: a foreground and a bac[m kground in 24-bit[m
/// color are ten, with room for a reset and a rendition or two. A seventeenth m[m arks the sequence[m
/// ignored rather than growing the array.[m
pub(crate) const MAXIMUM_PARAMS: usize = 16;[m
[m
/// **A terminal's live grid, plus its off-screen history.**[m
///[m
/// Construct with [`Vt::new`], push bytes with [`Vt::feed`], read pixels with [[m `Vt::pixel`], ask[m
/// what changed with [`Vt::take_damage`], and scroll with [`Vt::scroll_up`]/[`V[m t::scroll_down`].[m
///[m
/// **A `Vt` is several hundred KiB and must never be a runtime-constructed loca[m l or return[m
/// value.** Build it in a `static` with constant geometry and retarget it with [m [`Vt::reset_to`];[m
/// `script/stack-frame-check` catches a violation. See notes/video-terminal.md,[m  "The grid's[m
/// capacity".[m
pub struct Vt {[m
:[K[K    cells: [Cell; MAXIMUM_CELLS],[m
