#!/bin/sh
# pre-push: the formatting gate and lint's text checks, run where they are cheap, plus the fleet's
# checks on a checkout that opted in to them.
#
# CI's rustfmt is one of seven required checks, and a lane that pushes unformatted code learns
# that from a runner ten minutes later, then pushes again. Every lane on 2026-08-15 and -16 paid
# that tax at least once, three of them on the same night, which is a gate teaching the wrong
# lesson: "run CI to find out how to format". This runs the identical check in about 2 s before the
# push leaves the machine.
#
# What this runs, and what it skips (milestone 729 (the pre-push hook runs what fits in seconds), provisional, 2026-10-03 UTC; calef approved
# COE decision 3 on #1564: "Approve the revised decision 3."):
#
#   1. `script/fmt --check`.
#   2. `script/lint --no-cargo`: every lint check that does not invoke cargo. Clippy stays in CI.
#      Skipped when helpers/pre-push-lint-cache.sh holds this machine's marker that the same
#      checks already passed on the same tree: the marker is keyed on every input the checks read
#      (the working tree with its untracked files, the index, the committed tip, the merge base,
#      the lint tools' binaries), so a skipped hook passes exactly when the run it skips would
#      have, and any failure to key or record lands on a run, never on a skip. CI reruns
#      everything and stays the authority either way.
#   3. On a checkout with `git config nife.fleet true` only: the queued-branch refusal, the fleet
#      tooling's own lint and the ready-status check, all in helpers/pre-push-fleet.sh.
#   4. All but the queued-branch refusal are skipped for a push whose commits change no files, which is a claim (an empty
#      commit, §90 (the claim is a draft pull request)). That push used to be refused for "milestone N has no roadmap
#      block", five false refusals on 2026-10-03, because the block comes after the claim.
#
# The marker (2026-10-28, fix 3 in notes/lint-cost-2026-10-18.md): a `--no-cargo` run costs one to
# four minutes on this machine (notes/lint-cost-2026-10-18.md section 1), and a push that follows a
# passing lint on an unchanged tree paid for it again on every retry of the push. Skipping repeats
# is also a safety change: GitHub closes an idle push connection somewhere between 300 and 480 s
# (milestone 729's header; #2478), so every second the hook runs is time an approved push can die
# in.
#
# How it got here. The hook grew one gate per incident (clippy on 2026-09-29, then the prose
# ratchets, then the baselines check), each after a lane lost a queue cycle, and the list lagged
# every time. Milestone 630 (a merge-queue ejection is caught before the queue, and recovered
# after it) then made it all of `script/lint`, which on 2026-10-03 cost 70 to 120 s warm and 202 s
# cold on a loaded machine, past an agent harness's two-minute tool limit. #1556's claim push sat
# in it for a whole lane, #1560's first push timed out, and lanes took to `--no-verify`, which is
# a gate teaching the wrong lesson again. Of the 38 lint failures CI saw on pull requests between
# 2026-09-19 and 10-03 under an fmt-only hook, 36 came from checks that read text, so the text
# checks are the ones worth the seconds. The measured cost of this version is in notes/scripts.md.
#
# "Not cargo" is a rule and not a list: `script/lint --no-cargo` reads the partition out of
# script/lint's own sections (helpers/lint-no-cargo.awk), so a new check is in a bucket the moment
# it is written. `script/lint --no-cargo --list` prints which sections run. The design record is
# the COE for 2026-10-03, notes/coes/2026-10-03-the-queue-judged-one-pull-request-at-a-time.md.
#
# Installed by `script/setup` via core.hooksPath, so it covers every worktree sharing this .git
# (which is how lanes work) rather than needing per-worktree installation.
#
# **Without the opt-in this hook runs no `gh` command and needs no network** (milestone 889 (the
# tree's gates stop depending on the fleet tooling), provisional). Asking GitHub whether a branch
# is queued, or whether its pull request is ready, is a question about a lane in the fleet's merge
# queue, and a stranger's push should pass or fail on the tree alone. The lane claim sets the opt-in
# on the machine that cuts lanes; helpers/pre-push-fleet.sh has the rest. This file names no fleet
# script by path, so script/lint's contract check (every `script/<name>` named here exists) holds
# in a tree with the fleet tooling moved out.
#
# `NIFE_PUSH_QUEUED=1 git push` overrides only the queued-branch check. Bypass with `git push --no-verify` when you mean it: pushing a work-in-progress branch for
# safekeeping is a legitimate reason, and this hook is a courtesy to the queue rather than a
# rule about what may exist on a branch.

root="$(git rev-parse --show-toplevel)"
[ -x "$root/script/fmt" ] || exit 0   # a branch predating the script pushes unimpeded

# git sends one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. Read it
# once, because two steps below want it.
refs="$(cat)"

# The fleet half, opted in per clone. Read once: both of its calls below want it.
fleet=
if [ "$(git config --bool nife.fleet 2>/dev/null)" = true ]; then
    if [ -x "$root/helpers/pre-push-fleet.sh" ]; then
        fleet=1
    else
        echo "pre-push: nife.fleet is set but helpers/pre-push-fleet.sh is missing here; the fleet checks did not run." >&2
    fi
fi

# The queued-branch refusal runs before the empty-push skip below, because an empty push to a
# queued branch removes it from the queue just as well. helpers/pre-push-fleet.sh says more.
if [ -n "$fleet" ]; then
    printf '%s\n' "$refs" | "$root/helpers/pre-push-fleet.sh" queued || exit 1
fi

# **A push that changes no files has nothing to check** (a claim: `git commit --allow-empty`). Changed
# is measured against the remote ref when it exists, and against where the branch left origin/main
# when it is new, so a claim is the same empty push the first time and every time. A deletion pushes
# no files. Any case this cannot answer (a remote sha this clone has never fetched) counts as
# changed, so the answer errs toward checking and never skips a push that carries files.
zero=0000000000000000000000000000000000000000
changed=
while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
        base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || base=
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" 2>/dev/null; then
        changed=1
    fi
done <<ENDREFS
$refs
ENDREFS
[ -n "$changed" ] || exit 0

if ! "$root/script/fmt" --check >/dev/null 2>&1; then
    echo "pre-push: rustfmt would change files, and CI's rustfmt check will fail." >&2
    echo "  Fix:    script/fmt        (then commit and push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi

# **git exports GIT_DIR to a hook, and lint must not inherit it** (found by this lane, 2026-10-03).
# Inside a hook GIT_DIR names this worktree's git directory, so any check that `cd`s into a
# throwaway repository and runs git there acts on the real one instead.
# helpers/scope-merge-base-selftest.sh did exactly that on this hook's first full run: its `git init`
# set `core.bare = true` and its `git config` set a fake user.name and user.email in the shared
# `.git/config`, under every worktree on the machine, before `git checkout -b main` failed. Both were
# put back by hand. The checks find the repository from their own working directory, which is what
# a person running `script/lint` gets, so clearing the hook's git environment is the whole fix.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_CONFIG_PARAMETERS

# **The fleet's checks start now and are joined after the text checks** (2026-10-31): the two share
# nothing, each takes 20 seconds or more, and run back to back they were the longest part of a push.
# The fleet half's output waits in a file and is shown only if it fails, in the order it always
# was: the text checks' failure is reported first, the fleet's second. A text-check failure stops
# the fleet half by its own pid. helpers/pre-push-fleet.sh says what the half runs.
fleet_out=
fleet_pid=
if [ -n "$fleet" ]; then
    fleet_out="$(mktemp "${TMPDIR:-/tmp}/nife-pre-push-fleet-out.XXXXXX")"
    printf '%s\n' "$refs" | "$root/helpers/pre-push-fleet.sh" after >"$fleet_out" 2>&1 &
    fleet_pid=$!
fi
stop_fleet() {
    if [ -n "$fleet_pid" ]; then
        kill "$fleet_pid" 2>/dev/null
        wait "$fleet_pid" 2>/dev/null
    fi
    [ -z "$fleet_out" ] || rm -f "$fleet_out"
}

# **The text checks run once per tree, not once per push.** helpers/pre-push-lint-cache.sh keys a
# machine-local marker on every input the checks read and keeps it outside every worktree (an
# in-tree marker would feed the next tree hash, and a hook must not drop files into the tree).
# A key that cannot be computed, a marker that is absent, and a cache that cannot be written all
# land on the run below: they are never a skip and never a refused push.
lint_key="$("$root/helpers/pre-push-lint-cache.sh" key 2>/dev/null)" || lint_key=
if [ -n "$lint_key" ] && "$root/helpers/pre-push-lint-cache.sh" check "$lint_key" >/dev/null 2>&1; then
    echo "pre-push: script/lint --no-cargo skipped; this machine's marker says the same checks passed on this tree already (helpers/pre-push-lint-cache.sh)."
else
    out="$(mktemp "${TMPDIR:-/tmp}/nife-pre-push.XXXXXX")"
    if ! "$root/script/lint" --no-cargo >"$out" 2>&1; then
        echo "pre-push: script/lint --no-cargo failed; CI runs these checks too and will fail the same way." >&2
        tail -n 15 "$out" | sed 's/^/  | /' >&2
        echo "  Fix:    script/lint --no-cargo   (read its output, fix, commit, push again)" >&2
        echo "  Bypass: git push --no-verify" >&2
        rm -f "$out"
        stop_fleet
        exit 1
    fi
    rm -f "$out"
    # Keyed after the run, so the marker names the tree the checks just judged rather than the one
    # they started on.
    lint_key="$("$root/helpers/pre-push-lint-cache.sh" key 2>/dev/null)" || lint_key=
    if [ -n "$lint_key" ]; then
        "$root/helpers/pre-push-lint-cache.sh" write "$lint_key" >/dev/null 2>&1 || true
    fi
fi

# The fleet's checks: its own lint, and the ready-status check. helpers/pre-push-fleet.sh. They have
# been running since before the text checks; their own messages are shown here.
if [ -n "$fleet_pid" ]; then
    if wait "$fleet_pid"; then
        cat "$fleet_out"
        rm -f "$fleet_out"
    else
        cat "$fleet_out" >&2
        rm -f "$fleet_out"
        exit 1
    fi
fi
