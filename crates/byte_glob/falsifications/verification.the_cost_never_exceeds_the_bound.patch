Falsifies `glob::verification::the_cost_never_exceeds_the_bound`.

The defect: `cost_bound` loses its dependence on the name length: the backtracking term is dropped, so a
pattern that backtracks across a long name is charged as though it never did.

Expected to fail: the harness's `assert!(steps <= cost_bound(plen, nlen))`.

diff --git a/crates/byte_glob/src/lib.rs b/crates/byte_glob/src/lib.rs
--- a/crates/byte_glob/src/lib.rs
+++ b/crates/byte_glob/src/lib.rs
@@ -251,10 +251,8 @@ pub const fn cost_bound(pattern_bytes: usize, name_bytes: usize) -> usize {
     let iterations = name_bytes
         .saturating_add(2)
         .saturating_mul(name_bytes.saturating_add(pattern_bytes).saturating_add(1));
-    iterations
-        .saturating_mul(pattern_bytes.saturating_mul(2).saturating_add(2))
-        .saturating_add(pattern_bytes)
-        .saturating_add(2)
+    let _ = iterations;
+    pattern_bytes.saturating_add(2).saturating_add(0 * name_bytes)
 }
 
 // ---- the pattern's elements ------------------------------------------------------------------
