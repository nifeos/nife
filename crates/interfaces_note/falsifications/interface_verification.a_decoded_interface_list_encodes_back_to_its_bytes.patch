     for i in 0..count {
         let at = 8 + i * INTERFACE_RECORD;
         let id = record(&d[at..at + INTERFACE_RECORD]).id;
-        if previous.is_some_and(|p| p >= id) {
+        if previous.is_some_and(|p| p > id) {
