    /// `sb_len` slots immediately before this one, wrapping.[m
    sb_tail: u32,[m
    /// How many scrollback rows are populated, capped at [`SCROLLBACK_ROWS`].[m
    sb_len: u32,[m
    /// How many rows scrolled back from the live view, `0..=sb_len`. `0` is the[m  ordinary live view;[m
    /// nonzero means [`Vt::cell`] (and therefore [`Vt::pixel`]/[`Vt::row_bytes`[m ]) reads from[m
    /// [`scrollback`](Self::scrollback) for the topmost `view_offset` display r[m ows.[m
    view_offset: u32,[m
    cols: u32,[m
    rows: u32,[m
    col: u32,[m
