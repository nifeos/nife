Falsifies `socket_contract::ephemeral::verification::a_stack_started_four_milliseconds_later_starts_past_every_port_used`.

The defect: the clock divides by 2000 where it divides by 1000, so a gap of four milliseconds
no longer gains a whole position and a later stack can start on the earlier stack's last port.

Expected to fail: `assert!(clock(last + gap) > clock(last))`.

diff --git a/crates/socket_contract/src/lib.rs b/crates/socket_contract/src/lib.rs
index d19a2bbbc..46b554924 100644
--- a/crates/socket_contract/src/lib.rs
+++ b/crates/socket_contract/src/lib.rs
@@ -439,7 +439,7 @@ pub mod ephemeral {
 
     /// The clock's position at `milliseconds`.
     fn clock(milliseconds: u64) -> u64 {
-        milliseconds.saturating_mul(PER_SECOND) / 1000
+        milliseconds.saturating_mul(PER_SECOND) / 2000
     }
 
     fn port_at(position: u64) -> u16 {
