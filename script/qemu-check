#!/bin/sh
# script/qemu-check: is the QEMU on PATH the one this project expects?
#
# `.qemu-version` is the single source of truth, and it is read by three things that must agree: this
# check, `script/ci-qemu` (which builds that exact version on the runner), and the CI cache key. Change
# the file and all three move together.
#
# **Two different questions, deliberately answered with different severity**, because they are not
# equally serious:
#
#   1. *Does this QEMU have the devices we need?* A hard failure. Without `riscv-iommu-pci` the riscv
#      leg cannot boot milestone 16b's tests at all, and the tempting workaround (drop the device when
#      absent) would let the DMA-confinement tests pass while testing nothing. That is the silent
#      degradation the CRICKER_DISK check exists to prevent.
#
#   2. *Is it the exact pinned version?* A warning. Benchmark numbers are icount instruction counts,
#      so a different QEMU can legitimately shift them. But Homebrew cannot install an arbitrary
#      older QEMU, so demanding an exact match locally would be a rule nobody could follow. Loud and
#      non-fatal is the honest setting.
#
#      **This paragraph used to say `bench/baseline-aarch64.txt` "was recorded against the pinned
#      one", and nothing in the tree supported that** (corrected 2026-09-21). No baseline recorded
#      which emulator produced it, and this machine has run 11.1.1 against a pinned 11.0.2 since
#      2026-08-28, so the claim was an assumption wearing a fact's clothes in the one place a reader
#      goes to ask the question. The baselines now carry a `# qemu:` line, `cargo xtask bench --save`
#      writes it from the binary it ran, and `--check` compares it against the emulator in front of
#      it; the existing files say `unrecorded`, which is the truth about them.
#
# Run it directly any time; `script/bootstrap` calls it after installing.
#
# **"The QEMU on PATH" means the project's, not the system's** (milestone 287). This script
# sources `helpers/qemu-path.sh` below, so on Linux it reports on whatever `script/ci-qemu`
# built rather than on apt's. Before that it answered about `/usr/bin`'s 8.2.2 even on a
# machine that had built 11.0.2 an hour earlier, which is how the remedy this check prints
# came to name two commands that looped.
#
# Name: recorded (script/undefined-behavior-check, ratified 2026-08-03 by calef). Introduced
# 2026-07-30. The `-check` suffix is not this script's coinage to defend: calef signed it while
# replacing `miri`, and the ratification cites this script by name as one of the two that had
# already established the suffix, concluding that "the long form costs nothing the directory was
# not already paying" because eight of twenty-six scripts were hyphenated already. The stem is the
# tool it checks the version of. no architect has ratified this instance.

set -e
cd "$(dirname "$0")/.."

# This project's own QEMU, if `script/ci-qemu` has built one (helpers/qemu-path.sh says why
# PATH is the mechanism). A no-op on macOS and on any machine without that prefix.
. helpers/qemu-path.sh

want="$(tr -d ' \n' < .qemu-version)"

if ! command -v qemu-system-aarch64 >/dev/null 2>&1 \
    || ! command -v qemu-system-riscv64 >/dev/null 2>&1 \
    || ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "qemu-check: qemu-system-aarch64, qemu-system-riscv64 and qemu-system-x86_64 must all be on PATH." >&2
    echo "  Run script/bootstrap, or on Linux script/ci-qemu to build the pinned version." >&2
    exit 1
fi

have="$(qemu-system-aarch64 --version | head -1 | awk '{print $4}')"

# The capability check. These are the devices whose absence silently guts a test rather than failing
# it, so each is named here rather than discovered at boot. riscv-iommu-pci is the one that actually
# bit us: Ubuntu 24.04's QEMU 8.2 had no such device and the riscv leg died mid-suite.
missing=""
qemu-system-riscv64 -device help 2>&1 | grep -q "riscv-iommu-pci" \
    || missing="$missing riscv-iommu-pci(riscv64)"
qemu-system-aarch64 -machine help 2>&1 | grep -q "virt" \
    || missing="$missing virt(aarch64)"

if [ -n "$missing" ]; then
    echo "qemu-check: QEMU $have is missing:$missing" >&2
    echo "  These are required (milestone 16b, DECISIONS §20). Upgrade to $want or newer." >&2
    echo "  macOS:  brew upgrade qemu" >&2
    echo "  Linux:  script/ci-qemu   (builds and installs the pinned version)" >&2
    exit 1
fi

if [ "$have" != "$want" ]; then
    echo "qemu-check: WARNING: QEMU $have on PATH, but .qemu-version pins $want."
    echo "  Every device this project needs is present, so the tests will run."
    echo "  What can differ is the BENCHMARKS: bench/baseline-aarch64.txt holds icount instruction counts,"
    echo "  and a different QEMU can move them (the check has a 10% tolerance). Which emulator actually"
    echo "  produced a baseline is in its own '# qemu:' line; 'unrecorded' means it predates that record,"
    echo "  and 'cargo xtask bench --check' says so rather than assuming this QEMU is the right one."
    echo
    echo "  Pick one, deliberately:"
    echo "    - keep this QEMU and update the pin:  echo $have > .qemu-version   (commit it; CI"
    echo "      rebuilds and re-caches, and re-run script/bench --save --why \"new QEMU: ...\" if the"
    echo "      numbers actually moved)"
    echo "    - keep the pin and hold QEMU still:   brew pin qemu"
    exit 0
fi

echo "qemu-check: QEMU $have matches the pin, with every required device present."
