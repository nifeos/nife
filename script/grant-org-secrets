#!/bin/sh
#
# Grant new repositories access to the organization secrets that have "selected" visibility.
#
#     script/grant-org-secrets <repo>...
#     script/grant-org-secrets --dry-run <repo>...
#
# For each named repository of the nifeos organization, add it to the selected-repositories list of
# NIFE_SMELTER_PRIVATE_KEY and SETTINGS_TOKEN, the two organization secrets the crate release and
# settings workflows read. NIFE_SMELTER_APP_ID is an organization variable open to every repository
# (an App id is not sensitive) and is not touched here.
#
# It needs a logged-in `gh` whose token has the admin:org scope. For each repository it resolves
# the repository id, makes the grant with PUT /orgs/nifeos/actions/secrets/<NAME>/repositories/<id>
# (granting twice changes nothing), then lists the secret's repositories and exits 1 if the
# repository is missing. It reads and prints no secret value; the grant moves only the list.
#
# It refuses a name that is not an existing nifeos repository, and refuses `nife`: the key bypasses
# the crate tag rulesets, so it stays out of the repository where lanes push branches.
#
#     --dry-run   resolve each repository and say what would be granted; change nothing
#     -h, --help  print this text
#
# Exit 0 when every repository holds both grants, 1 when a refusal or a failed verification
# occurred, 2 on a usage error.
#
# See notes/crate-move.md step 7.
#
# Name: provisional. Says what it grants and to what; the verb leads, as for the other scripts that
# act. calef has not ruled on it.

set -eu

secrets="NIFE_SMELTER_PRIVATE_KEY SETTINGS_TOKEN"
dry_run=0
repos=""

for arg in "$@"; do
    case "$arg" in
    -h | --help)
        sed -n "3,25p" "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    --dry-run) dry_run=1 ;;
    -*)
        echo "grant-org-secrets: unknown option $arg" >&2
        exit 2
        ;;
    *) repos="$repos $arg" ;;
    esac
done

if [ -z "$repos" ]; then
    echo "usage: script/grant-org-secrets [--dry-run] <repo>..." >&2
    exit 2
fi

failed=0
for repo in $repos; do
    case "$repo" in
    nife)
        echo "grant-org-secrets: refusing nife; the key stays out of the repository lanes push to" >&2
        failed=1
        continue
        ;;
    */* | "" | .*)
        echo "grant-org-secrets: $repo is a repository name, not a path" >&2
        failed=1
        continue
        ;;
    esac
    if ! id=$(gh api "repos/nifeos/$repo" -q .id 2>/dev/null); then
        echo "grant-org-secrets: nifeos/$repo is not an existing repository" >&2
        failed=1
        continue
    fi
    for name in $secrets; do
        listing="/orgs/nifeos/actions/secrets/$name/repositories"
        if [ "$dry_run" -eq 1 ]; then
            echo "would grant $name to nifeos/$repo (id $id)"
            continue
        fi
        if gh api --paginate "$listing" -q '.repositories[].name' | grep -qx "$repo"; then
            before=present
        else
            before=absent
        fi
        gh api -X PUT "$listing/$id"
        if gh api --paginate "$listing" -q '.repositories[].name' | grep -qx "$repo"; then
            if [ "$before" = present ]; then
                echo "$name: nifeos/$repo was already granted"
            else
                echo "$name: granted to nifeos/$repo"
            fi
        else
            echo "grant-org-secrets: $name does not list nifeos/$repo after the grant" >&2
            failed=1
        fi
    done
done
exit "$failed"
