# A `#[test]` inside a `#[cfg(kani)]` module never runs, and nothing says so. `cargo test` does not
# set `kani`, so the module is not compiled: the test does not fail, does not get skipped, and does
# not appear in the count. It simply is not there.
#
# This is not hypothetical. Milestone 85's glob triage appended two tests to the end of
# `mod verification` instead of `mod tests`, then reported them as killing fourteen mutants. They
# had never executed. The mutation run is what caught it, four hours later, and only because a
# survivor list disagreed with a paragraph; moving the two tests took the suite from 15 to 18 and
# killed eleven mutants at once.
#
# `.cargo/mutants.toml` already records the same fact from the other side, which is why mutants
# inside `mod verification` are excluded from the run. The tree has 22 `mod verification` blocks
# and 7 `mod proofs`, so there are 29 places for this to happen again. (Was "18 and 3, so 21" when
# this was written; nothing gates the number, and it went stale exactly as a hand-kept count does.
# It is a sense of scale, not a claim, which is why it is not worth a gate of its own.)
echo "==> tests the suite cannot see"
python3 - <<'PY'
import pathlib
import re
import sys

bad = []
for path in pathlib.Path('.').rglob('*.rs'):
    if 'target' in path.parts or 'vendor' in path.parts:
        continue
    src = path.read_text(errors='replace')
    # Walk each `#[cfg(kani)] mod NAME { ... }` to its matching brace and look inside. A brace
    # counter rather than a regex, because these modules nest and hold string literals of their own.
    for head in re.finditer(r'#\[cfg\(kani\)\]\s*(?:pub\s+)?mod\s+(\w+)\s*\{', src):
        depth, i = 0, head.end() - 1
        while i < len(src):
            if src[i] == '{':
                depth += 1
            elif src[i] == '}':
                depth -= 1
                if depth == 0:
                    break
            i += 1
        body = src[head.end():i]
        if '#[test]' in body:
            n = body.count('#[test]')
            bad.append(f'{path}: {n} #[test] inside #[cfg(kani)] mod {head.group(1)}')

if bad:
    print('lint: a #[test] inside a #[cfg(kani)] module is never compiled by cargo test:',
          file=sys.stderr)
    for line in bad:
        print(f'  {line}', file=sys.stderr)
    print('', file=sys.stderr)
    print('Move it to `mod tests`. A test that cannot run is worse than no test, because it '
          'reports a coverage it does not have.', file=sys.stderr)
    sys.exit(1)

blocks = sum(len(re.findall(r'#\[cfg\(kani\)\]\s*(?:pub\s+)?mod\s+\w+', p.read_text(errors='replace')))
             for p in pathlib.Path('.').rglob('*.rs')
             if 'target' not in p.parts and 'vendor' not in p.parts)
print(f'kani modules: {blocks} blocks, none hiding a #[test]')
PY

# **Every test module `system_tests/src/user.rs` declares carries its own `cfg`.** The suite's
# modules are declared one per line under `#[cfg(test)]` or `#[cfg(all(test, initrd))]`, and an
# attribute binds to the next item only. Milestone 634 (a plain SEND received by RECEIVE_CAP never
# hands the receiver a sender-chosen slot) inserted `mod recv_cap_attack_tests;`
# between an existing attribute and `mod revocation_in_flight_tests;`, so the attribute moved onto
# the new module and the old one was declared bare: compiled into every build of the crate, which
# nothing noticed because the crate still built (the 2026-10-03 security audit's follow-up, item
# (e)). A bare `mod` here is either that slip or a module that is not a test, and the second does
# not exist in this file.
python3 - <<'PY'
import re
import sys

path = 'system_tests/src/user.rs'
prev = ''
bad = []
for n, line in enumerate(open(path, errors='replace'), 1):
    if re.match(r'^(pub )?mod \w+;$', line):
        if not prev.startswith('#[cfg('):
            bad.append(f'{path}:{n}: {line.strip()} is not preceded by a #[cfg(...)] attribute')
    if line.strip():
        prev = line.strip()
if bad:
    print('lint: a test module in system_tests/src/user.rs is declared without its own cfg:',
          file=sys.stderr)
    for b in bad:
        print(f'  {b}', file=sys.stderr)
    print('\nEach `mod` line takes its own `#[cfg(test)]` (or `#[cfg(all(test, initrd))]`); an '
          'attribute binds to the next item only, so inserting a module between an attribute '
          'and its `mod` moves the attribute.', file=sys.stderr)
    sys.exit(1)
print('system_tests modules: every `mod` in user.rs carries its own cfg')
PY

# **A crate can carry proof harnesses and be proved by nothing, and the suite gets FASTER when it
# happens.** `script/verify`'s own table comment records the first instance: `multicast_dns_protocol` landed
# with milestone 55 carrying three harnesses, was never added to the crate list, and nothing said
# so for three months. Milestone 193 found the second, `jh7110_entropy`, the same way: by counting.
#
# Nothing in the tree could see either one. The `harness-crates` counted claim below is a
# `count-at-least` floor measured against prose, and the shard packer's own partition assertion in
# `script/verify` checks that the shards cover the TABLE, never that the table covers the TREE. Both
# were green throughout.
#
# So this is the missing comparison, and it is the cheap half of the pair: the packer already
# guarantees table -> shards, and this guarantees tree -> table. It runs here rather than in
# `script/verify` on purpose, because a missing row costs nothing to find and 42 minutes to find
# late.
echo "==> every crate with proof harnesses is in the verify table"
python3 - <<'PY'
import json
import os
import re
import subprocess
import sys

# The same package-ownership walk `script/verify --affected-since` does, and for the same reason:
# derived from `cargo metadata` so it cannot drift as the workspace grows.
meta = json.loads(subprocess.run(
    ["cargo", "metadata", "--format-version", "1", "--locked", "--no-deps"],
    capture_output=True, text=True, check=True,
).stdout)
root = meta["workspace_root"]
prefixes = {}
for p in meta["packages"]:
    rel = os.path.relpath(os.path.dirname(p["manifest_path"]), root)
    if rel.startswith(".."):
        continue
    prefixes[p["name"]] = "" if rel == "." else rel + "/"

# Files that hold `#[kani::proof]` and belong to no workspace package. Both of these are deliberate
# and neither is provable: the shim is source rustc compiles by hand for `script/lint`'s own
# harness-clippy pass, and `vendor/redoxfs` is upstream code kept out of the workspace on purpose
# (see the workspace Cargo.toml's own note). A new entry here should be argued for, not added.
EXEMPT = {
    "helpers/kani-lint-shim/kani_attributes.rs",
    "vendor/redoxfs/src/node.rs",
}

files = subprocess.run(
    ["git", "grep", "-lF", "#[kani::proof]", "--", "*.rs"],
    capture_output=True, text=True,
).stdout.split()

carriers, orphans = set(), []
for f in files:
    if f in EXEMPT:
        continue
    owner = None
    for name, prefix in prefixes.items():
        if f.startswith(prefix) and (owner is None or len(prefix) > len(prefixes[owner])):
            owner = name
    if owner is None:
        orphans.append(f)
    else:
        carriers.add(owner)

table = set(re.findall(r"^(\w+)\t\d+\t", open("script/verify").read(), re.M))

missing = sorted(carriers - table)
stale = sorted(table - carriers)
if missing or orphans or stale:
    print("lint: script/verify's crate table and the tree's proof harnesses disagree:", file=sys.stderr)
    for c in missing:
        print(f"  {c} carries #[kani::proof] and is in no shard; NOTHING proves it", file=sys.stderr)
    for f in orphans:
        print(f"  {f} carries #[kani::proof] and belongs to no workspace package", file=sys.stderr)
    for c in stale:
        print(f"  {c} is in the table and carries no harness; the row wastes a runner", file=sys.stderr)
    print("", file=sys.stderr)
    print("Add the row to the CRATES table in script/verify (run the harnesses first: a row added "
          "blind can turn main red on a 42-minute check), or delete a stale one.", file=sys.stderr)
    sys.exit(1)

print(f"verify table: {len(table)} crates, exactly the ones carrying harnesses")
PY

# **A count above two in front of the word "halves"**, which is a claim that cannot be true and is
# therefore checkable without judgement. Found 2026-09-19 by calef, reading a lane's workflow that
# called macOS, Linux and Windows each a "half" of one program; a sweep found four more in the tree
# (a deliverable in "three <halves>", four of them landing over three days, a test pinning "all
# three <halves>", three <halves> that are one claim). The examples are written with the angle
# brackets on purpose: a gate whose own comment spells the forbidden shape fires on itself, which
# design/roadmap/0094-untracked-work.md hit first and script/lint line 660 already records.
#
# The tree has ~3,500 uses of half/halves and nearly all are honest two-way splits, so this reads
# ONLY the arithmetic-impossible shape: a count word immediately before the word. It does not judge
# whether a "half" far from its subject has two siblings, because that needs a reader, and a gate
# that guesses at prose is how script/lint lost three checks. The word this tree uses for one branch
# of a multi-way split is "arm" (components/src/console.rs: "its x86 arm"), and
# design/naming/vocabulary-rulings.md says so under "A half implies two".
#
# `git grep` does not understand `\b` and silently matches nothing (design/naming.md records the
# same trap costing two renames a count), so the boundaries here are POSIX classes.
echo "==> every RETYPE outside the run wrapper passes 0"
# `MemoryRegion::RETYPE`'s first argument became a page count on 2026-09-26 (calef, option A of
# design/roadmap/0659-a-region-retypes-a-frame-run.md), with 0 meaning one page. Every caller
# before it passed 0 and still means one page, so a raw invoke passing anything else is a run asked
# for by accident. The one intended caller is `user_mode_runtime::retype_page_frame_run`.
# The kernel's own tests are exempt: they drive the handler directly with every count on purpose.
if git grep -n 'memory_region::RETYPE,' -- '*.rs' ':!vendor' ':!kernel' \
    | grep -v 'RETYPE, 0, 0, 0)' | grep -v '// run wrapper$'; then
    echo "lint: a RETYPE above passes a count. Ask for a run through" >&2
    echo "      user_mode_runtime::retype_page_frame_run, or pass 0 for one page." >&2
    exit 1
fi
echo "RETYPE: every raw call passes 0, and runs go through one wrapper"

echo "==> halves that are not halves"
if git grep -nEi '(^|[^[:alnum:]_])(three|four|five|six|seven|eight|nine|ten|several|many)[[:space:]]+halves([^[:alnum:]_]|$)' \
    -- '*.md' '*.rs' '*.yml' '*.toml' 'script/*' 'helpers/*' ':!vendor' ':!patches'; then
    echo "lint: a count above two in front of that word. Two things have halves; three have arms," >&2
    echo "      parts or pieces (design/naming.md, \"A half implies two\")." >&2
    exit 1
fi
echo "halves: none counted above two"

# Spelling, over prose AND code. The documentation is part of the deliverable here, so a typo in a
# note is a defect in the product. Configuration and the honest assessment of what this found are in
# _typos.toml.
echo "==> spelling"
if ! command -v typos >/dev/null 2>&1; then
    echo "lint: typos not found; run script/bootstrap (it installs it)." >&2
    exit 1
fi
typos
echo "spelling: clean"

if ! command -v shellcheck >/dev/null 2>&1; then
    echo "lint: shellcheck not found; run script/bootstrap (it installs it)." >&2
    exit 1
fi
cd "$(dirname "$0")/.."
shellcheck --severity=warning script/* helpers/*.sh
# Counted, not remembered. This line read "23 sh scripts" as a literal, so it kept saying 23 after a
# 24th was added -- harmless here because the glob above is what actually checks them, but it is the
# same defect as script/fmt's: a gate reporting a number it did not measure. Anything that looks like
# evidence has to be derived from the thing it describes.
echo "shellcheck: $(ls script/* helpers/*.sh | wc -l | tr -d ' ') sh scripts, no errors or warnings"

# ShellCheck is a static analyzer and knows POSIX from bashisms, but it does not *run* a shell, so it
# cannot catch a shell's own parser being wrong about syntax that is valid. `/bin/sh` on the dev Mac
# is bash 3.2.57 (Apple's last GPLv2 build, frozen since 2007), and it has a real bug: a single
# apostrophe on one line of script/verify's CRATES table, deep inside a `<<'TABLE'` heredoc whose
# delimiter is quoted (meaning POSIX says the body is fully literal, no exceptions), was enough to
# make bash 3.2 report "unexpected EOF looking for matching `)'" for the *whole file* -- confirmed by
# bisection, and confirmed that removing the one apostrophe fixed it with everything else unchanged.
# `sh -n` (parse only, nothing runs) is cheap and catches exactly this: a file that dash, zsh, and
# ShellCheck all call clean but the dev machine's own interpreter cannot even parse. Ubuntu CI's
# `/bin/sh` is dash and will not reproduce this defect, which is fine: the gate's job here is to fire
# on the machine that has the bug, not to prove the bug exists everywhere.
echo "==> sh -n (does the dev machine's own /bin/sh parse every script)"
shfail=""
for f in script/* helpers/*.sh; do
    [ -f "$f" ] || continue
    head -n1 "$f" | grep -q '^#!.*\bsh\b' || continue
    if ! /bin/sh -n "$f" 2>/tmp/lint-sh-n.$$; then
        echo "lint: /bin/sh cannot parse $f:" >&2
        sed 's/^/  /' /tmp/lint-sh-n.$$ >&2
        shfail=1
    fi
    rm -f /tmp/lint-sh-n.$$
done
if [ -n "$shfail" ]; then
    exit 1
fi
echo "sh -n: every #!/bin/sh script parses under this machine's own /bin/sh"

# script/verify passes extra arguments through to `cargo kani` (found 2026-10-05). It once ended its
# option parsing with `set -- -j ... --output-format=terse`, which overwrote "$@" and dropped
# `--harness <name>`, so `script/verify-riscv64 --harness X` proved the whole row and said nothing.
# Run it against a stub `cargo` that records its arguments; no Kani is involved, so this costs a
# second. script/verify-riscv64 adds no argument handling of its own: it forwards "$@" here.
echo "==> script/verify passes extra arguments through to cargo kani"
vstub="$(mktemp -d)"
cat >"$vstub/cargo" <<'STUB'
#!/bin/sh
# Stub: `cargo kani --version` succeeds; any other call is recorded.
[ "$1" = kani ] && [ "$2" = "--version" ] && exit 0
printf '%s\n' "$*" >>"$VERIFY_STUB_LOG"
STUB
chmod +x "$vstub/cargo"
VERIFY_STUB_LOG="$vstub/log" PATH="$vstub:$PATH" script/verify --only capability --harness lint_probe_harness >/dev/null 2>&1 || true
if ! grep -q '^kani -p capability .*--harness lint_probe_harness' "$vstub/log" 2>/dev/null; then
    echo "lint: script/verify --only capability --harness X did not hand --harness X to cargo kani:" >&2
    sed 's/^/  /' "$vstub/log" >&2 2>/dev/null || echo "  (stub cargo was never called)" >&2
    rm -rf "$vstub"
    exit 1
fi
rm -rf "$vstub"
echo "script/verify: extra arguments reach cargo kani"
