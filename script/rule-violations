#!/bin/sh
#
# The violation ledger: total the strikes against each documented rule, and say which have crossed
# three (milestone 118).
#
# AGENTS.md's own "Nobody remembers, so build the mechanism that does not need them to" section names
# the failure this closes: a rule stated in prose (rung four of that section's ladder) but violated
# anyway has demonstrated it is on the wrong rung, and "A rule that is violated repeatedly is not
# stated too quietly. It is on the wrong rung" is milestone 118's own line. Nothing before this script
# totaled how many times that had actually happened; the evidence sat in AGENTS.md's own scar
# paragraphs (the pkill incidents, the reset --hard clobbers) and in lane reports, uncounted.
#
# It cannot see a violation happen. It totals what a table in notes/rule-violations.md says somebody
# reported, honestly, the same way script/audits cannot run an audit and can only say one is due.
#
#   script/rule-violations           report: every rule, its open strikes, and its status
#   script/rule-violations --check   fail (non-zero) if any OPEN rule has reached three strikes
#
# A `local` row of script/ci-build, and a step of the `lint` job in CI (milestone 341 (give the three
# instruments nothing runs a caller), §174 (a caller for each of the three uncalled instruments),
# ruled 2026-10-27 UTC). It takes 0.07 seconds. It is not part of script/lint itself.
#
# Name: provisional. Minted by milestone 118's lane on 2026-08-22. Named for what it reads, in the
# family of `script/roadmap`, `script/decisions` and `script/names`, none of which are verbs
# either, and DECISIONS §134 has since written that family rule down. What is unsigned is the stem
# rather than the form. `rule-violations` names the exceptions rather than the rules, which is
# deliberate, since the rules live in AGENTS.md and design/decisions/ and this reports only where the
# tree departs from them; the alternative reading, that it reports on rules, is the misreading to
# weigh against. no architect has ratified it.

set -e

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

exec python3 - "$ROOT" "${1:-}" <<'PY'
import re
import sys

root, mode = sys.argv[1], sys.argv[2]

STRIKE_THRESHOLD = 3

LEDGER = f"{root}/notes/rule-violations.md"

# The table lives under "## The convention" in notes/rule-violations.md, between the header row and
# the next blank line. Five columns, pipe-delimited, the header and separator rows skipped by shape
# (the separator is all dashes and pipes; the header's first cell is literally "date").
ROW = re.compile(
    r"^\|\s*(\d{4}-\d{2}-\d{2})\s*\|\s*(.+?)\s*\|\s*(\d+)\s*\|\s*(open|escalated|resolved)\s*\|"
    r"\s*(.+?)\s*\|\s*$"
)

rows = []
text = open(LEDGER, errors="replace").read()
fenced = False
for line in text.split("\n"):
    # Skip fenced code blocks: notes/rule-violations.md's own EXAMPLES section shows a row inside a
    # ```markdown fence, which is the convention being demonstrated, not a claim about the tree. The
    # same carve-out script/citations and the counted-claims registry make for their own examples.
    if line.lstrip().startswith("```"):
        fenced = not fenced
        continue
    if fenced:
        continue
    m = ROW.match(line)
    if not m:
        continue
    date, rule, instances, status, source = m.groups()
    rows.append({
        "date": date, "rule": rule, "instances": int(instances), "status": status,
        "source": source,
    })

if not rows:
    print(f"rule-violations: no rows parsed from {LEDGER}; has its table shape changed?",
          file=sys.stderr)
    sys.exit(1)

# Group by rule text (see notes/rule-violations.md's BUGS: exact text, not meaning). A rule's total
# is the sum of its OPEN rows only; an escalated or resolved row stops counting toward a strike, on
# purpose, because a rule that already moved up the ladder should not keep failing --check.
by_rule = {}
for r in rows:
    entry = by_rule.setdefault(r["rule"], {"open": 0, "dates": [], "all_status": set()})
    entry["all_status"].add(r["status"])
    if r["status"] == "open":
        entry["open"] += r["instances"]
        entry["dates"].extend([r["date"]] * r["instances"])

total_rows = len(rows)
total_open = sum(v["open"] for v in by_rule.values())
struck = {rule: v for rule, v in by_rule.items() if v["open"] >= STRIKE_THRESHOLD}

if mode == "--check":
    if struck:
        for rule, v in sorted(struck.items(), key=lambda kv: -kv[1]["open"]):
            dates = ", ".join(v["dates"])
            print(f"rule-violations: {rule!s} has {v['open']} open strikes ({dates}; "
                  f"see notes/rule-violations.md), which is the promotion threshold "
                  f"({STRIKE_THRESHOLD}).", file=sys.stderr)
            print("  Move it up the ladder (a mechanism, in AGENTS.md's ladder sense) or mark its "
                  "row `resolved` as unenforceable in notes/rule-violations.md; either is an "
                  "architect's or the integrator's call, never a lane's.", file=sys.stderr)
        sys.exit(1)
    print(f"rule violations: {total_rows} rows, {total_open} open instances across "
          f"{len(by_rule)} rules, none past {STRIKE_THRESHOLD} strikes")
    sys.exit(0)

if mode:
    print(f"rule-violations: unknown argument {mode!r} (no argument, or --check)", file=sys.stderr)
    sys.exit(2)

print(f"rule violations: {total_rows} rows, {total_open} open instances across {len(by_rule)} rules")
for rule, v in sorted(by_rule.items(), key=lambda kv: -kv[1]["open"]):
    label = "strike" if v["open"] == 1 else "strikes"
    flag = " (at threshold)" if v["open"] >= STRIKE_THRESHOLD else ""
    status = ", ".join(sorted(v["all_status"]))
    print(f"  {v['open']:>2} {label:<8}{flag:<16} [{status:<9}] {rule}")
PY
