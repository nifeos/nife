Falsifies `file_system_contract::proofs::an_attribute_reply_is_never_an_error`.

The defect: `extended_attribute::reply` shifts the kind one bit too far, so a large kind sets the sign bit and the reply reads as an errno.

Expected to fail: `assert!(r0 >= 0)` for a kind with bit 30 set, and the kind round trip.

diff --git a/crates/file_system_contract/src/extended_attribute.rs b/crates/file_system_contract/src/extended_attribute.rs
--- a/crates/file_system_contract/src/extended_attribute.rs
+++ b/crates/file_system_contract/src/extended_attribute.rs
@@ -127,7 +127,7 @@
 /// what the store read, never reaches the panic.
 pub const fn reply(kind: u32, value_len: usize) -> i64 {
     assert!(kind <= MAXIMUM_KIND && value_len <= u32::MAX as usize);
-    ((kind as i64) << 32) | value_len as i64
+    ((kind as i64) << 33) | value_len as i64
 }
 /// The kind of a [`file_system::GETXATTR`] reply. Only meaningful when the reply is non-negative.
 pub const fn reply_kind(r0: i64) -> u32 {
