Falsifies `glob::verification::no_magic_means_the_pattern_is_its_own_only_match`.

The defect: `literal` copies the pattern byte at the escape rather than the byte the escape names, so `\*`
comes out as a backslash while the matcher still treats it as `*`.

Expected to fail: the harness's `assert_eq!(matches_with(p, n, Dot::Ordinary), n == lit)`.

diff --git a/crates/byte_glob/src/lib.rs b/crates/byte_glob/src/lib.rs
--- a/crates/byte_glob/src/lib.rs
+++ b/crates/byte_glob/src/lib.rs
@@ -134,7 +134,8 @@ pub fn literal<'a>(pattern: &[u8], out: &'a mut [u8]) -> Option<&'a [u8]> {
     while let Some((elem, _)) = decode(pattern, j, 0) {
         match elem {
             Element::Byte { byte, next } => {
-                *out.get_mut(n)? = byte;
+                let _ = byte;
+                *out.get_mut(n)? = pattern[j];
                 n += 1;
                 j = next;
             }
