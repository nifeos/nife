Falsifies `file_allocation_table::long_name::verification::every_alias_is_a_legal_short_name`.

The defect: the base is allowed one byte too many, so the tail starts at the eighth byte and spills its last digit into the extension.

Expected to fail: the harness's `assert!((1..=6).contains(&tilde))`.

diff --git a/crates/file_allocation_table/src/long_name.rs b/crates/file_allocation_table/src/long_name.rs
--- a/crates/file_allocation_table/src/long_name.rs
+++ b/crates/file_allocation_table/src/long_name.rs
@@ -144,7 +144,7 @@ impl LongName {
         }
         let tail_len = digits + 1;
         let mut out = [b' '; 11];
-        let base_len = fold(base, &mut out[..(8 - tail_len).min(6)]);
+        let base_len = fold(base, &mut out[..9 - tail_len]);
         if base_len == 0 {
             return None;
         }
