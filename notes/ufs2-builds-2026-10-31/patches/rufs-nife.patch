diff -rN -U0 -x target -x Cargo.lock rufs/src/errno.rs ../pb/rufs/src/errno.rs
--- rufs/src/errno.rs
+++ rufs/src/errno.rs
@@ -0,0 +1,39 @@
+//! The errno values rufs reports, by name. On a unix host they are the host's own, so a FUSE
+//! driver hands them to the kernel unchanged. Elsewhere (nife's std, whose `os` is "nife" and
+//! where libc defines none) they are Linux's numbers; a caller there maps them by name.
+
+#[cfg(unix)]
+pub use libc::{EEXIST, EFAULT, EINVAL, EIO, ENOENT, ENOSPC, ENOTDIR, ENOTEMPTY, EROFS};
+
+#[cfg(any(target_os = "freebsd", target_os = "openbsd", target_os = "macos"))]
+pub const ENOATTR: i32 = libc::ENOATTR;
+#[cfg(target_os = "linux")]
+pub const ENOATTR: i32 = libc::ENODATA;
+
+#[cfg(not(unix))]
+mod portable {
+	pub const EIO: i32 = 5;
+	pub const EFAULT: i32 = 14;
+	pub const EEXIST: i32 = 17;
+	pub const ENOTDIR: i32 = 20;
+	pub const EINVAL: i32 = 22;
+	pub const ENOSPC: i32 = 28;
+	pub const EROFS: i32 = 30;
+	pub const ENOTEMPTY: i32 = 39;
+	pub const ENOENT: i32 = 2;
+	pub const ENOATTR: i32 = 61;
+}
+#[cfg(not(unix))]
+pub use portable::*;
+
+/// The preferred I/O size of an open file: the host's `st_blksize` on unix, 4096 elsewhere.
+#[cfg(unix)]
+pub fn blksize(m: &std::fs::Metadata) -> usize {
+	use std::os::unix::fs::MetadataExt;
+	m.blksize() as usize
+}
+
+#[cfg(not(unix))]
+pub fn blksize(_: &std::fs::Metadata) -> usize {
+	4096
+}
