echo "==> markdown links and the notes index"
# Two checks, and deliberately NOT a markdown linter. A survey of all 95 markdown files found zero
# broken relative links and exactly one unindexed note, so generic style rules (heading case, line
# length, list markers) would fire constantly on prose that is deliberate and catch nothing. These
# two are the parts that rot silently:
#
# 1. Relative links must resolve. Currently clean, so this is a REGRESSION GUARD: milestone 46 moved
#    five things and could easily have broken a link, and the next rename might.
# 2. Every notes/*.md must appear in notes/README.md or an area page under notes/README/, which
#    CLAUDE.md requires and which had already drifted (notes/session-handoff.md).
#
# Backticked repo paths are still deliberately NOT checked, but **the measurement that justified it
# has rotted and the conclusion is weaker than it was.** Re-measured by milestone 93's first
# documentation sweep, 2026-08-16: 31 distinct unresolvable backticked paths over 379 markdown files,
# where this comment used to say 8 over 95 and "a checker there is 100% false positives".
#
# It is no longer 100%. Most are still deliberate history (`crates/linedisc` preserved in DECISIONS
# §39; `crates/heap`/`crates/slab`/`kernel/src/heap.rs` accurate prose about what milestone 14
# removed; every old spelling inside design/roadmap/73 and /63, which are the blocks *about* renaming
# those files; `script/sanitize` and `script/brief`, which are names milestone 115 rejected). But the
# sweep found six that were simply wrong and fixed them: `user/src/suptree.rs`, `user/src/virtio.rs`
# and `script/stack-frames` had all been renamed out from under their notes.
#
# The reason it stays ungated is now the false-positive *rate* rather than a claim of perfection, and
# separating deliberate history from rot needs a reader. That reader is the documentation sweep
# (notes/documentation-audit.md), and `script/audits --worklist` ranks which document to hand them.
python3 - <<'PY'
import glob, os, re, sys

md = [f for f in glob.glob('**/*.md', recursive=True)
      if not f.startswith(('vendor/', 'target/', '.claude/', 'patches/'))]

bad = []
for f in md:
    base = os.path.dirname(f)
    for m in re.finditer(r'\[[^\]]*\]\(([^)]+)\)', open(f, errors='replace').read()):
        target = m.group(1).split('#')[0].strip()
        if not target or target.startswith(('http://', 'https://', 'mailto:')):
            continue
        if not os.path.exists(os.path.normpath(os.path.join(base, target))):
            bad.append(f'{f} -> {target}')

# The index is notes/README.md plus its area pages under notes/README/, which is where its lines
# moved when it reached §212's 3,000-word cap on 2026-09-26 (UTC). A note's line may be on either.
index_pages = ['notes/README.md'] + sorted(glob.glob('notes/README/*.md'))
index = ''.join(open(p, errors='replace').read() for p in index_pages)
notes = sorted(glob.glob('notes/*.md'))
if not md or not notes:
    sys.exit('lint: the markdown sweep selected nothing (no **/*.md, or no notes/*.md), so the '
             'link and index checks judged nothing. See milestone 401.')
missing = [n for n in notes
           if os.path.basename(n) != 'README.md' and os.path.basename(n) not in index]

if bad:
    print('lint: broken relative markdown links:', file=sys.stderr)
    for b in bad:
        print(f'  {b}', file=sys.stderr)
if missing:
    print('lint: notes/ files missing from notes/README.md and its area pages in notes/README/:',
          file=sys.stderr)
    for m in missing:
        print(f'  {m}', file=sys.stderr)
    print('Every note is indexed there (CLAUDE.md); an unindexed note is one nobody finds.',
          file=sys.stderr)
    print('Add a line to the notes/README/<area>.md page that fits; notes/README.md says how.',
          file=sys.stderr)
if bad or missing:
    sys.exit(1)
print(f'markdown: {len(md)} files, every relative link resolves, every note indexed')
