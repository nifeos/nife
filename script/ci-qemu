#!/bin/sh
# script/ci-qemu: make the QEMU this project runs exactly the version `.qemu-version` pins, building
# it into a cacheable prefix when it is not, and fail with the reason when that cannot be done.
#
# **The one place that checks QEMU**, §322 (the QEMU bootstrap is the one QEMU check).
# `script/bootstrap` neither checks for QEMU nor installs it. Every route to an emulator goes
# through this script: `script/setup`, `script/update` and `script/ci-build`'s no-argument path call
# it after `script/bootstrap`, every CI job that boots a kernel runs it as a step of its own, and a
# developer can run it by hand at any time. The `ci-` in the name is older than that; this script is
# for every machine, not only CI's.
#
# What it accepts, and nothing less:
#
#   1. All three emulators the suite boots are on PATH: qemu-system-aarch64, qemu-system-riscv64 and
#      qemu-system-x86_64 (milestone 161 added the third).
#   2. **Each of them is exactly the pinned version.** An emulator version is part of what "the tests
#      passed" means, and the benchmarks are icount instruction counts that a different QEMU can
#      move. Each binary is checked, because a PATH can mix two installations.
#   3. The devices whose absence would gut a test rather than fail it are present:
#      `riscv-iommu-pci` on riscv64 (milestone 16b, the RISC-V IOMMU, §20) and the `virt` machine on
#      aarch64. Dropping the IOMMU device when QEMU lacks it is refused on purpose: the confinement
#      tests would pass while testing nothing, and a test that quietly stops testing is worse than a
#      red build.
#
# When the QEMU on PATH (the prefix's, once `helpers/qemu-path.sh` has put it there) passes, this
# exits 0 at once, which is what makes it cheap to call unconditionally. When it does not, this
# builds `.qemu-version`'s release from source into `$QEMU_PREFIX` (default
# `$HOME/.cache/nife-qemu`), on Linux and on macOS alike. A package manager is never the remedy: no
# Ubuntu release before 26.04 ships a QEMU with `riscv-iommu-pci` (24.04's 8.2.2 dies with "not a
# valid device model name"), `apt-get` already fetches the newest package for a release, and
# Homebrew installs whatever is current rather than the pin.
#
# **The build counts only once it is on PATH.** A build that lands in the prefix while a stale
# `/usr/bin` QEMU stays first on PATH is a loop: the next check finds the old emulator again, names
# the same remedy, and the remedy builds the same thing. `helpers/qemu-path.sh` closes it. This
# script sources it again after the build and judges the result through PATH, and every `script/`
# entry point that can reach an emulator sources it too (`script/lint` checks that), so the build is
# what they all run.
#
# Name: recorded (AGENTS.md's naming table, which makes `script/` entry points hyphenated, and the
# sibling `ci-build` this was formed against). Introduced 2026-07-30. Both halves are standard
# terms a reader brings with them, and the `ci-` prefix says which machine is meant to run it,
# which is the distinction that matters at a glance beside `script/test`. The hyphen was this
# directory's practice before milestone 63 made it a rule on 2026-08-01, and this script is part
# of what that rule was describing. no architect has ratified it.

set -e

# `sudo` only when not already root: a container often runs as root with no `sudo` binary at all,
# which is the cloud-session case (notes/working-from-a-cloud-session.md).
if [ "$(id -u)" -eq 0 ]; then SUDO=; else SUDO=sudo; fi
cd "$(dirname "$0")/.."

want="$(tr -d ' \n' < .qemu-version)"
prefix="${QEMU_PREFIX:-$HOME/.cache/nife-qemu}"
os="$(uname -s)"

# The prefix's QEMU is dynamically linked against libslirp, and actions/cache restores only
# `$prefix`, never apt state. A fresh runner therefore has the cached binary but not the shared
# object it needs to print `--version`, and without this every warm cache would read as broken and
# rebuild. So when a cached binary is present and cannot run, install the runtime package (not
# `-dev`) first. A fresh container ships empty package lists (a Claude cloud runner does; GitHub's
# images do not), where `apt-get install` fails with "Unable to locate package" before fetching
# anything: update once and retry only on that failure. A machine whose cached binary runs is never
# asked for sudo here. The package lists live in helpers/apt-packages.txt, which the owned image
# probe also reads.
if [ "$os" = Linux ] && [ -x "$prefix/bin/qemu-system-aarch64" ] \
    && ! "$prefix/bin/qemu-system-aarch64" --version >/dev/null 2>&1; then
    echo "==> QEMU at $prefix cannot run; installing its runtime libraries"
    # shellcheck disable=SC2046 # package names hold no whitespace
    $SUDO apt-get install -y $(helpers/apt-packages.sh qemu-runtime) >/dev/null 2>&1 || {
        $SUDO apt-get update >/dev/null
        # shellcheck disable=SC2046
        $SUDO apt-get install -y $(helpers/apt-packages.sh qemu-runtime) >/dev/null
    }
fi

# This project's own QEMU, when the prefix holds the pinned version (helpers/qemu-path.sh says why
# PATH is the mechanism, and why a prefix at another version is left off).
. helpers/qemu-path.sh

# The verdict is `script/qemu-check`'s: one line per problem on stderr, nothing on success. It
# sources helpers/qemu-path.sh itself, so it judges the QEMU every caller will run. This script
# keeps only the remedy.
if problems="$(script/qemu-check 2>&1 >/dev/null)"; then
    echo "==> QEMU $want on PATH ($(command -v qemu-system-aarch64)), with every required device"
    exit 0
fi

echo "==> The QEMU on PATH is not the one .qemu-version pins:"
echo "$problems" | sed 's/^qemu-check: /      /'

# The build dependencies, from the platform's package manager. libslirp is not optional: the network
# tests use QEMU's user-mode networking (-netdev user), including the guestfwd echo peer and the
# TFTP fixture the UDP gate reads.
case "$os" in
Linux)
    $SUDO apt-get update
    # shellcheck disable=SC2046
    $SUDO apt-get install -y $(helpers/apt-packages.sh qemu-build)
    ;;
Darwin)
    if ! command -v brew >/dev/null 2>&1; then
        echo "ci-qemu: building QEMU on macOS needs Homebrew for its build dependencies;" >&2
        echo "  install it from https://brew.sh, then re-run script/ci-qemu." >&2
        exit 1
    fi
    brew install ninja meson pkg-config glib pixman libslirp python
    ;;
*)
    echo "ci-qemu: no build recipe for '$os'. Put QEMU $want, with qemu-system-aarch64," >&2
    echo "  qemu-system-riscv64 and qemu-system-x86_64, first on PATH, then re-run script/ci-qemu." >&2
    exit 1
    ;;
esac

# Say what this is about to cost before it costs it: a provisioning step that silently turns into a
# source build of several minutes is a surprise of its own.
echo
echo "==> Building QEMU $want from source into $prefix."
echo "    THIS TAKES ABOUT 5 TO 12 MINUTES the first time; it is kept afterwards, and"
echo "    script/ci-qemu then finishes in under a second."
echo

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

curl -fsSL "https://download.qemu.org/qemu-$want.tar.xz" -o "$work/qemu.tar.xz"
tar -xJf "$work/qemu.tar.xz" -C "$work"

# A subshell, so the build directory never becomes this script's working directory: everything after
# it still runs from the repository root.
(
    cd "$work/qemu-$want"
    # Only the three system emulators this project boots. Building all of QEMU would multiply the
    # cold-cache cost for targets nothing here runs. Docs and the GUI front ends are off for the same
    # reason; slirp is ON because the net tests depend on it. `make install` also puts QEMU's own
    # edk2 firmware under `$prefix/share/qemu`, where helpers/qemu-uefi-x86_64.sh looks first.
    # On macOS three flags more (notes/qemu.md, BUGS): `hw/display/apple-gfx.m` does not link on the
    # SDK without the Cocoa display and the paravirtualized graphics device off, and the suite runs
    # headless anyway; and configure stops in `mkvenv` under Apple's python3 (3.9), so Homebrew's
    # is named.
    macos_flags=
    if [ "$os" = Darwin ]; then
        macos_flags="--python=$(brew --prefix python)/libexec/bin/python3 --disable-cocoa --disable-pvg"
    fi
    # shellcheck disable=SC2086 # macos_flags is a list of whitespace-free words, or nothing
    ./configure $macos_flags \
        --prefix="$prefix" \
        --target-list=aarch64-softmmu,riscv64-softmmu,x86_64-softmmu \
        --enable-slirp \
        --disable-docs \
        --disable-gtk \
        --disable-sdl \
        --disable-vnc \
        --disable-werror
    make -j"$(getconf _NPROCESSORS_ONLN)"
    make install
)

echo "==> QEMU $want installed at $prefix"

# Judge the build through PATH, the way every caller will meet it, and not through the prefix's path
# directly: this is what keeps a build from being followed by the old emulator again.
. helpers/qemu-path.sh
if ! problems="$(script/qemu-check 2>&1 >/dev/null)"; then
    echo >&2
    echo "ci-qemu: QEMU $want was built at $prefix, and the QEMU on PATH is still not usable:" >&2
    echo "$problems" | sed 's/^qemu-check: /    /' >&2
    echo "  If a device is missing from the build itself, .qemu-version pins a release too old for" >&2
    echo "  this tree; raise the pin. If the version is wrong, something on PATH shadows" >&2
    echo "  $prefix/bin; helpers/qemu-path.sh says how that directory is put first." >&2
    exit 1
fi

echo "==> QEMU $want on PATH ($(command -v qemu-system-aarch64)), with every required device"
echo "    Every script/ entry point puts $prefix/bin first on PATH. To run QEMU by hand,"
echo "    export PATH=\"$prefix/bin:\$PATH\"."
