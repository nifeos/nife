Falsifies `jh7110_pci_express::verification::bus_numbers_forward_bus_one_only`.

The defect: the subordinate bus number stays 0, below the secondary, so the root port forwards no
configuration request to bus 1 and the drive behind it never answers.

Expected to fail: the harness's assertion that the subordinate byte reads `SECONDARY_BUS`.

diff --git a/crates/jh7110_pci_express/src/root_port.rs b/crates/jh7110_pci_express/src/root_port.rs
index fc0948551..5e8e6ef2a 100644
--- a/crates/jh7110_pci_express/src/root_port.rs
+++ b/crates/jh7110_pci_express/src/root_port.rs
@@ -83,7 +83,7 @@ pub const fn memory_base_and_limit(window: Window) -> Option<u32> {
 /// Name: provisional, minted 2026-11-19 (UTC) by lane milestone/163-jh7110-pcie-root-complex.
 #[must_use]
 pub const fn bus_numbers(before: u32) -> u32 {
-    (before & 0xff00_0000) | ((SECONDARY_BUS as u32) << 16) | ((SECONDARY_BUS as u32) << 8)
+    (before & 0xff00_0000) | ((SECONDARY_BUS as u32) << 8)
 }
 
