Falsifies `file_system_contract::proofs::a_file_request_round_trips`.

The defect: `file_system::request` shifts the handle one bit too far, so the handle bleeds out of its field.

Expected to fail: `assert!(file_system::request_handle(w0) == handle)`, for any non-zero handle.

diff --git a/crates/file_system_contract/src/file_system.rs b/crates/file_system_contract/src/file_system.rs
--- a/crates/file_system_contract/src/file_system.rs
+++ b/crates/file_system_contract/src/file_system.rs
@@ -356,7 +356,7 @@ pub const MAXIMUM_HANDLE: u64 = 0xffff;
 /// Name: provisional, minted 2026-11-21 (UTC) by the request-names lane of milestone 1090 (an outside review of `file_system_contract`).
 pub const fn request(operation: u64, handle: u64, len: u64) -> u64 {
     (operation << super::OPERATION_SHIFT)
-        | ((handle & MAXIMUM_HANDLE) << 40)
+        | ((handle & MAXIMUM_HANDLE) << 41)
         | (len & MAXIMUM_LENGTH_BYTES)
 }
 /// The handle of a file request word.
