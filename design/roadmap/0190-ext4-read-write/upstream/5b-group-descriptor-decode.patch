+        self.modify(group_idx, |desc| {
             desc.bg_used_dirs_count_lo = (count & 0xFFFF) as u16;
             desc.bg_used_dirs_count_hi = ((count >> 16) & 0xFFFF) as u16;
-            true
-        } else {
-            false
