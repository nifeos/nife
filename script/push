#!/bin/sh
#
# Push the current branch to origin, then confirm origin holds it, and fail loudly when it does not.
#
#     script/push
#     script/push --set-upstream
#     script/push --requeue
#
# Pushes HEAD to the branch of the same name on origin. Arguments go to `git push` as options; a
# refspec is not accepted, because the confirmation reads back exactly one branch.
#
# `--requeue` is for a branch whose pull request is in the merge queue or has auto-merge on. It
# dequeues the pull request, pushes, and, only once origin holds HEAD, arms it again through
# helpers/arm.sh, which refuses a pull request carrying `needs-architect`, `held-by-lane` or
# `held-for-red-trunk` and exits 1 unless GitHub then shows it queued or armed. A pull request that
# was not armed before the push stays unarmed. Without the flag the pre-push hook keeps refusing a
# push to a queued branch (helpers/push-queued-check.sh). The two halves are
# helpers/push-requeue.sh (COE action 7, notes/coes/2026-11-03-merge-queue-backlog.md). The last line it
# prints is the verdict, so `script/push | tail -n 3` still shows whether the commit landed.
#
# # Why this exists
#
# git opens the connection to the remote, reads the remote's refs, and only then runs `pre-push`.
# The connection sits idle for as long as the hook takes. GitHub closes an idle push connection
# somewhere between 300 and 480 s (measured 2026-10-20 UTC with a hook that only slept: 300 s
# landed, 480 s did not). The gates pass, then git prints `Connection to github.com closed by remote
# host.` and exits 141, killed by SIGPIPE writing the update to a closed socket, and the branch has
# not moved. A lane piping the push through `tail` read tail's 0 and believed it (#2478).
#
# Three things here, each for one part of that:
#
# - **The hook runs first, before git connects.** This script runs the pre-push hook itself, the
#   same file git would run (`git rev-parse --git-path hooks/pre-push`), with the ref line git would
#   give it. A failure stops here with the hook's own message and no connection opened. A pass
#   leaves helpers/pre-push-lint-cache.sh's marker for this tree, so when git runs the hook again
#   inside the push, `script/lint --no-cargo` is skipped and the connection waits only for the
#   rest of the hook (`script/fmt --check`, the marker's key and, on a fleet clone, the fleet half).
#   The hook is still the one list of what is checked, and `git push` still runs all of it. With
#   `--no-verify` among the options git skips the hook, and so does this.
# - **ssh keepalives** (`ServerAliveInterval=30`), so the connection is not idle while the hook
#   runs. A 480 s hook landed with them. They are not enough alone: a hook of several minutes on a
#   loaded machine has still lost the connection with them on, which is why the hook now runs
#   first. They are added only when neither GIT_SSH_COMMAND, GIT_SSH nor core.sshCommand is set, so
#   a person's own ssh setup is never overridden.
# - **The read-back.** After the push, `git ls-remote` asks origin where the branch is, and anything
#   but HEAD's commit is exit 1 with the reason. This does not trust git's exit status, so it holds
#   for a failure that exits 0 and for a caller that loses the status in a pipe.
#
# BUGS
#
# - Nothing makes a lane use this rather than `git push`; notes/skills/worktree-commits/SKILL.md says
#   to. The hook cannot do it: it runs before the update is sent and cannot see whether it arrived.
# - On a fleet clone the hook inside the push still runs helpers/pre-push-fleet.sh, and its
#   `script/lint-fleet` (about 40 s) is the longest part of the connected wait, because the lint
#   marker does not cover it: it reads the branch name, and its selftests were never audited for
#   other inputs. Covering it means keying a marker on the branch as well as the tree.
#
# Name: provisional. git's own verb for the act; considered `push-confirmed`, which says less than
# the header does. calef has not ruled on it. See notes/scripts.md.

set -u

requeue=
for arg in "$@"; do
    shift
    if [ "$arg" = "--requeue" ]; then requeue=1; else set -- "$@" "$arg"; fi
done

branch="$(git symbolic-ref --quiet --short HEAD)" || {
    echo "push: HEAD is detached; check out the lane's branch first." >&2
    exit 2
}
for arg in "$@"; do
    case "$arg" in
    -*) ;;
    *)
        echo "push: '$arg' is not an option; script/push always pushes HEAD to origin/$branch." >&2
        exit 2
        ;;
    esac
done

head="$(git rev-parse HEAD)"
short="$(git rev-parse --short=12 HEAD)"

# The hook, before the connection. It runs ahead of --requeue's dequeue, so a failing check leaves
# the pull request in the queue; the queued-branch refusal is waived for this run only, because the
# dequeue has not happened yet, and the hook inside the push asks it again after the dequeue. The
# remote sha comes from origin, as git's own would, so the hook's empty-push and rewrite checks
# judge the same range; when origin cannot be asked it is the all-zero sha of a new branch, and the
# hook inside the push judges the real one.
verify=1
for arg in "$@"; do
    [ "$arg" != "--no-verify" ] || verify=
done
hook="$(git rev-parse --git-path hooks/pre-push)"
if [ -n "$verify" ] && [ -x "$hook" ]; then
    zero=0000000000000000000000000000000000000000
    remote_before="$(git ls-remote origin "refs/heads/$branch" 2>/dev/null)" || remote_before=
    remote_before="${remote_before%%	*}"
    url="$(git remote get-url --push origin 2>/dev/null)" || url=origin
    echo "push: running the pre-push hook before connecting to origin."
    if ! printf 'refs/heads/%s %s refs/heads/%s %s\n' "$branch" "$head" "$branch" "${remote_before:-$zero}" |
        NIFE_PUSH_QUEUED="${requeue:+1}${NIFE_PUSH_QUEUED:-}" "$hook" origin "$url"; then
        echo "push: NOT PUSHED. The pre-push hook refused, before any connection to origin." >&2
        exit 1
    fi
fi

requeue_number=
if [ -n "$requeue" ]; then
    requeue_dir="$(CDPATH='' cd -- "$(dirname -- "$0")/../helpers" && pwd)"
    requeue_state="$("$requeue_dir/push-requeue.sh" before "$branch")" || exit 1
    case "$requeue_state" in
    "none 0") echo "push: --requeue: $branch has no open pull request, so there is nothing to re-arm." ;;
    *" 0") echo "push: --requeue: #${requeue_state% *} was not armed, so it stays unarmed." ;;
    *) requeue_number="${requeue_state% *}" ;;
    esac
fi

if [ -z "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && ! git config core.sshCommand >/dev/null 2>&1; then
    GIT_SSH_COMMAND="ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=10"
    export GIT_SSH_COMMAND
fi

git push "$@" origin "HEAD:refs/heads/$branch"
status=$?

if ! remote="$(git ls-remote --exit-code origin "refs/heads/$branch")"; then
    remote=
fi
remote="${remote%%	*}"

if [ "$remote" = "$head" ]; then
    if [ "$status" -ne 0 ]; then
        echo "push: git push exited $status, but origin/$branch is at $short, HEAD's commit." >&2
        [ -z "$requeue_number" ] || echo "push: --requeue: #$requeue_number is NOT re-armed; run helpers/arm.sh $requeue_number." >&2
        exit "$status"
    fi
    echo "push: origin/$branch is at $short, HEAD's commit."
    if [ -n "$requeue_number" ]; then
        "$requeue_dir/push-requeue.sh" after "$requeue_number" || {
            echo "push: --requeue: the push landed but #$requeue_number is NOT re-armed." >&2
            exit 1
        }
    fi
    # Tell a lane, before it arms, that its ready pull request conflicts with the merge queue.
    # Advisory: it never changes this script's exit. NIFE_SKIP_QUEUE_CHECK=1 skips it.
    # script/queue-conflicts says more.
    [ "${NIFE_SKIP_QUEUE_CHECK:-}" = 1 ] || "$(dirname "$0")/queue-conflicts" --advisory || true
    exit 0
fi

echo "" >&2
if [ -n "$requeue_number" ]; then
    echo "push: --requeue: #$requeue_number was dequeued and is NOT armed; arm it with helpers/arm.sh $requeue_number once the push lands." >&2
fi
echo "push: NOT PUSHED. origin/$branch is at ${remote:-nothing (no such branch)}, not HEAD's $head." >&2
if [ "$status" -eq 0 ]; then
    echo "push: git push exited 0 anyway; the read-back is what to believe." >&2
else
    echo "push: git push exited $status. If the hook's checks passed and git's last line was" >&2
    echo "push: 'Connection to github.com closed by remote host', the hook outlasted the connection; run script/push again." >&2
fi
exit 1
