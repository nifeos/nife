--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,9 @@
+# cricker-os pin divergence: an empty [workspace] table marks this vendored crate as its own
+# workspace root, so the outer cricker-os workspace treats it as an external path dependency, not a
+# member. That is what keeps our `-D warnings` clippy gate and our `cargo fmt` gate off code we do
+# not own, while it still builds normally as redoxfs_host's dependency. See vendor/README.md.
+[workspace]
+
 [package]
 name = "redoxfs"
 description = "The Redox Filesystem"
@@ -88,11 +94,15 @@
 fuser = { version = "0.16", optional = true }
 
 [target.'cfg(target_os = "redox")'.dependencies]
-redox-rings = { git = "https://gitlab.redox-os.org/redox-os/redox-rings.git", features = ["userspace", "sync"] }
+# cricker-os pin divergence: the two git dependencies that were here (redox-rings and
+# redox-buffer-pool, both on gitlab.redox-os.org) are removed. Cargo resolves every target's
+# dependencies into the lockfile, so a git source here would put a non-nifeos git dependency into
+# every workspace that builds this engine, which deny.toml refuses (DECISIONS §305) and which would
+# make the build need the network. Only `src/disk/ring.rs` and the Redox scheme use them, and both
+# are compiled only for `target_os = "redox"`, which nife never builds. See vendor/README.md.
 libredox = { version = "0.1.20", optional = true }
 redox-path = "0.4.1"
 redox-scheme = { version = "0.12", optional = true }
-redox-buffer-pool = { git = "https://gitlab.redox-os.org/redox-os/redox-buffer-pool.git" }
 
 [lints.rust]
 unexpected_cfgs = { level = "warn", check-cfg = ['cfg(fuzzing)'] }
