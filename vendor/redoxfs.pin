# Pin metadata for vendor/redoxfs, read by script/vendor-verify.
#
# The claim this file exists to make checkable: the tree in vendor/redoxfs is the published
# crates.io package below, plus exactly the changes in the divergence patch, and nothing else.
# Milestone 32's headline is "a real filesystem we did not write, running confined", and that is
# only worth as much as our ability to say what we are actually running. See vendor/README.md for
# the prose account and design/roadmap/0042-supply-chain-and-fuzzing.md for why this is a gate.
#
# Format: `key = value`, one per line, `#` comments. Deliberately not TOML: this is five fields and
# a stdlib-only parser, and adding a dependency to the integrity checker would be funny in the
# wrong way.

name = redoxfs
version = 0.9.1

# `git` means the pinned source is an archive of an upstream commit that no published version
# carries (0.9.1 is still the newest release and `Cargo.toml` still says 0.9.1). Without this line a
# pin is a crates.io package. script/vendor-verify says what each form hashes.
source = git

# Gitlab's archive of the pinned commit. The commit sha in the url cannot move. The sha256 is of the
# archive's uncompressed tar stream, which is what `git archive db847d8` produces byte for byte
# (compression is the forge's choice and may change without the commit changing).
url = https://gitlab.redox-os.org/redox-os/redoxfs/-/archive/db847d87c68052618d1427537c7277293a626a18/redoxfs-db847d87c68052618d1427537c7277293a626a18.tar.gz
sha256 = 89a904ebc1b917643458295b202146fd543d3e254223b5be494ba73092f1bbf5

# The upstream commit the archive above is of (master, 2026-10-29). Checked against the url by
# script/vendor-verify, and the point script/vendor-watch counts new commits from.
vcs = db847d87c68052618d1427537c7277293a626a18

# Every byte of difference from the archive, in `patch -p1` form. Regenerate with
# `script/vendor-verify --write-patch` after a deliberate change, and expect to explain the diff.
divergence = vendor/redoxfs.divergence.patch

# Upstream's source repository, read by script/vendor-watch (milestone 203) and by nothing else.
# The git half is checked as well as the published version because releases here are months apart,
# so a correctness fix can sit on master long before anybody publishes it.
vcs_url = https://gitlab.redox-os.org/redox-os/redoxfs
vcs_branch = master
