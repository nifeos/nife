+++ b/kernel/src/sched/process.rs
@@ -257,7 +257,7 @@ pub(super) fn depart(
         .threads
         .iter_mut()
         .any(|o| o.process == Some(pid) && o.id != current && is_running(o));
-    if whole || !others_run {
+    if !others_run {
         end(sched, pid, current, how);
     }
     own
