+        self.modify(group_idx, |desc| {
             desc.bg_flags |= flags;
-            true
-        } else {
-            false
-        }
+        })
     }
 
     /// Clears descriptor flags for one group.
     pub fn clear_flags(&mut self, group_idx: BGIndex, flags: u16) -> bool {
-        if let Some(desc) = self.get_desc_mut(group_idx) {
+        self.modify(group_idx, |desc| {
