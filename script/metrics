# queue file's reason. File name provisional (maintainer/build-time-chart).
CI_BUILDS_PATH = DATA_DIR / 'ci-builds.csv'
# The lid a build is held to, in minutes. Milestone 721 (each merge-group CI job has a 20-minute
# budget) set the same number per job; this is the whole build's, first job start to last job end
# across both workflows.
BUILD_LID = 20
# A job whose weekly median is under this many minutes in every charted week is counted in the note
# under ci-jobs.svg rather than drawn (`build_job_series`). A third of the lid: a job that short
# fits three deep in a `needs:` chain. Chosen from the record on 2026-10-11 (UTC), where it falls in
# the widest gap: fuzz peaked at 11.9 and every job left under it peaked at 5.9 or less (lint).
JOB_BAR_MINUTES = BUILD_LID / 3.0

# **This list is the roadmap's status vocabulary and it has to stay all of it**, because a status
# missing here is counted as nothing: `milestones()` below keys on this dict and skips a row whose
# token it does not hold, so `milestones_total` goes short by exactly the milestones it cannot see.
# That is not hypothetical. `SUPERSEDED` was minted 2026-09-15 and never added, so seven blocks were
# invisible in every weekly row until milestone 448 (a refusal gets a number, a status, and a
# condition that would change it) added both it and `REFUSED`. A backfill restates the history, so
# the correction reaches the weeks that were already written rather than only the next one.
MILESTONE_STATUSES = ['BUILT', 'PARTIAL', 'IN-PROGRESS', 'REMOVED',
                      'NOT-STARTED', 'OPTIONAL', 'RECORDED', 'SUPERSEDED', 'REFUSED']
DECISION_STATUSES = ['DECIDED', 'AMENDED', 'SUPERSEDED', 'PROPOSED', 'UNRECORDED']
# The naming vocabulary is `script/names`', taken from the shared module rather than retyped, so a
# fifth word added there arrives here as a column instead of as a silent undercount. It is lower
# case where the other two are upper, because these are the words a `Name:` block literally spells.
NAME_STATUSES = name_provenance.STATUSES

# ---------------------------------------------------------------------------------------------
# Which model wrote it (the commits-and-lines-by-model milestone, provisional).
#
# **The source is the `Co-Authored-By` trailer, and the richer source was refused on purpose.** The
# agent harness's own session records carry tokens per model, which is a better measure of effort
# than either of the two columns below. They are not usable here and the reasons are structural
# rather than a matter of taste: they are not in git, they live on one laptop and nothing promises
# to keep them (`script/effort`'s header already records 2026W29 through 2026W33 as unrecoverable);
# they cannot be backfilled, and git can; they see one machine, which is not hypothetical, because
# `Claude Fable 5` signs 360 commits here and appears in NO session record on the machine those
# records live on; and this script may not read anything but git, by the rule at the top of this
# file, because `.github/workflows/metrics.yml` runs it on a GitHub runner where none of that
# exists. A trailer-based series can live here. A token-based one cannot.
#
# **Every commit falls in exactly one of four buckets, and the sum is checked** (calef,
# 2026-09-24). `attributed` (a trailer, counted per model), `unattributed` (authored, no trailer),
# `merge`, and `claim` (an empty commit). `models_by_week` asserts that the four add up to the
# week's whole commit count, and
# a mismatch is a hard failure rather than a note. That assertion is the point of the shape: every
# other miscount this tree has written up was a count over a set nobody could see, and this one is
# auditable by arithmetic. If normalization ever drops a name, or a rule is wrong, the total stops
# balancing and something says so.
#
# **Normalization collapses a variant, never a version.** `Claude Opus 5 (1M context)` and
# `Claude Opus 5` are one model addressed through two context windows, so the trailing parenthetical
# is stripped. `Claude Fable 5.1` keeps its own column, because a version is a different model and
# folding it into `Claude Fable 5` would be exactly the silent merge this table exists to prevent.
#
# **A name this table has never seen is counted in `other_models` AND printed by name on every
# run.** It is not dropped and it does not quietly become an existing model. That is this tree's
# recurring "checked nothing, found nothing" failure (MILESTONE_STATUSES above carries the same
# scar: a status missing from a list was counted as zero for five days), and the difference here is
# that the bucket is visible in the CSV, the value is named on stderr, and the invariant still
# balances, so the reader is told rather than reassured.
MODEL_SLUGS = ['opus_5', 'opus_5_5', 'opus_4_8', 'sonnet_5', 'fable_5', 'fable_5_1', 'sonnet_5_5',
               'haiku_4_5', 'glm_5_3', 'glm_5_3_flash', 'other_models']

# Every trailer value this repository has ever carried, mapped to its column. Checked 2026-09-24
# against all 5,487 commits: 2,934 carry a trailer and these seven spellings are all of them.
# `Claude Opus 5.5` joined the same day, when the tree switched to it: until it had a row here every
# commit it signed fell into `other_models`, which is the warning below doing its job.
# `Claude Code` is the tool rather than a model. It is the default `script/claim` signs its empty
# claim commit with, and those land in the `claim` bucket, never here; the one non-empty commit it
# signs predates the convention. `OpenCode (GLM)` (normalized to `OpenCode`) signed 100 commits on
# 2026-10-15 and 10-16 UTC and names a harness and a vendor but no version, and nothing in the
# tree says which ran: `commit-models.csv` holds none of those shas and `effort.csv` has no GLM row
# for 2026W42. Choosing `glm_5_3` or `glm_5_3_flash` would be the silent merge the next paragraph
# forbids, so both tool names land in `other_models` as decisions rather than as unrecognized
# values warned about on every run. `GLM-5.3-Flash` is a spelling of `GLM 5.3 Flash`, the same
# model, and shares its column.
MODEL_TRAILERS = {
    'Claude Opus 5': 'opus_5',
    'Claude Opus 5.5': 'opus_5_5',
    'Claude Opus 4.8': 'opus_4_8',
    'Claude Sonnet 5': 'sonnet_5',
    'Claude Fable 5': 'fable_5',
    'Claude Fable 5.1': 'fable_5_1',
    'Claude Sonnet 5.5': 'sonnet_5_5',
    'Claude Haiku 4.5': 'haiku_4_5',
    'GLM 5.3': 'glm_5_3',
    'GLM 5.3 Flash': 'glm_5_3_flash',
    'GLM-5.3-Flash': 'glm_5_3_flash',
    'Claude Code': 'other_models',
    'OpenCode': 'other_models',
}
MODEL_UNKNOWN = 'other_models'

# **The trailer is not the only evidence of who wrote a commit** (milestone 725 (machine effort and commit
# attribution count every vendor), provisional). From 2026-09-29 to 2026-10-01 the work ran on z.ai's GLM
# models under opencode, which signed nothing, so 152 commits read as `unattributed`. opencode's
# own database holds proof for them (a `git commit` tool call with the sha git printed, or the
# subject it committed), and a runner has no such database, so `script/effort --attribute` writes
# the proof into `commit-models.csv` and this reads that file. The file's names are trailer
# spellings, so a commit it names takes the same path as a signed one. A trailer on the commit wins
# over the file, and a sha absent from the file stays `unattributed`: the column still means "no
# evidence", it just no longer means "no evidence in git".
COMMIT_MODELS_PATH = pathlib.Path('notes/project-metrics/commit-models.csv')


def commit_models(path=COMMIT_MODELS_PATH):
    """{commit sha: trailer-spelled model name} from the committed attribution record."""
    if not path.exists():
        return {}
    with path.open() as handle:
        return {row['sha']: row['model'] for row in csv.DictReader(handle)}


def signed_by(sha, trailer_names, recorded):
    """The model names a commit is attributed to: its own trailers, else the record's, else none."""
    if trailer_names:
        return trailer_names
    return [recorded[sha]] if sha in recorded else []

# The buckets no model owns. `pre_convention` is split out of `unattributed` because the two
# hide different facts: a commit made before the first trailer ever appeared could not have carried
# one, and a commit made after it and carrying none is a gap. Only the second is a defect.
# `claim` is an empty commit, which `models_by_week` explains.
MODEL_EXTRA = ['unattributed', 'pre_convention', 'merge', 'claim']


def _model_col(kind, slug):
    return 'model_' + kind + '_' + slug


def normalize_model(raw):
    """A trailer value, reduced to the model it names. See MODEL_TRAILERS above."""
    name = raw.split('<')[0].strip()
    return re.sub(r'\s*\([^)]*\)\s*$', '', name).strip()



def _col(prefix, status):
    return prefix + '_' + status.lower().replace('-', '_')


# One file per measure, which is what makes a new measure a new file rather than a new column
# (milestone 581, one metrics file per measure). `weekly.csv` held all of these side by side and
# was 58 columns wide, so every branch that added a measure rewrote the same header line and the
# same eleven data lines. Two pull requests adding disjoint measures collided with each other and
# with `main`; two of them aborted a rebase in one batch on 2026-09-23. A measure in its own file
# cannot collide with a measure in another one, which is AGENTS.md's top rung: the wrong state is
# unrepresentable rather than merely discouraged.
#
# The boundaries are the charts'. `notes/project-metrics.md` already presents these as separate
# panels, so a reader who knows the page knows the files, and `CHARTS` below is the index that
# names both. `weeks` is the one entry that is not a measure: it is the series index, recording
# which commit and date each week's numbers were read at.
#
# Two consequences worth knowing before reading `read_csv` and `render_csvs`. A row is written only
# when its measure has something to say for that week, so a series that began in 2026W39 starts
# there instead of carrying ten blank cells. And `read_csv` merges every file back into one row per
# week, so everything downstream of it, the charts included, still sees the flat row it always saw.
#
# `cost` rather than `effort`, because `effort.csv` in this same directory is `script/effort`'s
# output and an input to this script. Its chart, `effort.svg`, was removed on 2026-10-11 (UTC) at calef's
# request; the columns are still written, and `context-per-turn.svg` still draws from the same records.
WEEK = 'week'

