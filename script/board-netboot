#!/bin/sh
# script/board-netboot: serve the board payload over TFTP, so radon boots without a card (257).
#
#   script/board-netboot                        # serve target/board on udp/69 until Ctrl-C
#   script/board-netboot --root /some/dir       # serve somewhere else
#   script/board-netboot --port 6969            # a port an unprivileged bind is certain to get
#
# Read-only, one directory, one transfer at a time. It exists to answer three files:
# nife-vf2.img, nife-initial-ramdisk.img, and whatever else a bench session wants to hand the board.
#
# **Port 69 binds without root on macOS**, checked on patagonia on 2026-09-04, so there is no
# `sudo` in the runbook. If a machine refuses it, `--port` plus `setenv tftpdstp <port>` at the
# U-Boot prompt is the way out, and the board's script does not know about it.
#
# **Why this and not dnsmasq**, which is the other obvious answer and was considered properly
# (DECISIONS §46: taking a dependency is a decision, not a convenience). Three reasons, and the
# second is the one that decided it:
#
#   * It is not in the shipping graph, so §46's weight is lower here than it would be for a crate.
#     That argument cuts toward dnsmasq, and is stated first so it is not hidden.
#   * dnsmasq is a DHCP server that also does TFTP. On this bench the LAN is a family's house
#     network with a router already handing out leases, and a second DHCP server on it is an
#     outage for everyone in the building. `--port=0 --enable-tftp` with no `--dhcp-range` is
#     safe, and it is safe only as long as every future invocation stays right. A tool that
#     cannot speak DHCP at all cannot get that wrong.
#   * python3 is already what ten `script/` entry points are written in, so this is no new
#     requirement on anybody's machine, while `brew install dnsmasq` is.
#
# The cost, stated rather than implied: this is ours to maintain, and it is a bench tool rather
# than a hardened server. See the BUGS section at the end of this comment.
#
# Name: ratified 2026-09-05 (calef, milestone 257). Hyphenated because `script/` entry points are
# (AGENTS.md's naming table), and `board-` to sit with `board-image` and `board-console`: build
# the payload, serve it, watch it boot.
#
# The lane shipped this provisionally as `board-tftp` and calef chose `board-netboot` instead.
# The reason is the family's own scheme rather than a preference: `board-image` names the image it
# builds and `board-console` names the console it gives you, and `script/server`'s header states
# the rule outright, that "an OS is what you start, so this is script/server". Every member names
# the thing, and `board-tftp` would have been the one member naming its wire instead. `netboot`
# keeps the property that argued for `tftp`, which is that a reader already knows the word from
# outside this project, and AGENTS.md calls that the best name available.
#
# **The name overclaims slightly and that was accepted rather than missed:** this script serves
# files, and U-Boot does the booting. `board-payload` was refused for a worse collision, since
# `board-image` already builds the thing called the payload and two scripts named for one noun
# leave a reader guessing which end they are at. `tftpd` was refused outright: its `d` suffix is
# the exact form DECISIONS §39 spends a whole vocabulary avoiding, and `script/lint`'s first
# naming check rejects it.
#
# The U-Boot variable this script tells you to set is `nife_boot_server`, ratified the same day and
# corrected from `nife_server` on the same principle one level down: the address is for booting, not
# for TFTP, so `nife_tftp_server` was refused too. It is namespaced rather than U-Boot's own
# `serverip` because the generated script sets `serverip` FROM it, which leaves an override path (set
# `nife_boot_server` at the prompt and the baked address is not used) without writing a firmware-wide
# setting as the source of truth.
#
# BUGS
#   * One transfer at a time, and one board. Two boards fetching at once will make the second
#     wait or time out. There is exactly one board.
#   * No write support, and none is wanted: a board that can write to the machine that builds its
#     kernel is a worse rig than one that cannot.
#   * It trusts the LAN. Any host that can reach the port can read any file under the served
#     directory. The directory is `target/board`, which holds a kernel and an archive that are
#     about to be published anyway, and the traversal check keeps the request inside it.
#   * The addresses it prints are every private IPv4 this machine has. It cannot tell you which
#     one radon can route to, only that these are the candidates.
#   * The filename is taken verbatim, so a client that spells its path with backslashes gets a
#     "file not found". UEFI PXE clients send the DHCP option 67 string unchanged and dnsmasq
#     passes it through, so `EFI/BOOT/BOOTX64.EFI` arrives as written (measured under OVMF,
#     milestone 260); a client that did otherwise would need this to normalise separators.
#   * A transfer that stalls is retried six times per block and then abandoned, and the board is
#     told nothing; it sees its own timeout. U-Boot then fails `tftpboot`, which is the boot
#     script's fallback condition, so the failure mode is the card rather than a hang.

set -e
cd "$(dirname "$0")/.."

exec python3 - "$@" <<'PYEOF'
"""A read-only TFTP server, just enough for U-Boot: RFC 1350 plus blksize/tsize (RFC 2348/2349)."""

import os
import socket
import struct
import subprocess
import sys
import time

RRQ, DATA, ACK, ERROR, OACK = 1, 3, 4, 5, 6


class Cancelled(Exception):
    """The client sent a TFTP ERROR, which for a UEFI client is ROUTINE rather than a fault.

    EDK2's PXE base code asks for a file twice: once to learn its size, which it does by starting a
    read, taking the `tsize` out of the option acknowledgement, and then sending an ERROR to stop
    the transfer it just started; and once to actually fetch it. Milestone 260 found this server
    treating that cancellation as silence, retrying its acknowledgement six times, and printing
    `FAILED` on the one transfer of a boot that was working perfectly. Two costs, and the second is
    the one that mattered: the retries held the server long enough that the client's real request
    timed out and had to be sent again, and the log said a healthy netboot had failed.

    Milestone 257 wrote down the shape of that (`design/roadmap/0257-network-boot-radon.md`): a
    network boot can fail in a way that looks like success. This is the same coin's other face.
    """

# U-Boot asks for a large block and the transfer is 6,200 round trips at the 512-byte default, so
# the option is the difference between twenty seconds and several minutes. Capped at a jumbo frame
# because nothing on this path fragments usefully.
MAX_BLKSIZE = 9000
# Six tries per block, three seconds each. Long enough to ride out a board that is busy, short
# enough that a board that has gone away does not hold the server for a minute.
BLOCK_TRIES = 6
BLOCK_TIMEOUT = 3.0


def parse_args(argv):
    root, port = "target/board", 69
    rest = list(argv)
    while rest:
        arg = rest.pop(0)
        if arg == "--root" and rest:
            root = rest.pop(0)
        elif arg == "--port" and rest:
            port = int(rest.pop(0))
        else:
            sys.exit(f"board-netboot: unknown argument {arg} (--root <dir>, --port <n>)")
    return os.path.abspath(root), port


def private_addresses():
    """Every RFC 1918 address on this machine, which is what the board could fetch from.

    Read off the interfaces rather than out of the routing table, for the reason
    `cargo xtask board-script` records at length: a default route can belong to a Tailscale
    interface, and the address it hands back is one radon has no path to.
    """
    for command in (["ifconfig"], ["ip", "-4", "-o", "addr", "show"]):
        try:
            out = subprocess.run(command, capture_output=True, text=True, check=True).stdout
        except (OSError, subprocess.CalledProcessError):
            continue
        found = []
        for line in out.splitlines():
            words = line.split()
            for i, word in enumerate(words):
                if word == "inet" and i + 1 < len(words):
                    addr = words[i + 1].split("/")[0]
                    octets = addr.split(".")
                    if len(octets) != 4 or not all(o.isdigit() for o in octets):
                        continue
                    a, b = int(octets[0]), int(octets[1])
                    if a == 10 or (a == 172 and 16 <= b <= 31) or (a == 192 and b == 168):
                        found.append(addr)
        if found:
            return found
    return []


def error(sock, peer, code, message):
    sock.sendto(struct.pack("!HH", ERROR, code) + message.encode() + b"\0", peer)


def serve_file(peer, path, name, options):
    size = os.path.getsize(path)
    blksize = min(int(options.get("blksize", 512)), MAX_BLKSIZE)
    xfer = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    xfer.bind(("0.0.0.0", 0))
    xfer.settimeout(BLOCK_TIMEOUT)
    print(f"board-netboot: {peer[0]} <- {name} ({size} bytes, blksize {blksize})", flush=True)
    started = time.monotonic()
    try:
        acknowledged = {}
        if "blksize" in options:
            acknowledged["blksize"] = str(blksize)
        if "tsize" in options:
            acknowledged["tsize"] = str(size)
        if acknowledged:
            oack = struct.pack("!H", OACK) + b"".join(
                k.encode() + b"\0" + v.encode() + b"\0" for k, v in acknowledged.items()
            )
            for _ in range(BLOCK_TRIES):
                xfer.sendto(oack, peer)
                try:
                    reply, _from = xfer.recvfrom(1024)
                except socket.timeout:
                    continue
                if struct.unpack("!H", reply[:2])[0] == ERROR:
                    raise Cancelled("after the option acknowledgement")
                if struct.unpack("!HH", reply[:4]) == (ACK, 0):
                    break
            else:
                raise TimeoutError("no ACK for the option acknowledgement")

        with open(path, "rb") as payload:
            block = 1
            while True:
                chunk = payload.read(blksize)
                packet = struct.pack("!HH", DATA, block & 0xFFFF) + chunk
                for _ in range(BLOCK_TRIES):
                    xfer.sendto(packet, peer)
                    try:
                        reply, _from = xfer.recvfrom(1024)
                    except socket.timeout:
                        continue
                    op, acked = struct.unpack("!HH", reply[:4])
                    if op == ERROR:
                        raise Cancelled(f"at block {block}")
                    if op == ACK and acked == (block & 0xFFFF):
                        break
                else:
                    raise TimeoutError(f"no ACK for block {block}")
                if len(chunk) < blksize:
                    break
                block += 1
        elapsed = time.monotonic() - started
        rate = size / elapsed / 1024 if elapsed > 0 else 0.0
        print(
            f"board-netboot: {name} done, {size} bytes in {elapsed:.2f}s ({rate:.0f} KiB/s)",
            flush=True,
        )
    except Cancelled as where:
        # Not a failure, and saying so is the point. See Cancelled's docstring.
        print(
            f"board-netboot: {name} cancelled by the client {where} "
            f"(a UEFI client's file-size probe does exactly this)",
            flush=True,
        )
    except Exception as why:
        print(f"board-netboot: {name} FAILED: {why}", flush=True)
    finally:
        xfer.close()


def main():
    root, port = parse_args(sys.argv[1:])
    if not os.path.isdir(root):
        sys.exit(f"board-netboot: {root} is not a directory (script/board-image builds it)")

    server = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        server.bind(("0.0.0.0", port))
    except PermissionError:
        sys.exit(
            f"board-netboot: udp/{port} needs privileges on this machine.\n"
            f"            --port 6969, plus `setenv tftpdstp 6969` at the U-Boot prompt."
        )

    print(f"board-netboot: serving {root} on udp/{port}", flush=True)
    for entry in sorted(os.listdir(root)):
        full = os.path.join(root, entry)
        if os.path.isfile(full):
            print(f"            {entry}  ({os.path.getsize(full)} bytes)", flush=True)
    addresses = private_addresses()
    if addresses:
        print(
            "\nThe card's boot script expects one of these, and says which at boot.\n"
            "If it names a different one, the lease moved and this is the fix:",
            flush=True,
        )
        for addr in addresses:
            print(f"            StarFive # setenv nife_boot_server {addr}", flush=True)
        # The same list, for the other consumer. radon reads its server address off a card and can
        # be corrected at a prompt; xenon reads it out of a DHCP offer and cannot be corrected at
        # all, because the machine has no console this project can type into. So the address in the
        # router's `dhcp-boot` has to be right before the machine is powered on, and this list is
        # where it comes from. Which of these a board can route to is not knowable from here.
        print(
            "\nFor a UEFI client (xenon, milestone 260) the same address goes in the router's\n"
            "dhcp-boot line; see bench/xenon-netboot/dnsmasq.conf. There is no prompt to fix it at.",
            flush=True,
        )
    print("\nCtrl-C to stop.", flush=True)

    while True:
        packet, peer = server.recvfrom(65536)
        if len(packet) < 4 or struct.unpack("!H", packet[:2])[0] != RRQ:
            continue
        parts = packet[2:].split(b"\0")
        name = parts[0].decode("latin1")
        options = {
            parts[i].decode("latin1").lower(): parts[i + 1].decode("latin1")
            for i in range(2, len(parts) - 1, 2)
            if parts[i]
        }

        # No traversal: the name asked for has to resolve inside the served directory.
        path = os.path.abspath(os.path.join(root, name.lstrip("/")))
        if not path.startswith(root + os.sep) or not os.path.isfile(path):
            error(server, peer, 1, "file not found")
            print(f"board-netboot: {peer[0]} asked for {name!r}: NOT FOUND", flush=True)
            continue
        serve_file(peer, path, name, options)


try:
    main()
except KeyboardInterrupt:
    print("\nboard-netboot: stopped.", flush=True)
PYEOF
