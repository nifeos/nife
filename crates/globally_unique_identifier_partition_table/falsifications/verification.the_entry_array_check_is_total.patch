     header: &Header,
     supplied: &'a [u8],
 ) -> Result<&'a [u8], Error> {
-    if header.entry_bytes < entry::ENTRY_BYTES_U32 || !header.entry_bytes.is_multiple_of(8) {
+    if !header.entry_bytes.is_multiple_of(8) {
