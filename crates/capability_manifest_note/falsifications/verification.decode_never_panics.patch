Falsifies `capability_manifest_note::verification::decode_never_panics`.

The defect: `decode` reads the version and then trusts the length. A note's descriptor size is a
word in the file, so a hostile program can carry a four-byte descriptor that says version 1, and
every later field read then indexes past it. `decode` checks a version 1 length in its own arm and
slices the fixed fields after; the patch removes both.

Expected to fail: an index out of bounds in `decode`.

diff --git a/crates/capability_manifest_note/src/lib.rs b/crates/capability_manifest_note/src/lib.rs
--- a/crates/capability_manifest_note/src/lib.rs
+++ b/crates/capability_manifest_note/src/lib.rs
@@ -396,17 +396,15 @@
         return Err(Error::NoVersion);
     }
     match u32::from_le_bytes([d[0], d[1], d[2], d[3]]) {
-        VERSION if d.len() != DESCRIPTOR_LEN => return Err(Error::WrongLength),
         VERSION => {}
         ZONED_VERSION => {
             check_zones(d)?;
         }
         SERVICED_VERSION => {
             check_serviced(d)?;
         }
         _ => return Err(Error::UnknownVersion),
     }
-    let d = d.get(..DESCRIPTOR_LEN).ok_or(Error::WrongLength)?;
     let arg = decode_arg(d)?;
     let mem = decode_mem(d)?;
     let file = decode_file(d)?;
