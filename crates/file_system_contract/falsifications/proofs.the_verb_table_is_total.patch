Falsifies `file_system_contract::proofs::the_verb_table_is_total`.

The defect: `verb::of` accepts one opcode past `LAST`.

Expected to fail: the table's index-out-of-bounds check at `LAST + 1`.

diff --git a/crates/file_system_contract/src/verb.rs b/crates/file_system_contract/src/verb.rs
--- a/crates/file_system_contract/src/verb.rs
+++ b/crates/file_system_contract/src/verb.rs
@@ -294,7 +294,7 @@
 /// A caretaker's whole dispatch is this lookup plus the fields it returns, so an opcode a client
 /// invents is refused at one site rather than falling through a match's catch-all.
 pub const fn of(operation: u64) -> Option<&'static Verb> {
-    if operation < FIRST || operation > LAST {
+    if operation < FIRST || operation > LAST + 1 {
         return None;
     }
     Some(&TABLE[(operation - FIRST) as usize])
