Falsifies `counter_frequency_contract::verification::a_built_page_reads_back_its_rate`.

The defect: the writer stores the rate big-endian while the reader decodes little-endian, the
byte-order slip a writer makes when it copies a network-order habit. Every rate that is not a
byte-palindrome reads back as another number.

Expected to fail: the harness's `assert_eq!(page.hertz(), Some(hertz))`, on any `hertz` whose
bytes differ from their reversal.

diff --git a/crates/counter_frequency_contract/src/lib.rs b/crates/counter_frequency_contract/src/lib.rs
--- a/crates/counter_frequency_contract/src/lib.rs
+++ b/crates/counter_frequency_contract/src/lib.rs
@@ -150,7 +150,7 @@ const _: () = assert!(PAGE_VIRTUAL_ADDRESS <= usize::MAX as u64);
 pub fn build_page(hertz: u64) -> [u8; PAGE_CONTENT_BYTES] {
     let mut page = [0u8; PAGE_CONTENT_BYTES];
     page[MAGIC_OFFSET_BYTES..MAGIC_OFFSET_BYTES + 8].copy_from_slice(&MAGIC);
-    page[HERTZ_OFFSET_BYTES..HERTZ_OFFSET_BYTES + 8].copy_from_slice(&hertz.to_le_bytes());
+    page[HERTZ_OFFSET_BYTES..HERTZ_OFFSET_BYTES + 8].copy_from_slice(&hertz.to_be_bytes());
     page
 }
 
