Falsifies `globally_unique_identifier_partition_table::verification::an_entries_block_count_never_panics_and_is_exact`.

The defect: `blocks` subtracts and adds with the plain operators once the range is not reversed,
so the range `0 ..= u64::MAX` overflows: a panic with overflow checks on, a count of zero with
them off.

Expected to fail: the arithmetic overflow check in `blocks`, reached through the harness's `blocks` call.
diff --git a/crates/globally_unique_identifier_partition_table/src/entry.rs b/crates/globally_unique_identifier_partition_table/src/entry.rs
index 9aff667e7..7ecfabc74 100644
--- a/crates/globally_unique_identifier_partition_table/src/entry.rs
+++ b/crates/globally_unique_identifier_partition_table/src/entry.rs
@@ -135,12 +135,10 @@ impl Entry {
     /// range `0 ..= u64::MAX`). [`crate::PartitionTable`] rejects both, so a partition obtained
     /// from a parsed table always has a size.
     pub const fn blocks(&self) -> Option<u64> {
-        match self
-            .last_logical_block_address
-            .checked_sub(self.first_logical_block_address)
-        {
-            Some(span) => span.checked_add(1),
-            None => None,
+        if self.last_logical_block_address < self.first_logical_block_address {
+            None
+        } else {
+            Some(self.last_logical_block_address - self.first_logical_block_address + 1)
         }
     }
 
