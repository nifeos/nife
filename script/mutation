#!/bin/sh
# script/mutation: mutation testing over the host crates (milestone 85). See notes/mutation-testing.md.
#
# Coverage answers "did this line run under a test"; this answers the question coverage cannot,
# "would any test NOTICE if this line were wrong". cargo-mutants rewrites one function at a time
# (replace a return value, delete an arm, flip an operator), reruns the mutated package's tests, and
# a mutant the suite fails to kill is a survivor: a place where the code could be wrong and every
# test would stay green. The survivors are the product; each one is either a test worth writing or
# an exclusion worth recording in .cargo/mutants.toml with its reason.
#
#   script/mutation                        full run over the host crates (hours; see the note)
#   script/mutation --shard 1/4            one quarter of the mutants, for splitting across jobs
#   script/mutation -p glob -p network_time_protocol        just those packages
#   script/mutation --list                 enumerate the mutants without running anything
#   script/mutation --report [DIR...]      per-crate table from finished run output, vs the baseline
#
# "vs the baseline" is vs. the census `.cargo/mutants-baseline.txt` names on its second line, never
# vs. the previous census: see the TRAP comment in report() before treating that column as a recent
# delta. `script/mutation-census --save-baseline CENSUS` rewrites the file from a recorded census.
#
# Each mutant's test binary runs under a memory ceiling (milestone 277), because cargo-mutants
# bounds a mutant on time and the failure that kills this sweep is an allocation.
# MUTATION_MEMORY_LIMIT_KB raises, lowers or (at 0) removes it; helpers/memory-bounded-runner.sh is
# the mechanism and the argument.
#
# **A report, not a gate**, deliberately (roadmap 85): the full run costs hours, and a survivor is a
# worklist entry rather than a defect in the commit that happened to trigger the run. So survivors
# and timeouts exit 0 here, loudly; only a broken run (unmutated tree failing its own tests, tool
# error) fails. The weekly `mutation testing` workflow runs this sharded and publishes the report.
#
# Scope: `--workspace` minus the host-excluded set, which this script derives from
# helpers/host-excluded-crates.sh and passes to cargo-mutants on the command line (the crates whose
# lines cannot build for the host; the same set script/coverage exempts, for the same reason), and
# minus the judgment exclusions in .cargo/mutants.toml, each with its reason there. Timeouts
# are cargo-mutants' auto timeouts, derived from the baseline build and test times per package.
#
# Not in script/ci-build's table or script/test, on purpose: both are gates a developer waits on, and this
# is neither fast nor a gate.
#
# Name: ratified 2026-08-03 (calef), replacing `mutants`. Refused `mutants` (it names the tool,
# cargo-mutants, rather than the function). The directory it sits in had already made the argument:
# `verify`, `fuzz` and `coverage` all name the function and none names its tool.

set -e
# A heavy job: wait for one of the machine's heavy-job slots first (helpers/heavy_slot.py).
. "$(dirname "$0")/../helpers/heavy-slot.sh"
cd "$(dirname "$0")/.."

baseline_file=".cargo/mutants-baseline.txt"

usage() {
    cat <<'EOF'
usage: script/mutation [--report [DIR...]] [cargo-mutants args...]

  --report         summarize finished run output (default mutants.out) against the baseline
  anything else    forwarded to `cargo mutants --workspace` (e.g. --shard 2/4, -p glob, --list)
EOF
}

# Turn one or more mutants.out directories into per-crate counts: "crate caught missed timeout
# unviable" lines, sorted by crate. The outcome files each hold one mutant per line, starting with
# its source path, so the crate is the path component before /src/.
counts() {
    for dir in "$@"; do
        for kind in caught missed timeout unviable; do
            [ -f "$dir/$kind.txt" ] || continue
            sed "s|^|$kind |" "$dir/$kind.txt"
        done
    done | awk '
        {
            path = $2
            sub(/\/src\/.*/, "", path)
            n = split(path, part, "/")
            crate = part[n]
            crates[crate] = 1
            count[$1 "/" crate]++
        }
        END {
            for (c in crates)
                printf "%s %d %d %d %d\n", c,
                    count["caught/" c], count["missed/" c],
                    count["timeout/" c], count["unviable/" c]
        }
    ' | sort
}

report() {
    [ $# -gt 0 ] || set -- mutants.out
    for dir in "$@"; do
        if [ ! -d "$dir" ]; then
            echo "script/mutation: no run output at $dir (run script/mutation first)" >&2
            exit 2
        fi
    done
    # TRAP, recorded 2026-09-23 by milestone 512 (the census blamed one pull request for 55
    # survivors it did not write): this column is always .cargo/mutants-baseline.txt, a SINGLE
    # fixed census named on its second line (see $baseline_file above), never the previous one. A
    # crate's own history has no other record in the tree, so "missed 77, baseline missed 22" reads
    # exactly like two days of regression when it can just as easily be six weeks of untriaged
    # growth. That misreading shipped once, in design/fatal-risks.md's risk 3, blaming a pull
    # request for 55 survivors it did not write: 73 of machine_discovery's 77 predated the pull
    # request and the baseline column could not say so. Diff two runs' own missed.txt (or
    # script/mutation-census --compare) for a real between-census delta; this column only ever
    # answers "since the baseline's census", which the header line below names.
    base_census="$(sed -n 's/^# census=\([0-9-]*\) .*/\1/p' "$baseline_file" 2>/dev/null)"
    echo "crate                    caught  missed  timeout  unviable  (baseline missed, ${base_census:-no baseline})"
    counts "$@" | while read -r crate caught missed timeout unviable; do
        base="-"
        if [ -f "$baseline_file" ]; then
            base="$(awk -v c="$crate" '$1 == c { print $3 }' "$baseline_file")"
            [ -n "$base" ] || base="new"
        fi
        printf "%-24s %6d  %6d  %7d  %8d  %s\n" \
            "$crate" "$caught" "$missed" "$timeout" "$unviable" "$base"
    done
    echo
    # The survivors themselves, because the counts say how many and these say where. Each line is
    # a function the tests would not notice being wrong; the triage rule is in the note.
    for dir in "$@"; do
        for kind in missed timeout; do
            [ -s "$dir/$kind.txt" ] || continue
            echo "== $kind ($dir):"
            sed 's/^/  /' "$dir/$kind.txt"
        done
    done
}

case "$1" in
    --report) shift; report "$@"; exit 0 ;;
    --save-baseline)
        # Run directories can be any subset of a census, and eight per-crate runs written here would
        # replace the corpus with eight rows. The baseline comes only from a recorded whole census.
        echo "script/mutation: the baseline is written from a recorded census:" >&2
        echo "  script/mutation-census --save-baseline CENSUS" >&2
        exit 2
        ;;
    -h|--help) usage; exit 0 ;;
esac

# The version is PINNED in .cargo-mutants-version, the same discipline as .cargo-deny-version and
# .cargo-fuzz-version, and for cargo-deny's recorded reason: a tool whose verdict people compare
# week over week has to be the same tool everywhere. cargo-mutants in particular changes which
# mutants it GENERATES between versions, and a count that moves because the tool moved is
# indistinguishable from a count that moved because the tests got worse.
pinned="$(cat .cargo-mutants-version)"
installed="$(cargo mutants --version 2>/dev/null | awk '{print $2}')"
if [ "$installed" != "$pinned" ]; then
    echo "==> Installing cargo-mutants $pinned (have: ${installed:-none})"
    cargo install --locked "cargo-mutants@$pinned"
fi

# -j 2, and the number is a scar, not a guess. cargo-mutants parallelism is per MUTANT: each job
# holds a full copy of the tree with its own target/ and runs its own rustc and test binaries. At
# -j 4 the baseline run took the development machine (8 cores, 16 GiB) to zero free memory and the
# OOM killer took the session with it; at -j 2 the same run is slower and finishes. CI runners have
# no more memory than that machine, so the bound is not a local tuning. Raise it only with the
# memory headroom measured first. The jobserver (on by default) still caps compiler tasks at NCPUS.
#
# `--iterate` is worth knowing when resuming a long run: it skips mutants a previous mutants.out
# already caught, so a killed run resumes instead of repaying hours.
#
# Exit codes are the tool's verdict, not the script's: 2 means mutants survived and 3 means some
# timed out, and both are the report this exists to produce. Everything else (1 usage, 4 the
# unmutated tree failing its own tests) is a broken run and stays fatal.
#
# `--test-threads=4` (the trailing args reach libtest through cargo test): without it each of the
# two jobs runs its test binaries at NCPUS threads, so a machine shared with other work sees
# 2 x NCPUS bursts from what claims to be a two-job run. Four threads per job keeps the whole run
# inside roughly the core budget -j 2 implies. It costs wall clock on the heavy suites and that is
# the accepted trade; raise it only on a box this run has to itself.
#
# **A memory bound per mutant, because cargo-mutants only has a clock** (milestone 277). Its
# complete set of limits in 27.1.0 is `--timeout`, `--build-timeout`, their two multipliers and
# `--minimum-test-timeout`; there is no memory option to reach for, checked rather than assumed.
# The weekly sweep has never produced a full report and the reason is not the clock: one mutant
# went 1.4 GB to 15.8 GB in twenty seconds and took the runner agent with it, well inside the
# 28-to-51-second auto timeout, which therefore never fired. A mutant that turns a bound into an
# unbounded allocation is a hang no clock gets to notice.
#
# cargo runs each test binary through `target.<triple>.runner`, which is the only point in this
# pipeline that sees exactly one test binary and neither rustc nor the other job's binary, so it is
# the one place a PER-MUTANT bound can live. Setting it here rather than in .cargo/config.toml is
# deliberate: that file would bound every host `cargo test` in the tree, and this is a property of a
# mutation run rather than of the tree. MUTATION_MEMORY_LIMIT_KB tunes or disables it; the ceiling,
# what it costs, and why macOS is opt-out are in the runner's own header.
runner_var="CARGO_TARGET_$(rustc -vV | awk '/^host:/ {print toupper($2)}' | tr - _)_RUNNER"
export "$runner_var=$(pwd)/helpers/memory-bounded-runner.sh"

# Say once per RUN what the runner would otherwise have to say once per test binary, which at
# ~9,900 mutants is not a notice but a flood. The macOS default is no ceiling (the runner's BUGS
# section has the reason: XNU enforces RLIMIT_AS, but nobody has measured what number is safe
# there), and an unbounded run that looks identical to a bounded one is the thing this milestone
# exists to stop being true.
if [ "$(uname -s)" = "Darwin" ] && [ "${MUTATION_MEMORY_LIMIT_KB:-0}" = "0" ]; then
    echo "==> no per-mutant memory ceiling on macOS (default); a runaway mutant can still take the" >&2
    echo "    machine. Set MUTATION_MEMORY_LIMIT_KB to bound it; see helpers/memory-bounded-runner.sh" >&2
fi

# The derived exclusions ride on the command line (the shape roadmap 393 chose: .cargo/mutants.toml
# is not the record for the host-excluded set). Paths mode gives globs, the same form
# .cargo/mutants.toml's exclude_globs took, and `set -f` keeps the shell from expanding them
# against the tree before cargo-mutants sees one.
bare_paths=$(helpers/host-excluded-crates.sh paths) || exit 1
bare_excludes=""
for p in $bare_paths; do
    bare_excludes="$bare_excludes --exclude $p/**"
done
set -f
rc=0
cargo mutants --workspace -j 2 $bare_excludes "$@" -- -- --test-threads=4 || rc=$?
set +f
case "$rc" in
    0) echo "==> mutants: every mutant caught" ;;
    2|3) echo "==> mutants: survivors found (exit $rc); a report, not a gate. Triage per the note:" ;;
    *) echo "==> mutants: run FAILED (exit $rc): this is a broken run, not a survivor count" >&2
       # Exit 4 is the unmutated tree failing its own tests, and since milestone 277 this script
       # imposes a memory ceiling that could be the cause: an honest test binary that needs more
       # address space than the ceiling allows fails exactly like a broken baseline. Name the
       # suspect here rather than leaving the next reader to find the runner on their own.
       if [ "$rc" = "4" ]; then
           echo "==> the ceiling is a suspect: an honest test binary needing more address space than" >&2
           echo "    MUTATION_MEMORY_LIMIT_KB allows fails exactly like a broken baseline. Raise it," >&2
           echo "    or set it to 0 to run unbounded (helpers/memory-bounded-runner.sh)." >&2
       fi
       exit "$rc" ;;
esac

# A bare --list (or --version and friends) produces no outcome files; only report on a real run.
if [ -f mutants.out/caught.txt ] || [ -f mutants.out/missed.txt ]; then
    report mutants.out
fi
