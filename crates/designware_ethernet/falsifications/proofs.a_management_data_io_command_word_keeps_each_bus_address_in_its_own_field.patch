     (CLOCK_RANGE_500_TO_800_MEGAHERTZ << CLOCK_RANGE_SHIFT)
         | (((physical_layer_device_bus_address & 0x1f) as u32)
             << PHYSICAL_LAYER_DEVICE_BUS_ADDRESS_SHIFT)
-        | (((register & 0x1f) as u32) << REGISTER_BUS_ADDRESS_SHIFT)
