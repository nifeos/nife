# Anchored `/target` ignores ONLY the top-level one. This tree has four cargo workspaces
# (`fs-server/`, `tools/redoxfs-host/`, `std_exerciser/`, and the root), and on 2026-08-02 a
# `git add -A` swept 680 build artifacts from a nested `target/` into a commit, which is what
# GitHub's large-file warning and a broken `script/decisions` were both reporting: `git grep`
# emitted "Binary file ... matches" and the parser read "inary" as a section number.
#
# Unanchored, so it matches at any depth.
target/
# And the top-level one again without the slash, because `target/` matches only a directory and a
# symlink is not one to git: notes/dev-machine-disk.md makes the main checkout's `target` a symlink
# to another volume, and without this line `git status` lists it and `git add -A` commits it.
/target
*.ll

# Claude Code agent worktrees and local session files. The directory's contents are ignored rather
# than the directory itself, because git cannot re-include a file under an ignored directory, and
# settings.json is the project's shared hook configuration (#1202 meant to check it in and could
# not, for exactly that reason). settings.local.json stays ignored: it is per person. skills/ holds
# symlinks into notes/skills/, so Claude Code loads those instructions (2026-10-06, UTC); shared too.
.claude/*
!.claude/settings.json
!.claude/skills/
.playwright-mcp/

# macOS finder junk, tracked once by accident.
.DS_Store

# cargo-mutants scratch output (script/mutation). Unanchored: shard runs may write it in subdirs.
mutants.out/
mutants.out.old/

# Python bytecode from the shared modules under helpers/ (a run of script/names leaves one).
__pycache__/
*.pyc

# A session's scratchpad (gate logs, PR-body drafts, census dumps) lives in the main checkout,
# and the unsafe census plus the ratchets read the working copy: unlisted, a scratchpad's dumps
# get counted as tree and trip script/lint on a machine whose CI is green. Deleted on sight
# (2026-10-16, calef); this line keeps the next session's scratchpad from tripping them again.
scratchpad/

# The site build's npm packages (script/site). Its output goes to target/site.
site/node_modules/
