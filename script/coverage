#!/bin/sh
# script/coverage: line/region/function coverage for the host-testable logic crates, and the
# 80%-per-file floor that CI gates on.
#
# The kernel and user crates are bare-metal and only run under QEMU, where host instrumentation
# does not reach; DECISIONS §7 deliberately keeps the testable logic in host crates, and this
# measures exactly those (abi, capability, nifefs, device_tree_blob, elf, frames, paging, pci, ...). Requires
# cargo-llvm-cov. Not one of the canonical "Scripts to Rule Them All"; see notes/scripts.md.
#
#     script/coverage            the host crates, gated at the per-file floor (CI runs this)
#     script/coverage --kernel   the kernel's unit-test image on aarch64, instrumented and booted
#                                under QEMU (milestone 781); a report, never a gate, and in no CI job
#
# `--kernel` is `cargo xtask coverage`: it builds the image with `-C instrument-coverage`, boots it
# bounded, and reads the counters the kernel wrote to the host through semihosting. It needs QEMU
# and clang, not cargo-llvm-cov. notes/kernel-coverage.md has the method and the numbers.
#
# Name: ratified 2026-08-03 (calef), retroactively and as a pattern rather than as a rename. When he
# renamed `script/miri` and `script/mutants`, the argument was that `script/verify` runs Kani,
# `script/fuzz` runs cargo-fuzz and `script/coverage` runs llvm-cov, and none of them says so in its
# name, which is why swapping the tool someday costs nothing. Introduced 2026-07-22.

set -e
# A heavy job: wait for one of the machine's heavy-job slots first (helpers/heavy_slot.py).
. "$(dirname "$0")/../helpers/heavy-slot.sh"
cd "$(dirname "$0")/.."

if [ "$1" = "--kernel" ]; then
    . helpers/qemu-path.sh
    exec cargo xtask coverage
fi

# Auto-install the one tool this script needs, the first time it is run. It lives here rather than
# in script/bootstrap on purpose: bootstrap runs in the CI test job, which must not spend minutes
# compiling a coverage tool it never uses. CI's coverage job installs a prebuilt binary instead.
if ! cargo llvm-cov --version >/dev/null 2>&1; then
    echo "==> Installing cargo-llvm-cov (first run only)"
    cargo install cargo-llvm-cov
fi

# Run the host tests once under instrumentation (--no-report keeps the raw data), then render the
# summary, an lcov file, and a browsable HTML report from that same data.
#
# The host-excluded half of the selection is DERIVED, not carried: helpers/host-excluded-crates.sh
# asks cargo's dependency graph for every workspace crate that reaches `crates/user_mode_runtime`,
# and those are exactly the crates with no host logic to measure. `user_mode_runtime` is aarch64-only
# inline asm (the user-mode syscall runtime); `supervision_protocol` and `hot_swap_contract` are thin
# wrappers over its syscalls (build a child, quiesce a component); `system_initializer` spends a
# capability through one on every line (retype an object, build a child, delegate, delete);
# `virtio`'s seven entry points each orchestrate a live device. The exclusions are deliberate and
# narrow, not a way to keep the number green.
#
# `system_initializer`'s exclusion raises a narrower question worth stating rather than burying:
# whether that crate should grow a seam that IS host-testable, the way `regions` holds the untyped
# arithmetic the kernel calls into. Nothing here decides that; the exclusion says only that the
# crate as written cannot run on the host.
#
# `kernel` and `system_tests` are excluded by judgment rather than the derivation: bare metal
# through `kernel`, which the dependency-graph walk does not see. `xtask` sits with them: host
# tooling whose product is the gates themselves.
#
# `c_seam` is NOT excluded, because it is pure: constants, offsets, and small functions. It now
# carries the test the seam never had, asserting that `fixtures/c/c_seam.c` states the same values
# this crate does. That test is the reason rule 7 is worth its churn.
# Features are named ONE AT A TIME rather than swept with `--all-features`, and the reason is a
# failure this gate actually hit (2026-08-30, PR #590, milestone 87).
#
# What the flag was for: a feature-gated test is still a test and the floor does not know that.
# `crates/documentation`'s index reader is exercised by a round trip against the builder, and the builder
# sits behind `builder` because it allocates and the guest cannot. Without it, llvm-cov compiled the
# reader, ran none of the three tests that reach it, and reported 33.3% on a file that is
# round-tripped against its own writer.
#
# Why it cannot be `--all-features`: `uefi_loader`'s UEFI application is gated by `required-features
# = ["uefi"]`, which is exactly the mechanism that keeps `cargo build --workspace` from compiling a
# UEFI binary for macOS. `--all-features` turns that feature back on, and the crate's `build.rs`
# then panics by design, because the application embeds the kernel it boots and cannot be built
# outside `cargo xtask uefi-image`. **A feature that gates something un-buildable is a trap for every
# workspace-wide sweep, not just this one**, and naming features explicitly is the narrow fix; the
# crate's own foot gun is recorded in its manifest.
#
# So: add a package-qualified feature here when a crate grows one whose tests this floor should see.
# That is a line of maintenance per featured crate, and it buys back the limitation `--all-features`
# had anyway, which is that a union-of-all-features run can carry an undertested default build.
#
# The derived half of the selection (helpers/host-excluded-crates.sh), beside the three judgment
# excludes named above.
bare_crates=$(helpers/host-excluded-crates.sh) || exit 1
bare_excludes=""
for c in $bare_crates; do
    bare_excludes="$bare_excludes --exclude $c"
done
cargo llvm-cov --workspace --features documentation/builder \
    --exclude kernel --exclude system_tests --exclude xtask $bare_excludes --no-report
cargo llvm-cov report --summary-only
mkdir -p target/llvm-cov # the lcov --output-path parent must exist; --html creates its own
cargo llvm-cov report --lcov --output-path target/llvm-cov/lcov.info
cargo llvm-cov report --html

echo "==> lcov: target/llvm-cov/lcov.info"
echo "==> html: target/llvm-cov/html/index.html"

# --- The floor ----------------------------------------------------------------------------
# Per FILE, not just the total. The workspace total sat comfortably above 80% while three
# files were below it (one at 0%), which is exactly how a per-total gate hides a hole: a big
# well-tested crate subsidizes an untested one. lcov's LF/LH records are lines-found and
# lines-hit per file, so the check is a few lines of awk and needs no extra tooling.
#
# The floor is a floor, not a target: a file at 81% is not "done", and 100% is not the goal
# (tests must prove something; see CLAUDE.md on filler tests). The gate exists to make a
# regression loud, so the fix is a deliberate test or a deliberate, recorded exception here.
floor=85
# Where the per-file minimum is written for `script/metrics --coverage-min-from`. The aggregate a
# reader sees on the dashboard cannot move when one file slides from 85% to 81%, so the chart used
# to plot the comforting number while the gate read a different one. This file is what closes that.
# Provisional name (this lane), like the metrics column it feeds.
summary=target/llvm-cov/floor.txt
# The host-excluded paths, derived (helpers/host-excluded-crates.sh paths), become the first skip
# entries in the awk below. `cargo llvm-cov report` has no --exclude, so the flags on the run above
# keep those crates out of the RUN but not out of this report; the exemption has to be restated
# here to have any effect. A path this report never names (the bare-metal members are never
# instrumented at all) matches nothing and costs nothing.
bare_paths=$(helpers/host-excluded-crates.sh paths) || exit 1
floor_skips=""
for p in $bare_paths; do
    floor_skips="$floor_skips /$p/src/"
done
awk -F: -v floor="$floor" -v summary="$summary" -v skips="$floor_skips" '
    /^SF:/ { file = $2 }
    /^LF:/ { found = $2 }
    /^LH:/ {
        # Skip a file that no longer exists. `cargo llvm-cov report` reads accumulated profile
        # data from target/, so a retired crate lingers there and fails the floor at 0% long
        # after it was deleted (crates/heap did exactly this on 2026-07-31, and it costs whoever
        # hits it a confused half hour because the path looks real). CI starts clean and never
        # sees it; a working tree does. system() returns the exit status, so 0 means present.
        if (system("test -f " file) != 0) { next }
        # Crates that cannot execute a line on the host: the derived set again (see skips above),
        # because lcov records their files even with the run excluding them. They need a kernel or
        # a live device underneath, and one of them carries a measured reason worth keeping: the
        # security-critical part of virtio is already elsewhere and already tested, the
        # descriptor-ring validation in crates/direct_memory_access_validator (milestone 35 (prove
        # the DMA-confinement boundary)), which is why that thousand-line driver is thin on pure
        # logic, with two volatile ops.
        n = split(skips, skip_path, " ")
        for (i = 1; i <= n; i++) {
            if (index(file, skip_path[i])) { next }
        }
        # **c_seam is deliberately NOT here.** It is pure, and it now carries the test asserting
        # that fixtures/c/c_seam.c states the same constants it does. Keep the derivation to
        # things that physically cannot run, never to things that are merely untested.
        # **Build scripts, and this is a structural exemption rather than a membership one.** The
        # uncovered lines in a build script are its failure paths, and those do not execute in a
        # build that succeeded, which is every build this gate ever measures. So it can never reach
        # the floor no matter how well written: uefi_loader/build.rs scored 48.5% while doing exactly
        # its job, and the missing half is the diagnostics printed when an environment variable is
        # unset.
        #
        # It became visible on 2026-08-30 (PR #590, milestone 87) because it is the FIRST build
        # script in scope. Every other crate carrying one (kernel, user, std_exerciser,
        # redoxfs_server) is already outside this run for its own reason, so nobody had met the
        # question. Verified rather than assumed: the lcov report names exactly one build.rs.
        #
        # This is not the cannot-run-on-the-host class above. A build script does run, and on the
        # host; what it cannot do is exercise its own error branches during a successful build. Its
        # correctness is gated by the build working at all, loudly and immediately, which is a
        # stronger signal than a line count.
        if (file ~ /\/build\.rs$/) { next }
        # **The host half of `stick_maker`, and its entry point** (the stick program, 2026-09-19).
        # The decisions of that program are all in files this floor measures: the offer rule
        # (disk.rs), what each host says about its disks (macos.rs, linux.rs, windows.rs), and the
        # whole conversation with the person, tested against a fake host (cli.rs). What is exempt
        # only runs the tools of a host, and none of it can run here: this is an unprivileged Linux
        # process, with no diskutil, no kernel32, and no block device it may erase as root. Each
        # arm is run for real on its own host instead, by helpers/stick-maker-proof.sh (macOS)
        # and .github/workflows/stick-maker-hosts.yml (Linux on a loop device, and Windows), which
        # is where a regression in it would show. src/main.rs is the dozen lines that hand cli::run
        # the real machine; a test never executes the main of a binary, in the same structural
        # sense that a successful build never executes the failure paths of a build script.
        # (No apostrophes in this block: it sits inside the single-quoted awk program.)
        # Mirrored in .cargo/mutants.toml exclude_globs; change the two together.
        if (index(file, "/stick_maker/src/host/") || file ~ /\/stick_maker\/src\/main\.rs$/) { next }
        if (found <= 0) { next }
        # Past every exemption, so this is exactly the population the floor acts on, and therefore
        # exactly the population the minimum and the bands below describe. One pass on purpose: a
        # second reader of the lcov would drift from the exemptions above, and the value of
        # reporting a minimum is that it is the gate view rather than a near-miss of it.
        pct = $2 * 100 / found
        gated++
        if (gated == 1 || pct < min) { min = pct; min_file = file }
        if (pct < floor) {
            printf "coverage: %s: %.1f%% line coverage is under the %d%% floor\n",
                file, pct, floor
            failed = 1
            band_below++
        } else if (pct < 85) { newly_85++; newly_90++; band_80++ }
        else if (pct < 90) { newly_90++; band_85++ }
        else if (pct < 95) { band_90++ }
        else if (pct < 100) { band_95++ }
        else { band_100++ }
    }
    END {
        if (gated == 0) { print "coverage: no files in scope; is the lcov empty?"; exit 1 }
        printf "==> minimum per-file line coverage: %.1f%% (%s)\n", min, min_file
        printf "==> %d files gated. under %d%%: %d", gated, floor, band_below + 0
        printf ", %d-84.9%%: %d", floor, band_80 + 0
        printf ", 85-89.9%%: %d", band_85 + 0
        printf ", 90-94.9%%: %d", band_90 + 0
        printf ", 95-99.9%%: %d", band_95 + 0
        printf ", 100%%: %d\n", band_100 + 0
        # The question a proposal to raise the floor actually asks, answered on every run rather
        # than by somebody re-deriving it from the HTML report. Raising the floor is the architect
        # decision; this only prices it.
        printf "==> a floor of 85 newly fails %d of them; a floor of 90, %d\n",
            newly_85 + 0, newly_90 + 0
        # Written for script/metrics, which plots the minimum beside the aggregate on the
        # dashboard. It cannot recompute the minimum from the lcov alone: the exemptions above are
        # the judgment of this script plus the derivation it calls (helpers/host-excluded-crates.sh),
        # and a minimum derived without them would be some exempt file and not the number that can
        # fail a build.
        printf "min_file_pct %.1f\n", min > summary
        printf "min_file %s\n", min_file > summary
        printf "files_gated %d\n", gated > summary
        printf "newly_fail_at_85 %d\n", newly_85 + 0 > summary
        printf "newly_fail_at_90 %d\n", newly_90 + 0 > summary
        exit failed
    }
' target/llvm-cov/lcov.info || {
    echo "==> coverage floor FAILED (see above; floor is ${floor}% of lines per file)"
    echo "==> floor summary: $summary"
    exit 1
}
echo "==> coverage floor ok: every file is at or above ${floor}% line coverage"
echo "==> floor summary: $summary"
