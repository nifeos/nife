#!/bin/sh
#
# Name: provisional, minted 2026-11-18 (UTC) by lane/idle-prs-check.
#
# Flag every open pull request that nobody owns the next step of; exit 1 if any is flagged. The
# queue sweep runs it. The classifier and its classes are in helpers/idle_pull_requests.py, and
# partsfoundry/record:notes/idle-pull-requests.md says how a held pull request declares itself.
#
#     script/idle-pull-requests [<repo> ...] [--all-nifeos]
#     script/idle-pull-requests --selftest

exec python3 "$(dirname "$0")/../helpers/idle_pull_requests.py" "$@"
